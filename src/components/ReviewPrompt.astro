---
import { Star, ThumbsUp, MessageSquare } from "lucide-react";
---

<div class="bg-primary/10 text-secondary py-2">
  <div class="container">
    <div class="flex flex-col sm:flex-row justify-between items-center">
      <div class="flex items-center gap-2 mb-2 sm:mb-0 text-center sm:text-left">
        <Star size={16} className="text-primary hidden sm:block" />
        <span class="text-xs sm:text-sm font-medium">Rate your experience</span>
      </div>
      <div>
        <a 
          href="/feedback" 
          class="inline-flex items-center text-xs py-1 px-3 bg-primary text-white rounded hover:bg-primary/90 transition-colors"
        >
          <MessageSquare size={12} className="mr-1" />
          Feedback
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  // Track feedback link clicks for analytics purposes
  document.addEventListener('DOMContentLoaded', () => {
    const feedbackLink = document.querySelector('a[href="/feedback"]');
    
    if (feedbackLink) {
      feedbackLink.addEventListener('click', () => {
        console.log('Feedback link clicked');
        // Add analytics tracking here if needed
      });
    }
  });
</script>