---
// MoverbaseRedirect.astro
// Intercepts Moverbase postMessage events fired after successful form submission
// and redirects to /thank-you.
//
// How Moverbase works (sourced from lead.moverbase.net/js/widget.js):
//   On success: postMessage('MoverbaseWidget:RequestSent', '*')   <- always fires
//   If redirect URL set in dashboard: postMessage({ 'MoverbaseWidget:Redirect': path }, '*')
//
// We catch 'MoverbaseWidget:RequestSent' (the guaranteed one) and redirect ourselves.
---
<script is:inline>
(function () {
  var redirected = false;

  function goToThankYou() {
    if (redirected) return;
    redirected = true;
    window.location.href = '/thank-you';
  }

  window.addEventListener('message', function (e) {
    try {
      var data = e.data;

      // PRIMARY: plain string fired on every successful Moverbase submission
      if (data === 'MoverbaseWidget:RequestSent') {
        goToThankYou();
        return;
      }

      // SECONDARY: object fired when a redirect URL is configured in Moverbase dashboard
      if (data && typeof data === 'object' && data.hasOwnProperty('MoverbaseWidget:Redirect')) {
        goToThankYou();
        return;
      }

      // SAFETY NET: catch either as a JSON string
      if (typeof data === 'string' && data.indexOf('MoverbaseWidget:RequestSent') !== -1) {
        goToThankYou();
        return;
      }
    } catch (err) {}
  });

})();
</script>
