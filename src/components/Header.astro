---
import { buttonVariants } from "@/components/ui/button";
import { Truck, MapPin, Phone, Menu, X } from "lucide-react";
---

<header
  class="bg-background/95 supports-[backdrop-filter]:bg-background/60 sticky top-0 z-50 w-full border-b backdrop-blur shadow-sm"
>
  <!-- Top bar with contact info -->
  <div class="bg-secondary text-white py-2 hidden md:block">
    <div class="container flex justify-between items-center">
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-1">
          <MapPin size={16} className="text-accent" />
          <a href="https://maps.app.goo.gl/guTYTjBgBgSYpH5L9" target="_blank" rel="noreferrer" class="text-xs hover:text-accent transition-colors">
            1510 Glen Ayr Dr, Lakewood, CO 80215
          </a>
        </div>
        <div class="flex items-center gap-1">
          <Phone size={16} className="text-accent" />
          <a href="tel:9706164481" class="text-xs hover:text-accent transition-colors phone-link" data-google-link="https://maps.app.goo.gl/guTYTjBgBgSYpH5L9">
            (970) 616-4481
          </a>
        </div>
      </div>
      <div>
        <span class="text-xs">Mon-Sun: 8:00am - 6:00pm</span>
      </div>
    </div>
  </div>
  
  <!-- Main navigation -->
  <div
    class="container flex h-16 items-center justify-between"
  >
    <div class="flex items-center gap-2">
      <a href="/" class="flex items-center">
        <img 
          src="/assets/legacy-logo_nw_1c856f89.png" 
          alt="Legacy Moving Denver Logo" 
          width="180" 
          height="40"
          class="h-10 w-auto"
        />
      </a>
    </div>
    
    <!-- Mobile menu button -->
    <button 
      id="mobile-menu-button" 
      class="md:hidden flex items-center p-2"
      aria-label="Toggle menu"
    >
      <Menu size={24} className="menu-icon" />
      <X size={24} className="close-icon hidden" />
    </button>
    
    <!-- Desktop navigation -->
    <nav class="hidden md:flex items-center space-x-1">
      <a
        href="/"
        class={buttonVariants({ variant: 'ghost', size: 'sm' })}
      >
        Home
      </a>
      <a
        href="/about-us"
        class={buttonVariants({ variant: 'ghost', size: 'sm' })}
      >
        About Us
      </a>
      <a
        href="/services"
        class={buttonVariants({ variant: 'ghost', size: 'sm' })}
      >
        Services
      </a>
      <a
        href="/pricing"
        class={buttonVariants({ variant: 'ghost', size: 'sm' })}
      >
        Pricing
      </a>
      <a
        href="/contact"
        class={buttonVariants({ variant: 'ghost', size: 'sm' })}
      >
        Contact
      </a>
      <a
        href="/get-quote"
        class={buttonVariants({ size: 'sm' })}
      >
        Get a Quote
      </a>
    </nav>
  </div>
  
  <!-- Mobile navigation menu (hidden by default) -->
  <div id="mobile-menu" class="hidden bg-white border-t md:hidden">
    <nav class="container flex flex-col py-4">
      <a href="/" class="py-2 px-4 hover:bg-muted rounded">Home</a>
      <a href="/about-us" class="py-2 px-4 hover:bg-muted rounded">About Us</a>
      <a href="/services" class="py-2 px-4 hover:bg-muted rounded">Services</a>
      <a href="/pricing" class="py-2 px-4 hover:bg-muted rounded">Pricing</a>
      <a href="/contact" class="py-2 px-4 hover:bg-muted rounded">Contact</a>
      <a href="/get-quote" class="mt-2 mx-4">
        <button class="w-full bg-primary text-white py-2 px-4 rounded font-medium">
          Get a Quote
        </button>
      </a>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.querySelector('.menu-icon');
    const closeIcon = document.querySelector('.close-icon');
    
    if (mobileMenuButton && mobileMenu && menuIcon && closeIcon) {
      mobileMenuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
        menuIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      });
    }
  });
</script>
