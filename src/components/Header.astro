---
import { buttonVariants } from "@/components/ui/button";
import { Truck, MapPin, Phone, Menu, X, PhoneCall, ClipboardCheck } from "lucide-react";
---

<header
  class="bg-background/95 supports-[backdrop-filter]:bg-background/60 sticky top-0 z-50 w-full border-b backdrop-blur shadow-sm"
>
  <!-- Top bar with contact info - Split design with rounded corner -->
  <div class="relative">
    <div class="flex justify-end">
      <!-- Left section (gray) with rounded bottom-left corner -->
      <div class="bg-gray-600 text-white py-2 md:py-3 px-4 md:px-6 flex items-center" style="border-bottom-left-radius: 30px;">
        <span class="text-xs md:text-sm font-medium">
          <span class="md:hidden">We are here to help!</span>
          <span class="hidden md:inline">We are here to help. Contact us today!</span>
        </span>
      </div>
      
      <!-- Right section (blue) with email and phone -->
      <div class="flex bg-primary text-white py-2 md:py-3 px-3 md:px-6 items-center gap-3 md:gap-4">
        <a href="mailto:info@legacymovingdenver.com" class="flex items-center gap-1 md:gap-2 hover:text-white/80 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="md:w-[18px] md:h-[18px]"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <span class="text-xs md:hidden font-medium">Email</span>
          <span class="hidden md:inline text-sm font-medium">info@legacymovingdenver.com</span>
        </a>
        <a href="tel:7203401849" class="hidden md:flex items-center gap-2 hover:text-white/80 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span class="text-sm font-medium">(720) 340-1849</span>
        </a>
      </div>
    </div>
  </div>
  
  <!-- Main navigation -->
  <div
    class="container flex h-20 md:h-24 items-center justify-between"
  >
    <div class="flex items-center gap-2 -mt-1 md:ml-12 md:-mt-10">
      <a href="/" class="flex items-center">
        <img 
          src="/assets/legacy-logo_nw_1c856f89.png" 
          alt="Legacy Moving Denver Logo" 
          width="280" 
          height="65"
          class="h-12 w-auto md:h-20"
        />
      </a>
    </div>
    
    <!-- Mobile phone and menu buttons -->
    <div class="md:hidden flex items-center gap-3">
      <!-- Phone call button (mobile only) -->
      <a 
        href="tel:7203401849" 
        class="flex items-center justify-center p-2 phone-link"
        aria-label="Call us"
      >
        <Phone size={24} className="text-gray-900" />
      </a>
      
      <!-- Mobile menu button -->
      <button 
        id="mobile-menu-button" 
        class="flex items-center p-2"
        aria-label="Toggle menu"
      >
        <Menu size={24} className="menu-icon" />
        <X size={24} className="close-icon hidden" />
      </button>
    </div>
    
    <!-- Desktop navigation -->
    <nav class="hidden md:flex items-center space-x-4 lg:space-x-6">
      <a
        href="/"
        class={buttonVariants({ variant: 'ghost', className: 'text-base lg:text-lg font-medium' })}
      >
        Home
      </a>
      <a
        href="/about-us"
        class={buttonVariants({ variant: 'ghost', className: 'text-base lg:text-lg font-medium' })}
      >
        About Us
      </a>
      <div class="relative group">
        <a 
          href="/services"
          class={buttonVariants({ variant: 'ghost', className: 'text-base lg:text-lg font-medium flex items-center' })}
          aria-haspopup="true"
        >
          Services
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="m6 9 6 6 6-6"/></svg>
        </a>
        <div class="absolute left-0 top-full pt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 hidden group-hover:block z-50">
          <div class="py-1">
            <a href="/services/local-moving" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Local Moving</a>
            <a href="/services/long-distance-moving" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Long Distance Moving</a>
            <a href="/services/residential-moving" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Residential Moving</a>
            <a href="/services/commercial-moving" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Commercial Moving</a>
            <a href="/services/packing-services" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Packing Services</a>
            <a href="/services/loading-unloading" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Loading & Unloading</a>
            <a href="/services/storage-solutions" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Storage Solutions</a>
            <a href="/services" class="block px-4 py-2 text-sm text-primary font-medium hover:bg-gray-100">View All Services</a>
          </div>
        </div>
      </div>
      <a
        href="/discounts"
        class={buttonVariants({ variant: 'ghost', className: 'text-base lg:text-lg font-medium' })}
      >
        Discounts
      </a>
      <a
        href="/contact"
        class={buttonVariants({ variant: 'ghost', className: 'text-base lg:text-lg font-medium' })}
      >
        Contact
      </a>
      <div class="ml-3 pl-3 border-l">
        <a
          href="tel:7203401849"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-md text-base font-semibold bg-primary text-white hover:bg-primary/90 shadow-sm phone-link"
        >
          <Phone size={18} className="mr-2" />
          (720) 340-1849
        </a>
      </div>
    </nav>
  </div>
  
  <!-- Mobile navigation menu (hidden by default) -->
  <div id="mobile-menu" class="hidden bg-white border-t md:hidden">
    <!-- Mobile call and quote buttons -->
    <div class="container py-3 border-b">
      <a href="/get-quote" class="flex items-center justify-center bg-primary text-white py-3 px-2 rounded-md font-medium mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
        Get a Quick Quote
      </a>
      <a href="tel:7203401849" class="flex items-center justify-center bg-secondary text-white py-3 px-2 rounded-md font-medium phone-link">
        <Phone size={16} className="mr-2" />
        Call (720) 340-1849
      </a>
    </div>

    <nav class="container flex flex-col py-4">
      <a href="/" class="py-2 px-4 hover:bg-muted rounded">Home</a>
      <a href="/about-us" class="py-2 px-4 hover:bg-muted rounded">About Us</a>
      
      <!-- Mobile Services Dropdown -->
      <div class="mobile-dropdown">
        <button id="mobile-services-button" class="flex items-center justify-between w-full py-2 px-4 hover:bg-muted rounded text-left">
          <span>Our Services</span>
          <svg id="mobile-services-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transform transition-transform"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="mobile-services-dropdown" class="hidden pl-4 mt-1 mb-2 border-l border-gray-200 ml-4 space-y-1">
          <a href="/services/local-moving" class="block py-2 px-4 hover:bg-muted rounded">Local Moving</a>
          <a href="/services/long-distance-moving" class="block py-2 px-4 hover:bg-muted rounded">Long Distance Moving</a>
          <a href="/services/residential-moving" class="block py-2 px-4 hover:bg-muted rounded">Residential Moving</a>
          <a href="/services/commercial-moving" class="block py-2 px-4 hover:bg-muted rounded">Commercial Moving</a>
          <a href="/services/packing-services" class="block py-2 px-4 hover:bg-muted rounded">Packing Services</a>
          <a href="/services/loading-unloading" class="block py-2 px-4 hover:bg-muted rounded">Loading & Unloading</a>
          <a href="/services/storage-solutions" class="block py-2 px-4 hover:bg-muted rounded">Storage Solutions</a>
          <a href="/services" class="block py-2 px-4 hover:bg-muted rounded font-medium text-primary">View All Services</a>
        </div>
      </div>
      
      <a href="/discounts" class="py-2 px-4 hover:bg-muted rounded">Discounts</a>
      <a href="/contact" class="py-2 px-4 hover:bg-muted rounded">Contact</a>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  document.addEventListener('DOMContentLoaded', () => {
    // Main mobile menu toggle
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.querySelector('.menu-icon');
    const closeIcon = document.querySelector('.close-icon');
    
    if (mobileMenuButton && mobileMenu && menuIcon && closeIcon) {
      mobileMenuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
        menuIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      });
    }
    
    // Services dropdown toggle for mobile
    const mobileServicesButton = document.getElementById('mobile-services-button');
    const mobileServicesDropdown = document.getElementById('mobile-services-dropdown');
    const mobileServicesIcon = document.getElementById('mobile-services-icon');
    
    if (mobileServicesButton && mobileServicesDropdown && mobileServicesIcon) {
      mobileServicesButton.addEventListener('click', () => {
        mobileServicesDropdown.classList.toggle('hidden');
        // Rotate the icon when dropdown is open/closed
        mobileServicesIcon.classList.toggle('rotate-180');
      });
    }
  });
</script>
