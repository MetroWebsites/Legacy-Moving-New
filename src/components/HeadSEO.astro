---
import "@/styles/global.css";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  ogImage?: URL | undefined;
}

// SEO-critical: ensure canonical never falls back to localhost if Astro.site isn't set
const SITE = Astro.site ?? new URL("https://www.legacymovingdenver.com");
const canonicalURL = new URL(Astro.url.pathname, SITE);

if (Astro.props.ogImage === undefined) {
  Astro.props.ogImage = new URL("/social-preview.jpg", SITE);
}

const { title, description, ogImage } = Astro.props;
---

<meta charset="utf-8" />

<!-- ✅ Allow indexing -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />

<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content="MetroWebsites.com" />

<link rel="canonical" href={canonicalURL} />

<link
  rel="icon"
  type="image/png"
  href="/favicon.png"
/>

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<!-- Preconnect to critical third-party origins — must come before their scripts -->
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://www.googletagmanager.com" />
<link rel="preconnect" href="https://lead.moverbase.net" />

<!-- Google Fonts: loaded via <link> (not @import) so the browser can discover and
     fetch it in parallel with other head resources instead of blocking on CSS parse. -->
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700;800&display=swap"
  media="print"
  onload="this.media='all'"
/>
<!-- Fallback for no-JS -->
<noscript>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700;800&display=swap" />
</noscript>

<!-- Google tag (gtag.js) — deferred until the browser is idle so it does not
     block first paint or LCP.  requestIdleCallback fires after the page is
     visually complete; setTimeout(…,0) is the fallback for Safari / older browsers. -->
<script is:inline>
  (function() {
    function loadGTM() {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=AW-10890296710';
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'AW-10890296710');
      gtag('config', 'G-6NR81FW8N5');
    }
    if ('requestIdleCallback' in window) {
      requestIdleCallback(loadGTM, { timeout: 4000 });
    } else {
      // Safari / older browsers: load after page load event completes
      if (document.readyState === 'complete') {
        setTimeout(loadGTM, 1);
      } else {
        window.addEventListener('load', function() { setTimeout(loadGTM, 1); });
      }
    }
  })();
</script>

<!-- hCaptcha: deferred load — script only injected when user interacts with a form.
     This removes the 2.2s blocking hcaptcha/1/api.js load from initial page load. -->
<script is:inline>
  (function() {
    var hcaptchaLoaded = false;

    function loadHCaptcha() {
      if (hcaptchaLoaded) return;
      hcaptchaLoaded = true;
      var s = document.createElement('script');
      s.src = 'https://js.hcaptcha.com/1/api.js';
      s.async = true;
      s.defer = true;
      document.head.appendChild(s);
    }

    // Load on first focus/click on any form field
    function attachListeners() {
      var triggers = ['input', 'textarea', 'select', 'button[type="submit"]'];
      triggers.forEach(function(sel) {
        document.querySelectorAll(sel).forEach(function(el) {
          el.addEventListener('focus', loadHCaptcha, { once: true, passive: true });
          el.addEventListener('click', loadHCaptcha, { once: true, passive: true });
        });
      });
      // Also fire on any form click as a fallback
      document.querySelectorAll('form').forEach(function(form) {
        form.addEventListener('click', loadHCaptcha, { once: true, passive: true });
        form.addEventListener('focusin', loadHCaptcha, { once: true, passive: true });
      });
    }

    // Run after DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', attachListeners);
    } else {
      attachListeners();
    }
  })();
</script>

<!-- DO NOT REMOVE - Plausible Analytics must always be enabled -->
<script is:inline>
  // Plausible Analytics - Dynamic Domain Detection
  // This script automatically detects the current domain and loads Plausible analytics
  (function() {
    var hostname = window.location.hostname;
    
    // Only track production domains (exclude localhost, IP addresses, etc.)
    if (hostname !== 'localhost' && !hostname.match(/^\d+\.\d+\.\d+\.\d+$/)) {
      var script = document.createElement('script');
      script.defer = true;
      script.setAttribute('data-domain', hostname);
      script.src = 'https://plausible.io/js/script.js';
      document.head.appendChild(script);
    }
  })();
</script>
