---
import "@/styles/global.css";
import "@/styles/fonts.css";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  ogImage?: URL | undefined;
}

// SEO-critical: ensure canonical never falls back to localhost if Astro.site isn't set
const SITE = Astro.site ?? new URL("https://www.legacymovingdenver.com");
const canonicalURL = new URL(Astro.url.pathname, SITE);

if (Astro.props.ogImage === undefined) {
  Astro.props.ogImage = new URL("/social-preview.jpg", SITE);
}

const { title, description, ogImage } = Astro.props;
---

<meta charset="utf-8" />

<!-- ✅ Allow indexing -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />

<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content="MetroWebsites.com" />

<link rel="canonical" href={canonicalURL} />

<link
  rel="icon"
  type="image/png"
  href="/favicon.png"
/>

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-10890296710"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'AW-10890296710');
</script>

<!-- hCaptcha API Script - Load before React hydration -->
<script is:inline src="https://js.hcaptcha.com/1/api.js"></script>

<!-- DO NOT REMOVE - Plausible Analytics must always be enabled -->
<script is:inline>
  // Plausible Analytics - Dynamic Domain Detection
  // This script automatically detects the current domain and loads Plausible analytics
  (function() {
    const hostname = window.location.hostname;
    
    // Only track production domains (exclude localhost, IP addresses, etc.)
    if (hostname !== 'localhost' && !hostname.match(/^\d+\.\d+\.\d+\.\d+$/)) {
      const script = document.createElement('script');
      script.defer = true;
      script.setAttribute('data-domain', hostname);
      script.src = 'https://plausible.io/js/script.js';
      document.head.appendChild(script);
    }
  })();
</script>
