---
interface Props {
  phoneNumber?: string;
}
const { phoneNumber = '7203401849' } = Astro.props;
const phoneDisplay = phoneNumber === '7207642299' ? '(720) 764-2299' : '(720) 340-1849';
---
<footer class="bg-secondary text-white pt-4 md:pt-5 pb-3 md:pb-3">
  <div class="container">
    <!-- Logo and social icons only on mobile -->
    <div class="mb-4 md:hidden flex items-center gap-4">
      <div class="flex-shrink-0">
        <img 
          src="/lm-logo.png" 
          alt="Legacy Moving Denver Logo" 
          width="64" 
          height="64"
          class="h-16 w-16" 
          onerror="this.onerror=null; this.src='/favicon.svg';"
        />
      </div>
      <div class="flex flex-wrap gap-3 items-center">
        <a href="https://facebook.com/LegacyMovingDenver" target="_blank" rel="noreferrer" class="text-gray-300 hover:text-white transition-colors">
          <span class="sr-only">Facebook</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-facebook"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="https://www.instagram.com/legacymoving_denver" target="_blank" rel="noreferrer" class="text-gray-300 hover:text-white transition-colors">
          <span class="sr-only">Instagram</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
        </a>
        <a href="https://twitter.com/Legacymoving_" target="_blank" rel="noreferrer" class="text-gray-300 hover:text-white transition-colors">
          <span class="sr-only">Twitter</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
        </a>
        <a href="https://maps.app.goo.gl/9YhGXwHp1TMi6xoG9" target="_blank" rel="noreferrer" class="text-gray-300 hover:text-white transition-colors">
          <span class="sr-only">Google Maps</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
        </a>
      </div>
    </div>

    <!-- Desktop: 6-column grid for better control, Mobile: 2-column -->
    <div class="grid grid-cols-2 md:grid-cols-6 gap-4 md:gap-4">
      <!-- About/Mission - Spans 2 columns on desktop for wider text -->
      <div class="hidden md:block md:col-span-2">
        <div class="flex items-center gap-4 mb-2">
          <img 
            src="/lm-logo.png" 
            alt="Legacy Moving Denver Logo" 
            width="64" 
            height="64"
            class="h-16 w-16" 
            onerror="this.onerror=null; this.src='/favicon.svg';"
          />
          <div class="flex flex-wrap gap-3">
            <a href="https://facebook.com/LegacyMovingDenver" target="_blank" rel="noreferrer" class="text-gray-300 hover:text-white transition-colors">
              <span class="sr-only">Facebook</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="https://www.instagram.com/legacymoving_denver" target="_blank" rel="noreferrer" class="text-gray-300 hover:text-white transition-colors">
              <span class="sr-only">Instagram</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
            </a>
            <a href="https://twitter.com/Legacymoving_" target="_blank" rel="noreferrer" class="text-gray-300 hover:text-white transition-colors">
              <span class="sr-only">Twitter</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
            </a>
            <a href="https://maps.app.goo.gl/9YhGXwHp1TMi6xoG9" target="_blank" rel="noreferrer" class="text-gray-300 hover:text-white transition-colors">
              <span class="sr-only">Google Maps</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
            </a>
          </div>
        </div>
        <p class="text-sm text-gray-300 leading-relaxed font-bold pr-4">
          Legacy Moving was established and built to set a higher standard in the moving industry, one defined by accredited professionalism, nationwide authorization, and unwavering customer trust. We bring peace of mind to every doorstep and confidence with every journey.
        </p>
      </div>
      
      <!-- Our Services - Single column, closer to Quick Links -->
      <div>
        <h3 class="text-sm font-semibold mb-1.5">Our Services</h3>
        <ul class="space-y-0.5 text-xs text-gray-300">
          <li><a href="/services/local-moving" class="hover:text-white transition-colors">Local Moving</a></li>
          <li><a href="/services/long-distance-moving" class="hover:text-white transition-colors">Long Distance Moving</a></li>
          <li><a href="/services/residential-moving" class="hover:text-white transition-colors">Residential Moving</a></li>
          <li><a href="/services/commercial-moving" class="hover:text-white transition-colors">Commercial Moving</a></li>
          <li><a href="/services/packing-services" class="hover:text-white transition-colors">Packing Services</a></li>
          <li><a href="/services/loading-unloading" class="hover:text-white transition-colors">Loading & Unloading</a></li>
          <li><a href="/services/storage-solutions" class="hover:text-white transition-colors">Storage Solutions</a></li>
          <li><a href="/services" class="hover:text-white transition-colors">View All Services</a></li>
          <li><a href="/services/specialty-items" class="text-orange-600 hover:text-orange-700 transition-colors">Specialty Items</a></li>
        </ul>
      </div>
      
      <!-- Quick Links - Single column, close to Services -->
      <div>
        <h3 class="text-sm md:text-base font-semibold mb-2 md:mb-3">Quick Links</h3>
        <ul class="space-y-1 md:space-y-1.5 text-xs text-gray-300">
          <li><a href="/about-us" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="/meet-the-team" class="hover:text-white transition-colors">Meet the Team</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors">Blog</a></li>
          <li><a href="/locations" class="hover:text-white transition-colors">Locations We Serve</a></li>
          <li><a href="/work-for-us" class="hover:text-white transition-colors">Work For Us</a></li>
          <li><a href="/faq" class="hover:text-white transition-colors">FAQ</a></li>
          <li><a href="/testimonials" class="hover:text-white transition-colors">Testimonials</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact Us</a></li>
        </ul>
      </div>
      
      <!-- Contact Us - Single column, close to Quick Links -->
      <div class="hidden md:block">
        <h3 class="text-sm md:text-base font-semibold mb-2 md:mb-3">Contact Us</h3>
        <ul class="space-y-1.5 md:space-y-2 text-xs text-gray-300">
          <li class="flex items-start gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent mt-0.5 flex-shrink-0"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <a href="https://maps.app.goo.gl/9YhGXwHp1TMi6xoG9" target="_blank" rel="noreferrer" class="hover:text-accent transition-colors leading-relaxed">
              8805 W. 14th Ave, Suite 300<br>Lakewood, CO 80215
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent flex-shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href={`tel:${phoneNumber}`} class="hover:text-accent transition-colors phone-link">
              {phoneDisplay}
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent flex-shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <a href="mailto:info@legacymovingdenver.com" class="hover:text-accent transition-colors">
              info@legacymovingdenver.com
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent flex-shrink-0"><path d="M12 2h.01"/><path d="M17 16h.01"/><path d="M14 20h.01"/><path d="M12 11h.01"/><path d="M7 16h.01"/><path d="M3 12h.01"/><circle cx="12" cy="12" r="10"/></svg>
            <div class="flex flex-col text-xs">
              <span>M-F: 8:00am - 6:00pm</span>
              <span>Sat: 8:00am - 3:00pm</span>
              <span>Sun: Closed</span>
            </div>
          </li>
        </ul>
      </div>
      
      <!-- Fully Licensed & Insured - Single column -->
      <div class="hidden md:block">
        <h3 class="text-sm md:text-base font-semibold mb-2 md:mb-3">Fully Licensed & Insured</h3>
        <div class="flex flex-col gap-1.5 md:gap-2">
          <span class="text-xs bg-gray-700/50 text-gray-300 px-2 py-0.5 md:py-1 rounded-md whitespace-nowrap">USDOT #3462023</span>
          <span class="text-xs bg-gray-700/50 text-gray-300 px-2 py-0.5 md:py-1 rounded-md whitespace-nowrap">MC #1189363</span>
          <span class="text-xs bg-gray-700/50 text-gray-300 px-2 py-0.5 md:py-1 rounded-md whitespace-nowrap">PUC #HHG-00682</span>
        </div>
      </div>
      
      <!-- Mobile: Contact info (full width) -->
      <div class="col-span-2 md:hidden">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <h3 class="text-sm font-semibold mb-2">Contact Us</h3>
            <ul class="space-y-1.5 text-xs text-gray-300">
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent mt-0.5 flex-shrink-0"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <a href="https://maps.app.goo.gl/9YhGXwHp1TMi6xoG9" target="_blank" rel="noreferrer" class="hover:text-accent transition-colors leading-relaxed">
                  8805 W. 14th Ave, Suite 300<br>Lakewood, CO 80215
                </a>
              </li>
              <li class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent flex-shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <a href={`tel:${phoneNumber}`} class="hover:text-accent transition-colors phone-link">
                  {phoneDisplay}
                </a>
              </li>
              <li class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent flex-shrink-0"><path d="M12 2h.01"/><path d="M17 16h.01"/><path d="M14 20h.01"/><path d="M12 11h.01"/><path d="M7 16h.01"/><path d="M3 12h.01"/><circle cx="12" cy="12" r="10"/></svg>
                <div class="flex flex-col text-xs">
              <span>M-F: 8:00am - 6:00pm</span>
              <span>Sat: 8:00am - 3:00pm</span>
              <span>Sun: Closed</span>
            </div>
              </li>
            </ul>
          </div>
          
          <div>
            <p class="text-xs text-gray-300 font-semibold mb-1.5">Fully Licensed & Insured</p>
            <div class="flex flex-col gap-1">
              <span class="text-[10px] bg-gray-700/50 text-gray-300 px-1.5 py-0.5 rounded-md whitespace-nowrap">USDOT #3462023</span>
              <span class="text-[10px] bg-gray-700/50 text-gray-300 px-1.5 py-0.5 rounded-md whitespace-nowrap">MC #1189363</span>
              <span class="text-[10px] bg-gray-700/50 text-gray-300 px-1.5 py-0.5 rounded-md whitespace-nowrap">PUC #HHG-00682</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Bottom bar -->
    <div class="border-t border-gray-700 mt-3 md:mt-4 pt-2">
      <div class="flex justify-center gap-2 md:gap-3 mb-1 flex-wrap">
        <a href="/terms" class="text-xs text-gray-400 hover:text-white transition-colors">Terms</a>
        <span class="text-gray-600">|</span>
        <a href="/privacy" class="text-xs text-gray-400 hover:text-white transition-colors">Privacy</a>
        <span class="text-gray-600">|</span>
        <a href="/sitemap.xml" class="text-xs text-gray-400 hover:text-white transition-colors">Sitemap</a>
        <span class="text-gray-600">|</span>
        <a href="/robots.txt" class="text-xs text-gray-400 hover:text-white transition-colors">Robots.txt</a>
        <span class="text-gray-600">|</span>
        <a href="/llms.txt" class="text-xs text-gray-400 hover:text-white transition-colors">LLMs.txt</a>
      </div>
      <p class="text-xs text-gray-400 text-center leading-tight">
        &copy; 2026 Legacy Moving Denver. All rights reserved. Website & SEO by <a href="https://www.metrowebsites.com" target="_blank" rel="noreferrer" class="text-gray-400 hover:text-white underline underline-offset-2">MetroWebsites.com</a>
      </p>
    </div>
  </div>
</footer>

