---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { Check, Package, Shield, Clock, TagIcon } from 'lucide-react';
import packingImage from '../assets/services/packing.jpg';
---

<BaseLayout
  title="Packing Services Denver | Legacy Moving Denver"
  description="Professional packing services in Denver. Our expert packers provide full and partial packing solutions to ensure your belongings arrive safely. Get a free quote today."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-primary to-primary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={packingImage} 
        alt="Legacy Moving Denver professional packing services" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">Packing Services</h1>
        <p class="text-xl text-white/90 mb-8 max-w-2xl">
          Professional packing services for a stress-free move. Our expert packers ensure your belongings are carefully packed, protected, and arrive safely at your new home.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/request-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-primary hover:bg-secondary hover:text-white font-semibold' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary text-white hover:bg-secondary/80 font-semibold' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
        <div>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">Professional Packing Services</h2>
          <p class="text-muted-foreground mb-4">
            Packing is often the most time-consuming and stressful part of moving. At Legacy Moving Denver, our professional packing services take that burden off your shoulders. Our trained packers use quality materials and proven techniques to ensure your belongings are safely packed for transport.
          </p>
          <p class="text-muted-foreground mb-6">
            Whether you need full-service packing for your entire home, partial packing assistance for specific areas, or just help with fragile or specialty items, our team is here to help make your move simpler and more efficient.
          </p>
          
          <div class="space-y-4 mt-8">
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Full and partial packing options</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Quality packing materials included</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Expert handling of fragile items</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Unpacking services available</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Organized labeling system</p>
            </div>
          </div>
        </div>
        
        <div>
          <div class="bg-gray-50 p-6 rounded-lg border border-gray-100 shadow-md">
            <h3 class="font-display font-bold text-xl mb-4 text-secondary">Our Packing Services Include:</h3>
            <ul class="space-y-3">
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <Package size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Full-Service Packing</h4>
                  <p class="text-muted-foreground text-sm">Complete packing of your entire home, from kitchen to garage</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <Clock size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Partial Packing</h4>
                  <p class="text-muted-foreground text-sm">Selective packing services for specific rooms or items</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <Shield size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Specialty Item Packing</h4>
                  <p class="text-muted-foreground text-sm">Custom packing for artwork, antiques, electronics, and other valuable or fragile items</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <TagIcon size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Unpacking Services</h4>
                  <p class="text-muted-foreground text-sm">Assistance setting up your new home, including unpacking boxes and removing packing materials</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Packing Materials Section -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-3xl mb-6 text-secondary">Quality Packing Materials</h2>
        <p class="text-muted-foreground max-w-3xl mx-auto">
          We use only premium packing supplies to ensure your belongings remain safe during transport. Our comprehensive selection includes:
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <!-- Material 1 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Moving Boxes</h3>
          <p class="text-muted-foreground">
            Sturdy cardboard boxes in various sizes designed specifically for moving. From small boxes for heavy items to large boxes for bulky, lightweight items.
          </p>
        </div>
        
        <!-- Material 2 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Protective Wrapping</h3>
          <p class="text-muted-foreground">
            Bubble wrap, packing paper, foam pouches, and furniture blankets to cushion and protect your belongings from damage.
          </p>
        </div>
        
        <!-- Material 3 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Specialty Containers</h3>
          <p class="text-muted-foreground">
            Wardrobe boxes, dish packs, mirror boxes, and custom crating for artwork, antiques, and other high-value items.
          </p>
        </div>
        
        <!-- Material 4 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Sealing & Securing</h3>
          <p class="text-muted-foreground">
            Professional-grade packing tape, stretch wrap, mattress bags, and furniture covers to secure items properly.
          </p>
        </div>
        
        <!-- Material 5 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Labeling Systems</h3>
          <p class="text-muted-foreground">
            Color-coded labels, inventory sheets, and detailed box contents lists to make unpacking and finding items easy.
          </p>
        </div>
        
        <!-- Material 6 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Protective Equipment</h3>
          <p class="text-muted-foreground">
            Floor runners, door jamb protectors, banister guards, and furniture sliders to protect your home during the packing and moving process.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Our Packing Services -->
  <section class="py-16">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">Why Choose Our Packing Services?</h2>
        <p class="text-muted-foreground max-w-3xl mx-auto">Discover the advantages of letting our professionals handle your packing needs</p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Benefit 1 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><circle cx="12" cy="12" r="10"></circle><path d="M9 9h.01"></path><path d="M15 9h.01"></path><path d="M8 13h8"></path><path d="M9.5 16a2.5 2.5 0 0 1 5 0"></path></svg>
          </div>
          <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Stress Reduction</h3>
          <p class="text-muted-foreground">
            Eliminate the most time-consuming and stressful part of moving. Our team handles the entire packing process so you can focus on other aspects of your transition.
          </p>
        </div>
        
        <!-- Benefit 2 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
          </div>
          <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Maximum Protection</h3>
          <p class="text-muted-foreground">
            Our professional packers are trained in the best techniques to properly protect your belongings, significantly reducing the risk of damage during transport.
          </p>
        </div>
        
        <!-- Benefit 3 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path><path d="M12 8v4l2 2"></path></svg>
          </div>
          <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Time Efficiency</h3>
          <p class="text-muted-foreground">
            What might take you days can be completed by our team in hours. Our efficient packing process saves you valuable time during your move.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-3xl mb-4 text-secondary">Packing Service Pricing</h2>
        <p class="text-muted-foreground max-w-3xl mx-auto">
          We offer flexible packing options to meet your needs and budget. Contact us for a detailed quote based on your specific requirements.
        </p>
      </div>
      
      <div class="flex justify-center">
        <div class="text-center mt-4">
          <a href="/packing-prices" class={buttonVariants({ className: 'bg-primary text-white hover:bg-primary/90' })}>
            View Our Packing Prices
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="bg-primary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">Ready for a Stress-Free Move?</h2>
        <p class="text-white/90 text-lg mb-8">
          Contact our packing specialists today to discuss your needs and get a customized quote for your upcoming move.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/request-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-secondary hover:text-white font-semibold transition-colors' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary border border-white text-white hover:bg-secondary/80 hover:text-white phone-link transition-colors' })} data-google-link="https://maps.app.goo.gl/9YhGXwHp1TMi6xoG9">
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>