---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Phone, Package, ClipboardList, Clock, CheckCircle, Truck, ArrowRight, Star, MessageSquare } from "lucide-react";
---

<BaseLayout
  title="We Got Your Request! Here's What's Next | Legacy Moving Denver"
  description="Your form was submitted to Legacy Moving Denver. Here's exactly what happens next and how to get ready for your move."
  noindex={true}
>
  <!-- Hero / Confirmation Banner -->
  <section class="bg-gradient-to-br from-secondary to-secondary/90 text-white py-14 md:py-20 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 50%, #0066cc 0%, transparent 60%), radial-gradient(circle at 80% 20%, #00aaff 0%, transparent 50%);"></div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <!-- Big check -->
        <div class="w-20 h-20 bg-green-400/20 border-4 border-green-400 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-4">
          You're All Set — We Got It!
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto">
          Your request just landed in our inbox. A member of our team will be in touch shortly. In the meantime, here's exactly what happens next and how to hit the ground running.
        </p>
      </div>
    </div>
  </section>

  <!-- Want a quote RIGHT now? -->
  <section class="bg-primary py-8">
    <div class="container">
      <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6 text-white text-center sm:text-left">
        <div>
          <p class="font-display font-bold text-xl md:text-2xl mb-1">Don't want to wait? Get an instant quote right now.</p>
          <p class="text-white/85 text-sm md:text-base">Call us and we'll walk through your move on the phone in under 5 minutes — no forms, no waiting.</p>
        </div>
        <a
          href="tel:7203401849"
          class="flex-shrink-0 inline-flex items-center gap-2 bg-white text-primary font-bold text-lg py-4 px-8 rounded-xl hover:bg-gray-100 transition-colors shadow-lg"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          (720) 340-1849
        </a>
      </div>
    </div>
  </section>

  <!-- What Happens Next timeline -->
  <section class="py-16 md:py-20 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-secondary text-center mb-4">What Happens Next</h2>
        <p class="text-muted-foreground text-center max-w-2xl mx-auto mb-12">
          Here's the exact sequence of events from right now until moving day. No surprises.
        </p>

        <div class="relative">
          <!-- Vertical timeline line (desktop) -->
          <div class="hidden md:block absolute left-8 top-8 bottom-8 w-0.5 bg-primary/20"></div>

          <div class="space-y-8">

            <!-- Step 1 -->
            <div class="flex gap-6 items-start">
              <div class="flex-shrink-0 w-16 h-16 bg-primary rounded-full flex items-center justify-center shadow-md z-10">
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <span class="text-xs font-bold uppercase tracking-wider text-primary bg-primary/10 px-3 py-1 rounded-full">Step 1 — Within a few hours</span>
                </div>
                <h3 class="font-display font-bold text-xl text-secondary mb-2">We'll reach out to confirm your details</h3>
                <p class="text-muted-foreground">
                  Someone from our team will call or text you to go over your move — the date, your locations, what you're moving, any big or specialty items. This is where we nail down an accurate quote rather than just a rough ballpark. The more you can tell us, the faster this goes.
                </p>
                <p class="text-sm text-muted-foreground mt-3 italic">
                  Can't wait? Just call us at <a href="tel:7203401849" class="text-primary font-semibold hover:underline">(720) 340-1849</a> and we'll do this right now.
                </p>
              </div>
            </div>

            <!-- Step 2 -->
            <div class="flex gap-6 items-start">
              <div class="flex-shrink-0 w-16 h-16 bg-secondary rounded-full flex items-center justify-center shadow-md z-10">
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg>
              </div>
              <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <span class="text-xs font-bold uppercase tracking-wider text-secondary bg-secondary/10 px-3 py-1 rounded-full">Step 2 — Same day or next day</span>
                </div>
                <h3 class="font-display font-bold text-xl text-secondary mb-2">You'll get your written quote</h3>
                <p class="text-muted-foreground">
                  Once we have your details, we'll send over a written estimate. No hidden fees, no vague ranges — a real number based on your actual move. You'll know exactly what you're agreeing to before you book anything.
                </p>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="flex gap-6 items-start">
              <div class="flex-shrink-0 w-16 h-16 bg-primary rounded-full flex items-center justify-center shadow-md z-10">
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
              </div>
              <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <span class="text-xs font-bold uppercase tracking-wider text-primary bg-primary/10 px-3 py-1 rounded-full">Step 3 — Once you approve</span>
                </div>
                <h3 class="font-display font-bold text-xl text-secondary mb-2">Your date gets locked in</h3>
                <p class="text-muted-foreground">
                  When you're ready to book, we'll confirm your move date and put you on the schedule. During peak season in Denver (May through August), dates fill up fast — especially weekends and end-of-month slots. The sooner you confirm, the better your options.
                </p>
              </div>
            </div>

            <!-- Step 4 -->
            <div class="flex gap-6 items-start">
              <div class="flex-shrink-0 w-16 h-16 bg-green-500 rounded-full flex items-center justify-center shadow-md z-10">
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/><rect width="13" height="8" x="9" y="13" rx="1"/><path d="M5 17v4"/><circle cx="6.5" cy="17.5" r="2.5"/><circle cx="16.5" cy="17.5" r="2.5"/></svg>
              </div>
              <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <span class="text-xs font-bold uppercase tracking-wider text-green-600 bg-green-50 px-3 py-1 rounded-full">Step 4 — Moving day</span>
                </div>
                <h3 class="font-display font-bold text-xl text-secondary mb-2">The crew shows up and handles it</h3>
                <p class="text-muted-foreground">
                  Our team arrives on time, fully equipped, and ready to work. We take it from there — loading, transport, unloading, and placing furniture where you want it. We don't start the clock until we're on site.
                </p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Start Preparing Now -->
  <section class="py-16 md:py-20">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-secondary text-center mb-4">Get a Head Start While You Wait</h2>
        <p class="text-muted-foreground text-center max-w-2xl mx-auto mb-12">
          The best moves are the ones that are prepped well. Here's what you can start doing right now to make moving day faster, cheaper, and way less stressful.
        </p>

        <div class="grid md:grid-cols-2 gap-6">

          <!-- Tip 1: Declutter -->
          <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ea580c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="m19 6-.867 12.142A2 2 0 0 1 16.138 20H7.862a2 2 0 0 1-1.995-1.858L5 6"/><path d="m10 11 0 6"/><path d="m14 11 0 6"/><path d="m9 6 1-3h4l1 3"/></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-lg text-secondary mb-2">Declutter first — seriously</h3>
                <p class="text-muted-foreground text-sm">
                  Every item you move costs time and money. Go room by room and ruthlessly cut anything you haven't touched in a year. Denver has plenty of donation spots — Goodwill, ARC Thrift, Facebook Marketplace for furniture. Less stuff means a faster move and a lower bill.
                </p>
              </div>
            </div>
          </div>

          <!-- Tip 2: Start packing non-essentials -->
          <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-lg text-secondary mb-2">Start boxing up non-essentials now</h3>
                <p class="text-muted-foreground text-sm">
                  Books, décor, out-of-season clothes, guest room stuff, things in storage — pack all of this now. You don't need it in the next few weeks anyway. Getting boxes filled and stacked in one area of your home makes moving day dramatically faster for our crew.
                </p>
              </div>
            </div>
          </div>

          <!-- Tip 3: Label well -->
          <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#9333ea" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/><path d="m15 5 3 3"/></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-lg text-secondary mb-2">Label every box with room AND contents</h3>
                <p class="text-muted-foreground text-sm">
                  "Kitchen" isn't enough. Write the room on top and on the side so it's readable when stacked. Note the contents ("kitchen – pots/pans" or "bedroom 2 – linens"). Mark fragile boxes on all four sides. Our crew will put boxes in the right rooms at your new place, so good labels save you hours of unpacking confusion.
                </p>
              </div>
            </div>
          </div>

          <!-- Tip 4: Empty furniture -->
          <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-teal-100 rounded-full flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 9V6a2 2 0 0 0-4 0v3"/><rect width="14" height="5" x="5" y="9" rx="1"/><path d="M3 20v-7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v7"/></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-lg text-secondary mb-2">Empty your dressers and file cabinets</h3>
                <p class="text-muted-foreground text-sm">
                  This one surprises people. Dressers full of clothes are significantly heavier and can shift during the move, damaging the piece. Pack the contents into boxes or bags. Same goes for filing cabinets, nightstands, and any furniture with drawers. It takes 10 minutes and saves real time on moving day.
                </p>
              </div>
            </div>
          </div>

          <!-- Tip 5: Disassemble what you can -->
          <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ca8a04" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m14.5 12.5-8 8a2.119 2.119 0 1 1-3-3l8-8"/><path d="m16 16 6-6"/><path d="m8 8 6-6"/><path d="m9 7 8 8"/><path d="m21 11-8-8"/></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-lg text-secondary mb-2">Break down what you can beforehand</h3>
                <p class="text-muted-foreground text-sm">
                  Bed frames, modular shelving, certain desks and tables — disassembling these before moving day saves everyone time. When you take something apart, put all the hardware (screws, bolts, Allen keys) into a labeled zip-lock bag and tape it directly to the furniture piece. Nothing worse than arriving at the new place and hunting for bed frame hardware.
                </p>
              </div>
            </div>
          </div>

          <!-- Tip 6: Pack the essentials bag -->
          <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" x2="21" y1="6" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-lg text-secondary mb-2">Pack a "first night" bag — keep it with you</h3>
                <p class="text-muted-foreground text-sm">
                  Set aside a bag or box that rides in your car — not in the moving truck. It should have: medications, phone chargers, passports and important documents, one day's change of clothes per person, kids' comfort items, basic toiletries, coffee supplies, and toilet paper. You'll thank yourself at 9pm when you can't find anything else.
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Want us to handle packing? -->
  <section class="py-12 bg-secondary text-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="flex flex-col md:flex-row items-center gap-8">
          <div class="flex-1 text-center md:text-left">
            <h2 class="font-display font-bold text-2xl md:text-3xl mb-3">Rather skip the packing entirely?</h2>
            <p class="text-white/85 text-base md:text-lg">
              We offer full and partial packing services. Our crew brings all the materials, packs everything safely, and you don't lift a finger. If you want to add packing to your move, just mention it when we call — or bring it up now.
            </p>
          </div>
          <div class="flex flex-col gap-3 flex-shrink-0">
            <a href="tel:7203401849" class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary/90 text-white font-bold py-4 px-7 rounded-xl transition-colors text-lg shadow-md">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              Call (720) 340-1849
            </a>
            <a href="/packing-services" class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 border border-white/40 text-white font-semibold py-3 px-7 rounded-xl transition-colors">
              Learn About Packing Services
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick useful resources -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-2xl md:text-3xl text-secondary text-center mb-3">Helpful Reading While You Plan</h2>
        <p class="text-muted-foreground text-center mb-10">A few of our most useful guides for people in exactly your position right now.</p>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-5">

          <a href="/blog/how-to-prepare-home-for-professional-movers-denver" class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 hover:shadow-md transition-shadow group">
            <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3 class="font-semibold text-secondary mb-1 group-hover:text-primary transition-colors">How to Prepare Your Home for Movers</h3>
            <p class="text-sm text-muted-foreground">Room-by-room checklist so the crew can hit the ground running.</p>
          </a>

          <a href="/blog/how-far-in-advance-schedule-moving-company-denver" class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 hover:shadow-md transition-shadow group">
            <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            </div>
            <h3 class="font-semibold text-secondary mb-1 group-hover:text-primary transition-colors">When to Book Your Denver Movers</h3>
            <p class="text-sm text-muted-foreground">How far out you need to book depending on the season and your date.</p>
          </a>

          <a href="/packing-services" class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 hover:shadow-md transition-shadow group">
            <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
            </div>
            <h3 class="font-semibold text-secondary mb-1 group-hover:text-primary transition-colors">Professional Packing Services</h3>
            <p class="text-sm text-muted-foreground">What's included if you want us to handle the packing for you.</p>
          </a>

          <a href="/moving-tips" class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 hover:shadow-md transition-shadow group">
            <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            </div>
            <h3 class="font-semibold text-secondary mb-1 group-hover:text-primary transition-colors">Essential Moving Tips</h3>
            <p class="text-sm text-muted-foreground">The full playbook for a smooth Denver move from start to finish.</p>
          </a>

