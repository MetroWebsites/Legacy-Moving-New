---
import PartnerLayout from "@/layouts/PartnerLayout.astro";
---

<PartnerLayout
  title="Neil & Brittany Sanderlin's Moving Page | Legacy Moving Denver × Flourish Collective"
  description="Neil & Brittany Sanderlin of The Umphress Group // Flourish Collective recommend Legacy Moving Denver to all their clients. 1,700+ five-star reviews, licensed & insured, same-day availability."
  partnerName="Flourish Collective"
  partnerLogo="/assets/partners/flourish-collective-logo.png"
  partnerLogoAlt="Flourish Collective — Powered by Place | real"
  partnerAccentColor="#1565f0"
>

  <!-- ══════════════════════════════════════════════
       HERO — Co-branded: Neil & Brittany left, form right
  ══════════════════════════════════════════════ -->
  <section class="relative bg-gradient-to-br from-[#1e3a5f] via-[#1e3a5f] to-[#162d4a] text-white overflow-hidden py-14 md:py-20">
    <!-- Subtle dot-grid texture -->
    <div class="absolute inset-0 opacity-5" style="background-image:repeating-linear-gradient(45deg,#1565f0 0,#1565f0 1px,transparent 0,transparent 50%);background-size:20px 20px;"></div>

    <div class="container relative z-10">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">

        <!-- LEFT: Neil & Brittany intro -->
        <div>

          <!-- Brand logos row -->
          <div class="flex items-center gap-4 mb-7 flex-wrap">
            <img
              src="/assets/partners/flourish-collective-logo.png"
              alt="Flourish Collective — Powered by Place"
              width="120"
              height="60"
              class="h-14 w-auto object-contain invert brightness-200"
              loading="eager"
              decoding="async"
            />
            <div class="w-px h-10 bg-white/30"></div>
            <img
              src="/assets/partners/real-logo.png"
              alt="real"
              width="80"
              height="40"
              class="h-9 w-auto object-contain invert brightness-200"
              loading="eager"
              decoding="async"
            />
          </div>

          <h1 class="font-display font-bold text-4xl md:text-5xl leading-tight mb-5">
            Moving Made Easy<br>
            <span class="text-primary">For Neil & Brittany's Clients</span>
          </h1>

          <p class="text-white/80 text-lg leading-relaxed mb-8 max-w-lg">
            When Neil or Brittany Sanderlin refers you to Legacy Moving Denver, you're getting a team that treats every move with the same dedication and care they bring to every closing.
          </p>

          <!-- Neil & Brittany photo + quote card -->
          <div class="flex flex-col items-center sm:flex-row sm:items-start gap-5 bg-white/8 border border-white/15 rounded-2xl p-6 mb-8 backdrop-blur-sm text-center sm:text-left">
            <img
              src="/assets/partners/neil-brittany-sanderlin.jpg"
              alt="Neil & Brittany Sanderlin — The Umphress Group // Flourish Collective"
              width="200"
              height="200"
              class="w-44 h-44 sm:w-48 sm:h-48 rounded-full object-cover object-top flex-shrink-0 ring-4 ring-primary mx-auto sm:mx-0"
              loading="eager"
              decoding="async"
            />
            <div>
              <blockquote class="text-white/90 text-sm leading-relaxed italic mb-4">
                "If you're looking for a moving company you can truly trust, we cannot recommend Legacy Movers enough. As real estate agents, we've had the opportunity to refer many of our clients to their team, and time after time they have gone above and beyond in every part of the moving process. We have also personally used them ourselves in our move in 2025. Their professionalism, strong work ethic, attention to detail, and reasonable pricing consistently create an incredible experience for our clients during what can often be a stressful season."
              </blockquote>
              <cite class="not-italic text-xs font-bold text-blue-300 block mb-3">
                Neil &amp; Brittany Sanderlin · The Umphress Group // Flourish Collective · Denver, CO
              </cite>
              <!-- Agent contact links -->
              <div class="flex flex-col gap-1 text-xs text-white/65">
                <a href="http://neil.poweredbyflourish.com/" target="_blank" rel="noopener" class="hover:text-white transition-colors underline underline-offset-2">neil.poweredbyflourish.com</a>
                <a href="http://brittany.poweredbyflourish.com/" target="_blank" rel="noopener" class="hover:text-white transition-colors underline underline-offset-2">brittany.poweredbyflourish.com</a>
              </div>
            </div>
          </div>

          <!-- Mini stats row -->
          <div class="flex flex-wrap gap-6">
            <div>
              <div class="font-display font-bold text-2xl text-primary">1,700+</div>
              <div class="text-white/60 text-xs mt-0.5">Five-Star Reviews</div>
            </div>
            <div>
              <div class="font-display font-bold text-2xl text-primary">6,000+</div>
              <div class="text-white/60 text-xs mt-0.5">Moves Completed</div>
            </div>
            <div>
              <div class="font-display font-bold text-2xl text-primary">A</div>
              <div class="text-white/60 text-xs mt-0.5">BBB Rated</div>
            </div>
            <div>
              <div class="font-display font-bold text-2xl text-primary">Same-Day</div>
              <div class="text-white/60 text-xs mt-0.5">Availability</div>
            </div>
          </div>
        </div>

        <!-- RIGHT: Quote form -->
        <div>
          <div class="bg-white p-5 md:p-7 rounded-2xl shadow-2xl">
            <div class="text-center mb-4">
              <p class="text-xs font-bold uppercase tracking-widest mb-1 text-primary">Priority Quote — Neil & Brittany's Clients</p>
              <h2 class="font-display font-bold text-xl text-secondary">Get Your Free Moving Quote</h2>
              <p class="text-xs text-muted-foreground mt-1">Referred by Neil or Brittany? Mention their name for priority scheduling.</p>
            </div>

            <!-- Moverbase widget -->
            <div data-version="2" id="NBS001"></div>
            <script is:inline>
            (function(r,k) {
              var s = document.createElement('script');
              s.async = true;
              s.defer = true;
              s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
              s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
              document.getElementById(r).appendChild(s);
            })('NBS001','PE277BJIM3OAT6PP0J8IF0BJ5VH5WR8SG2NIKF7AD92OR5EF');
            </script>

            <p class="text-center text-xs text-muted-foreground mt-4 flex items-center justify-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              No commitment · Free estimate · We'll contact you within the hour
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       FULL REFERRAL QUOTE — highlighted band
  ══════════════════════════════════════════════ -->
  <section class="py-12 md:py-14 bg-primary/5 border-y border-primary/10">
    <div class="container max-w-4xl mx-auto">
      <div class="flex flex-col md:flex-row gap-8 items-center">
        <img
          src="/assets/partners/neil-brittany-sanderlin.jpg"
          alt="Neil & Brittany Sanderlin"
          width="160"
          height="160"
          class="w-32 h-32 md:w-40 md:h-40 rounded-full object-cover object-top ring-4 ring-primary flex-shrink-0 mx-auto md:mx-0"
          loading="lazy"
          decoding="async"
        />
        <div>
          <div class="flex gap-0.5 mb-3">
            {[...Array(5)].map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#f97316" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
          </div>
          <blockquote class="text-gray-800 text-base md:text-lg leading-relaxed italic mb-4">
            "Whether moving across town or out of state, Legacy Movers has continued to provide reliable service, great communication, and genuine care for the people they serve. We are incredibly grateful for the way they take care of our clients and confidently recommend them to anyone looking for a smooth, trustworthy, and high-quality moving experience."
          </blockquote>
          <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
            <cite class="not-italic font-bold text-sm text-secondary">
              Neil &amp; Brittany Sanderlin
            </cite>
            <span class="hidden sm:block text-gray-300">·</span>
            <span class="text-sm text-muted-foreground">REALTORS® · The Umphress Group // Flourish Collective</span>
          </div>
          <!-- Flourish + Real logos small -->
          <div class="flex items-center gap-3 mt-4">
            <img src="/assets/partners/flourish-icon.png" alt="Flourish Collective" width="32" height="32" class="h-8 w-auto object-contain opacity-75" loading="lazy" decoding="async" />
            <img src="/assets/partners/real-logo.png" alt="real" width="48" height="24" class="h-6 w-auto object-contain opacity-60" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       ABOUT NEIL & BRITTANY
  ══════════════════════════════════════════════ -->
  <section class="py-14 md:py-16 bg-white">
    <div class="container max-w-4xl mx-auto">
      <div class="grid md:grid-cols-2 gap-10 items-start">

        <!-- Left: about text -->
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-primary mb-3">Your Denver REALTORS®</p>
          <h2 class="font-display font-bold text-3xl md:text-4xl text-secondary mb-5 leading-tight">
            Neil & Brittany<br>Sanderlin
          </h2>
          <p class="text-muted-foreground text-base leading-relaxed mb-4">
            Neil and Brittany Sanderlin are Denver-based REALTORS® with The Umphress Group, part of the Flourish Collective powered by Place and real. They bring a personal, client-first approach to every transaction — whether you're buying your first home or relocating across the state.
          </p>
          <p class="text-muted-foreground text-base leading-relaxed mb-6">
            When it comes to moving, they refer every client to Legacy Moving Denver because they know from personal experience — having used the team themselves in 2025 — that the service is second to none.
          </p>

          <div class="flex flex-col gap-3">
            <a href="http://neil.poweredbyflourish.com/" target="_blank" rel="noopener"
               class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              neil.poweredbyflourish.com
            </a>
            <a href="http://brittany.poweredbyflourish.com/" target="_blank" rel="noopener"
               class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              brittany.poweredbyflourish.com
            </a>
            <a href="tel:9098157748"
               class="inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:text-primary transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Neil: (909) 815-7748
            </a>
            <a href="mailto:neil@poweredbyflourish.com"
               class="inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:text-primary transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              neil@poweredbyflourish.com
            </a>
          </div>
        </div>

        <!-- Right: headshot + logo badges -->
        <div class="flex flex-col gap-5">
          <div class="relative rounded-2xl overflow-hidden shadow-xl aspect-[3/4]">
            <img
              src="/assets/partners/neil-brittany-sanderlin.jpg"
              alt="Neil & Brittany Sanderlin — Flourish Collective REALTORS®"
              width="500"
              height="667"
              class="w-full h-full object-cover object-top"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 p-4" style="background:linear-gradient(to top,rgba(30,45,61,0.92),transparent);">
              <p class="text-white font-bold text-sm">Neil & Brittany Sanderlin</p>
              <p class="text-white/70 text-xs">REALTORS® · The Umphress Group</p>
            </div>
          </div>

          <!-- Brand badge cards -->
          <div class="grid grid-cols-2 gap-3">
            <div class="bg-gray-50 border border-gray-100 rounded-xl p-4 flex flex-col items-center gap-2">
              <img src="/assets/partners/flourish-collective-logo.png" alt="Flourish Collective" width="100" height="50" class="h-12 w-auto object-contain" loading="lazy" decoding="async" />
            </div>
            <div class="bg-black rounded-xl p-4 flex flex-col items-center justify-center gap-2">
              <img src="/assets/partners/real-logo.png" alt="real" width="80" height="40" class="h-10 w-auto object-contain invert brightness-200" loading="lazy" decoding="async" />
              <p class="text-white/60 text-xs">Brokerage</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       WHAT TO EXPECT — 3-step reassurance
  ══════════════════════════════════════════════ -->
  <section class="py-14 md:py-16 bg-gray-50 border-t border-gray-100">
    <div class="container max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-3xl text-secondary mb-3">What You Can Expect</h2>
        <p class="text-muted-foreground max-w-xl mx-auto">We don't just move boxes — we protect relationships. Here's how every move works.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {[
          {
            step: "01",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
            title: "Submit Your Quote",
            desc: "Fill out the form above or call us directly. Mention Neil or Brittany Sanderlin for priority scheduling and a dedicated move coordinator.",
          },
          {
            step: "02",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
            title: "We Confirm & Plan",
            desc: "Your move coordinator will reach out within the hour to confirm details, answer questions, and lock in your date — even on short notice around closing.",
          },
          {
            step: "03",
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.28a1 1 0 0 0-.684-.948l-1.923-.641a1 1 0 0 1-.578-.579l-1.393-4.18A1 1 0 0 0 18.845 11H10"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>`,
            title: "Move Day, Stress-Free",
            desc: "Our uniformed, background-checked crew arrives on time, handles everything with care, and leaves your new space exactly how you want it.",
          },
        ].map(({ step, icon, title, desc }) => (
          <div class="relative bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
            <div class="absolute top-4 right-4 font-display font-bold text-5xl text-gray-100 select-none leading-none">{step}</div>
            <div class="relative z-10">
              <div class="w-11 h-11 rounded-lg bg-primary/10 flex items-center justify-center text-primary mb-4" set:html={icon}></div>
              <h3 class="font-display font-bold text-lg text-secondary mb-2">{title}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       SERVICES INCLUDED
  ══════════════════════════════════════════════ -->
  <section class="py-14 md:py-16 bg-white border-t border-gray-100">
    <div class="container max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-3xl text-secondary mb-3">Every Service Your Move Might Need</h2>
        <p class="text-muted-foreground max-w-xl mx-auto">From a single-room move to a full home relocation, we have every corner of your move covered.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          {
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"/><path d="m3 9 2.45-4.9A2 2 0 0 1 7.24 3h9.52a2 2 0 0 1 1.8 1.1L21 9"/><path d="M12 3v6"/></svg>`,
            title: "Local Moving",
            desc: "Denver metro moves with same-day availability and flexible scheduling around your closing date.",
          },
          {
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.28a1 1 0 0 0-.684-.948l-1.923-.641a1 1 0 0 1-.578-.579l-1.393-4.18A1 1 0 0 0 18.845 11H10"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>`,
            title: "Long Distance",
            desc: "Careful, detailed service for out-of-state moves — coordinated door to door.",
          },
          {
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>`,
            title: "Full Packing Service",
            desc: "We pack everything — dishes, artwork, furniture — using quality materials so nothing arrives broken.",
          },
          {
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 15 2 2 4-4"/><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`,
            title: "Load & Unload Only",
            desc: "Already have a truck? We'll handle all the heavy lifting so you don't have to.",
          },
          {
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
            title: "Short-Term Storage",
            desc: "Bridge the gap between your old home and new one with secure, flexible storage.",
          },
          {
            icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`,
            title: "Same-Day Moves",
            desc: "Closing sooner than expected? We specialize in last-minute moves that still feel first-class.",
          },
        ].map(({ icon, title, desc }) => (
          <div class="bg-gray-50 rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/20 transition-all">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary mb-3" set:html={icon}></div>
            <h3 class="font-semibold text-secondary mb-1">{title}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       SOCIAL PROOF — Reviews
  ══════════════════════════════════════════════ -->
  <section class="py-14 md:py-16 bg-gray-50 border-t border-gray-100">
    <div class="container max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-1.5 mb-3">
          {[...Array(5)].map(() => (
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#f97316" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          ))}
        </div>
