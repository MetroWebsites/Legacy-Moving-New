---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Home, Truck, MapPin } from "lucide-react";
---

<BaseLayout
  title="Page Not Found | Legacy Moving Denver"
  description="The page you're looking for doesn't exist or has been moved. Return to the Legacy Moving Denver homepage."
>
  <section class="container flex items-center justify-center py-20 min-h-[calc(100vh-28rem)]">
    <div class="flex max-w-[980px] flex-col items-center gap-6 text-center">
      <div class="w-20 h-20 bg-primary/10 rounded-full flex items-center justify-center">
        <Truck size={40} className="text-primary" />
      </div>
      <h1
        class="text-4xl sm:text-5xl font-display font-bold text-secondary"
      >
        404: Page Not Found
      </h1>
      <p class="text-muted-foreground max-w-[600px] text-lg mb-4">
        The page you're looking for has moved or doesn't exist. Let us help you get back on the right route.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 mt-2">
        <a
          href="/"
          class={buttonVariants({ size: 'lg', className: 'gap-2' })}
        >
          <Home size={18} />
          Back to Home
        </a>
        <a
          href="/contact"
          class={buttonVariants({ variant: 'outline', size: 'lg', className: 'gap-2' })}
        >
          <MapPin size={18} />
          Contact Us
        </a>
      </div>
      
      <div class="mt-12 border-t border-gray-200 pt-8 w-full max-w-md">
        <h2 class="text-xl font-display font-semibold mb-4 text-secondary">Popular Pages</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-left">
          <li>
            <a href="/services" class="text-primary hover:underline">Our Services</a>
          </li>
          <li>
            <a href="/about-us" class="text-primary hover:underline">About Us</a>
          </li>
          <li>
            <a href="/pricing" class="text-primary hover:underline">Pricing</a>
          </li>
          <li>
            <a href="/get-quote" class="text-primary hover:underline">Get a Quote</a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
