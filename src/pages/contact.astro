---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MoverbaseRedirect from '../components/MoverbaseRedirect.astro';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Mail, Facebook, Instagram } from "lucide-react";
---

<BaseLayout
  title="Contact Us | Legacy Moving Denver | Get a Free Moving Quote"
  description="Contact Legacy Moving Denver for a free moving quote. Our professional team is ready to help with your residential or commercial move in Denver, Colorado."
  ogImage={new URL("/social-preview.jpg", Astro.site)}
>
  <!-- Hero Section -->
  <section class="relative bg-secondary py-16 text-white overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1582213782179-e0d53f98f2ca?w=1200&auto=format&q=80')] bg-cover bg-center opacity-20 mix-blend-overlay"></div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">Contact Us</h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto">
          Have questions about our moving services? Get in touch with our team for a free quote or to learn more about how we can help with your move.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Information -->
  <section class="py-16">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-12">
        <!-- Contact Form -->
        <div>
          <h2 class="font-display font-bold text-2xl md:text-3xl mb-6 text-secondary">Get in Touch</h2>
          <p class="text-muted-foreground mb-8">
            Fill out the form below and our team will get back to you as soon as possible. We're here to answer any questions you may have about our services.
          </p>
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <!-- Moverbase Quote Widget -->
            <div data-version="10" id="J8QDKR-contact"></div>
            <script is:inline>
            (function(r,k) {
              var s = document.createElement('script');
              s.async = true;
              s.defer = true;
              s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
              s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); } );
              document.getElementById(r).appendChild(s);
            })('J8QDKR-contact','JGCB6TGFN7N3NTTDOGMQUK1S9L3A4N73LYF2ZX4H248K97JD');
            </script>
          </div>
        </div>
        
        <!-- Contact Information -->
        <div>
          <h2 class="font-display font-bold text-2xl md:text-3xl mb-6 text-secondary">Contact Information</h2>
          <p class="text-muted-foreground mb-8">
            You can reach us by phone, email, or by visiting our office in Lakewood. We're available Monday through Saturday to assist with your moving needs.
          </p>
          
          <div class="space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
                  <MapPin size={20} className="text-primary" />
                </div>
                <div>
                  <h3 class="font-display font-semibold text-lg mb-2 text-secondary">Our Location</h3>
                  <p class="text-muted-foreground">
                    8805 W. 14th Ave, Suite 300<br>
                    Lakewood, CO 80215
                  </p>
                  <a 
                    href="https://maps.app.goo.gl/9YhGXwHp1TMi6xoG9" 
                    target="_blank" 
                    rel="noreferrer"
                    class="text-primary font-medium inline-flex items-center hover:underline mt-2"
                  >
                    Get Directions
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
                  </a>
                </div>
              </div>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
                  <Phone size={20} className="text-primary" />
                </div>
                <div>
                  <h3 class="font-display font-semibold text-lg mb-2 text-secondary">Phone</h3>
                  <p class="text-muted-foreground mb-2">
                    Call us to speak directly with our team:
                  </p>
                  <a 
                    href="tel:7203401849" 
                    class="text-primary font-medium text-lg hover:underline"
                  >
                    (720) 340-1849
                  </a>
                </div>
              </div>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
                  <Mail size={20} className="text-primary" />
                </div>
                <div>
                  <h3 class="font-display font-semibold text-lg mb-2 text-secondary">Email</h3>
                  <p class="text-muted-foreground mb-2">
                    Send us an email with your questions or quote request:
                  </p>
                  <a 
                    href="mailto:info@legacymovingdenver.com" 
                    class="text-primary font-medium hover:underline"
                  >
                    info@legacymovingdenver.com
                  </a>
                </div>
              </div>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
                  <Clock size={20} className="text-primary" />
                </div>
                <div>
                  <h3 class="font-display font-semibold text-lg mb-2 text-secondary">Business Hours</h3>
                  <p class="text-muted-foreground">
                    Monday - Saturday<br>
                    8:00 AM - 6:00 PM
                  </p>
                </div>
              </div>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
                  <Facebook size={20} className="text-primary" />
                </div>
                <div>
                  <h3 class="font-display font-semibold text-lg mb-2 text-secondary">Connect With Us</h3>
                  <p class="text-muted-foreground mb-2">
                    Follow us on social media for updates and moving tips:
                  </p>
                  <div class="flex space-x-4">
                    <a 
                      href="https://facebook.com/LegacyMovingDenver" 
                      target="_blank" 
                      rel="noreferrer"
                      class="text-primary font-medium hover:underline flex items-center"
                    >
                      <Facebook size={16} className="mr-1" />
                      Facebook
                    </a>
                    <a 
                      href="https://maps.app.goo.gl/9YhGXwHp1TMi6xoG9" 
                      target="_blank" 
                      rel="noreferrer"
                      class="text-primary font-medium hover:underline flex items-center"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
                      Google
                    </a>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Colorado 150 Years Badge -->
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <div class="flex flex-col items-center text-center">
                <img 
                  src="/colorado-150-badge.png" 
                  alt="Colorado Celebrating 150 Years - Legacy Moving Denver" 
                  class="w-48 h-auto mb-3"
                  width="192"
                  height="auto"
                  loading="lazy"
                  decoding="async"
                />
                <h3 class="font-display font-semibold text-lg text-secondary">Celebrating Colorado's 150th</h3>
                <p class="text-muted-foreground text-sm mt-2">
                  Proud to serve Colorado families and businesses since 2018
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Licensing Information -->
  <section class="py-8">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="bg-gray-50 p-6 rounded-lg border border-gray-100 text-center">
          <h3 class="text-xl font-bold text-secondary mb-4">Licensed & Insured Moving Professionals</h3>
          <p class="text-muted-foreground mb-6">
            Legacy Moving Denver is fully licensed and insured to provide residential and commercial moving services throughout Colorado and beyond.
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100">
              <h4 class="text-primary font-semibold mb-1">U.S. DOT</h4>
              <p class="text-2xl font-bold text-secondary">#3462023</p>
            </div>
            
            <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100">
              <h4 class="text-primary font-semibold mb-1">MC Number</h4>
              <p class="text-2xl font-bold text-secondary">#1189363</p>
            </div>
            
            <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100">
              <h4 class="text-primary font-semibold mb-1">PUC License</h4>
              <p class="text-2xl font-bold text-secondary">#HHG-00682</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Map Section -->
  <section class="py-8 pb-16">
    <div class="container">
      <div class="rounded-lg overflow-hidden shadow-lg">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3068.0336874005876!2d-105.1111833!3d39.7410345!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x876b8162eb1c3323%3A0xb64e7c4d35f9f8d7!2s8805%20W%2014th%20Ave%20%23300%2C%20Lakewood%2C%20CO%2080215!5e0!3m2!1sen!2sus!4v1640121345678!5m2!1sen!2sus" 
          width="100%" 
          height="450" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy"
          title="Legacy Moving Denver location map"
        ></iframe>
      </div>
    </div>
  </section>
<MoverbaseRedirect />
</BaseLayout>