---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MoverbaseRedirect from '../components/MoverbaseRedirect.astro';
---

<BaseLayout
  title="Property Manager Moving Partner | Legacy Moving Denver | Reliable Tenant Moving Services"
  description="Legacy Moving Denver partners with Denver property managers to provide fast, reliable tenant moving services. Reduce turnover time, protect your property, and keep residents happy."
  phoneNumber="7207642299"
>
  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-secondary to-secondary/90 py-16 md:py-24 text-white overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=1400&auto=format&q=80')] bg-cover bg-center opacity-10"></div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-primary/20 border border-primary/30 rounded-full px-4 py-1.5 text-sm font-medium mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          For Property Managers
        </div>
        <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight">
          Denver's Most Trusted<br>
          <span class="text-primary">Property Manager Moving Partner</span>
        </h1>
        <p class="text-lg md:text-xl text-white/85 mb-8 max-w-2xl mx-auto">
          Faster turnovers. Protected properties. Happy tenants. Legacy Moving Denver is the moving partner property managers across Denver rely on to keep their portfolios running smoothly.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="tel:7207642299" class="inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-white font-semibold py-3.5 px-8 rounded-xl transition-all hover:scale-105 shadow-lg shadow-primary/30">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call (720) 764-2299
          </a>
          <a href="/preferred-partner" class="inline-flex items-center gap-2 border-2 border-white/40 text-white hover:bg-white/10 font-semibold py-3.5 px-8 rounded-xl transition-all">
            Partner With Us
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Tagline Bar -->
  <section class="py-10 bg-primary">
    <div class="container text-center">
      <p class="text-white font-display font-bold text-2xl md:text-3xl tracking-wide">
        🏆 We Make <span class="underline underline-offset-4 decoration-white/60">YOU</span> Look Good. 🏆
      </p>
    </div>
  </section>

  <!-- Quick Contact Form -->
  <section class="py-14 bg-white border-b border-gray-100">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-8">
        <span class="inline-block bg-primary/10 text-primary text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-4">Get a Free Quote</span>
        <h2 class="font-display font-bold text-3xl text-secondary mb-2">Request Your Free Moving Quote</h2>
        <p class="text-muted-foreground">Fill out the form below and our team will get back to you with a detailed estimate.</p>
      </div>
      <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-lg border border-gray-100 p-6 md:p-8">
        <div data-version="10" id="J8QDKR-propmanager"></div>
        <script is:inline>
        (function(r,k) {
          var s = document.createElement('script');
          s.async = true;
          s.defer = true;
          s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
          s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
          document.getElementById(r).appendChild(s);
        })('J8QDKR-propmanager','JGCB6TGFN7N3NTTDOGMQUK1S9L3A4N73LYF2ZX4H248K97JD');
        </script>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-6 max-w-4xl mx-auto text-center">
        {[
          ["6,000+", "Moves Completed"],
          ["5★", "Google Rated"],
          ["A", "BBB Rating"],
          ["100%", "Licensed & Insured"],
          ["Denver", "Local Experts"],
        ].map(([stat, label]) => (
          <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
            <div class="font-display font-bold text-3xl text-primary mb-1">{stat}</div>
            <div class="text-sm text-muted-foreground">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-16">
    <div class="container">
      <div class="text-center mb-12">
        <span class="inline-block bg-primary/10 text-primary text-sm font-semibold px-4 py-1.5 rounded-full mb-3">Property Management Services</span>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-secondary mb-4">Protecting Your Reputation One Move at a Time</h2>
        <p class="text-muted-foreground max-w-2xl mx-auto">We work as an extension of your team — fast, professional, and completely aligned with your property standards.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {[
          ["⚡", "Fast Move-Out Clearances", "We clear units quickly so your team can begin turns immediately. Less vacancy time means more revenue for your portfolio."],
          ["🛡️", "Property Protection on Every Move", "Floor runners, door jamb protectors, and wall padding keep your hallways and units in perfect condition during every move."],
          ["📋", "Coordinated Scheduling", "We sync directly with your office calendar to schedule moves around your tenant rotation — zero friction, maximum efficiency."],
          ["💰", "Portfolio Pricing for Multiple Properties", "Managing multiple properties? We offer tiered pricing for property managers with multiple units or buildings."],
          ["📞", "Dedicated Account Manager", "Partner-level clients get a direct phone line to a dedicated rep who knows your properties and your standards."],
          ["🎁", "Referral Bonuses for Every Tenant", "Earn monthly bonuses when your tenants use Legacy Moving. A win for them, a win for you."],
        ].map(([icon, title, desc]) => (
          <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100 hover:border-primary/30 hover:shadow-lg transition-all">
            <div class="text-3xl mb-4">{icon}</div>
            <h3 class="font-display font-semibold text-lg text-secondary mb-2">{title}</h3>
            <p class="text-muted-foreground text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Credibility -->
  <section class="py-14 bg-secondary text-white">
    <div class="container">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-3xl mb-3">Trusted by Denver's Top Property Managers</h2>
        <p class="text-white/75 max-w-xl mx-auto">Fast, Professional, Stress-Free Moving for Your Tenants</p>
      </div>
      <div class="flex flex-wrap justify-center gap-4 max-w-3xl mx-auto">
        {[
          "Licensed & Insured",
          "5-Star Reviews",
          "Locally Owned Denver Company",
          "Professional Uniformed Movers",
          "Background Checked Crews",
          "Property Protection Protocols",
          "Same Week Availability",
          "Portfolio Pricing Available",
        ].map((badge) => (
          <span class="inline-flex items-center gap-2 bg-white/10 border border-white/20 text-white text-sm px-4 py-2 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><polyline points="20 6 9 17 4 12"/></svg>
            {badge}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Why It Matters -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-10 items-center">
        <div>
          <span class="inline-block bg-primary/10 text-primary text-sm font-semibold px-4 py-1.5 rounded-full mb-4">Why It Matters</span>
          <h2 class="font-display font-bold text-3xl text-secondary mb-5">A Smooth Move Means a Better Review for Your Property</h2>
          <p class="text-muted-foreground mb-6">Tenants who have stressful move-in and move-out experiences leave bad reviews — for the movers AND the property. When you recommend Legacy Moving, you're giving your tenants a proven, 5-star experience that reflects well on your management.</p>
          <ul class="space-y-3">
            {[
              "Reduce negative move-related maintenance calls",
              "Faster unit turns = less vacancy loss",
              "Happy tenants renew leases and leave good reviews",
              "Professional movers who respect your property",
              "Consistent performance across your entire portfolio",
            ].map((item) => (
              <li class="flex items-center gap-3 text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
                <span class="text-secondary font-medium">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-secondary text-white rounded-2xl p-8">
          <div class="flex items-center gap-1 mb-4">
            {[...Array(5)].map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#f97316" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
          </div>
          <p class="text-white/85 text-sm leading-relaxed mb-4">"Our property management company has referred Legacy Moving to dozens of tenants. They always show up professional, protect the building, and our tenants always thank us for the recommendation."</p>
          <p class="text-white/60 text-xs">— Verified Google Review, Denver Property Manager</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-primary">
    <div class="container text-center">
      <h2 class="font-display font-bold text-3xl md:text-4xl text-white mb-4">Ready to Streamline Your Property's Moves?</h2>
      <p class="text-white/85 text-lg mb-8 max-w-xl mx-auto">Call today to set up a preferred vendor agreement and start offering your tenants a world-class moving experience.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="tel:7207642299" class="inline-flex items-center gap-2 bg-white text-primary hover:bg-white/90 font-semibold py-3.5 px-8 rounded-xl transition-all hover:scale-105 shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call (720) 764-2299
        </a>
        <a href="/preferred-partner" class="inline-flex items-center gap-2 border-2 border-white/40 text-white hover:bg-white/10 font-semibold py-3.5 px-8 rounded-xl transition-all">
          View Partner Program
        </a>
      </div>
    </div>
  </section>

  <!-- Preferred Partner Teaser -->
  <section class="py-14 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8 bg-secondary/5 border border-secondary/15 rounded-2xl p-8">
        <div>
          <h3 class="font-display font-bold text-2xl md:text-3xl text-secondary mb-3">Legacy Preferred Partner Program</h3>
          <p class="text-muted-foreground max-w-xl">Portfolio pricing, priority scheduling, dedicated account management, and monthly referral bonuses — built specifically for Denver property managers.</p>
        </div>
        <a href="/preferred-partner" class="flex-shrink-0 inline-flex items-center gap-2 bg-primary text-white hover:bg-primary/90 font-semibold py-3.5 px-8 rounded-xl transition-all hover:scale-105 shadow-lg whitespace-nowrap">
          Learn More
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
<MoverbaseRedirect />
</BaseLayout>
