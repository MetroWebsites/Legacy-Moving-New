---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from '@/components/ContactForm';
import QuickQuoteForm from '@/components/QuickQuoteForm';
import { buttonVariants } from "@/components/ui/button";
import { Image } from 'astro:assets';
import truckImage from '../assets/truck-in-driveway-legacy-moving-denver_nw_b9c9f7fe.jpeg';
import packingImage from '../assets/working-ad-legacy-moving-denver_nw_c7ceaf8e.jpeg';
import teamImage from '../assets/308748956_459885262825080_6269738357866645302_n_nw_0489b96e.jpg';
import furnitureImage from '../assets/290197457_539473571254356_3082118749704086809_n_nw_a389c17b.jpg';
import movingImage from '../assets/img_4114-legacy-moving-denver_nw_9a9d79b0.jpeg';
---

<BaseLayout
  title="Top-Rated Denver Moving Company | Legacy Moving Denver | Local & Long-Distance Movers"
  description="Trusted Denver movers with 1,700+ 5-star reviews. Professional residential and commercial moving services, packing, loading, storage solutions, and long-distance moving at competitive rates. Family-owned since 2018."
>
  <!-- Top Service Bar - 3 Buttons -->
  <section class="w-full bg-white border-b border-gray-200">
    <div class="flex w-full">
      <!-- Local Moving Button - Blue (Left) -->
      <a 
        href="/services/local-moving" 
        class="flex-1 flex items-center justify-center py-4 px-2 bg-primary text-white font-semibold text-sm sm:text-base hover:bg-black hover:text-white transition-colors duration-300 border-r border-white whitespace-nowrap"
      >
        Local Moving
      </a>
      
      <!-- Long Distance Button - Dark Gray (Middle) -->
      <a 
        href="/services/long-distance-moving" 
        class="flex-1 flex items-center justify-center py-4 px-2 bg-gray-700 text-white font-semibold text-sm sm:text-base hover:bg-black hover:text-white transition-colors duration-300 border-r border-white whitespace-nowrap"
      >
        Long Distance
      </a>
      
      <!-- Labor Only Button - Light Gray (Right) -->
      <a 
        href="/services/loading-unloading" 
        class="flex-1 flex items-center justify-center py-4 px-2 bg-gray-500 text-white font-semibold text-sm sm:text-base hover:bg-black hover:text-white transition-colors duration-300 whitespace-nowrap"
      >
        Labor Only
      </a>
    </div>
  </section>

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white overflow-hidden">
    <!-- Background Image (Mobile) -->
    <div class="absolute inset-0 md:hidden opacity-20 mix-blend-overlay">
      <Image src={truckImage} alt="Legacy Moving Denver truck" class="w-full h-full object-cover" />
    </div>
    
    <!-- Background Video (Desktop) -->
    <div class="absolute inset-0 hidden md:block">
      <video 
        id="hero-video"
        autoplay 
        muted 
        loop 
        playsinline
        webkit-playsinline
        preload="auto"
        disablePictureInPicture
        class="w-full h-full object-cover opacity-70"
      >
        <source src="/videos/hero-video.mp4" type="video/mp4" />
        Your browser does not support the video tag.
      </video>
      <!-- Overlay gradient for better text readability -->
      <div class="absolute inset-0 bg-gradient-to-r from-secondary/40 to-secondary/20"></div>
    </div>
    
    <div class="container relative grid lg:grid-cols-2 gap-4 md:gap-8 pt-6 md:pt-12 lg:pt-16 pb-3 md:pb-6 lg:pb-8">
      <div class="flex flex-col justify-center">
        <h1 class="font-display font-bold text-2xl md:text-5xl lg:text-6xl leading-tight mb-3 md:mb-6">
          Your Highly Recommended, Accredited, <span class="text-white">Local and Long-Distance Moving Experts</span>
        </h1>
        <p class="hidden md:block text-lg md:text-xl text-white/90 mb-8 max-w-xl">
          Professional and affordable local and long-distance moving services in Denver. We handle your move with care, clear pricing, and experienced crews so you can relax and focus on what's next.
        </p>
      </div>
      <div class="lg:flex items-center justify-center">
        <div class="bg-white p-4 md:p-6 rounded-lg shadow-xl w-full max-w-md">
          <!-- KEEP ALL FORMS client:load !! DO NOT USE client:visible AS THIS CAUSES HYDRATION ISSUES!!-->
          <QuickQuoteForm client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- Scrolling Trust Badges Section -->
