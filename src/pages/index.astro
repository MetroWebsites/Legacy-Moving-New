              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


<style>
  .scroll-container-fast {
    position: relative;
    overflow: hidden;
    width: 100%;
    -webkit-overflow-scrolling: touch;
  }
  
  .scroll-content-fast {
    display: flex;
    gap: 0.5rem;
    animation: scroll-fast 10s linear infinite;
    width: max-content;
    will-change: transform;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    perspective: 1000px;
    -webkit-perspective: 1000px;
  }
  
  @media (min-width: 768px) {
    .scroll-content-fast {
      gap: 1.5rem;
      animation: scroll-fast 15s linear infinite;
    }
  }
  
  @keyframes scroll-fast {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }
  
  .scroll-container-fast:hover .scroll-content-fast {
    animation-play-state: paused;
  }
  
  .trust-badge-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem;
    background: white;
    border-radius: 8px;
    min-width: 90px;
    flex-shrink: 0;
    text-decoration: none;
    transition: transform 0.2s ease;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  
  @media (min-width: 768px) {
    .trust-badge-item {
      gap: 0.5rem;
      padding: 1rem;
      min-width: 140px;
    }
  }
  
  .trust-badge-item:hover {
    transform: translateY(-2px);
  }
  
  .badge-logo {
    height: 35px;
    width: auto;
    max-width: 80px;
    object-fit: contain;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
  }
  
  @media (min-width: 768px) {
    .badge-logo {
      height: 50px;
      max-width: 100px;
    }
  }
  
  .badge-rating {
    font-size: 0.75rem;
    font-weight: 600;
    color: #1f2937;
    text-align: center;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  
  @media (min-width: 768px) {
    .badge-rating {
      font-size: 0.875rem;
    }
  }
  
  .badge-rating .stars {
    color: #FFA500;
    font-size: 0.875rem;
    margin-right: 0.25rem;
    display: inline-block;
    position: relative;
  }
  
  @media (min-width: 768px) {
    .badge-rating .stars {
      font-size: 1rem;
    }
  }
  
  /* Partial star ratings using gradient overlay */
  .stars-4-2 {
    background: linear-gradient(to right, #FFA500 0%, #FFA500 87%, #D3D3D3 87%, #D3D3D3 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  
  .stars-4-7 {
    background: linear-gradient(to right, #FFA500 0%, #FFA500 94%, #D3D3D3 94%, #D3D3D3 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  
  .stars-4-8 {
    background: linear-gradient(to right, #FFA500 0%, #FFA500 96%, #D3D3D3 96%, #D3D3D3 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>

