                <img src="/images/trust-badges/mapquest.png" alt="MapQuest" class="badge-logo" />
                <div class="badge-rating"><span class="stars">★★★★★</span></div>
              </a>
              
              <a href="https://www.trustindex.io/reviews/legacymovingdenver.com-1" target="_blank" rel="noopener" class="trust-badge-item">
                <img src="/images/trust-badges/trustindex.png" alt="Trustindex" class="badge-logo" />
