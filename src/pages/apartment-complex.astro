---
import FunnelLayout from "@/layouts/FunnelLayout.astro";
import MoverbaseRedirect from '../components/MoverbaseRedirect.astro';
import PartnerBenefitsSection from '../components/PartnerBenefitsSection.astro';
---

<FunnelLayout
  title="Apartment Complex Moving Partner | Legacy Moving Denver | Resident Moving Services"
  description="Legacy Moving Denver partners with Denver apartment complexes to provide seamless move-in and move-out services for residents. Reduce turnover stress and improve resident satisfaction."
  phoneNumber="7207642299"
>
  <!-- HERO: Split layout -->
  <section class="relative bg-gradient-to-br from-secondary via-secondary to-secondary/90 py-16 md:py-20 text-white overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=1400&auto=format&q=80')] bg-cover bg-center opacity-10"></div>
    <div class="container relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 items-start">

        <!-- LEFT -->
        <div>
          <div class="inline-flex items-center gap-2 bg-primary/20 border border-primary/30 rounded-full px-4 py-1.5 text-sm font-medium mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/></svg>
            Apartment Complex Partner Program
          </div>

          <h1 class="font-display font-bold text-4xl md:text-5xl leading-tight mb-4">
            Seamless Move-In &amp; Move-Out<br>
            <span class="text-primary">For Your Residents</span>
          </h1>

          <!-- 1,700+ Reviews Trust Signal -->
          <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-xl px-4 py-2.5 mb-6">
            <div class="flex gap-0.5">
              {[...Array(5)].map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#f97316" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
            </div>
            <span class="text-white/90 text-sm font-medium">1,700+ five-star Google reviews</span>
          </div>

          <p class="text-white/80 text-lg mb-8 max-w-lg leading-relaxed">
            Give your residents a moving experience that reflects the quality of your property. We handle the logistics — you keep your reputation spotless.
          </p>

          <ul class="space-y-3 mb-8">
            {[
              "Move-In & Move-Out Coordination",
              "Fast Turnaround Between Tenants",
              "Elevator & Common Area Protection",
              "Packing Services for Residents",
              "Preferred Vendor Discounts for Residents",
              "Recurring Property Scheduling Blocks",
            ].map((item) => (
              <li class="flex items-center gap-3 text-white/90 text-sm">
                <span class="w-5 h-5 rounded-full bg-primary flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                {item}
              </li>
            ))}
          </ul>

          <div class="flex flex-wrap gap-6 mb-8">
            {[["6,000+","Moves Done"],["1,700+","Five-Star Reviews"],["A","BBB Rating"],["Denver","Local Experts"]].map(([n,l]) => (
              <div>
                <div class="font-display font-bold text-2xl text-primary">{n}</div>
                <div class="text-white/60 text-xs mt-0.5">{l}</div>
              </div>
            ))}
          </div>

          <div class="flex flex-wrap gap-3">
            <a href="tel:7207642299" class="inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-white font-semibold py-3 px-7 rounded-xl transition-all hover:scale-105 shadow-lg shadow-primary/30 text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Call (720) 764-2299
            </a>
            <a href="#get-quote" class="inline-flex items-center gap-2 border-2 border-white/30 hover:border-white/60 text-white hover:bg-white/10 font-semibold py-3 px-7 rounded-xl transition-all text-sm">
              Get a Free Quote ↓
            </a>
          </div>
        </div>

        <!-- RIGHT: Moverbase Quote Form -->
        <div id="get-quote" class="bg-white rounded-2xl shadow-2xl overflow-hidden">
          <div class="bg-primary px-7 py-5">
            <h2 class="font-display font-bold text-xl text-white">Get a Free Moving Quote</h2>
            <p class="text-white/80 text-sm mt-1">Tell us about your property — we'll be in touch within 1 business day.</p>
          </div>
          <div class="p-7">
            <div data-version="4" id="56AIR8"></div>
            <script is:inline>
            (function(r,k) {
              var s = document.createElement('script');
              s.async = true;
              s.defer = true;
              s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
              s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
              document.getElementById(r).appendChild(s);
            })('56AIR8','PE277BJIM3OAT6PP0J8IF0BJ5VH5WR8SG2NIKF7AD92OR5EF');
            </script>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Tagline Bar -->
  <section class="py-8 bg-primary">
    <div class="container text-center">
      <p class="text-white font-display font-bold text-xl md:text-2xl tracking-wide">
        ⭐ We Make <span class="underline underline-offset-4 decoration-white/60">YOUR RESIDENTS</span> Look Forward to Moving Day. ⭐
      </p>
    </div>
  </section>

  <!-- Trust Bar -->
  <div class="bg-gray-50 border-y border-gray-200 py-4">
    <div class="container">
      <div class="flex flex-wrap items-center justify-center gap-6 md:gap-10">
        {[["⭐","1,700+ Five-Star Google Reviews"],["🏆","BBB A-Rated"],["🛡️","Licensed & Insured"],["🏢","Common Area Protection"],["🚚","Same-Week Availability"],["📋","DOT #3462023"]].map(([icon,label]) => (
          <div class="flex items-center gap-2 text-sm font-medium text-secondary"><span>{icon}</span><span>{label}</span></div>
        ))}
      </div>
    </div>
  </div>

  <!-- Services -->
  <section class="py-16">
    <div class="container">
      <div class="text-center mb-12">
        <span class="inline-block bg-primary/10 text-primary text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-3">Apartment Complex Services</span>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-secondary mb-4">Fast, Flexible Moving for High-Turnover Properties</h2>
        <p class="text-muted-foreground max-w-2xl mx-auto">We understand the pace of property management. Our team moves as fast as your turnovers demand.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {[
          ["🏠","Move-In & Move-Out Coordination","We work directly with your office to schedule resident moves without disrupting daily operations or clogging elevators."],
          ["⚡","Fast Turnaround Between Tenants","Unit cleared, cleaned out, and ready for the next resident. We move at property management speed."],
          ["📦","Packing Services for Residents","Offer your residents full-service packing as an amenity — a differentiator that helps with retention and reviews."],
          ["🛗","Elevator & Common Area Protection","Floor runners, furniture pads, and door protectors preserve your property's common areas during every move."],
          ["📋","Preferred Vendor Discounts for Residents","Offer your community exclusive discounted rates with Legacy Moving — a perk that sets your property apart."],
          ["🔄","Recurring Property Scheduling","Ongoing partnerships mean we hold blocks of time specifically for your building's move-in/out calendar."],
        ].map(([icon,title,desc]) => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:border-primary/30 hover:shadow-md transition-all">
            <div class="w-12 h-12 bg-secondary rounded-xl flex items-center justify-center text-2xl mb-4">{icon}</div>
            <h3 class="font-display font-semibold text-base text-secondary mb-2">{title}</h3>
            <p class="text-muted-foreground text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Review + Benefits Split -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 items-center max-w-5xl mx-auto">
        <div>
          <span class="inline-block bg-primary/10 text-primary text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-4">The Resident Experience</span>
          <h2 class="font-display font-bold text-3xl text-secondary mb-5">Happy Residents Leave Better Reviews</h2>
          <p class="text-muted-foreground mb-6">Moving is one of the most stressful moments in a person's life. When your property provides a trusted, seamless moving recommendation, residents notice — and they tell their friends.</p>
          <ul class="space-y-3">
            {["Outstanding first impression on move-in day","Stress-free move-out experience","Professional movers who respect the building","On-time, efficient service every time"].map((item) => (
              <li class="flex items-center gap-3 text-sm">
                <div class="w-5 h-5 rounded-full bg-primary flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-white"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span class="text-secondary font-medium">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-secondary text-white rounded-2xl p-8">
          <div class="flex gap-0.5 mb-4">
            {[...Array(5)].map(() => (<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#f97316" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>))}
          </div>
          <p class="text-white/85 text-sm leading-relaxed mb-4 italic">"My apartment complex recommended Legacy Moving and I'm so glad they did. The crew was professional, fast, and took great care of the hallways. I'll never use anyone else."</p>
          <p class="text-white/50 text-xs">— Verified Google Review, Denver Resident</p>
          <div class="mt-6 pt-6 border-t border-white/10 grid grid-cols-2 gap-4">
            {[["6,000+","Moves Done"],["1,700+","Five-Star Reviews"],["A","BBB Rating"],["100%","Licensed & Insured"]].map(([n,l]) => (
              <div class="text-center">
                <div class="font-display font-bold text-2xl text-primary">{n}</div>
                <div class="text-white/50 text-xs mt-0.5">{l}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Preferred Partner Program — Full Section -->
  <PartnerBenefitsSection />

  <!-- CTA -->
  <section class="py-14 bg-primary">
    <div class="container text-center">
      <h2 class="font-display font-bold text-3xl text-white mb-4">Add Moving Services to Your Property's Amenities</h2>
      <p class="text-white/85 mb-8 max-w-xl mx-auto">Contact us today to set up a preferred vendor agreement for your apartment complex.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#get-quote" class="inline-flex items-center gap-2 bg-white text-primary hover:bg-white/90 font-bold py-3.5 px-8 rounded-xl transition-all hover:scale-105 shadow-lg">Get a Free Quote</a>
        <a href="tel:7207642299" class="inline-flex items-center gap-2 border-2 border-white/40 text-white hover:bg-white/10 font-semibold py-3.5 px-8 rounded-xl transition-all">📞 (720) 764-2299</a>
      </div>
    </div>
  </section>

  <!-- Internal Cross-Links -->
  <section class="py-10 bg-secondary text-white">
    <div class="container">
      <p class="text-white/50 text-xs text-center uppercase tracking-widest mb-5">Also Partnering With</p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        {[
          ["🏡", "Realtors", "/realtor"],
          ["🔨", "Contractors", "/contractor"],
          ["🛋️", "Interior Designers", "/interior-designer"],
          ["💛", "Senior Living", "/senior-living"],
          ["🏠", "Property Managers", "/property-manager"],
          ["⭐", "Partner Program", "/preferred-partner"],
        ].map(([icon, label, href]) => (
          <a href={href} class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white text-sm px-4 py-2 rounded-full transition-all">
            <span>{icon}</span><span>{label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

<MoverbaseRedirect />
</FunnelLayout>
