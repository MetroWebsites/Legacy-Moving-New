---
import FunnelLayout from "@/layouts/FunnelLayout.astro";
import MoverbaseRedirect from '../components/MoverbaseRedirect.astro';
import PartnerBenefitsSection from '../components/PartnerBenefitsSection.astro';
---

<FunnelLayout
  title="Interior Designer & Home Stager Moving Partner | Legacy Moving Denver | Precision Movers"
  description="Legacy Moving Denver is the preferred moving partner for Denver's top home stagers and interior designers. Delicate furniture handling, white-glove protection, and same-day stage moves available."
  phoneNumber="7207642299"
>
  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-secondary to-secondary/90 py-16 md:py-24 text-white overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1631679706909-1844bbd07221?w=1400&auto=format&q=80')] bg-cover bg-center opacity-10"></div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-primary/20 border border-primary/30 rounded-full px-4 py-1.5 text-sm font-medium mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><path d="M2 7h20"/><path d="M22 7v3a2 2 0 0 1-2 2a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12a2 2 0 0 1-2-2V7"/></svg>
          For Interior Designers & Stagers
        </div>
        <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl mb-5 leading-tight">
          Precision Movers for<br>
          <span class="text-primary">Denver's Top Home Stagers</span>
        </h1>

        <!-- 1,700+ Reviews Trust Signal -->
        <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-xl px-5 py-2.5 mb-6">
          <div class="flex gap-0.5">
            {[...Array(5)].map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#f97316" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
          </div>
          <span class="text-white/90 text-sm font-medium">Trusted by 1,700+ customers with five-star Google reviews</span>
        </div>

        <p class="text-lg md:text-xl text-white/85 mb-8 max-w-2xl mx-auto">
          Your furniture is your inventory — we treat it that way. White-glove handling, on-time delivery, and the precision your staging business demands.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="tel:7207642299" class="inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-white font-semibold py-3.5 px-8 rounded-xl transition-all hover:scale-105 shadow-lg shadow-primary/30">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call (720) 764-2299
          </a>
          <a href="/preferred-partner" class="inline-flex items-center gap-2 border-2 border-white/40 text-white hover:bg-white/10 font-semibold py-3.5 px-8 rounded-xl transition-all">
            Partner With Us
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Tagline Bar -->
  <section class="py-10 bg-primary">
    <div class="container text-center">
      <p class="text-white font-display font-bold text-2xl md:text-3xl tracking-wide">
        🛋️ Your Furniture Is Your Inventory —<span class="underline underline-offset-4 decoration-white/60"> We Treat It That Way.</span>
      </p>
    </div>
  </section>

  <!-- Quick Contact Form -->
  <section class="py-14 bg-white border-b border-gray-100">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-8">
        <span class="inline-block bg-primary/10 text-primary text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-4">Get a Free Quote</span>
        <h2 class="font-display font-bold text-3xl text-secondary mb-2">Request Your Free Moving Quote</h2>
        <p class="text-muted-foreground">Fill out the form below and our team will get back to you with a detailed estimate.</p>
      </div>
      <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-lg border border-gray-100 p-6 md:p-8">
        <div data-version="4" id="56AIR8"></div>
        <script is:inline>
        (function(r,k) {
          var s = document.createElement('script');
          s.async = true;
          s.defer = true;
          s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
          s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
          document.getElementById(r).appendChild(s);
        })('56AIR8','PE277BJIM3OAT6PP0J8IF0BJ5VH5WR8SG2NIKF7AD92OR5EF');
        </script>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-6 max-w-4xl mx-auto text-center">
        {[
          ["6,000+", "Moves Completed"],
          ["1,700+", "Five-Star Reviews"],
          ["A+", "BBB Rating"],
          ["100%", "Licensed & Insured"],
          ["Denver", "Local Experts"],
        ].map(([stat, label]) => (
          <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
            <div class="font-display font-bold text-3xl text-primary mb-1">{stat}</div>
            <div class="text-sm text-muted-foreground">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-16">
    <div class="container">
      <div class="text-center mb-12">
        <span class="inline-block bg-primary/10 text-primary text-sm font-semibold px-4 py-1.5 rounded-full mb-3">Staging & Design Services</span>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-secondary mb-4">Moving Services Built for the Staging Industry</h2>
        <p class="text-muted-foreground max-w-2xl mx-auto">We understand that in staging, every piece matters and every hour counts. Our team is trained to handle designer furniture with the same care you put into curating it.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {[
          ["🤍", "Delicate Furniture Handling", "We treat every sofa, artwork, and accent piece as irreplaceable. Custom padding, wrap, and placement protocols for high-value inventory."],
          ["⏰", "On-Time Pickup & Delivery", "Your staging timeline is our timeline. We confirm windows the day before and execute with precision — no surprise delays."],
          ["⚡", "Same-Day Stage Moves Available", "A listing came through last minute? We hold flexible slots for staging partners so your pipeline never stalls."],
          ["🏠", "Room-by-Room Placement Assistance", "Our crew follows your room layout and places every piece exactly where you specify — so you spend time styling, not hauling."],
          ["🎀", "White Glove Protection Wrap Included", "Every move includes full furniture wrapping and padding as standard. No add-ons, no surprises."],
          ["💼", "Ongoing Partner Rates", "Staging companies who partner with us receive preferred pricing on every job, plus dedicated scheduling blocks for your listings."],
        ].map(([icon, title, desc]) => (
          <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100 hover:border-primary/30 hover:shadow-lg transition-all">
            <div class="text-3xl mb-4">{icon}</div>
            <h3 class="font-display font-semibold text-lg text-secondary mb-2">{title}</h3>
            <p class="text-muted-foreground text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Credibility -->
  <section class="py-14 bg-secondary text-white">
    <div class="container">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-3xl mb-3">White-Glove Moving for Clients Who Expect More</h2>
        <p class="text-white/75 max-w-xl mx-auto">Denver's Most Trusted Moving Partner for the Design Industry — 1,700+ five-star Google reviews</p>
      </div>
      <div class="flex flex-wrap justify-center gap-4 max-w-3xl mx-auto">
        {[
          "Licensed & Insured",
          "1,700+ Five-Star Reviews",
          "Locally Owned Denver Company",
          "Professional Uniformed Movers",
          "Background Checked Crews",
          "White Glove Wrap Included",
          "Same-Day Availability",
          "Ongoing Partner Rates",
        ].map((badge) => (
          <span class="inline-flex items-center gap-2 bg-white/10 border border-white/20 text-white text-sm px-4 py-2 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><polyline points="20 6 9 17 4 12"/></svg>
            {badge}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- How We Work with Stagers -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-10 items-center">
        <div>
          <span class="inline-block bg-primary/10 text-primary text-sm font-semibold px-4 py-1.5 rounded-full mb-4">Our Process</span>
          <h2 class="font-display font-bold text-3xl text-secondary mb-5">How We Support Your Staging Business</h2>
          <p class="text-muted-foreground mb-6">We've built our staging workflow around the realities of the home staging industry — tight timelines, delicate inventory, and last-minute changes.</p>
          <ul class="space-y-4">
            {[
              ["You schedule the stage", "Share the listing address, room layout, and furniture list. We confirm the crew immediately."],
              ["We arrive & prepare", "Furniture pads, shrink wrap, and floor runners deployed before a single piece moves."],
              ["Precision placement", "Your crew leads, we follow. Every piece goes exactly where you specify."],
              ["Pickup on your timeline", "De-staging handled just as carefully. Inventory returns in perfect condition."],
            ].map(([step, desc]) => (
              <li class="flex items-start gap-4">
                <div class="w-2 h-2 bg-primary rounded-full mt-2 flex-shrink-0"></div>
                <div>
                  <span class="font-semibold text-secondary">{step}</span>
                  <p class="text-muted-foreground text-sm mt-0.5">{desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-secondary text-white rounded-2xl p-8">
          <div class="flex items-center gap-1 mb-4">
            {[...Array(5)].map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#f97316" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
          </div>
          <p class="text-white/85 text-sm leading-relaxed mb-4">"As a home stager, I needed a crew I could trust completely with my inventory. Legacy Moving is the only team I use. They handle my furniture like it's their own and always show up on time."</p>
          <p class="text-white/60 text-xs">— Verified Google Review, Denver Home Stager</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Preferred Partner Program — Full Section -->
  <PartnerBenefitsSection />

  <!-- Emotional Hook + CTA -->
  <section class="py-16 bg-primary">
    <div class="container text-center">
      <h2 class="font-display font-bold text-3xl md:text-4xl text-white mb-4">We Make YOU Look Good.</h2>
      <p class="text-white/85 text-lg mb-8 max-w-xl mx-auto">
        When every piece arrives on time, perfectly placed, and in pristine condition — your clients see the level of professionalism that sets your business apart.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="tel:7207642299" class="inline-flex items-center gap-2 bg-white text-primary hover:bg-white/90 font-semibold py-3.5 px-8 rounded-xl transition-all hover:scale-105 shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call (720) 764-2299
        </a>
        <a href="/preferred-partner" class="inline-flex items-center gap-2 border-2 border-white/40 text-white hover:bg-white/10 font-semibold py-3.5 px-8 rounded-xl transition-all">
          Staging Partner Program
        </a>
      </div>
    </div>
  </section>

  <!-- Internal Cross-Links -->
  <section class="py-10 bg-secondary text-white">
    <div class="container">
      <p class="text-white/50 text-xs text-center uppercase tracking-widest mb-5">Also Partnering With</p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        {[
          ["🏡", "Realtors", "/realtor"],
          ["🔨", "Contractors", "/contractor"],
          ["🏢", "Apartment Complexes", "/apartment-complex"],
          ["💛", "Senior Living", "/senior-living"],
          ["🏠", "Property Managers", "/property-manager"],
          ["⭐", "Partner Program", "/preferred-partner"],
        ].map(([icon, label, href]) => (
          <a href={href} class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white text-sm px-4 py-2 rounded-full transition-all">
            <span>{icon}</span><span>{label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

<MoverbaseRedirect />
</FunnelLayout>
