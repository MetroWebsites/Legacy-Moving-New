---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import packingImage from '../assets/services/packing.jpg';
---

<BaseLayout
  title="Packing Services | Legacy Moving Denver | Professional Packing"
  description="Professional packing services for Denver moves. We offer full-service, partial, and specialty item packing. Get a free custom quote today."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-primary to-primary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={packingImage} 
        alt="Legacy Moving Denver professional packing services" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">Professional Packing Services</h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto">
          Expert packing solutions for your Denver move. Find the option that best fits your needs.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">Our Packing Service Options</h2>
          <p class="text-muted-foreground max-w-3xl mx-auto mb-8">
            At Legacy Moving Denver, we offer flexible packing options to accommodate different needs. Our services are comprehensive and professional, with no hidden fees or surprises.
          </p>
          <div class="bg-gray-50 p-4 rounded-lg border border-gray-200 inline-block">
            <p class="text-secondary font-semibold">For a precise quote tailored to your specific needs, please contact us directly for a free consultation.</p>
          </div>
        </div>
        
        <!-- Pricing Options -->
        <div class="grid md:grid-cols-3 gap-8 mb-16">
          <!-- Full Packing -->
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 hover:shadow-lg transition-all">
            <div class="bg-primary/10 rounded-full w-16 h-16 flex items-center justify-center mb-4 mx-auto">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M21 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v3"></path><path d="M12 19c0-3.4-2.6-6-6-6H5"></path><path d="M12 19c0-3.4 2.6-6 6-6h1"></path><path d="M3 19h18"></path><rect x="8" y="10" width="8" height="3" rx="1"></rect></svg>
            </div>
            <h3 class="font-display font-bold text-xl text-center mb-4 text-secondary">Full Packing Service</h3>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="text-muted-foreground">Complete packing of your entire home</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="text-muted-foreground">All packing materials included</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="text-muted-foreground">Professional labeling and inventory</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="text-muted-foreground">Furniture disassembly as needed</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="text-muted-foreground">Specialized packing for fragile items</span>
              </li>
            </ul>
            <div class="text-center">
              <a href="/request-quote" class={buttonVariants({ className: 'bg-primary text-white hover:bg-primary/90 w-full justify-center' })}>
                Get a Custom Quote
              </a>
            </div>
          </div>
          
          <!-- Partial Packing -->
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 hover:shadow-lg transition-all">
            <div class="bg-primary/10 rounded-full w-16 h-16 flex items-center justify-center mb-4 mx-auto">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M21 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v3"></path><path d="M9 21H5a2 2 0 0 1-2-2V8h18v11a2 2 0 0 1-2 2h-4"></path><path d="M10 12h4"></path><circle cx="12" cy="16" r="5"></circle><path d="M12 14v4"></path><path d="M10 16h4"></path></svg>
            </div>
            <h3 class="font-display font-bold text-xl text-center mb-4 text-secondary">Partial Packing Service</h3>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="text-muted-foreground">Packing of specific rooms or areas</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="text-muted-foreground">Materials for selected areas included</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="text-muted-foreground">Focus on kitchens, fragile items, etc.</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="text-muted-foreground">Professional packing techniques</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="text-muted-foreground">Ideal for those who want to pack non-essential items themselves</span>
              </li>
            </ul>
            <div class="text-center">
              <a href="/request-quote" class={buttonVariants({ className: 'bg-primary text-white hover:bg-primary/90 w-full justify-center' })}>
                Get a Custom Quote
              </a>
            </div>
          </div>
          
          <!-- Specialty Item Packing -->
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 hover:shadow-lg transition-all">
            <div class="bg-primary/10 rounded-full w-16 h-16 flex items-center justify-center mb-4 mx-auto">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="M10 13c.5 0 1-.1 1.4-.4l5.3 5.3a2.5 2.5 0 0 0 3.8-3.2l-5.5-5.5c.3-.4.4-.9.4-1.4a4 4 0 1 0-7.6 1.7A4 4 0 0 0 10 13"></path></svg>
            </div>
            <h3 class="font-display font-bold text-xl text-center mb-4 text-secondary">Specialty Item Packing</h3>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="text-muted-foreground">Custom crating for artwork</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="text-muted-foreground">Special handling for antiques</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="text-muted-foreground">Electronics packaging</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="text-muted-foreground">Mirrors and large glass items</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="text-muted-foreground">Custom solutions for unique items</span>
              </li>
            </ul>
            <div class="text-center">
              <a href="/request-quote" class={buttonVariants({ className: 'bg-primary text-white hover:bg-primary/90 w-full justify-center' })}>
                Get a Custom Quote
              </a>
            </div>
          </div>
        </div>
        
        <!-- Additional Services -->
        <div class="mb-16">
          <h2 class="font-display font-bold text-2xl mb-6 text-secondary">Additional Packing Services</h2>
          
          <div class="space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <div class="flex justify-between items-center mb-4 flex-wrap gap-4">
                <h3 class="font-semibold text-xl text-secondary">Unpacking Service</h3>
                <div>
                  <span class="bg-primary/10 text-primary px-4 py-1 rounded-full font-medium">Studio/1-BR</span>
                </div>
              </div>
              <p class="text-muted-foreground">
                Our unpacking service includes opening all boxes, placing items in appropriate locations, basic setup of rooms, and removal of all packing materials. Pricing varies based on the size of your home and number of items.
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <div class="flex justify-between items-center mb-4 flex-wrap gap-4">
                <h3 class="font-semibold text-xl text-secondary">Packing Supply Kit</h3>
                <div>
                  <span class="bg-primary/10 text-primary px-4 py-1 rounded-full font-medium">2-3 BR Home</span>
                </div>
              </div>
              <p class="text-muted-foreground">
                If you prefer to pack yourself, we offer curated packing supply kits containing boxes, packing paper, bubble wrap, tape, and markers. Kits are sized based on your home size (small, medium, or large).
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <div class="flex justify-between items-center mb-4 flex-wrap gap-4">
                <h3 class="font-semibold text-xl text-secondary">Electronics Disconnect/Reconnect</h3>
                <div>
                  <span class="bg-primary/10 text-primary px-4 py-1 rounded-full font-medium">Custom Quote</span>
                </div>
              </div>
              <p class="text-muted-foreground">
                Professional disconnection, packing, and reconnection of your electronic devices, including home entertainment systems, computers, and smart home equipment. Includes cable management and setup.
              </p>
            </div>
          </div>
        </div>
        
        <!-- Pricing Factors -->
        <div class="bg-gray-50 p-8 rounded-lg mb-16">
          <h2 class="font-display font-bold text-2xl mb-6 text-secondary text-center">Factors That Affect Packing Prices</h2>
          
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <h3 class="font-semibold text-lg text-secondary mb-2">Home Size & Inventory Volume</h3>
              <p class="text-muted-foreground text-sm">
                The size of your home and the amount of belongings you have are the primary factors in determining packing costs. More items mean more materials and labor.
              </p>
            </div>
            
            <div>
              <h3 class="font-semibold text-lg text-secondary mb-2">Item Complexity & Fragility</h3>
              <p class="text-muted-foreground text-sm">
                Special items like artwork, antiques, electronics, and fragile items require extra care, special materials, and more time to pack properly.
              </p>
            </div>
            
            <div>
              <h3 class="font-semibold text-lg text-secondary mb-2">Organization Level</h3>
              <p class="text-muted-foreground text-sm">
                The current organization level of your home can impact packing time. Pre-sorted items are quicker to pack than items that need to be sorted first.
              </p>
            </div>
            
            <div>
              <h3 class="font-semibold text-lg text-secondary mb-2">Packing Timeline</h3>
              <p class="text-muted-foreground text-sm">
                Rush packing services may incur additional costs. Planning ahead allows for more standard pricing and careful packing.
              </p>
            </div>
          </div>
        </div>
        
        <!-- Get a Quote -->
        <div class="text-center">
          <h2 class="font-display font-bold text-2xl mb-4 text-secondary">Get Your Personalized Packing Quote</h2>
          <p class="text-muted-foreground max-w-2xl mx-auto mb-6">
            Every move is unique, and so are your packing needs. Contact us today for a personalized quote tailored to your specific requirements.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/request-quote" class={buttonVariants({ className: 'bg-primary text-white hover:bg-primary/90' })}>
              Get a Free Quote
            </a>
            <a href="/packing-services" class={buttonVariants({ className: 'bg-secondary text-white hover:bg-secondary/90' })}>
              Learn More About Our Packing Services
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>