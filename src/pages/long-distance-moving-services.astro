---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { Check, MapPin, Truck, ShieldCheck, CalendarClock } from 'lucide-react';
import ContactForm from '@/components/ContactForm';
import longdistanceImage from '../assets/services/longdistance.jpg';
---

<BaseLayout
  title="Long Distance Moving Services Denver | Legacy Moving Denver"
  description="Professional long distance moving services from Denver. Our interstate movers provide reliable, affordable long distance relocation. Get a free quote today."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-primary to-primary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={longdistanceImage} 
        alt="Legacy Moving Denver long distance movers" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">Long Distance Moving Services</h1>
        <p class="text-xl text-white/90 mb-8 max-w-2xl">
          Reliable, stress-free long distance moving from Denver to anywhere in the United States. Our interstate moving experts ensure your belongings arrive safely at your new home.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/request-quote" class={buttonVariants({ size: 'lg', className: 'bg-white text-primary hover:bg-secondary hover:text-white font-semibold' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary text-white hover:bg-secondary/80 font-semibold' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
        <div>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">Interstate Moving Experts</h2>
          <p class="text-muted-foreground mb-4">
            Legacy Moving Denver specializes in long-distance relocations, providing reliable, efficient service for moves across state lines. Our experienced team understands the complexities of interstate moving and has the expertise to ensure your long-distance relocation is smooth and stress-free.
          </p>
          <p class="text-muted-foreground mb-6">
            Whether you're moving from Denver to another state or relocating across the country to Colorado, our long-distance moving specialists provide the professional service, careful handling, and peace of mind you need during this significant transition.
          </p>
          
          <div class="space-y-4 mt-8">
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Fully licensed and insured interstate movers</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Dedicated trucks for direct transportation</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Transparent pricing with no hidden fees</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">GPS tracking for real-time shipment updates</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Experienced with interstate moving regulations</p>
            </div>
          </div>
        </div>
        
        <div>
          <div class="bg-gray-50 p-6 rounded-lg border border-gray-100 shadow-md">
            <h3 class="font-display font-bold text-xl mb-4 text-secondary">Our Long Distance Moving Services Include:</h3>
            <ul class="space-y-3">
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <Truck size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Interstate Transportation</h4>
                  <p class="text-muted-foreground text-sm">Reliable long-distance moving services to and from any state in the continental U.S.</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <ShieldCheck size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Full-Service Options</h4>
                  <p class="text-muted-foreground text-sm">Comprehensive packing, loading, transportation, unloading, and unpacking services</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <CalendarClock size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Flexible Scheduling</h4>
                  <p class="text-muted-foreground text-sm">Customized planning to accommodate your timeline and specific requirements</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <MapPin size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Storage Solutions</h4>
                  <p class="text-muted-foreground text-sm">Short and long-term storage options if your new home isn't ready yet</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Moving Process -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-3xl mb-6 text-secondary">Our Long Distance Moving Process</h2>
        <p class="text-muted-foreground max-w-3xl mx-auto">
          We've refined our long-distance moving process to ensure efficiency, transparency, and peace of mind at every step.
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto relative">
        <!-- Timeline Line -->
        <div class="absolute left-1/2 top-0 bottom-0 w-1 bg-primary/20 transform -translate-x-1/2 hidden md:block"></div>
        
        <!-- Step 1 -->
        <div class="relative">
          <div class="md:flex items-center">
            <div class="md:w-1/2 pr-0 md:pr-12 text-left md:text-right">
              <h3 class="font-display font-semibold text-xl mb-2 text-secondary">Free Consultation & Quote</h3>
              <p class="text-muted-foreground">
                We begin with a detailed assessment of your moving needs, including inventory, locations, and timeline, to provide an accurate quote.
              </p>
            </div>
            <div class="absolute left-0 md:left-1/2 top-0 -translate-x-1/2 w-8 h-8 bg-primary rounded-full z-10 flex items-center justify-center text-white font-bold">1</div>
            <div class="md:w-1/2 pl-12 md:pl-12"></div>
          </div>
        </div>
        
        <!-- Step 2 -->
        <div class="relative mt-8 md:mt-16">
          <div class="md:flex items-center">
            <div class="md:w-1/2 pr-12 hidden md:block"></div>
            <div class="absolute left-0 md:left-1/2 top-0 -translate-x-1/2 w-8 h-8 bg-primary rounded-full z-10 flex items-center justify-center text-white font-bold">2</div>
            <div class="md:w-1/2 pl-12">
              <h3 class="font-display font-semibold text-xl mb-2 text-secondary">Customized Moving Plan</h3>
              <p class="text-muted-foreground">
                We create a detailed plan tailored to your specific long-distance move, considering everything from packing requirements to delivery timing.
              </p>
            </div>
          </div>
        </div>
        
        <!-- Step 3 -->
        <div class="relative mt-8 md:mt-16">
          <div class="md:flex items-center">
            <div class="md:w-1/2 pr-0 md:pr-12 text-left md:text-right">
              <h3 class="font-display font-semibold text-xl mb-2 text-secondary">Professional Packing</h3>
              <p class="text-muted-foreground">
                Our team carefully packs your belongings using quality materials and specialized techniques for long-distance transportation.
              </p>
            </div>
            <div class="absolute left-0 md:left-1/2 top-0 -translate-x-1/2 w-8 h-8 bg-primary rounded-full z-10 flex items-center justify-center text-white font-bold">3</div>
            <div class="md:w-1/2 pl-12 md:pl-12"></div>
          </div>
        </div>
        
        <!-- Step 4 -->
        <div class="relative mt-8 md:mt-16">
          <div class="md:flex items-center">
            <div class="md:w-1/2 pr-12 hidden md:block"></div>
            <div class="absolute left-0 md:left-1/2 top-0 -translate-x-1/2 w-8 h-8 bg-primary rounded-full z-10 flex items-center justify-center text-white font-bold">4</div>
            <div class="md:w-1/2 pl-12">
              <h3 class="font-display font-semibold text-xl mb-2 text-secondary">Secure Transport</h3>
              <p class="text-muted-foreground">
                Your items are securely loaded and transported in our dedicated trucks, with careful logistics planning to ensure timely delivery.
              </p>
            </div>
          </div>
        </div>
          
        <!-- Step 5 -->
        <div class="relative mt-8 md:mt-16">
          <div class="md:flex items-center">
            <div class="md:w-1/2 pr-0 md:pr-12 text-left md:text-right">
              <h3 class="font-display font-semibold text-xl mb-2 text-secondary">Professional Unloading</h3>
              <p class="text-muted-foreground">
                Upon arrival at your new home, we carefully unload and place furniture and boxes according to your preferences, with the same care shown during loading.
              </p>
            </div>
            <div class="absolute left-0 md:left-1/2 top-0 -translate-x-1/2 w-8 h-8 bg-primary rounded-full z-10 flex items-center justify-center text-white font-bold">5</div>
            <div class="md:w-1/2 pl-12 md:pl-12"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="bg-primary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">Ready for Your Interstate Move?</h2>
        <p class="text-white/90 text-lg mb-8">
          Get in touch with our long distance moving specialists today for a free, detailed quote on your out-of-state relocation.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/request-quote" class={buttonVariants({ size: 'lg', className: 'bg-white text-secondary hover:bg-primary hover:text-white font-semibold transition-colors' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary border border-white text-white hover:bg-secondary/80 hover:text-white phone-link transition-colors' })} data-google-link="https://maps.app.goo.gl/E3SEsp435kWzLBeQ8">
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>