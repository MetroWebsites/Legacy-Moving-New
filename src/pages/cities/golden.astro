---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/services/hero.jpg';

const cityName = "Golden";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Golden Moving Company | Trusted Movers in Golden, Colorado
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Moving in Golden, CO? Legacy Moving provides reliable moving services throughout Golden and the foothills. Our Golden movers are experienced with mountain-area moves, narrow streets, and unique access challenges. Whether you're moving to or from Golden, we've got you covered. Request your free Golden moving estimate today!
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Mountain & Foothills Moving Challenges -->
  <section class="py-14 bg-gradient-to-br from-orange-50 to-amber-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          Why Golden Moves Are Different
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground mb-8">
          <p class="mb-4">
            Moving in Golden isn't like moving in flat, grid-layout suburbs. You've got elevation changes, winding roads, narrow driveways, and properties built into hillsides. We've navigated them all.
          </p>
          <p>
            Our Golden moving crews come prepared for the unique challenges of foothills living:
          </p>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="font-bold text-xl mb-3 text-secondary">⛰️ Steep Driveways & Hills</h3>
            <p class="text-muted-foreground mb-3">
              Homes built into hillsides require extra care. We use wheel chocks, have extra crew for heavy items, and never rush uphill carries.
            </p>
            <p class="text-sm text-muted-foreground italic">
              <strong>Example:</strong> Moved a 3-bedroom home on Lookout Mountain with a 45-degree driveway—took an extra hour but zero damages.
            </p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="font-bold text-xl mb-3 text-secondary">🛳️ Narrow Streets</h3>
            <p class="text-muted-foreground mb-3">
              Golden's historic streets weren't designed for moving trucks. We scout locations beforehand and bring smaller backup trucks if needed.
            </p>
            <p class="text-sm text-muted-foreground italic">
              <strong>Example:</strong> Downtown Golden moves often require parking on Washington Ave and shuttle-loading.
            </p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="font-bold text-xl mb-3 text-secondary">❄️ Weather Considerations</h3>
            <p class="text-muted-foreground mb-3">
              Golden gets more snow and ice than lower elevations. We monitor forecasts and reschedule for safety if conditions are dangerous.
            </p>
            <p class="text-sm text-muted-foreground italic">
              <strong>Pro tip:</strong> Book Golden moves for mornings in winter—ice melts by afternoon.
            </p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="font-bold text-xl mb-3 text-secondary">🏔️ Access Roads & Gates</h3>
            <p class="text-muted-foreground mb-3">
              Many Golden properties have gated access or unpaved roads. We coordinate gate codes and ensure our trucks can handle the terrain.
            </p>
            <p class="text-sm text-muted-foreground italic">
              <strong>Note:</strong> Some foothills areas require 4WD access—we bring appropriate vehicles.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            We've built our reputation in {cityName} on reliability, professionalism, and exceptional customer service.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                {cityName}'s highest-rated moving company with verified reviews across Google, Yelp, and Facebook.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Local {cityName} Experts</h3>
              <p class="text-muted-foreground">
                We know {cityName} neighborhoods, buildings, and logistics. Serving the Denver metro since 2018.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Flexible Scheduling</h3>
              <p class="text-muted-foreground">
                Same-day and next-day moves available in {cityName}. We work around your schedule, including weekends.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                Clear, upfront quotes for {cityName} moves. No hidden fees, no surprises. Licensed and fully insured.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area Info -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          Serving All {cityName} Neighborhoods
        </h2>
        <p class="text-muted-foreground text-lg mb-8">
          Whether you're moving to Downtown Golden, Table Mountain, Applewood, Lookout Mountain, or any other {cityName} neighborhood, our experienced movers know the area and can navigate any challenge. We provide the same exceptional service to every {cityName} resident.
        </p>
        <a href="/service-area" class={buttonVariants({ className: 'bg-secondary text-white hover:bg-primary' })}>
          View All Service Areas
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our {cityName} moving specialists are standing by to help plan your perfect move.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
