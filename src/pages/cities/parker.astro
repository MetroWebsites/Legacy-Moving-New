---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/308748956_459885262825080_6269738357866645302_n_nw_0489b96e.jpg';

const cityName = "Parker";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Parker Moving Company | Professional Movers in Parker, CO
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Need a moving company in Parker, Colorado? Legacy Moving serves Parker with professional residential and commercial moving services at competitive rates. From family homes in Pradera to townhomes near Mainstreet Parker, we handle every move with care and efficiency. Licensed, insured, and trusted by hundreds of Parker families — get your free quote today.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Complete Moving Services in {cityName}
          </h2>
          <p class="text-muted-foreground text-lg">
            From residential moves to commercial relocations, we handle every aspect of your {cityName} move with care and professionalism.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Local Moving</h3>
            <p class="text-muted-foreground">
              Efficient local moves within {cityName} and throughout the south Denver metro. Whether you're moving within Parker or to a neighboring city, we keep things on schedule.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Long Distance</h3>
            <p class="text-muted-foreground">
              Interstate moving from {cityName} to anywhere in the US. Professional packing, careful loading, and safe delivery for your long-distance relocation.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Packing Services</h3>
            <p class="text-muted-foreground">
              Full-service packing for your entire Parker home or individual rooms. We use quality materials and know how to pack fragile items, artwork, and specialty pieces.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Loading & Unloading</h3>
            <p class="text-muted-foreground">
              Labor-only services for Parker residents. If you've rented a truck, PODS container, or storage unit, we'll load or unload it safely and efficiently.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Commercial Moving</h3>
            <p class="text-muted-foreground">
              Office and business relocation in {cityName}. We minimize downtime and disruption for Parker businesses with efficient planning and experienced crews.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Storage Solutions</h3>
            <p class="text-muted-foreground">
              Secure storage options for Parker residents who need gap coverage between their move-out and move-in dates. Short-term and long-term storage available.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Know About Moving in Parker -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          What to Know Before Moving in Parker
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground">
          <p class="mb-4">
            Parker has grown significantly over the past decade, evolving from a small equestrian town into one of the most desirable family communities in the Denver metro. With that growth has come a wide mix of housing — newer planned subdivisions with HOA governance, custom homes on larger lots in communities like Pradera and Idyllwilde, established neighborhoods near Mainstreet, and a growing number of townhome and condo developments near Parker Road and Lincoln Avenue.
          </p>
          <p class="mb-4">
            HOA governance is common in Parker. Many of the newer subdivisions — including Lincoln Creek, Challenger Park, Stroh Ranch, and Sierra Ridge — have HOA rules that specify move-in hours, truck parking zones, and in some cases require advance notification or a damage deposit. We recommend contacting your HOA management company at least 7–10 days before your move to understand what's required and avoid any day-of surprises.
          </p>
          <p class="mb-4">
            Parker's streets are generally well-designed for larger vehicles, especially in the newer developments — wide cul-de-sacs and access roads make truck maneuvering relatively easy. The older neighborhood near Mainstreet Parker is more compact, with smaller lots and tighter street access in some areas. Our crews assess your specific address and plan truck positioning accordingly.
          </p>
          <p class="mb-4">
            Moving costs in Parker are influenced primarily by home size. Parker homes tend to be large — many are 2,500 to 4,000+ square feet with multiple levels, three-car garages, finished basements, and outdoor living areas. We encourage thorough inventory when you request a quote so the estimate accurately reflects your actual move, not a rough guess.
          </p>
          <p>
            Parker is about 30–35 minutes from our Lakewood base, which means we factor travel time into scheduling but not into your quote. Our Parker crews are well-rested and ready when they arrive — we don't overbook and scramble. We also do a high volume of moves between Parker and Denver proper, Lone Tree, Castle Rock, and Highlands Ranch — all common relocation corridors for Parker residents.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Apartment & HOA Moving Tips -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary text-center">
          HOA Rules, Apartment Moves & Local Tips for Parker
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">HOA Move Requirements</h3>
            <p class="text-muted-foreground mb-3">Parker's planned communities are HOA-governed and take those rules seriously. Most require advance move registration, specify truck parking zones, and limit move hours to standard business hours. A few require damage deposits that are refunded after move completion.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Contact your HOA management 7–10 days before moving</li>
              <li>✓ Ask specifically about truck parking and access restrictions</li>
              <li>✓ We protect driveways, walkways, and community surfaces</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Apartment & Townhome Moves</h3>
            <p class="text-muted-foreground mb-3">Parker's growing apartment and townhome communities near Parker Road and Lincoln Avenue typically require scheduled moves and may need a COI from your moving company. We provide all required documentation immediately on request.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Schedule with leasing office at least 5 days in advance</li>
              <li>✓ We provide certificate of insurance on request</li>
              <li>✓ Ask about elevator windows if applicable</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Parker Neighborhoods We Serve</h3>
            <p class="text-muted-foreground">We regularly move clients in Pradera, Idyllwilde, Challenger Park, Lincoln Creek, Stroh Ranch, Sierra Ridge, Stonegate, Mainstreet Parker, and the newer communities along Lincoln Avenue and Motsenbocker Road. Every corner of Parker is familiar territory for our crews.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Large Home Moves in Parker</h3>
            <p class="text-muted-foreground">Parker's homes are big. Three-car garages, finished basements, media rooms, workout equipment, and outdoor furniture are the norm rather than the exception. We send appropriately-sized crews — typically 3–4 movers for larger Parker homes — and bring the right truck capacity for your volume. We don't understaff a big move.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            We've built our reputation across the Denver metro on reliability, professionalism, and honest service.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                Denver metro's highest-rated moving company with verified reviews on Google, Yelp, and Facebook. Parker residents consistently comment on crew professionalism and how carefully their belongings are handled.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">South Denver Metro Experts</h3>
              <p class="text-muted-foreground">
                We know Parker's neighborhoods, HOA rules, and logistics. From Pradera to Stroh Ranch, our crews have moved in every corner of Parker and understand what each community requires.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Flexible Scheduling</h3>
              <p class="text-muted-foreground">
                We work around your Parker move timeline, including weekends. We're available for large, complex moves that need multiple days and for smaller moves that can be done in a morning.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                Clear, upfront quotes for Parker moves. No hidden fees, no surprise charges day-of. What we quote based on your inventory is what you pay barring changes on your end.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our Parker moving specialists are ready to help — call or submit our quick online form and we'll get back to you fast.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
