---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/services/hero.jpg';

const cityName = "Denver";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Denver Moving Company | Trusted Local & Long Distance Movers
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Looking for reliable movers in Denver? Legacy Moving is your top-rated Denver moving company with over 1,700 five-star reviews. Whether you're moving downtown, to the suburbs, or across the country, our experienced team makes your Denver move stress-free. Licensed, insured, and locally owned since 2018.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent Denver Moves -->
  <section class="py-12 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-3 text-secondary text-center">
          Recent Denver Moves We've Completed
        </h2>
        <p class="text-center text-muted-foreground mb-10">
          Here are just a few examples of moves we've handled across Denver neighborhoods:
        </p>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="border-l-4 border-primary pl-4">
            <p class="font-semibold text-secondary mb-1">Capitol Hill to Cherry Creek</p>
            <p class="text-sm text-muted-foreground">2-bedroom condo, completed in 4 hours</p>
          </div>
          <div class="border-l-4 border-primary pl-4">
            <p class="font-semibold text-secondary mb-1">LoDo Loft to Highlands</p>
            <p class="text-sm text-muted-foreground">1-bedroom apartment, same-day service</p>
          </div>
          <div class="border-l-4 border-primary pl-4">
            <p class="font-semibold text-secondary mb-1">Wash Park Home to Fort Collins</p>
            <p class="text-sm text-muted-foreground">4-bedroom house, long-distance move</p>
          </div>
          <div class="border-l-4 border-primary pl-4">
            <p class="font-semibold text-secondary mb-1">Five Points to RiNo</p>
            <p class="text-sm text-muted-foreground">Art studio + apartment, careful handling</p>
          </div>
          <div class="border-l-4 border-primary pl-4">
            <p class="font-semibold text-secondary mb-1">Downtown Office to DTC</p>
            <p class="text-sm text-muted-foreground">Commercial move, completed over weekend</p>
          </div>
          <div class="border-l-4 border-primary pl-4">
            <p class="font-semibold text-secondary mb-1">University Hills to Texas</p>
            <p class="text-sm text-muted-foreground">3-bedroom home, interstate relocation</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What Makes Denver Moving Unique -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          What Makes Moving in Denver Different?
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground">
          <p class="mb-4">
            Denver isn't like other cities. We've moved thousands of families and businesses here, and we know the challenges: narrow streets in Capitol Hill, parking restrictions downtown, high-rise elevators in LoDo, and unpredictable mountain weather.
          </p>
          <p class="mb-4">
            That's why we don't just show up with a truck. Our Denver crews arrive prepared with building access permits, elevator reservations, protective floor runners, and backup plans for everything. We've moved out of fourth-floor walkups in Five Points and handled delicate art collections in Cherry Creek mansions.
          </p>
          <p>
            Every Denver neighborhood has its quirks, and after six years serving this city, we know them all. Whether you're in a vintage bungalow in Berkeley or a modern high-rise downtown, we've got you covered.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            We've built our reputation in {cityName} on reliability, professionalism, and exceptional customer service.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                {cityName}'s highest-rated moving company with verified reviews across Google, Yelp, and Facebook.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Local {cityName} Experts</h3>
              <p class="text-muted-foreground">
                We know {cityName} neighborhoods, buildings, and logistics. Serving the Denver metro since 2018.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Flexible Scheduling</h3>
              <p class="text-muted-foreground">
                Same-day and next-day moves available in {cityName}. We work around your schedule, including weekends.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                Clear, upfront quotes for {cityName} moves. No hidden fees, no surprises. Licensed and fully insured.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Denver Neighborhoods We Serve -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-8 text-secondary text-center">
          Every Denver Neighborhood, One Trusted Team
        </h2>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 mb-8">
          <div class="bg-gray-50 px-4 py-3 rounded text-center hover:bg-primary hover:text-white transition-colors">
            Capitol Hill
          </div>
          <div class="bg-gray-50 px-4 py-3 rounded text-center hover:bg-primary hover:text-white transition-colors">
            Cherry Creek
          </div>
          <div class="bg-gray-50 px-4 py-3 rounded text-center hover:bg-primary hover:text-white transition-colors">
            Highlands
          </div>
          <div class="bg-gray-50 px-4 py-3 rounded text-center hover:bg-primary hover:text-white transition-colors">
            LoDo
          </div>
          <div class="bg-gray-50 px-4 py-3 rounded text-center hover:bg-primary hover:text-white transition-colors">
            Washington Park
          </div>
          <div class="bg-gray-50 px-4 py-3 rounded text-center hover:bg-primary hover:text-white transition-colors">
            Five Points
          </div>
          <div class="bg-gray-50 px-4 py-3 rounded text-center hover:bg-primary hover:text-white transition-colors">
            RiNo
          </div>
          <div class="bg-gray-50 px-4 py-3 rounded text-center hover:bg-primary hover:text-white transition-colors">
            Park Hill
          </div>
          <div class="bg-gray-50 px-4 py-3 rounded text-center hover:bg-primary hover:text-white transition-colors">
            Congress Park
          </div>
          <div class="bg-gray-50 px-4 py-3 rounded text-center hover:bg-primary hover:text-white transition-colors">
            Berkeley
          </div>
          <div class="bg-gray-50 px-4 py-3 rounded text-center hover:bg-primary hover:text-white transition-colors">
            Sloan's Lake
          </div>
          <div class="bg-gray-50 px-4 py-3 rounded text-center hover:bg-primary hover:text-white transition-colors">
            University Hills
          </div>
        </div>
        <p class="text-center text-muted-foreground">
          Don't see your neighborhood? We serve all of Denver and the surrounding metro area. <a href="tel:7203401849" class="text-primary font-semibold hover:underline">Call us</a> to confirm service in your area.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our {cityName} moving specialists are standing by to help plan your perfect move.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
