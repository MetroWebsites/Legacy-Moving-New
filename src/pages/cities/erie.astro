---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/truck-in-driveway-legacy-moving-denver_nw_b9c9f7fe.jpeg';

const cityName = "Erie";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Erie Moving Company | Professional Movers in Erie, CO
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Moving to or from Erie? Legacy Moving provides professional, careful moving services throughout Erie and the Boulder-Weld County corridor. From Vista Ridge and Flatiron Meadows to Colliers Hill and Erie Commons, our crews handle every move with professionalism and honest pricing. Licensed, insured, and trusted — call for your free quote today.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Complete Moving Services in {cityName}
          </h2>
          <p class="text-muted-foreground text-lg">
            From Erie's master-planned communities to historic Old Town Erie, we handle every move with expertise and local knowledge.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Local Moving</h3>
            <p class="text-muted-foreground">
              Efficient local moves within Erie and throughout the Boulder-Weld corridor. We connect Erie to Longmont, Lafayette, Broomfield, and the Denver metro without long-distance rates.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Long Distance</h3>
            <p class="text-muted-foreground">
              Interstate moving from Erie to anywhere in the US. We handle long-distance moves with professional packing, careful loading, and reliable delivery coordination.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Packing Services</h3>
            <p class="text-muted-foreground">
              Full-service packing for your Erie home. We supply all materials and pack everything carefully — from delicate glassware to large furniture — with professional handling throughout.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Loading & Unloading</h3>
            <p class="text-muted-foreground">
              Labor-only services for Erie residents using their own truck or container. We load systematically to protect your belongings and maximize space.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Commercial Moving</h3>
            <p class="text-muted-foreground">
              Office and business relocation in Erie and the surrounding corridor. We work around your schedule to minimize disruption to your business during the move.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Storage Solutions</h3>
            <p class="text-muted-foreground">
              Secure storage for Erie residents in transition. We offer flexible options to bridge gaps between your old and new home throughout the moving process.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Know About Moving in Erie -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          What to Know Before Moving in Erie
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground">
          <p class="mb-4">
            Erie is one of Colorado's fastest-growing towns — straddling Boulder and Weld counties, it has grown from a small agricultural community into a substantial suburban town with a population that has more than tripled over the past 20 years. The town's location between Boulder, Longmont, and the Denver metro makes it a strong choice for families who want newer construction and more space while staying within commuting range of multiple employment centers.
          </p>
          <p class="mb-4">
            Vista Ridge is Erie's largest and most established master-planned community — a neighborhood with thousands of homes, its own golf course, community pool, parks, and an active HOA. Moving into Vista Ridge requires advance notification to the HOA and adherence to designated truck access routes and move hours. The community is well-maintained and the HOA is actively managed. Give yourself at least one to two weeks before move day to contact the HOA office and confirm requirements.
          </p>
          <p class="mb-4">
            Flatiron Meadows is another major Erie community on the west side of town — a newer master-planned neighborhood with views toward the Flatirons. HOA requirements here are similar to Vista Ridge. Colliers Hill is Erie's newest large community, developed within the last decade, with its own active HOA and newer infrastructure throughout.
          </p>
          <p class="mb-4">
            Old Town Erie is the historic core of the town — a small, charming area with older homes, narrow streets, and limited parking for large trucks. Moves in Old Town require the same approach as other older Colorado neighborhoods: careful truck positioning, sometimes blocking part of the street temporarily, and working efficiently to minimize any neighborhood disruption. There are no HOA restrictions in Old Town, which gives more scheduling flexibility.
          </p>
          <p>
            Erie is about 45 minutes from our Lakewood base. We regularly serve it alongside <a href="/cities/lafayette" class="text-primary hover:underline">Lafayette</a>, <a href="/cities/longmont" class="text-primary hover:underline">Longmont</a>, <a href="/cities/broomfield" class="text-primary hover:underline">Broomfield</a>, and <a href="/cities/frederick" class="text-primary hover:underline">Frederick</a>. All are within our standard service area with no additional fees.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Apartment & HOA Moving Tips -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary text-center">
          HOA Rules, New Construction & Local Tips for Erie Moves
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Vista Ridge HOA Requirements</h3>
            <p class="text-muted-foreground mb-3">Vista Ridge is one of Erie's most actively managed HOA communities. Advance notification, designated truck access, and move-hour windows are all required. Contact the HOA well in advance of your move.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Contact Vista Ridge HOA 7–14 days before moving</li>
              <li>✓ Confirm approved truck routes and parking areas</li>
              <li>✓ Move hours typically 8am–6pm in managed communities</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Flatiron Meadows & Colliers Hill</h3>
            <p class="text-muted-foreground mb-3">Erie's newer master-planned communities have similar HOA requirements — advance notification and move-hour restrictions are standard. Check with your specific community before scheduling your move.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ HOA advance notification required across all major communities</li>
              <li>✓ Surface protection provided at all managed community moves</li>
              <li>✓ We coordinate with HOA management before move day</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Erie Neighborhoods We Serve</h3>
            <p class="text-muted-foreground">We move clients throughout Erie including Vista Ridge, Flatiron Meadows, Colliers Hill, Erie Commons, Old Town Erie, and new developments near US-287 and Erie Parkway. All are within our standard service area.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Boulder-Erie Corridor Moves</h3>
            <p class="text-muted-foreground">Erie sits at the intersection of Boulder and Weld counties, making it a common destination for people moving from Boulder who want more space. We regularly handle moves between Boulder, Lafayette, Erie, and Longmont as part of this housing market corridor.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            Professional movers serving the Boulder-Weld corridor and northern Front Range.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                Denver metro's highest-rated moving company. Erie clients appreciate our knowledge of HOA communities, our care with new construction, and our professional attitude.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Boulder-Weld Corridor Experts</h3>
              <p class="text-muted-foreground">
                We know Erie's master-planned communities, HOA requirements, and the local road network. Vista Ridge, Flatiron Meadows, Colliers Hill — we've moved in all of them.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Reliable, On-Time Crews</h3>
              <p class="text-muted-foreground">
                Travel time to Erie is factored into our scheduling. Your crew arrives when we say they will — ready to work from the first minute of your reserved window.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                We quote Erie moves based on your actual home and services. No inflated distance rates. Licensed, insured, and upfront about every cost from the start.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nearby Cities -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="font-display font-bold text-2xl md:text-3xl mb-6 text-secondary">Also Serving Nearby Cities</h2>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/cities/lafayette" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Lafayette</a>
          <a href="/cities/longmont" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Longmont</a>
          <a href="/cities/broomfield" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Broomfield</a>
          <a href="/cities/frederick" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Frederick</a>
          <a href="/cities/westminster" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Westminster</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our Erie moving specialists know the local communities and are ready to plan your move from start to finish.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
