---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/truck-in-driveway-legacy-moving-denver_nw_b9c9f7fe.jpeg';

const cityName = "Greenwood Village";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Greenwood Village Moving Company | Professional Movers in Greenwood Village, CO
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Moving to or from Greenwood Village? Legacy Moving provides professional, white-glove moving services throughout Greenwood Village and the Denver Tech Center corridor. From Cherry Hills Farm and Sundance Hills to DTC high-rises and executive estates, we handle every move with care and expertise. Licensed, insured, and trusted — call for your free quote today.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Complete Moving Services in {cityName}
          </h2>
          <p class="text-muted-foreground text-lg">
            From luxury high-rises in the DTC to executive estates in Cherry Hills Farm, we handle every Greenwood Village move with the highest professional standards.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Local Moving</h3>
            <p class="text-muted-foreground">
              Precise local moves within {cityName} and throughout the DTC corridor. We connect Greenwood Village to Denver, Centennial, Lone Tree, Englewood, and beyond with the same reliable crew quality.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Long Distance</h3>
            <p class="text-muted-foreground">
              Interstate moving from Greenwood Village to anywhere in the US. Greenwood Village's executive and corporate population means we frequently handle high-stakes, carefully planned interstate relocations.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Packing Services</h3>
            <p class="text-muted-foreground">
              White-glove packing services for Greenwood Village homes. We specialize in fine art, antiques, wine collections, and custom furniture that requires expert handling and premium materials.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Loading & Unloading</h3>
            <p class="text-muted-foreground">
              Labor-only services for Greenwood Village residents using their own truck or a moving container. We load systematically to protect high-value items and maximize space.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Commercial Moving</h3>
            <p class="text-muted-foreground">
              Office and corporate relocation services in and around the Denver Tech Center. We handle executive suite moves, full office relocations, and technology-heavy environments with appropriate care.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Storage Solutions</h3>
            <p class="text-muted-foreground">
              Secure climate-controlled storage for Greenwood Village residents. We bridge gaps between closing and possession dates with flexible storage options for valuable belongings.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Know About Moving in Greenwood Village -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          What to Know Before Moving in Greenwood Village
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground">
          <p class="mb-4">
            Greenwood Village is one of Colorado's most affluent communities — a city of about 15,000 residents with the Denver Tech Center running through its eastern edge and some of the most beautiful residential streets in the metro area through its western neighborhoods. The median home price is among the highest in the region, and the community maintains strong HOA governance across most of its residential areas. Moving here requires preparation and the right moving company.
          </p>
          <p class="mb-4">
            Cherry Hills Farm, Sundance Hills, and the other established neighborhoods of Greenwood Village are quiet, tree-lined communities with strong HOA oversight. HOA rules in Greenwood Village typically require advance notification of moves, designated truck parking, and specific time windows — generally 8am–6pm on weekdays and weekends. Some communities prohibit moves on Sundays. Check with your HOA management office before scheduling, and confirm whether a damage deposit is required for common areas.
          </p>
          <p class="mb-4">
            High-rise and mid-rise residential buildings in the DTC area have their own moving protocols. Buildings like The Landmark at Greenwood Village require elevator reservations well in advance, certificates of insurance, and in some cases charge a move-in fee to building management. We are experienced with managed-building moves and carry the documentation that Greenwood Village buildings require.
          </p>
          <p class="mb-4">
            Greenwood Village has significant horse property and equestrian estates in its western sections. Homes on large lots often have long driveways, detached garages or guest houses, and specialized storage needs. For estate-scale moves, we recommend a pre-move walkthrough so we can properly assess the scope of work and send the right crew size.
          </p>
          <p>
            Greenwood Village is about 25–30 minutes from our Lakewood base. We serve it alongside the DTC corridor cities of <a href="/cities/centennial" class="text-primary hover:underline">Centennial</a>, <a href="/cities/lone-tree" class="text-primary hover:underline">Lone Tree</a>, <a href="/cities/englewood" class="text-primary hover:underline">Englewood</a>, and <a href="/cities/denver" class="text-primary hover:underline">Denver</a>. All are within our regular service area, and we move between these cities frequently.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Apartment & HOA Moving Tips -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary text-center">
          HOA Rules, Managed Buildings & Local Tips for Greenwood Village Moves
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">DTC High-Rise Move Requirements</h3>
            <p class="text-muted-foreground mb-3">Buildings like The Landmark at Greenwood Village have strict move protocols. Elevator reservations, COI documentation, and move-in fees are common. We handle all pre-move coordination.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Reserve freight elevator at least 2 weeks in advance</li>
              <li>✓ Certificate of insurance required — we provide it</li>
              <li>✓ Some buildings charge a building move-in fee</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Residential HOA Communities</h3>
            <p class="text-muted-foreground mb-3">Cherry Hills Farm, Sundance Hills, and other GV neighborhoods have active HOA management. Advance notification and adherence to move hours is required across most communities.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Contact HOA management 1–2 weeks before move day</li>
              <li>✓ Move hour windows vary — confirm with your HOA</li>
              <li>✓ Surface protection provided at all HOA moves</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Greenwood Village Neighborhoods We Serve</h3>
            <p class="text-muted-foreground">We regularly move clients throughout Greenwood Village including Cherry Hills Farm, Sundance Hills, The Landmark, Orchard Hills, residential areas near Belleview Avenue, and the DTC high-rise corridor. All neighborhoods are within our standard service area.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Estate & White-Glove Moves</h3>
            <p class="text-muted-foreground">For large estate moves with fine art, antiques, wine cellars, or custom furnishings, we offer white-glove packing and handling as a premium service. Ask about our specialty item consultation when you request a quote.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            Denver's highest-rated moving company — trusted by Greenwood Village residents who expect premium service and care.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                Denver metro's highest-rated moving company. Greenwood Village clients frequently mention our careful handling of high-value items and our professional crew conduct.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">DTC Corridor Experts</h3>
              <p class="text-muted-foreground">
                We know every managed building protocol, HOA rule, and access challenge in Greenwood Village, Centennial, Lone Tree, and Englewood. No surprises on move day.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">White-Glove Standard</h3>
              <p class="text-muted-foreground">
                We apply the same careful, methodical approach to every move — whether it's a one-bedroom apartment or an estate home. Surface protection, careful wrapping, and deliberate handling are always included.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                We quote Greenwood Village moves based on your actual home and services — no inflated rates for an upscale ZIP code. Licensed and fully insured with managed-building documentation ready.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nearby Cities -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="font-display font-bold text-2xl md:text-3xl mb-6 text-secondary">Also Serving Nearby Cities</h2>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/cities/centennial" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Centennial</a>
          <a href="/cities/lone-tree" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Lone Tree</a>
          <a href="/cities/englewood" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Englewood</a>
          <a href="/cities/denver" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Denver</a>
          <a href="/cities/highlands-ranch" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Highlands Ranch</a>
          <a href="/cities/castle-pines" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Castle Pines</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our Greenwood Village specialists understand managed building protocols, HOA requirements, and high-value home moves.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
