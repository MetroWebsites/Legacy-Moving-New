---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/truck-in-driveway-legacy-moving-denver_nw_b9c9f7fe.jpeg';

const cityName = "Castle Rock";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Castle Rock Moving Company | Professional Movers in Castle Rock, CO
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Moving to or from Castle Rock? Legacy Moving provides professional, careful moving services throughout Castle Rock and the south Denver metro corridor. From The Meadows and Cobblestone Ranch to older neighborhoods near Downtown Castle Rock, our crews handle every move with professionalism and honest pricing. Licensed, insured, and trusted — call for your free quote today.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Complete Moving Services in {cityName}
          </h2>
          <p class="text-muted-foreground text-lg">
            From small townhome moves to large custom home relocations, we handle every Castle Rock move with the same professional care.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Local Moving</h3>
            <p class="text-muted-foreground">
              Efficient local moves within {cityName} and throughout the south Denver metro. We handle same-area moves and relocations to/from Castle Rock all along the I-25 corridor.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Long Distance</h3>
            <p class="text-muted-foreground">
              Interstate moving from {cityName} to anywhere in the US. A significant portion of Castle Rock residents are relocating in or out of Colorado — we make it seamless.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Packing Services</h3>
            <p class="text-muted-foreground">
              Full-service packing for your Castle Rock home or individual rooms. We handle fragile items, art, wine collections, and specialty pieces with appropriate care and materials.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Loading & Unloading</h3>
            <p class="text-muted-foreground">
              Labor-only services for Castle Rock residents who've rented their own truck or arranged a POD. We load efficiently and methodically to protect your belongings.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Commercial Moving</h3>
            <p class="text-muted-foreground">
              Office and business relocation in {cityName}. Castle Rock's growing commercial district and proximity to the tech corridor along I-25 creates regular commercial moving needs we serve.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Storage Solutions</h3>
            <p class="text-muted-foreground">
              Secure storage for Castle Rock residents during your transition. Whether you're waiting on a new build or bridging a gap between your close and possession dates, we have options.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Know About Moving in Castle Rock -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          What to Know Before Moving in Castle Rock
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground">
          <p class="mb-4">
            Castle Rock has become one of the most desirable places to live along Colorado's Front Range — and the numbers reflect that. It's one of the fastest-growing cities in the state, attracting families who want more space, newer homes, and access to nature without sacrificing the convenience of the I-25 corridor. As a result, we do a high volume of moves both into and out of Castle Rock, and our crews know the territory well.
          </p>
          <p class="mb-4">
            The Meadows is the largest master-planned community in Castle Rock and one of the most significant in the Denver metro. It's governed by the Meadows Community Association, which has specific move-in protocols — including required advance notice, designated truck access areas, and rules about protecting community surfaces. If you're moving into The Meadows, contact the HOA management office at least two weeks before your move to understand exactly what's required. The Meadows HOA takes its rules seriously and will follow up on violations.
          </p>
          <p class="mb-4">
            Other Castle Rock communities — Cobblestone Ranch, Crystal Valley Ranch, Castlewood Ranch, Terrain, Metzler Ranch — are also HOA-governed with their own sets of rules. The general pattern across Castle Rock HOAs is similar: advance notification required, truck parking designated, move hours typically 8am–6pm, and sometimes a damage deposit. Check with your specific community before scheduling.
          </p>
          <p class="mb-4">
            Castle Rock's custom home market creates a moving scenario that deserves extra planning. Large homes on acreage, steep driveways, and gated community access all factor into how we approach a Castle Rock move. If your home has a long driveway, a significant grade, or any access restrictions, tell us during the quote process. We build the right plan for your specific property.
          </p>
          <p>
            Distance matters for Castle Rock moves. We're based in Lakewood — about 40 minutes from most of Castle Rock. That's built into our scheduling but not into your quote as an inflated hourly rate. We're upfront about travel time and make sure your crew arrives at the right time to start and finish efficiently without burning unnecessary hours.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Apartment & HOA Moving Tips -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary text-center">
          HOA Rules, Access & Local Tips for Castle Rock Moves
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">The Meadows HOA Requirements</h3>
            <p class="text-muted-foreground mb-3">The Meadows Community Association is one of the more actively managed HOAs in the region. Moving in or out requires advance notice to the HOA office, adherence to designated truck access routes, and protection of common surfaces. We've done many Meadows moves.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Contact The Meadows HOA at least two weeks before moving</li>
              <li>✓ Confirm approved truck entry routes and parking areas</li>
              <li>✓ We carry surface protection equipment to every HOA move</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Other Castle Rock HOA Communities</h3>
            <p class="text-muted-foreground mb-3">Cobblestone Ranch, Crystal Valley Ranch, Terrain, and Metzler Ranch all have HOA governance. The rules vary by community but generally require advance notification and specify move-hour windows.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Most Castle Rock HOAs require 7–14 days advance notice</li>
              <li>✓ Move hours typically 8am–6pm in HOA communities</li>
              <li>✓ Some communities require a refundable damage deposit</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Castle Rock Neighborhoods We Serve</h3>
            <p class="text-muted-foreground">We regularly move clients throughout Castle Rock including The Meadows, Cobblestone Ranch, Crystal Valley Ranch, Terrain, Metzler Ranch, Castlewood Ranch, Downtown Castle Rock, and the newer communities near US-85 and Founders Parkway. Every neighborhood is within our regular service area.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">New Construction Moves in Castle Rock</h3>
            <p class="text-muted-foreground">Castle Rock has a significant new construction market. Moving into a newly built home creates its own logistics — builder-imposed move-in windows, protecting new flooring and paint, coordinating with construction cleanup schedules, and sometimes navigating an active development site. We're experienced with new build moves and know what to protect.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            We've built our reputation across the Denver metro and southern suburbs on reliability, professionalism, and honest pricing.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                Denver metro's highest-rated moving company with verified reviews on Google, Yelp, and Facebook. Castle Rock clients consistently highlight our care with large homes and our crew's professional attitude.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">South Denver Corridor Experts</h3>
              <p class="text-muted-foreground">
                We know Castle Rock's HOA communities, custom home neighborhoods, and the I-25 corridor logistics. We've handled everything from compact townhomes to 5,000 sq ft custom homes in The Meadows.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">We Work Within HOA Windows</h3>
              <p class="text-muted-foreground">
                Castle Rock HOAs have specific time windows and protocols. We schedule your move to work within those windows without rushing your crew or cutting corners. You get the same quality regardless of schedule constraints.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                We quote Castle Rock moves based on your actual home, access, and services — not a generic per-mile formula. Distance from our base is not padded into your hourly rate. Licensed and fully insured.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our Castle Rock moving specialists understand the local community requirements and are ready to help you plan a smooth, professional move.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
