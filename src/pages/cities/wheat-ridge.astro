---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/290197457_539473571254356_3082118749704086809_n_nw_a389c17b.jpg';

const cityName = "Wheat Ridge";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Wheat Ridge Moving Company | Local Movers in Wheat Ridge, CO
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Looking for a moving company in Wheat Ridge, Colorado? Legacy Moving serves Wheat Ridge homes and businesses with professional, careful service and honest pricing. Whether you're moving across town or across the state, our Wheat Ridge movers know the area and get the job done right. Licensed, insured, and locally owned — call for a free quote today.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Complete Moving Services in {cityName}
          </h2>
          <p class="text-muted-foreground text-lg">
            From residential moves to commercial relocations, we handle every aspect of your {cityName} move with care and professionalism.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Local Moving</h3>
            <p class="text-muted-foreground">
              Efficient local moves within {cityName} and to surrounding Denver metro communities. Same-day and next-day service available for Wheat Ridge residents.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Long Distance</h3>
            <p class="text-muted-foreground">
              Interstate moving from {cityName} to anywhere in the US. Professional packing, loading, and safe delivery guaranteed regardless of distance.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Packing Services</h3>
            <p class="text-muted-foreground">
              Full-service packing with quality materials. We'll carefully pack your entire {cityName} home or just the fragile items you don't want to box yourself.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Loading & Unloading</h3>
            <p class="text-muted-foreground">
              Labor-only services for {cityName} residents. We'll load or unload your rental truck or storage unit safely and efficiently.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Commercial Moving</h3>
            <p class="text-muted-foreground">
              Office and business relocation in {cityName} and the surrounding area. Minimize downtime with our efficient commercial moving services.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Storage Solutions</h3>
            <p class="text-muted-foreground">
              Secure storage options for {cityName} residents during your move. Short-term and long-term storage available at our Lakewood facility.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Know About Moving in Wheat Ridge -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          What to Know Before Moving in Wheat Ridge
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground">
          <p class="mb-4">
            Wheat Ridge has a character that's genuinely different from the surrounding suburbs. It's older, more established, and more eclectic — a mix of 1940s and 1950s bungalows, ranch-style homes, a growing number of new infill developments, and commercial corridors along 38th Avenue and Wadsworth that are in the middle of a significant revitalization. That variety creates a range of moving scenarios that our crews navigate every week.
          </p>
          <p class="mb-4">
            The older residential streets in Wheat Ridge are one of the first things you notice. Lots are smaller, trees are mature and overhanging, and some streets weren't designed with moving trucks in mind. Our crews assess truck size and staging before arriving so we're not improvising on your front lawn. For tighter access situations, we use smaller vehicles that can maneuver more easily without slowing the move down.
          </p>
          <p class="mb-4">
            Wheat Ridge doesn't have the heavy HOA governance that cities like Highlands Ranch or Centennial do — most neighborhoods are not HOA-controlled, which gives homeowners more flexibility about how and when they move. That said, if you're moving into one of the newer townhome or condo developments near the 38th and Kipling corridor or along the I-70 access roads, check with your property manager, as managed buildings have their own requirements.
          </p>
          <p class="mb-4">
            Apartment moves in Wheat Ridge are common near the West 38th Avenue corridor and the newer mixed-use developments around the Wheat Ridge / Ward Road light rail station. These properties typically require advance notice, a designated loading zone, and documentation that your moving company carries commercial liability insurance. We provide our credentials immediately on request.
          </p>
          <p>
            Wheat Ridge's location on the west side of Denver — just minutes from I-70 and adjacent to Lakewood, Arvada, and Denver — makes it one of the most accessible points in the metro for our crews. We're based in Lakewood, which means Wheat Ridge moves typically get some of the fastest response times in the region. For same-day moves in Wheat Ridge, calling before noon gives us the best chance of getting a crew to you that day.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Apartment & HOA Moving Tips -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary text-center">
          Apartment Moves, Parking & Local Tips for Wheat Ridge
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Managed Building Moves</h3>
            <p class="text-muted-foreground mb-3">Newer apartment and condo buildings in Wheat Ridge near the light rail and 38th Avenue corridor typically require advance scheduling and may request proof of moving company insurance. We provide our COI documents on request and work within your building's designated move windows.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Contact your property manager 5–7 days before moving</li>
              <li>✓ Ask about elevator and loading zone reservations</li>
              <li>✓ We provide certificate of insurance on request</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Street Access & Truck Parking</h3>
            <p class="text-muted-foreground mb-3">Most Wheat Ridge residential streets don't require city parking permits for moving trucks, but older neighborhoods with narrow streets and mature tree canopy require careful truck positioning. Our Wheat Ridge crews always assess access before arrival.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ No city street permit required for most moves</li>
              <li>✓ We size vehicles appropriately for tight access</li>
              <li>✓ We protect driveways and landscaping as standard</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Wheat Ridge Neighborhoods We Serve</h3>
            <p class="text-muted-foreground">We move clients throughout Wheat Ridge including the 38th Avenue Corridor, Prospect Valley, Fruitdale, Crown Hill, Bel Aire, and neighborhoods near the Wheat Ridge / Ward Road and Wheat Ridge / Arvada light rail stations. No Wheat Ridge neighborhood is too tight or too tricky for our crews.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Moving Costs in Wheat Ridge</h3>
            <p class="text-muted-foreground">Wheat Ridge moves are typically competitively priced given our proximity — we're based just a few miles away in Lakewood, so there's no long drive padding your bill. Most small-to-medium Wheat Ridge moves wrap up efficiently. We quote based on your actual home size and access, not a formula that overestimates to protect our margin.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            We've built our reputation across the Denver metro on reliability, professionalism, and honest service. Wheat Ridge is no exception.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                Denver's highest-rated moving company with verified reviews across Google, Yelp, and Facebook. Our Wheat Ridge customers consistently highlight our crew's professionalism and care.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Based Right Next Door in Lakewood</h3>
              <p class="text-muted-foreground">
                Our office is in Lakewood — just minutes from Wheat Ridge. That means faster response times, crews who know the roads, and no unnecessary travel fees built into your quote.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Flexible Scheduling</h3>
              <p class="text-muted-foreground">
                Same-day and next-day moves available in {cityName}. We work around your schedule, including weekends and evenings when needed.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                Clear, upfront quotes for {cityName} moves. No hidden fees, no fuel surcharges not in your original quote. Licensed and fully insured — DOT #3462023, MC #1189363.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our {cityName} moving specialists are ready to help plan your perfect move — call or fill out our quick quote form.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
