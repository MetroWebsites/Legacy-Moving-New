---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/truck-in-driveway-legacy-moving-denver_nw_b9c9f7fe.jpeg';

const cityName = "Frederick";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Frederick Moving Company | Professional Movers in Frederick, CO
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Moving to or from Frederick? Legacy Moving provides professional, careful moving services throughout Frederick and the northern Front Range. From Frederick's charming older neighborhoods to newer developments near I-25, our crews handle every move with professionalism and honest pricing. Licensed, insured, and trusted — call for your free quote today.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Complete Moving Services in {cityName}
          </h2>
          <p class="text-muted-foreground text-lg">
            Whether you're moving within Frederick or relocating from the Denver metro, we handle every move with the same professional care and local expertise.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Local Moving</h3>
            <p class="text-muted-foreground">
              Efficient local moves within Frederick and throughout the northern Front Range. We connect Frederick to Brighton, Longmont, Erie, and the Denver metro without long-distance rates.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Long Distance</h3>
            <p class="text-muted-foreground">
              Interstate moving from Frederick to anywhere in the US. We handle the complete process — packing, loading, transport, and delivery coordination for any destination.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Packing Services</h3>
            <p class="text-muted-foreground">
              Full-service packing for your Frederick home. We supply all materials and handle everything — from delicate kitchenware to large furniture — so you can focus on the details.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Loading & Unloading</h3>
            <p class="text-muted-foreground">
              Labor-only services for Frederick residents who have their own truck or container. We load with care and efficiency, protecting your belongings for transit.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Commercial Moving</h3>
            <p class="text-muted-foreground">
              Office and business relocation in Frederick and the northern corridor. We schedule around your operations to keep business disruption to a minimum.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Storage Solutions</h3>
            <p class="text-muted-foreground">
              Secure storage options for Frederick residents in transition. We bridge gaps between your old and new home with flexible short and long-term storage.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Know About Moving in Frederick -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          What to Know Before Moving in Frederick
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground">
          <p class="mb-4">
            Frederick is a small but growing town in Weld County, situated between Brighton and Longmont along the northern Front Range. It has a distinct small-town character with a historic downtown core, relatively lower housing costs compared to the rest of the metro, and easy access to I-25 for commuters. Over the past decade, Frederick has grown significantly as families and young professionals seek more affordable housing while staying within commuting distance of Denver, Boulder, and Longmont's tech corridor.
          </p>
          <p class="mb-4">
            Frederick sits next to the town of Firestone, and together they share several master-planned communities and HOA-governed neighborhoods. Communities like Wyndham Hill, which straddles Frederick and Firestone, are HOA-governed and require advance notification for moves. The HOA rules in these newer communities are similar to those across the Denver metro — advance notice, designated truck access, move hours generally 8am–6pm, and sometimes a deposit for common surfaces.
          </p>
          <p class="mb-4">
            Older neighborhoods near Downtown Frederick have less HOA oversight and more flexible move logistics. Streets in the older parts of town can be narrow, with limited parking for large trucks. On move day, plan for the crew to block part of the street temporarily — this is normal for older residential areas, and our crews are used to it. We notify neighbors as a courtesy in tight-access situations.
          </p>
          <p class="mb-4">
            Frederick's location in Weld County means the northern part of town is in oil and gas country — there's significant truck traffic on certain roads, particularly near Highway 52 and Highway 119. For moves involving a large truck, our drivers know the best routes to avoid heavy commercial traffic and to access residential areas efficiently.
          </p>
          <p>
            Frederick is about 45 minutes from our Lakewood base — one of our farther service points, but firmly within our regular territory. We frequently run moves between Frederick and <a href="/cities/brighton" class="text-primary hover:underline">Brighton</a>, <a href="/cities/longmont" class="text-primary hover:underline">Longmont</a>, and <a href="/cities/erie" class="text-primary hover:underline">Erie</a>. All are within our standard service area with no additional fees.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Apartment & HOA Moving Tips -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary text-center">
          HOA Rules, New Builds & Local Tips for Frederick Moves
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Wyndham Hill & HOA Communities</h3>
            <p class="text-muted-foreground mb-3">Communities like Wyndham Hill that span Frederick and Firestone require advance HOA coordination. Moving hour restrictions and truck access rules are standard in these newer master-planned developments.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Notify HOA management 7–14 days before moving</li>
              <li>✓ Confirm approved truck routes and move hours</li>
              <li>✓ Surface protection provided at all HOA moves</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Downtown & Older Frederick</h3>
            <p class="text-muted-foreground mb-3">Older neighborhoods near Downtown Frederick have more flexibility but narrower streets. We plan accordingly for tight access and coordinate with the crew to minimize disruption to the neighborhood.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Let us know about narrow driveways or tight access</li>
              <li>✓ We plan for street positioning in tight residential areas</li>
              <li>✓ Shuttle service available for extreme access challenges</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Frederick Neighborhoods We Serve</h3>
            <p class="text-muted-foreground">We move clients throughout Frederick including Wyndham Hill, Downtown Frederick, Centennial Valley, Frederick Village, and newer developments near the I-25 corridor. All are within our northern Front Range service area.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Northern Front Range Connections</h3>
            <p class="text-muted-foreground">Frederick is well positioned between Brighton to the south and Longmont and Erie to the north. We frequently handle moves along this corridor — whether you're moving within the area or relocating from Denver or Boulder into Frederick's more affordable market.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            Professional movers serving the entire northern Front Range corridor from Denver to Longmont.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                Denver metro's highest-rated moving company. Frederick clients appreciate our reliability, care with new construction, and straightforward pricing.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Northern Corridor Coverage</h3>
              <p class="text-muted-foreground">
                We know the I-25 northern corridor from Brighton to Longmont. Frederick, Firestone, Erie, and Lafayette are all regular destinations for our crews.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Reliable, Punctual Crews</h3>
              <p class="text-muted-foreground">
                Travel time to Frederick is built into our scheduling. Your crew arrives when we say they will, ready to work efficiently from the first minute.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                We quote Frederick moves based on your actual home and services — no padded distance rates. Licensed and fully insured with upfront pricing every time.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nearby Cities -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="font-display font-bold text-2xl md:text-3xl mb-6 text-secondary">Also Serving Nearby Cities</h2>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/cities/brighton" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Brighton</a>
          <a href="/cities/longmont" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Longmont</a>
          <a href="/cities/erie" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Erie</a>
          <a href="/cities/lafayette" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Lafayette</a>
          <a href="/cities/commerce-city" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Commerce City</a>
          <a href="/cities/thornton" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Thornton</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our Frederick moving specialists know the northern Front Range corridor and are ready to plan your move from start to finish.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
