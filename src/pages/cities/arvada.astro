---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/working-ad-legacy-moving-denver_nw_c7ceaf8e.jpeg';

const cityName = "Arvada";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Arvada Moving Services | Professional Movers You Can Trust
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Planning a move in Arvada? Legacy Moving provides fast, reliable moving services throughout Arvada and Northwest Denver. From family homes to apartment moves, our Arvada movers handle everything with care and efficiency. Fully licensed and insured with hundreds of satisfied Arvada customers. Request your free quote in minutes!
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Same-Day Moving in Arvada -->
  <section class="py-14 bg-gradient-to-br from-green-50 to-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary text-center">
          Need to Move Today? We Can Make It Happen.
        </h2>
        <p class="text-center text-muted-foreground mb-10">
          Arvada residents call us when they need a last-minute move. Here's how we handle same-day requests:
        </p>
        <div class="grid md:grid-cols-3 gap-6 mb-8">
          <div class="bg-white p-6 rounded-lg shadow-md text-center">
            <div class="text-4xl font-bold text-primary mb-3">1</div>
            <h3 class="font-bold text-lg mb-2 text-secondary">Call Before Noon</h3>
            <p class="text-muted-foreground text-sm">
              If you call us before 12pm, we can usually get a crew to you the same day (subject to availability).
            </p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md text-center">
            <div class="text-4xl font-bold text-primary mb-3">2</div>
            <h3 class="font-bold text-lg mb-2 text-secondary">Quick Assessment</h3>
            <p class="text-muted-foreground text-sm">
              Tell us what needs to move. We'll give you an honest estimate over the phone—no surprises later.
            </p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md text-center">
            <div class="text-4xl font-bold text-primary mb-3">3</div>
            <h3 class="font-bold text-lg mb-2 text-secondary">Crew Arrives Fast</h3>
            <p class="text-muted-foreground text-sm">
              We dispatch the nearest available crew. Most Arvada same-day moves start within 2-4 hours of your call.
            </p>
          </div>
        </div>
        <div class="bg-secondary/5 p-6 rounded-lg">
          <h3 class="font-semibold text-lg text-secondary mb-3 text-center">Common Same-Day Scenarios We Handle:</h3>
          <div class="grid md:grid-cols-2 gap-4">
            <div class="flex items-start gap-2">
              <span class="text-primary font-bold">✓</span>
              <span class="text-muted-foreground text-sm"><strong>Apartment lease expires today</strong> and you need out fast</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-primary font-bold">✓</span>
              <span class="text-muted-foreground text-sm"><strong>Original movers didn't show up</strong> and you need backup immediately</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-primary font-bold">✓</span>
              <span class="text-muted-foreground text-sm"><strong>Single item delivery</strong> (couch, mattress, appliance) needs to happen now</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-primary font-bold">✓</span>
              <span class="text-muted-foreground text-sm"><strong>Emergency relocation</strong> due to unexpected circumstances</span>
            </div>
          </div>
        </div>
        <div class="mt-8 text-center">
          <p class="text-muted-foreground mb-4">
            <strong>Pro tip:</strong> Same-day availability varies by season. Summer weekends book up fast—call early!
          </p>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary text-white hover:bg-primary' })}>
            Call Now for Same-Day Service
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            We've built our reputation in {cityName} on reliability, professionalism, and exceptional customer service.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                {cityName}'s highest-rated moving company with verified reviews across Google, Yelp, and Facebook.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Local {cityName} Experts</h3>
              <p class="text-muted-foreground">
                We know {cityName} neighborhoods, buildings, and logistics. Serving the Denver metro since 2018.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Flexible Scheduling</h3>
              <p class="text-muted-foreground">
                Same-day and next-day moves available in {cityName}. We work around your schedule, including weekends.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                Clear, upfront quotes for {cityName} moves. No hidden fees, no surprises. Licensed and fully insured.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Know About Moving in Arvada -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          What to Know Before Moving in Arvada
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground">
          <p class="mb-4">
            Arvada has been one of the fastest-growing and most sought-after communities in the Denver metro for the past several years — and it's easy to see why. You get great access to Denver via the Gold Line light rail, proximity to the mountains, a genuinely walkable historic downtown in Olde Town Arvada, and a wide range of housing options from 1950s ranch homes to brand-new builds in Candelas.
          </p>
          <p class="mb-4">
            Moving in Arvada varies a lot by neighborhood. The older streets near Olde Town are tight and charming, which means truck parking requires some planning. Newer developments like Candelas, West Woods, and Whisper Creek have wider access roads and are much more truck-friendly. We assess access during the quoting process so there are no surprises on move day.
          </p>
          <p class="mb-4">
            Arvada has a growing number of apartment communities, particularly near the Ralston Fields and Olde Town light rail stations. These buildings typically require move scheduling with the leasing office, elevator reservation if the building has one, and documentation that your movers are licensed and insured. We have no problem providing our credentials — just ask.
          </p>
          <p>
            HOA communities in Arvada — particularly newer ones on the west side — typically have rules about move-in hours and truck parking. Candelas HOA, for example, has specific provisions about commercial vehicle access. Always check with your HOA management before your move date. For unincorporated Jefferson County areas within the Arvada zip code, the rules differ again — we navigate all of this regularly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Apartment & HOA Moving Tips -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary text-center">
          Apartment Moves, HOA Rules & Local Tips for Arvada
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Light Rail-Adjacent Moves</h3>
            <p class="text-muted-foreground mb-3">Apartments near the Gold Line stations at Olde Town and Ralston Fields often have formal move-in procedures including scheduled time slots, elevator reservations, and insurance requirements from the moving company.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Contact the leasing office at least 5–7 days before moving</li>
              <li>✓ Request our COI/insurance certificate if required</li>
              <li>✓ Confirm elevator and loading dock reservation protocols</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">HOA Move Rules in Arvada</h3>
            <p class="text-muted-foreground mb-3">Candelas, West Woods, Whisper Creek, and other planned communities have HOA rules about truck access and timing. We're experienced with these communities and help you understand what to expect before move day.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Register your move with the HOA management office</li>
              <li>✓ We protect community surfaces with runners and padding</li>
              <li>✓ Most Arvada residential streets need no city parking permits</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Arvada Neighborhoods We Serve</h3>
            <p class="text-muted-foreground">We regularly move clients in Olde Town Arvada, Candelas, West Woods, Whisper Creek, Ralston Fields, Lakecrest, Scenic Heights, and communities along Wadsworth Boulevard and Indiana Street. Arvada is one of our highest-volume markets.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Moving Costs in Arvada</h3>
            <p class="text-muted-foreground">Arvada moves range from studio apartment moves (typically a 2-3 hour job) to large multi-bedroom homes in Candelas (typically half a day or more). We quote based on your actual situation. No guessing, no bait-and-switch. Your quote reflects your home size, access, and services needed.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area Info -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          Serving All {cityName} Neighborhoods
        </h2>
        <p class="text-muted-foreground text-lg mb-8">
          Whether you're moving to Olde Town Arvada, Candelas, West Woods, Whisper Creek, Ralston Fields, or any other {cityName} neighborhood, our experienced movers know the area and can navigate any challenge. We provide the same professional, careful service to every Arvada resident.
        </p>
        <a href="/service-area" class={buttonVariants({ className: 'bg-secondary text-white hover:bg-primary' })}>
          View All Service Areas
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our {cityName} moving specialists are standing by to help plan your perfect move.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
