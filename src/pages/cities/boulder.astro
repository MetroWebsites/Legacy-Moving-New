---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/services/hero.jpg';

const cityName = "Boulder";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Boulder Movers | Professional Moving Company in Boulder, CO
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Looking for Boulder movers who understand the unique needs of Boulder residents? Legacy Moving specializes in Boulder moving services including student moves, family relocations, and commercial moving. Our Boulder moving company offers flexible scheduling and careful handling of your belongings. Trusted by CU students and Boulder families alike!
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CU Boulder Student Moving -->
  <section class="py-14 bg-gradient-to-br from-amber-50 to-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary text-center">
          CU Boulder Student Moves Made Easy
        </h2>
        <p class="text-center text-muted-foreground mb-10">
          We move hundreds of CU students every semester—here's how we make it painless:
        </p>
        <div class="grid md:grid-cols-2 gap-8 mb-10">
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="font-bold text-xl mb-3 text-secondary">Move-In Rush (August)</h3>
            <ul class="space-y-2 text-muted-foreground">
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">•</span>
                <span><strong>Book Early:</strong> We fill up fast during move-in week</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">•</span>
                <span><strong>Dorm-Ready Crews:</strong> We know which residence halls allow carts, which have elevators, and parking rules</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">•</span>
                <span><strong>Parent-Friendly:</strong> We coordinate with parents flying in from out of state</span>
              </li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="font-bold text-xl mb-3 text-secondary">Move-Out Season (May)</h3>
            <ul class="space-y-2 text-muted-foreground">
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">•</span>
                <span><strong>Storage Options:</strong> Store your stuff for summer, we'll hold it at our facility</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">•</span>
                <span><strong>Quick Turnarounds:</strong> Need to be out in 24 hours? We can do that</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">•</span>
                <span><strong>Flexible Scheduling:</strong> We work around finals week stress</span>
              </li>
            </ul>
          </div>
        </div>
        <div class="bg-secondary/5 p-6 rounded-lg text-center">
          <p class="font-semibold text-secondary mb-2">Student Special</p>
          <p class="text-muted-foreground mb-4">
            Show your CU student ID and get <strong class="text-primary">15% off</strong> any local move under 3 hours
          </p>
          <p class="text-sm text-muted-foreground italic">
            Typical dorm move (Farrand Hall to off-campus apartment): 1.5-2 hours = $180-$240 after discount
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Boulder-Specific Challenges -->
  <section class="py-14 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          Boulder Isn't Your Average Move
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground">
          <p class="mb-4">
            Let's be honest: moving in Boulder comes with challenges you won't find in other cities. Narrow Pearl Street access. Historic homes with steep driveways and small doors. Parking meters everywhere. And those hills—lots of hills.
          </p>
          <p class="mb-4">
            We've been moving Boulder residents for years, and we've learned a few things. Like which streets require parking permits (we handle those). Which neighborhoods have alleys for easier truck access. And how to navigate CU campus during game days.
          </p>
          <p>
            Whether you're moving into a historic Mapleton Hill Victorian or a modern apartment near Twenty Ninth Street, our Boulder crews come prepared with the right equipment and local knowledge to make it smooth.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            We've built our reputation in {cityName} on reliability, professionalism, and exceptional customer service.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                {cityName}'s highest-rated moving company with verified reviews across Google, Yelp, and Facebook.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Local {cityName} Experts</h3>
              <p class="text-muted-foreground">
                We know {cityName} neighborhoods, buildings, and logistics. Serving the Denver metro since 2018.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Flexible Scheduling</h3>
              <p class="text-muted-foreground">
                Same-day and next-day moves available in {cityName}. We work around your schedule, including weekends.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                Clear, upfront quotes for {cityName} moves. No hidden fees, no surprises. Licensed and fully insured.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area Info -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          Serving All {cityName} Neighborhoods
        </h2>
        <p class="text-muted-foreground text-lg mb-8">
          Whether you're moving to Pearl Street, University Hill, Table Mesa, Chautauqua, or any other {cityName} neighborhood, our experienced movers know the area and can navigate any challenge. We provide the same exceptional service to every {cityName} resident.
        </p>
        <a href="/service-area" class={buttonVariants({ className: 'bg-secondary text-white hover:bg-primary' })}>
          View All Service Areas
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our {cityName} moving specialists are standing by to help plan your perfect move.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
