---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/truck-in-driveway-legacy-moving-denver_nw_b9c9f7fe.jpeg';

const cityName = "Longmont";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Longmont Moving Company | Professional Movers in Longmont, CO
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Moving to or from Longmont? Legacy Moving provides professional, careful moving services throughout Longmont and Boulder County. From Historic East Side and Downtown Longmont to Prospect New Town and the newer communities near US-287, our crews handle every move with professionalism and honest pricing. Licensed, insured, and trusted — call for your free quote today.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Complete Moving Services in {cityName}
          </h2>
          <p class="text-muted-foreground text-lg">
            From Longmont's historic neighborhoods to newer master-planned communities, we handle every move with expertise and care.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Local Moving</h3>
            <p class="text-muted-foreground">
              Efficient local moves within Longmont and throughout Boulder County and the northern Front Range. We connect Longmont to Boulder, Erie, Lafayette, Frederick, and the Denver metro.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Long Distance</h3>
            <p class="text-muted-foreground">
              Interstate moving from Longmont to anywhere in the US. We handle the complete long-distance process — from packing and loading to coordinated delivery at your destination.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Packing Services</h3>
            <p class="text-muted-foreground">
              Full-service packing for your Longmont home. We supply all materials and handle everything — fragile kitchenware, art, books, large furniture — with professional care throughout.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Loading & Unloading</h3>
            <p class="text-muted-foreground">
              Labor-only services for Longmont residents using their own truck or container. We load efficiently and carefully to protect your belongings for the move.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Commercial Moving</h3>
            <p class="text-muted-foreground">
              Office and business relocation in Longmont and Boulder County. Longmont's growing tech and manufacturing sector creates regular commercial moving needs that we handle efficiently.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Storage Solutions</h3>
            <p class="text-muted-foreground">
              Flexible storage for Longmont residents in transition. We bridge gaps between your old and new home with secure, short and long-term storage options.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Know About Moving in Longmont -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          What to Know Before Moving in Longmont
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground">
          <p class="mb-4">
            Longmont is Boulder County's largest city by population, a city of about 100,000 people that sits at the intersection of the Denver metro's northern growth corridor and Boulder's spillover market. It has significantly more affordable housing than Boulder, an active downtown with a strong local business community, and a growing tech and manufacturing presence anchored by companies like Seagate, Lumen Technologies, and a range of smaller firms in the city's industrial parks.
          </p>
          <p class="mb-4">
            The Historic East Side and Old Town Longmont neighborhoods are what you might expect from a 150-year-old Colorado city: mature trees, older homes with character, narrow streets, and limited parking for large moving trucks. Moving in these areas requires careful planning around truck positioning. Our crews have done many older neighborhood moves and know how to work efficiently in tight spaces — blocking part of the street temporarily and working quickly to minimize any disruption.
          </p>
          <p class="mb-4">
            Prospect New Town is Longmont's signature new urbanist development — a walkable, mixed-use neighborhood with alley-loaded homes, front porches, and a compact street grid. Moving into Prospect requires knowledge of the alley access system, which is how most homes receive deliveries. Trucks access many homes from the rear. We've done plenty of Prospect moves and know the layout.
          </p>
          <p class="mb-4">
            Newer master-planned communities on Longmont's west and south sides — along US-287 and near Hover Road — are HOA-governed with typical advance notification requirements, designated truck access, and move hour windows. If you're moving into a newer community on the Longmont periphery, plan to contact the HOA management office at least one to two weeks before your move.
          </p>
          <p>
            Longmont is about 50–55 minutes from our Lakewood base, making it one of our farther regular service points but firmly within our territory. We regularly move between Longmont and <a href="/cities/lafayette" class="text-primary hover:underline">Lafayette</a>, <a href="/cities/erie" class="text-primary hover:underline">Erie</a>, <a href="/cities/frederick" class="text-primary hover:underline">Frederick</a>, and <a href="/cities/brighton" class="text-primary hover:underline">Brighton</a>. All are within our standard service area with no additional fees.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Apartment & HOA Moving Tips -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary text-center">
          Apartments, HOA Rules & Local Tips for Longmont Moves
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Apartment & Condo Moves</h3>
            <p class="text-muted-foreground mb-3">Longmont has a range of apartment communities from older complexes near downtown to newer builds near US-287. Standard apartment move protocols apply — notify management and confirm elevator or loading dock access in advance.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Notify property manager at least one week in advance</li>
              <li>✓ Confirm elevator availability and reserved move parking</li>
              <li>✓ We carry furniture pads, dollies, and floor protection</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">HOA Community Requirements</h3>
            <p class="text-muted-foreground mb-3">Newer Longmont communities on the south and west sides have HOA governance. Advance notification and move-hour restrictions are standard. Check with your specific community before scheduling.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Contact HOA management 7–14 days before your move</li>
              <li>✓ Confirm truck access routes and parking areas</li>
              <li>✓ Typical move hours: 8am–6pm in managed communities</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Longmont Neighborhoods We Serve</h3>
            <p class="text-muted-foreground">We move clients throughout Longmont including Historic East Side, Prospect New Town, Old Town Longmont, Hover Acres, Renaissance, Stoneridge, and newer developments near US-287 and SH-119. All are within our Boulder County service area.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Boulder-to-Longmont Moves</h3>
            <p class="text-muted-foreground">We handle many moves between Boulder and Longmont as residents move to take advantage of more affordable housing while maintaining proximity to Boulder. These short-haul moves are priced as standard local moves within our service area — no long-distance premium applies.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            Professional movers serving Boulder County and the northern Front Range corridor.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                Denver metro's highest-rated moving company. Longmont and Boulder County clients note our punctuality, care with older homes, and straightforward pricing.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Boulder County Coverage</h3>
              <p class="text-muted-foreground">
                We know Longmont's neighborhoods — from tight Old Town streets to alley-access Prospect homes to newer HOA communities. We've moved in all of them.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Reliable, On-Time Crews</h3>
              <p class="text-muted-foreground">
                Travel time to Longmont is built into our scheduling. Your crew arrives ready to work — not late, not rushed, not distracted from another job.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                We quote Longmont moves based on your actual home and services. No inflated rates for distance. Licensed, insured, and upfront about every cost.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nearby Cities -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="font-display font-bold text-2xl md:text-3xl mb-6 text-secondary">Also Serving Nearby Cities</h2>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/cities/lafayette" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Lafayette</a>
          <a href="/cities/erie" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Erie</a>
          <a href="/cities/frederick" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Frederick</a>
          <a href="/cities/brighton" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Brighton</a>
          <a href="/cities/broomfield" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Broomfield</a>
          <a href="/cities/westminster" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Westminster</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our Longmont moving specialists know Boulder County's neighborhoods and are ready to plan your move from start to finish.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
