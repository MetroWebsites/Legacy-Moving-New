---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/truck-in-driveway-legacy-moving-denver_nw_b9c9f7fe.jpeg';

const cityName = "Brighton";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Brighton Moving Company | Professional Movers in Brighton, CO
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Moving to or from Brighton? Legacy Moving provides professional, careful moving services throughout Brighton and Adams County. From Brighton Crossing and Bromley Park to older neighborhoods near Downtown Brighton, our crews handle every move with professionalism and honest pricing. Licensed, insured, and trusted — call for your free quote today.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Complete Moving Services in {cityName}
          </h2>
          <p class="text-muted-foreground text-lg">
            From master-planned communities like Brighton Crossing and Bromley Park to newer construction along E-470, we handle every Brighton move with professionalism and care.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Local Moving</h3>
            <p class="text-muted-foreground">
              Efficient local moves within {cityName} and throughout Adams County. We connect Brighton to Thornton, Commerce City, Frederick, and the Denver metro without long-distance rates.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Long Distance</h3>
            <p class="text-muted-foreground">
              Interstate moving from Brighton anywhere in the US. We handle long-distance moves with the same care as local ones — professional packing, careful loading, and reliable delivery.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Packing Services</h3>
            <p class="text-muted-foreground">
              Full-service packing for your Brighton home. We bring all materials and handle everything from fragile kitchen items to large furniture so you can focus on the rest of your move.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Loading & Unloading</h3>
            <p class="text-muted-foreground">
              Labor-only services for Brighton residents using their own truck or a container. We load efficiently and protect your belongings from start to finish.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Commercial Moving</h3>
            <p class="text-muted-foreground">
              Office and business relocation in Brighton and Adams County. We work around your business hours to minimize operational disruption during your move.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Storage Solutions</h3>
            <p class="text-muted-foreground">
              Flexible storage for Brighton residents between homes. We offer secure short and long-term options to bridge gaps in your moving timeline.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Know About Moving in Brighton -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          What to Know Before Moving in Brighton
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground">
          <p class="mb-4">
            Brighton is one of the fastest-growing cities in the Denver metro area. Located in Adams County along the I-76 corridor, it has transformed over the past 15 years from a small agricultural town into a substantial suburban city with master-planned residential communities, a growing commercial strip, and direct access to both Denver and DIA. Many of our clients come to Brighton from more expensive parts of the metro, drawn by more space and newer construction at accessible price points.
          </p>
          <p class="mb-4">
            Brighton Crossing is one of the largest master-planned communities in the city — a neighborhood developed by Century Communities with thousands of homes, its own parks, trails, and HOA governance. Brighton Crossing HOA has specific protocols for moves, including advance notice, truck parking requirements, and move-hour restrictions. If you're moving into Brighton Crossing, contact the HOA office at least one to two weeks before your move to understand the current requirements.
          </p>
          <p class="mb-4">
            Bromley Park is Brighton's other major master-planned community — a large, established neighborhood with its own HOA that has governed the area for years. Bromley Park tends to be more established than Brighton Crossing, with mature landscaping and quieter streets. The HOA requires advance notification for moves and has designated procedures similar to other large Adams County communities.
          </p>
          <p class="mb-4">
            Downtown Brighton and the older east-side neighborhoods are less governed by HOAs and more open to flexible move scheduling. Streets in these areas can be narrower and parking more limited — our crew plans accordingly. If you're moving out of an older Brighton home, let us know about any access challenges during the quote process.
          </p>
          <p>
            Brighton is about 35–40 minutes from our Lakewood base — farther than our central Denver moves but well within our regular service area. We frequently run moves between Brighton and neighboring <a href="/cities/commerce-city" class="text-primary hover:underline">Commerce City</a>, <a href="/cities/thornton" class="text-primary hover:underline">Thornton</a>, and <a href="/cities/frederick" class="text-primary hover:underline">Frederick</a>. Travel time is built transparently into our scheduling.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Apartment & HOA Moving Tips -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary text-center">
          HOA Rules, New Construction & Local Tips for Brighton Moves
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Brighton Crossing HOA Requirements</h3>
            <p class="text-muted-foreground mb-3">Brighton Crossing HOA requires advance notification for moves and has designated truck access routes and move hours. Contact the HOA management office early to avoid issues on move day.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Notify HOA at least 7–14 days before your move</li>
              <li>✓ Confirm approved truck routes and parking areas</li>
              <li>✓ We carry surface protection for all HOA community moves</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Bromley Park HOA Rules</h3>
            <p class="text-muted-foreground mb-3">Bromley Park is an established master-planned community with active HOA management. Standard move notification and hour restrictions apply — check with the HOA before your move date.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Advance move notification required</li>
              <li>✓ Move hours typically 8am–6pm in managed areas</li>
              <li>✓ Ask about damage deposits for common surfaces</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Brighton Neighborhoods We Serve</h3>
            <p class="text-muted-foreground">We move clients throughout Brighton including Brighton Crossing, Bromley Park, Brandywine, Platte Valley Farms, Downtown Brighton, the east-side older neighborhoods, and new developments near E-470. All are within our service area.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">New Construction Moves in Brighton</h3>
            <p class="text-muted-foreground">Brighton continues to see significant new home construction. Moving into a new build means protecting new floors, fresh paint, and in some cases navigating an active construction site. We bring all necessary floor and door protection materials as standard.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            Professional movers trusted across the north Denver metro and Adams County.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                Denver metro's highest-rated moving company. Brighton clients highlight our reliability, care with new construction, and professional crew attitude.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Adams County Experts</h3>
              <p class="text-muted-foreground">
                We know Brighton's growing communities, HOA requirements, and the access challenges that come with large master-planned neighborhoods. We've done it before.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Reliable Scheduling</h3>
              <p class="text-muted-foreground">
                Travel time to Brighton is built into our scheduling. Your crew arrives on time ready to work — not rushing from another job or running behind schedule.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                We quote Brighton moves based on your actual home and services — no inflated rates for distance. Licensed and fully insured with clear, upfront pricing.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nearby Cities -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="font-display font-bold text-2xl md:text-3xl mb-6 text-secondary">Also Serving Nearby Cities</h2>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/cities/commerce-city" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Commerce City</a>
          <a href="/cities/thornton" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Thornton</a>
          <a href="/cities/frederick" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Frederick</a>
          <a href="/cities/westminster" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Westminster</a>
          <a href="/cities/aurora" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Aurora</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our Brighton moving specialists know the local communities and are ready to plan your move from start to finish.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
