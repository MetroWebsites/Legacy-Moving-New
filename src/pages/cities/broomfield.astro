---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/working-ad-legacy-moving-denver_nw_c7ceaf8e.jpeg';

const cityName = "Broomfield";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Broomfield Moving Company | Top-Rated Movers in Broomfield, CO
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Moving in Broomfield? Legacy Moving provides professional, careful moving services throughout Broomfield and the northwest Denver metro. Whether you're in Anthem, Anthem Ranch, Broadlands, or anywhere else in Broomfield, our experienced crews handle your move with the same professionalism we bring to every job. Licensed, insured, 1,700+ five-star reviews — call for a free quote.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Complete Moving Services in {cityName}
          </h2>
          <p class="text-muted-foreground text-lg">
            From single-bedroom apartments to large executive homes, we handle every Broomfield move with the same professional approach.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Local Moving</h3>
            <p class="text-muted-foreground">
              Efficient local moves within {cityName} and throughout the northwest Denver metro. We know Broomfield's streets, communities, and logistics.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Long Distance</h3>
            <p class="text-muted-foreground">
              Interstate moving from {cityName} to anywhere in the US. Broomfield is a popular starting point for long-distance moves — we make the transition seamless.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Packing Services</h3>
            <p class="text-muted-foreground">
              Full-service packing for your entire Broomfield home or partial packing for just the rooms you need help with. Quality materials, careful technique.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Loading & Unloading</h3>
            <p class="text-muted-foreground">
              Labor-only services if you've rented your own truck or have a POD container. We load efficiently and carefully — nothing gets damaged from poor packing or stacking.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Commercial Moving</h3>
            <p class="text-muted-foreground">
              Broomfield is a major corporate hub — home to dozens of tech and national company headquarters. We handle office and corporate campus relocations with minimal business disruption.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Storage Solutions</h3>
            <p class="text-muted-foreground">
              Secure short-term and long-term storage options for Broomfield residents. Ideal when your move-in date doesn't align perfectly with your move-out date.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Know About Moving in Broomfield -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          What to Know Before Moving in Broomfield
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground">
          <p class="mb-4">
            Broomfield is unique among Denver metro cities in that it spans both Boulder and Adams counties — a quirk that actually doesn't affect your move but does reflect just how thoughtfully this city was planned. Broomfield was incorporated as its own city and county in 2001 after a long campaign by residents, and that independent spirit is visible in how the city manages itself. It's well-maintained, well-planned, and — relevant to moving — has relatively straightforward logistics for our crews.
          </p>
          <p class="mb-4">
            The housing stock in Broomfield ranges from older townhomes and condos in the original city center area to large executive homes in Anthem and Anthem Ranch, and everything in between. The Broadlands and Willow Run communities feature larger single-family homes on more generous lots, while areas near the US-36 corridor and the Westminster/Broomfield border have more apartment and condo density.
          </p>
          <p class="mb-4">
            HOA governance is the norm in Broomfield. Anthem and Anthem Ranch in particular are actively HOA-governed communities with real rules about move-in timing, truck parking, and damage prevention. The Anthem HOA typically requires advance notification of your move date and specifies designated vehicle access routes and parking areas. We recommend calling the Anthem management office two weeks before your move to get the specific requirements in writing.
          </p>
          <p class="mb-4">
            Apartment and condo moves in Broomfield — particularly in buildings near the US-36 tech corridor and Flatiron Crossing — often involve managed building requirements. Contact your property manager at least a week out to understand the move-in protocol, reserve any elevator windows needed, and confirm what documentation is required from your moving company.
          </p>
          <p>
            Broomfield's corporate campus presence — companies like Oracle, Level 3, and various tech employers have significant operations here — creates a notable commercial moving market. We handle corporate campus relocations and office moves in Broomfield regularly, working weekends and after-hours to minimize disruption to ongoing business operations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Apartment & HOA Moving Tips -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary text-center">
          HOA Rules, Apartment Moves & Local Tips for Broomfield
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Anthem & Anthem Ranch HOA</h3>
            <p class="text-muted-foreground mb-3">These are some of the more strictly governed communities in the Denver metro. The HOA requires advance move notification, specifies truck access routes, and may require protective measures for driveways and walkways. Contact the Anthem management office at least two weeks before your move.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Two weeks advance notice recommended</li>
              <li>✓ We carry full protective equipment for HOA moves</li>
              <li>✓ We've worked in Anthem many times — we know the rules</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Managed Building Requirements</h3>
            <p class="text-muted-foreground mb-3">Apartment and condo buildings near Flatiron Crossing and the US-36 corridor often require scheduled moves, loading dock reservations, and insurance documentation from the moving company.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Contact leasing office at least 5–7 days before moving</li>
              <li>✓ We provide COI/insurance certificate on request</li>
              <li>✓ Elevator and loading dock reservation may be required</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Broomfield Neighborhoods We Serve</h3>
            <p class="text-muted-foreground">We regularly move clients in Anthem, Anthem Ranch, Broadlands, Willow Run, Broomfield Town Center, Miramonte, and neighborhoods along Sheridan Boulevard, Wadsworth Parkway, and the US-36 corridor. Broomfield's well-planned streets make for efficient moves.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Moving Costs in Broomfield</h3>
            <p class="text-muted-foreground">Broomfield moves run the full range — from efficient apartment moves near the tech corridor to all-day jobs in Anthem executive homes. We quote based on your real inventory. The size of your home, number of flights of stairs, and any specialty items all factor in. No surprises on move day.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            We've built our reputation across the Denver metro on reliability, professionalism, and honest service. Broomfield is one of our strongest markets.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                Denver metro's highest-rated moving company with verified reviews across Google, Yelp, and Facebook. Our Broomfield clients regularly comment on crew professionalism and move-day communication.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Northwest Metro Experts</h3>
              <p class="text-muted-foreground">
                We know Broomfield's HOA communities, corporate campuses, and neighborhoods. From Anthem to the tech corridor, our crews have moved in every part of Broomfield and understand what each area requires.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Flexible Scheduling</h3>
              <p class="text-muted-foreground">
                Same-day and next-day moves available. We accommodate HOA time windows and building restrictions without making you jump through hoops. Weekend and evening moves available.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                Clear, upfront quotes. No hidden fees, no fuel surcharges not disclosed in your original estimate. Licensed and fully insured — DOT #3462023, MC #1189363, PUC #HHG-00682.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our Broomfield moving specialists are standing by — call or fill out our quick quote form and we'll respond promptly.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
