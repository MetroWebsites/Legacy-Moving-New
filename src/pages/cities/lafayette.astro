---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/truck-in-driveway-legacy-moving-denver_nw_b9c9f7fe.jpeg';

const cityName = "Lafayette";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Lafayette Moving Company | Professional Movers in Lafayette, CO
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Moving to or from Lafayette? Legacy Moving provides professional, careful moving services throughout Lafayette and Boulder County. From Old Town Lafayette and Coal Creek Ranch to Waneka Lake and Indian Peaks, our crews handle every move with professionalism and honest pricing. Licensed, insured, and trusted — call for your free quote today.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Complete Moving Services in {cityName}
          </h2>
          <p class="text-muted-foreground text-lg">
            From Lafayette's charming Old Town neighborhoods to newer developments near US-287, we handle every move with expertise and local knowledge.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Local Moving</h3>
            <p class="text-muted-foreground">
              Efficient local moves within Lafayette and throughout Boulder County. We connect Lafayette to Louisville, Boulder, Longmont, Erie, and Broomfield without long-distance rates.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Long Distance</h3>
            <p class="text-muted-foreground">
              Interstate moving from Lafayette to anywhere in the US. We handle the complete long-distance process — packing, loading, transport coordination, and delivery.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Packing Services</h3>
            <p class="text-muted-foreground">
              Full-service packing for your Lafayette home. We supply all materials and handle everything with professional care — from delicate items to heavy furniture.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Loading & Unloading</h3>
            <p class="text-muted-foreground">
              Labor-only services for Lafayette residents using their own truck or container. We load efficiently and protect your belongings throughout the process.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Commercial Moving</h3>
            <p class="text-muted-foreground">
              Office and business relocation in Lafayette and Boulder County. We schedule around your operations to keep business disruption minimal during your move.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Storage Solutions</h3>
            <p class="text-muted-foreground">
              Flexible storage for Lafayette residents in transition. We bridge gaps between your old and new home with secure, short and long-term storage options.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Know About Moving in Lafayette -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          What to Know Before Moving in Lafayette
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground">
          <p class="mb-4">
            Lafayette is one of Boulder County's most beloved small cities — a place with a genuine local character, an arts-forward community, and housing that's still more accessible than Boulder proper. Located between Boulder and Longmont along the US-287 corridor, Lafayette attracts people from all over the metro who want proximity to Boulder's cultural offerings without Boulder's price tag. Old Town Lafayette in particular has developed into one of the most vibrant small downtown areas in the state.
          </p>
          <p class="mb-4">
            Old Town Lafayette is a mix of older bungalows, mid-century homes, and some newer infill development. The streets are relatively narrow, with limited parking for large moving trucks in the core neighborhoods. Moving in Old Town requires planning for truck positioning — our crews are used to working in tight urban residential areas. In some cases, we may need to position the truck on the street and use a walkway longer than typical. Tell us your address during the quote process and we'll plan accordingly.
          </p>
          <p class="mb-4">
            The newer developments on Lafayette's perimeter — Coal Creek Ranch, Waneka Lake area, Indian Peaks — are a mix of HOA and non-HOA communities. Coal Creek Ranch has an active HOA that requires advance notification for moves. Indian Peaks is another established community with HOA governance. If you're moving into any of Lafayette's planned communities, contact the HOA management company to understand the requirements before scheduling.
          </p>
          <p class="mb-4">
            Lafayette is also home to a substantial apartment and townhome market, particularly along the US-287 corridor. Apartment moves in Lafayette follow the standard managed-property protocol — notify the property manager in advance, confirm access to elevators or stairwells, and reserve any designated move parking. We handle apartment moves frequently in Lafayette and throughout Boulder County.
          </p>
          <p>
            Lafayette is about 45–50 minutes from our Lakewood base. We regularly serve it alongside neighboring <a href="/cities/erie" class="text-primary hover:underline">Erie</a>, <a href="/cities/longmont" class="text-primary hover:underline">Longmont</a>, <a href="/cities/broomfield" class="text-primary hover:underline">Broomfield</a>, and <a href="/cities/westminster" class="text-primary hover:underline">Westminster</a>. All are within our standard service area.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Apartment & HOA Moving Tips -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary text-center">
          Apartment Moves, HOA Rules & Local Tips for Lafayette
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Old Town & Older Neighborhoods</h3>
            <p class="text-muted-foreground mb-3">Old Town Lafayette has character-filled homes on narrower streets. Moving here requires planning for truck access. There are typically no HOA restrictions in older Lafayette, but street parking coordination is important.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Tell us your address — we'll assess access ahead of time</li>
              <li>✓ We plan truck positioning for narrow residential streets</li>
              <li>✓ Crews work efficiently to minimize street disruption</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">HOA Community Requirements</h3>
            <p class="text-muted-foreground mb-3">Coal Creek Ranch and Indian Peaks have active HOA governance. Advance notification is required, and move-hour restrictions are standard in these communities.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Contact HOA management 7–14 days before your move</li>
              <li>✓ Confirm truck access routes and move-hour windows</li>
              <li>✓ Surface protection included at all HOA community moves</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Lafayette Neighborhoods We Serve</h3>
            <p class="text-muted-foreground">We move clients throughout Lafayette including Old Town, Coal Creek Ranch, Indian Peaks, Waneka Lake, Tanglewood, the US-287 corridor apartments, and newer developments on the city's east side. All are within our Boulder County service area.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Boulder-Area Overflow Moves</h3>
            <p class="text-muted-foreground">Lafayette is a major destination for people relocating from Boulder who want more space and lower prices while staying close to the Boulder lifestyle. We handle Boulder-to-Lafayette moves regularly — the distance is short and the logistics are simple. No long-distance rates apply.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            Professional movers trusted throughout Boulder County and the northern Front Range.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                Denver metro's highest-rated moving company. Lafayette clients appreciate our care with older homes, our knowledge of Boulder County communities, and our honest approach.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Boulder County Coverage</h3>
              <p class="text-muted-foreground">
                We know Lafayette's neighborhoods from Old Town to Coal Creek Ranch to the US-287 corridor. We've handled every access type and HOA situation in the area.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Reliable, On-Time Crews</h3>
              <p class="text-muted-foreground">
                Travel time is built into our scheduling. Your crew arrives when expected, ready to work efficiently from the start of your move window.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                We quote Lafayette moves based on your actual home and services. No inflated rates for Boulder County distance. Licensed, insured, and upfront about everything.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nearby Cities -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="font-display font-bold text-2xl md:text-3xl mb-6 text-secondary">Also Serving Nearby Cities</h2>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/cities/erie" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Erie</a>
          <a href="/cities/longmont" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Longmont</a>
          <a href="/cities/broomfield" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Broomfield</a>
          <a href="/cities/westminster" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Westminster</a>
          <a href="/cities/frederick" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Frederick</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our Lafayette moving specialists know Boulder County and are ready to plan your move from start to finish.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
