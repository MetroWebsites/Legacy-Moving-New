---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/services/hero.jpg';

const cityName = "Lakewood";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Lakewood Moving Company | Local Movers & Storage Solutions
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Searching for movers in Lakewood? You've found the right team! Legacy Moving is based right here in Lakewood, offering local moving services, packing help, and secure storage solutions. As your neighbor and top-rated Lakewood moving company, we know the area inside and out. Get your free estimate today and experience the Legacy difference.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why We're Based in Lakewood -->
  <section class="py-14 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          Why We Call Lakewood Home
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground">
          <p class="mb-4">
            We didn't just choose Lakewood randomly for our headquarters—we chose it because it's the perfect hub to serve the entire Denver metro area. Our facility at 8805 W. 14th Ave puts us within 20 minutes of anywhere in the metro during normal traffic.
          </p>
          <p class="mb-4">
            But it's more than logistics. Lakewood has that perfect balance: close to downtown Denver but with a real community feel. When we're not helping families move, our crew grabs lunch at Casa Bonita (yes, really), hikes Green Mountain on weekends, and shops at Belmar.
          </p>
          <p>
            Being local means we know which Lakewood apartment complexes have narrow hallways, which buildings require move-in reservations, and which streets get congested on Broncos game days. That local knowledge saves our customers time and stress on moving day.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Storage + Moving Combo -->
  <section class="py-14 bg-secondary/5">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary text-center">
          Moving + Storage: We Make it Seamless
        </h2>
        <p class="text-center text-muted-foreground mb-10">
          Our Lakewood storage facility means we can coordinate your move and storage in one trip
        </p>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-md">
            <div class="text-4xl font-bold text-primary mb-3">1</div>
            <h3 class="font-bold text-xl mb-2 text-secondary">We Pack & Load</h3>
            <p class="text-muted-foreground">
              Our crew loads everything from your Lakewood home or apartment into our truck, just like a regular move.
            </p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <div class="text-4xl font-bold text-primary mb-3">2</div>
            <h3 class="font-bold text-xl mb-2 text-secondary">Store at Our Facility</h3>
            <p class="text-muted-foreground">
              We drive your belongings directly to our secure Lakewood storage facility—no extra handling or transfers.
            </p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <div class="text-4xl font-bold text-primary mb-3">3</div>
            <h3 class="font-bold text-xl mb-2 text-secondary">Deliver When Ready</h3>
            <p class="text-muted-foreground">
              When you're ready, we load up and deliver to your new place. One company, one smooth process.
            </p>
          </div>
        </div>
        <div class="mt-8 text-center">
          <p class="text-muted-foreground mb-4">
            <strong>Popular combo:</strong> Month-to-month storage + two moves (in and out) from $599
          </p>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary text-white hover:bg-primary' })}>
            Ask About Storage Options
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            We've built our reputation in {cityName} on reliability, professionalism, and exceptional customer service.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                {cityName}'s highest-rated moving company with verified reviews across Google, Yelp, and Facebook.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Local {cityName} Experts</h3>
              <p class="text-muted-foreground">
                We know {cityName} neighborhoods, buildings, and logistics. Serving the Denver metro since 2018.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Flexible Scheduling</h3>
              <p class="text-muted-foreground">
                Same-day and next-day moves available in {cityName}. We work around your schedule, including weekends.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                Clear, upfront quotes for {cityName} moves. No hidden fees, no surprises. Licensed and fully insured.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area Info -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          Serving All {cityName} Neighborhoods
        </h2>
        <p class="text-muted-foreground text-lg mb-8">
          Whether you're moving to Belmar, Green Mountain, West Colfax, Bear Creek, or any other {cityName} neighborhood, our experienced movers know the area and can navigate any challenge. We provide the same exceptional service to every {cityName} resident.
        </p>
        <a href="/service-area" class={buttonVariants({ className: 'bg-secondary text-white hover:bg-primary' })}>
          View All Service Areas
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our {cityName} moving specialists are standing by to help plan your perfect move.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
