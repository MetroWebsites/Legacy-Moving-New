---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/img_4115-legacy-moving-denver_nw_2e617951.jpeg';

const cityName = "Highlands Ranch";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Highlands Ranch Moving Company | Professional Movers
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Moving to or from Highlands Ranch? Legacy Moving specializes in Highlands Ranch relocations, including large homes, townhomes, and condos. Our Highlands Ranch movers provide white-glove service with careful handling of your valuables. Fully insured, background-checked crews, and no surprise fees. Schedule your Highlands Ranch move today!
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- White Glove Service for Highlands Ranch Homes -->
  <section class="py-14 bg-gradient-to-br from-purple-50 to-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary text-center">
          White-Glove Service for Your Highlands Ranch Home
        </h2>
        <p class="text-center text-muted-foreground mb-10">
          Highlands Ranch homes deserve special care. Here's our premium approach:
        </p>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
          <div class="bg-white p-6 rounded-lg shadow-md text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <span class="text-3xl">🧤</span>
            </div>
            <h3 class="font-bold text-lg mb-2 text-secondary">Protective Gear</h3>
            <p class="text-sm text-muted-foreground">
              Floor runners, door jam protectors, and furniture pads on everything
            </p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <span class="text-3xl">📦</span>
            </div>
            <h3 class="font-bold text-lg mb-2 text-secondary">Custom Crating</h3>
            <p class="text-sm text-muted-foreground">
              Artwork, chandeliers, and fragile items get custom wood crates
            </p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <span class="text-3xl">✓</span>
            </div>
            <h3 class="font-bold text-lg mb-2 text-secondary">Room-by-Room</h3>
            <p class="text-sm text-muted-foreground">
              Items labeled by room for organized unpacking at your new home
            </p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
              <span class="text-3xl">🔧</span>
            </div>
            <h3 class="font-bold text-lg mb-2 text-secondary">Reassembly</h3>
            <p class="text-sm text-muted-foreground">
              Beds, furniture, and fixtures put back together exactly as they were
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Specialty Items We Handle -->
  <section class="py-14 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary text-center">
          Specialty Items? No Problem.
        </h2>
        <p class="text-center text-muted-foreground mb-8">
          We've moved some interesting things out of Highlands Ranch homes:
        </p>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-gray-50 p-5 rounded-lg">
            <h3 class="font-semibold text-lg text-secondary mb-3">🎹 Pianos & Organs</h3>
            <p class="text-muted-foreground text-sm">
              Grand pianos, baby grands, uprights—we have the equipment and expertise. Climate-controlled transport for high-value instruments.
            </p>
          </div>
          <div class="bg-gray-50 p-5 rounded-lg">
            <h3 class="font-semibold text-lg text-secondary mb-3">🖼️ Fine Art & Antiques</h3>
            <p class="text-muted-foreground text-sm">
              Custom crating for paintings, sculptures, and collectibles. Insurance documentation and white-glove handling throughout.
            </p>
          </div>
          <div class="bg-gray-50 p-5 rounded-lg">
            <h3 class="font-semibold text-lg text-secondary mb-3">🏋️ Home Gyms & Safes</h3>
            <p class="text-muted-foreground text-sm">
              Heavy items up to 1,000 lbs. Treadmills, Pelotons, weight equipment, and safes moved with specialized dollies and extra crew.
            </p>
          </div>
          <div class="bg-gray-50 p-5 rounded-lg">
            <h3 class="font-semibold text-lg text-secondary mb-3">💎 Wine Collections & China</h3>
            <p class="text-muted-foreground text-sm">
              Cell packs for wine bottles, dish barrel boxes for china. Temperature considerations for valuable wine cellars.
            </p>
          </div>
        </div>
        <div class="mt-8 text-center">
          <p class="text-muted-foreground mb-4">
            Have something unique? Call us—we've probably moved it before.
          </p>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary text-white hover:bg-primary' })}>
            Discuss Your Specialty Items
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            We've built our reputation in {cityName} on reliability, professionalism, and exceptional customer service.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                {cityName}'s highest-rated moving company with verified reviews across Google, Yelp, and Facebook.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Local {cityName} Experts</h3>
              <p class="text-muted-foreground">
                We know {cityName} neighborhoods, buildings, and logistics. Serving the Denver metro since 2018.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Flexible Scheduling</h3>
              <p class="text-muted-foreground">
                Same-day and next-day moves available in {cityName}. We work around your schedule, including weekends.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                Clear, upfront quotes for {cityName} moves. No hidden fees, no surprises. Licensed and fully insured.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area Info -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          Serving All {cityName} Neighborhoods
        </h2>
        <p class="text-muted-foreground text-lg mb-8">
          Whether you're moving to Backcountry, Northridge, Westridge, Southridge, or any other {cityName} neighborhood, our experienced movers know the area and can navigate any challenge. We provide the same exceptional service to every {cityName} resident.
        </p>
        <a href="/service-area" class={buttonVariants({ className: 'bg-secondary text-white hover:bg-primary' })}>
          View All Service Areas
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our {cityName} moving specialists are standing by to help plan your perfect move.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
