---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/truck-in-driveway-legacy-moving-denver_nw_b9c9f7fe.jpeg';

const cityName = "Lone Tree";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Lone Tree Moving Company | Professional Movers in Lone Tree, CO
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Moving to or from Lone Tree? Legacy Moving provides professional, careful moving services throughout Lone Tree and the south Denver metro. From RidgeGate and Carriage Club to Lincoln Station and Heritage Hills, our crews handle every move with professionalism and honest pricing. Licensed, insured, and trusted — call for your free quote today.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Complete Moving Services in {cityName}
          </h2>
          <p class="text-muted-foreground text-lg">
            From high-rise condos at RidgeGate to large single-family homes in Heritage Hills, we handle every Lone Tree move with expert local knowledge.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Local Moving</h3>
            <p class="text-muted-foreground">
              Efficient local moves within {cityName} and throughout the south Denver metro. We serve moves along the RidgeGate Parkway corridor, Lincoln Station area, and connections to Greenwood Village, Centennial, and Highlands Ranch.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Long Distance</h3>
            <p class="text-muted-foreground">
              Interstate moving from Lone Tree to anywhere in the US. Lone Tree's tech and corporate presence means we regularly handle executive relocations and corporate transferees.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Packing Services</h3>
            <p class="text-muted-foreground">
              Full-service packing for your Lone Tree home or condo. We handle fragile items, fine art, and specialty pieces with appropriate materials and professional care.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Loading & Unloading</h3>
            <p class="text-muted-foreground">
              Labor-only services for Lone Tree residents using their own truck or a POD. We load efficiently and methodically, protecting your belongings for the road.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Commercial Moving</h3>
            <p class="text-muted-foreground">
              Office and business relocation in Lone Tree's corporate campuses and the Lincoln Station business district. We coordinate around your schedule to minimize operational downtime.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Storage Solutions</h3>
            <p class="text-muted-foreground">
              Secure storage for Lone Tree residents during your transition. Whether you're waiting on a closing date or need temporary storage between homes, we have flexible options.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Know About Moving in Lone Tree -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          What to Know Before Moving in Lone Tree
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground">
          <p class="mb-4">
            Lone Tree is a small city with a very high median household income, a polished urban village in RidgeGate, and some of the best-maintained HOA communities in the south Denver metro. It's home to the Denver Tech Center's southern edge, major employers like Charles Schwab and Sky Ridge Medical Center, and a growing residential population that has doubled over the past decade. Lone Tree moves are among our most frequent in the south corridor — we know the area well.
          </p>
          <p class="mb-4">
            RidgeGate is Lone Tree's signature mixed-use development — a walkable urban district with luxury apartments, condos, and townhomes alongside office towers, shops, and the Sky Ridge light rail station. Moving into a RidgeGate residential building requires elevator reservations, HOA coordination, and often a certificate of insurance on file with building management. Contact your building's management office at least two weeks before move day to secure an elevator time window and understand the specific rules for your building.
          </p>
          <p class="mb-4">
            Heritage Hills is Lone Tree's most prominent upscale neighborhood — a large master-planned community with its own HOA that governs landscaping, exterior appearance, and move-in protocols. Heritage Hills HOA requires advance notification for moves and has designated procedures for moving trucks. If you're moving into Heritage Hills, check with the HOA management company for your specific sub-community's requirements.
          </p>
          <p class="mb-4">
            Carriage Club is another prominent Lone Tree community with active HOA governance. Like Heritage Hills, Carriage Club requires advance move notification and has truck parking restrictions in certain areas. The streets in Carriage Club are relatively wide but the neighborhood is quiet and residential — our crews are respectful of that.
          </p>
          <p>
            Lincoln Station, the mixed-use development around the Lincoln light rail station, has its own residential component with managed buildings. Moves in Lincoln Station should follow the same managed-building protocol — elevator reservation, move time window, COI on file. Lone Tree is about 30–35 minutes from our Lakewood base, and we serve it regularly alongside neighboring <a href="/cities/greenwood-village" class="text-primary hover:underline">Greenwood Village</a>, <a href="/cities/centennial" class="text-primary hover:underline">Centennial</a>, <a href="/cities/castle-pines" class="text-primary hover:underline">Castle Pines</a>, and <a href="/cities/highlands-ranch" class="text-primary hover:underline">Highlands Ranch</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Apartment & HOA Moving Tips -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary text-center">
          Apartment Moves, HOA Rules & Local Tips for Lone Tree
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">RidgeGate Building Requirements</h3>
            <p class="text-muted-foreground mb-3">Moving into any RidgeGate residential building requires pre-coordination with the management office. Elevator reservations, COI requirements, and truck access rules apply at most buildings.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Reserve elevator at least 1–2 weeks in advance</li>
              <li>✓ Certificate of insurance required at most managed buildings</li>
              <li>✓ We provide COI documentation to building managers</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Heritage Hills & Carriage Club HOA</h3>
            <p class="text-muted-foreground mb-3">Lone Tree's premier single-family communities require advance notification to HOA management. Most have designated move hours and may require a damage deposit for common areas.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Contact HOA management 1–2 weeks before your move</li>
              <li>✓ Confirm truck parking and access route with HOA</li>
              <li>✓ Move hours typically 8am–6pm in managed communities</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Lone Tree Neighborhoods We Serve</h3>
            <p class="text-muted-foreground">We regularly move clients throughout Lone Tree including RidgeGate, Heritage Hills, Carriage Club, Lincoln Station, Schweiger Ranch, and the communities along I-25 and Lincoln Avenue. All are within our standard service area.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Corporate & Executive Relocation</h3>
            <p class="text-muted-foreground">Lone Tree's corporate campus concentration means we regularly handle executive relocations and corporate transferees. We work with HR departments and relocation coordinators to ensure smooth transitions for employees and their families.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            We've built our reputation across the Denver metro south corridor on reliability, professionalism, and honest pricing.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                Denver metro's highest-rated moving company with verified reviews on Google, Yelp, and Facebook. Lone Tree clients highlight our professionalism in managed buildings and HOA communities.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">South Denver Corridor Experts</h3>
              <p class="text-muted-foreground">
                We know every HOA protocol, managed building requirement, and access rule throughout Lone Tree, Greenwood Village, Centennial, and Highlands Ranch.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">On-Time, On-Budget</h3>
              <p class="text-muted-foreground">
                HOA and managed-building moves have strict time windows. We schedule your crew to arrive early and complete within your reserved window without rushing or cutting corners.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                We quote Lone Tree moves based on your actual home, access, and services — no hidden fees. Licensed and fully insured with proper documentation for managed buildings.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nearby Cities -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="font-display font-bold text-2xl md:text-3xl mb-6 text-secondary">Also Serving Nearby Cities</h2>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/cities/castle-pines" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Castle Pines</a>
          <a href="/cities/greenwood-village" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Greenwood Village</a>
          <a href="/cities/centennial" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Centennial</a>
          <a href="/cities/highlands-ranch" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Highlands Ranch</a>
          <a href="/cities/parker" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Parker</a>
          <a href="/cities/castle-rock" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Castle Rock</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our Lone Tree moving specialists understand managed building requirements, HOA rules, and the local area inside and out.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
