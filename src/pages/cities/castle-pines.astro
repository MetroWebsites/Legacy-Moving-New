---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/truck-in-driveway-legacy-moving-denver_nw_b9c9f7fe.jpeg';

const cityName = "Castle Pines";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Castle Pines Moving Company | Professional Movers in Castle Pines, CO
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Moving to or from Castle Pines? Legacy Moving provides professional, careful moving services throughout Castle Pines and the south Denver metro. From the Village at Castle Pines to Castle Pines North, our crews handle every move with professionalism and honest pricing. Licensed, insured, and trusted — call for your free quote today.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Complete Moving Services in {cityName}
          </h2>
          <p class="text-muted-foreground text-lg">
            From upscale single-family homes to townhomes in Castle Pines North, we handle every move with professional care and local expertise.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Local Moving</h3>
            <p class="text-muted-foreground">
              Efficient local moves within {cityName} and throughout the south Denver metro. We service moves to and from Castle Pines, Lone Tree, Parker, and Castle Rock without long-distance rates.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Long Distance</h3>
            <p class="text-muted-foreground">
              Interstate moving from Castle Pines to anywhere in the US. Many Castle Pines residents are relocating in or out of state — we make the process seamless and stress-free.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Packing Services</h3>
            <p class="text-muted-foreground">
              Full-service packing for your Castle Pines home. We handle fragile items, fine art, wine collections, and specialty pieces with appropriate materials and professional care.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Loading & Unloading</h3>
            <p class="text-muted-foreground">
              Labor-only services for Castle Pines residents who've rented their own truck or arranged a POD. We load methodically to protect your belongings and use every inch of space efficiently.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Commercial Moving</h3>
            <p class="text-muted-foreground">
              Office and business relocation in Castle Pines and the surrounding corridor. We coordinate commercial moves with minimal disruption to your business operations.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Storage Solutions</h3>
            <p class="text-muted-foreground">
              Secure storage for Castle Pines residents during your transition. Whether you're waiting on a new build or bridging between close dates, we have flexible storage options.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Know About Moving in Castle Pines -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          What to Know Before Moving in Castle Pines
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground">
          <p class="mb-4">
            Castle Pines is one of Colorado's most exclusive residential communities — a place where large custom homes sit on wooded lots and the pace of life feels deliberately slower than the rest of the Denver metro. The city incorporated in 2008 and has maintained a distinctly residential character with no commercial strip development. If you're moving here, you're likely coming from a larger city and looking for a quieter, more spacious lifestyle along Colorado's Front Range.
          </p>
          <p class="mb-4">
            The Village at Castle Pines is a private, gated community with its own moving protocols. Moving into The Village requires advance coordination with the security and HOA office — you'll typically need to register your moving company and provide proof of insurance before your crew is permitted entry. We carry the appropriate insurance documentation and are familiar with the check-in process at gated communities throughout the south Denver corridor.
          </p>
          <p class="mb-4">
            Castle Pines North, which is the non-gated area of Castle Pines, is governed by a separate HOA — the Castle Pines North Metropolitan District and associated community associations. These communities still require advance notification for moves, designated truck parking, and typically set move-hour windows of 8am–6pm. The neighborhoods are quieter and the streets are residential, so large moving trucks need thoughtful positioning to avoid blocking traffic or damaging landscaping.
          </p>
          <p class="mb-4">
            Access and driveway logistics matter in Castle Pines more than in most places. Homes here often have long driveways, significant grades, or narrow approaches through mature trees. When you request a quote, tell us about your driveway situation so we can select the right equipment and crew size. In some cases, a smaller shuttle truck is needed to access the home before transferring to a full-size moving truck for the road.
          </p>
          <p>
            Castle Pines is about 35–40 minutes from our base in Lakewood depending on traffic and time of day. That travel time is factored into our scheduling transparently — it doesn't inflate your hourly rate once the crew arrives and begins working. We schedule our Castle Pines crews to arrive early so your move starts and finishes on time. For moves between Castle Pines and neighboring communities like <a href="/cities/castle-rock" class="text-primary hover:underline">Castle Rock</a>, <a href="/cities/lone-tree" class="text-primary hover:underline">Lone Tree</a>, or <a href="/cities/parker" class="text-primary hover:underline">Parker</a>, we operate within the same service area without additional premiums.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Apartment & HOA Moving Tips -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary text-center">
          Gated Communities, HOA Rules & Local Tips for Castle Pines Moves
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">The Village at Castle Pines</h3>
            <p class="text-muted-foreground mb-3">Moving into The Village requires prior registration with security and HOA management. Moving companies must provide proof of insurance and receive gate access approval before move day. We handle this process routinely.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Register your movers with Village security in advance</li>
              <li>✓ Proof of moving company insurance required at gate</li>
              <li>✓ We carry and provide all documentation needed</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Castle Pines North HOA Communities</h3>
            <p class="text-muted-foreground mb-3">The non-gated communities in Castle Pines North still have active HOA governance. Most require advance move notification and set time windows for moving activity.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Most HOAs require 7–14 days advance notice</li>
              <li>✓ Move hours typically 8am–6pm in managed communities</li>
              <li>✓ We protect driveways, floors, and entryways as standard</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Castle Pines Neighborhoods We Serve</h3>
            <p class="text-muted-foreground">We move clients throughout Castle Pines including The Village at Castle Pines, Castle Pines North, the Timber Canyon area, and new developments near I-25. All are within our regular south Denver service area with no additional premiums.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Specialty Home Moves</h3>
            <p class="text-muted-foreground">Castle Pines has a significant concentration of custom homes with wine cellars, home theaters, and high-end furnishings. We're experienced with white-glove packing and handling for fine art, antiques, and custom furniture. Ask about our specialty item handling when you request a quote.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            We've earned the trust of Denver metro and south corridor residents through reliability, professionalism, and transparent pricing.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                Denver metro's highest-rated moving company with verified reviews on Google, Yelp, and Facebook. Castle Pines clients note our careful handling of high-value homes and belongings.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">South Denver Corridor Experts</h3>
              <p class="text-muted-foreground">
                We know the gated community protocols, custom home challenges, and HOA rules throughout Castle Pines, Lone Tree, Greenwood Village, and the south I-25 corridor.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">We Navigate Gated Access</h3>
              <p class="text-muted-foreground">
                Gated communities require advance coordination and proper documentation. We handle all pre-move communication with security offices and management companies so there are no surprises on move day.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                We quote Castle Pines moves based on your actual home, access logistics, and services — not a padded hourly rate. Licensed, fully insured, and upfront about every cost.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nearby Cities -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="font-display font-bold text-2xl md:text-3xl mb-6 text-secondary">Also Serving Nearby Cities</h2>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/cities/castle-rock" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Castle Rock</a>
          <a href="/cities/lone-tree" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Lone Tree</a>
          <a href="/cities/parker" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Parker</a>
          <a href="/cities/greenwood-village" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Greenwood Village</a>
          <a href="/cities/highlands-ranch" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Highlands Ranch</a>
          <a href="/cities/centennial" class="bg-white border border-gray-200 rounded-full px-5 py-2 text-sm font-medium text-secondary hover:bg-primary hover:text-white hover:border-primary transition-colors">Centennial</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our Castle Pines moving specialists understand gated community requirements and are ready to plan your smooth, professional move.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
