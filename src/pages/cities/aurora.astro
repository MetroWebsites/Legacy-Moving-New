---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/308748956_459885262825080_6269738357866645302_n_nw_0489b96e.jpg';

const cityName = "Aurora";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Aurora Movers | Affordable Moving Company in Aurora, CO
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Need movers in Aurora, Colorado? Legacy Moving specializes in Aurora residential and commercial moves with transparent pricing and no hidden fees. Serving all Aurora neighborhoods from Southlands to Stapleton, we're your trusted Aurora moving company with same-day availability and professional crews. Call now for a free moving quote!
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Transparency Section -->
  <section class="py-14 bg-gradient-to-br from-primary/5 to-secondary/5">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary text-center">
          Transparent Pricing for Aurora Moves
        </h2>
        <p class="text-center text-muted-foreground mb-10 text-lg">
          We believe moving shouldn't come with surprises. Here's our commitment to Aurora customers:
        </p>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-sm">
            <h3 class="font-bold text-xl mb-3 text-secondary">What's Included</h3>
            <ul class="space-y-2 text-muted-foreground">
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Professional moving crew</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Fully-equipped moving truck with fuel</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Basic tools, dollies, and equipment</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Floor and door frame protection</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Furniture disassembly/reassembly</span>
              </li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm">
            <h3 class="font-bold text-xl mb-3 text-secondary">Our Commitment</h3>
            <ul class="space-y-2 text-muted-foreground">
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Upfront quotes with no surprises</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Clear explanation of all costs</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Licensed and fully insured</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Transparent pricing policy</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Free, no-obligation estimates</span>
              </li>
            </ul>
          </div>
        </div>
        <div class="mt-8 text-center">
          <p class="text-muted-foreground mb-4">
            Every Aurora move is unique. Contact us for a personalized quote based on your specific needs.
          </p>
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-secondary text-white hover:bg-primary' })}>
            Get Your Free Quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular Aurora Routes -->
  <section class="py-12 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary text-center">
          Common Aurora Moving Routes
        </h2>
        <p class="text-center text-muted-foreground mb-10">
          We handle these Aurora moves regularly:
        </p>
        <div class="space-y-3">
          <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg hover:bg-primary/5 transition-colors">
            <div>
              <p class="font-semibold text-secondary">Southlands → Downtown Denver</p>
              <p class="text-sm text-muted-foreground">Popular neighborhood to city center route</p>
            </div>
            <span class="text-primary font-bold">→</span>
          </div>
          <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg hover:bg-primary/5 transition-colors">
            <div>
              <p class="font-semibold text-secondary">Stapleton → Aurora City Center</p>
              <p class="text-sm text-muted-foreground">Quick local Aurora move</p>
            </div>
            <span class="text-primary font-bold">→</span>
          </div>
          <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg hover:bg-primary/5 transition-colors">
            <div>
              <p class="font-semibold text-secondary">Seven Hills → Parker</p>
              <p class="text-sm text-muted-foreground">South Aurora to neighboring community</p>
            </div>
            <span class="text-primary font-bold">→</span>
          </div>
          <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg hover:bg-primary/5 transition-colors">
            <div>
              <p class="font-semibold text-secondary">Aurora Apartment → Colorado Springs</p>
              <p class="text-sm text-muted-foreground">Long-distance • Call for quote</p>
            </div>
            <span class="text-primary font-bold">→</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            We've built our reputation in {cityName} on reliability, professionalism, and exceptional customer service.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                {cityName}'s highest-rated moving company with verified reviews across Google, Yelp, and Facebook.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Local {cityName} Experts</h3>
              <p class="text-muted-foreground">
                We know {cityName} neighborhoods, buildings, and logistics. Serving the Denver metro since 2018.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Flexible Scheduling</h3>
              <p class="text-muted-foreground">
                Same-day and next-day moves available in {cityName}. We work around your schedule, including weekends.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                Clear, upfront quotes for {cityName} moves. No hidden fees, no surprises. Licensed and fully insured.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Know About Moving in Aurora -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          What to Know Before Moving in Aurora
        </h2>
        <div class="prose prose-lg max-w-none text-muted-foreground">
          <p class="mb-4">
            Aurora is the third-largest city in Colorado and one of the most geographically and demographically diverse places in the Denver metro. Moves in Aurora can range from small studio apartments near Fitzsimons to large 5-bedroom homes in the Tallyn's Reach area southeast of E-470 — and the logistics are very different depending on which part of Aurora you're dealing with.
          </p>
          <p class="mb-4">
            Apartment moves in Aurora are common, particularly near the Aurora Metro Center and the Iliff light rail stations along the University of Colorado Anschutz Medical Campus corridor. These buildings vary in their requirements — some have formal move-in scheduling systems with designated elevator windows, others are more casual — but in any case, contacting your building management before move day is always the right call.
          </p>
          <p class="mb-4">
            The Southlands area and communities east of E-470 are newer planned developments with HOA governance. These neighborhoods typically have wide streets, good truck access, and clear move-in protocols. HOA rules there often require advance move registration and specify which areas of the community can be used for truck parking and staging.
          </p>
          <p>
            One thing we see a lot in Aurora: military and medical community moves. With Buckley Space Force Base and the Anschutz Medical Campus both driving significant relocation activity, we're accustomed to helping people move on tight timelines. If you're relocating for work or a PCS assignment, we'll work with your timeline and keep things simple.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Apartment & HOA Moving Tips -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary text-center">
          Apartment Moves, HOA Rules & Local Tips for Aurora
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Apartment Complex Coordination</h3>
            <p class="text-muted-foreground mb-3">Aurora's managed apartment communities near the light rail and Anschutz area often require scheduled moves, elevator time slots, and insurance documentation. We provide everything your building needs from us and work within your time window.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Schedule with your complex at least 5–7 days in advance</li>
              <li>✓ Request our COI/insurance certificate if your building requires it</li>
              <li>✓ Confirm any move-in fees or elevator deposits upfront</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">HOA-Governed Aurora Neighborhoods</h3>
            <p class="text-muted-foreground mb-3">Tallyn's Reach, Saddle Rock, Southlands, and other east Aurora planned communities have HOA rules about truck parking, move timing, and protecting community surfaces. We're familiar with the standard protocols.</p>
            <ul class="space-y-1 text-sm text-muted-foreground">
              <li>✓ Contact your HOA 7–10 days before your scheduled move</li>
              <li>✓ We protect driveways and common surfaces as standard</li>
              <li>✓ No Aurora city street parking permits required in most cases</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Aurora Neighborhoods We Serve</h3>
            <p class="text-muted-foreground">We move clients across Aurora including Tallyn's Reach, Southlands, Saddle Rock, Fitzsimons, Stapleton-adjacent communities, The Landmark, Mission Viejo, and the Anschutz/Colfax corridor. We know Aurora's wide geography well.</p>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-bold text-xl mb-3 text-secondary">Military & Medical Moves in Aurora</h3>
            <p class="text-muted-foreground">Moving to or from Buckley Space Force Base, or relocating for work at Anschutz? We handle PCS moves and medical campus relocations regularly. We work fast, stay organized, and understand tight relocation timelines. Just tell us what you're working with and we'll build a plan.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area Info -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          Serving All {cityName} Neighborhoods
        </h2>
        <p class="text-muted-foreground text-lg mb-8">
          Whether you're moving to Tallyn's Reach, Southlands, Stapleton, The Landmark, Saddle Rock, or any other {cityName} neighborhood, our experienced movers know Aurora and can handle every type of move it presents. We serve the full geographic range of Aurora with the same professionalism.
        </p>
        <a href="/service-area" class={buttonVariants({ className: 'bg-secondary text-white hover:bg-primary' })}>
          View All Service Areas
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our {cityName} moving specialists are standing by to help plan your perfect move.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
