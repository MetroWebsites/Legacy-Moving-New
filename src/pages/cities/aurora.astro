---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin, Phone, Clock, Award } from 'lucide-react';
import heroImage from '../../assets/308748956_459885262825080_6269738357866645302_n_nw_0489b96e.jpg';

const cityName = "Aurora";
const cityState = "CO";
---

<BaseLayout
  title={`Professional Movers in ${cityName}, ${cityState} | Legacy Moving Denver`}
  description={`Top-rated moving company serving ${cityName}, ${cityState}. Local & long-distance moving, packing, loading services. Licensed, insured movers with 1,700+ 5-star reviews. Call (720) 340-1849 for a free quote.`}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt={`Legacy Moving Denver truck in ${cityName}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Aurora Movers | Affordable Moving Company in Aurora, CO
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Need movers in Aurora, Colorado? Legacy Moving specializes in Aurora residential and commercial moves with transparent pricing and no hidden fees. Serving all Aurora neighborhoods from Southlands to Stapleton, we're your trusted Aurora moving company with same-day availability and professional crews. Call now for a free moving quote!
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Transparency Section -->
  <section class="py-14 bg-gradient-to-br from-primary/5 to-secondary/5">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary text-center">
          Transparent Pricing for Aurora Moves
        </h2>
        <p class="text-center text-muted-foreground mb-10 text-lg">
          We believe moving shouldn't come with surprises. Here's our commitment to Aurora customers:
        </p>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-sm">
            <h3 class="font-bold text-xl mb-3 text-secondary">What's Included</h3>
            <ul class="space-y-2 text-muted-foreground">
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Professional moving crew</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Fully-equipped moving truck with fuel</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Basic tools, dollies, and equipment</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Floor and door frame protection</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Furniture disassembly/reassembly</span>
              </li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm">
            <h3 class="font-bold text-xl mb-3 text-secondary">Our Commitment</h3>
            <ul class="space-y-2 text-muted-foreground">
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Upfront quotes with no surprises</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Clear explanation of all costs</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Licensed and fully insured</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Transparent pricing policy</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>Free, no-obligation estimates</span>
              </li>
            </ul>
          </div>
        </div>
        <div class="mt-8 text-center">
          <p class="text-muted-foreground mb-4">
            Every Aurora move is unique. Contact us for a personalized quote based on your specific needs.
          </p>
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-secondary text-white hover:bg-primary' })}>
            Get Your Free Quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular Aurora Routes -->
  <section class="py-12 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary text-center">
          Common Aurora Moving Routes
        </h2>
        <p class="text-center text-muted-foreground mb-10">
          We handle these Aurora moves regularly:
        </p>
        <div class="space-y-3">
          <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg hover:bg-primary/5 transition-colors">
            <div>
              <p class="font-semibold text-secondary">Southlands → Downtown Denver</p>
              <p class="text-sm text-muted-foreground">Popular neighborhood to city center route</p>
            </div>
            <span class="text-primary font-bold">→</span>
          </div>
          <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg hover:bg-primary/5 transition-colors">
            <div>
              <p class="font-semibold text-secondary">Stapleton → Aurora City Center</p>
              <p class="text-sm text-muted-foreground">Quick local Aurora move</p>
            </div>
            <span class="text-primary font-bold">→</span>
          </div>
          <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg hover:bg-primary/5 transition-colors">
            <div>
              <p class="font-semibold text-secondary">Seven Hills → Parker</p>
              <p class="text-sm text-muted-foreground">South Aurora to neighboring community</p>
            </div>
            <span class="text-primary font-bold">→</span>
          </div>
          <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg hover:bg-primary/5 transition-colors">
            <div>
              <p class="font-semibold text-secondary">Aurora Apartment → Colorado Springs</p>
              <p class="text-sm text-muted-foreground">Long-distance • Call for quote</p>
            </div>
            <span class="text-primary font-bold">→</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
            Why {cityName} Residents Choose Legacy Moving
          </h2>
          <p class="text-muted-foreground text-lg">
            We've built our reputation in {cityName} on reliability, professionalism, and exceptional customer service.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Award size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">1,700+ Five-Star Reviews</h3>
              <p class="text-muted-foreground">
                {cityName}'s highest-rated moving company with verified reviews across Google, Yelp, and Facebook.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <MapPin size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Local {cityName} Experts</h3>
              <p class="text-muted-foreground">
                We know {cityName} neighborhoods, buildings, and logistics. Serving the Denver metro since 2018.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Clock size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Flexible Scheduling</h3>
              <p class="text-muted-foreground">
                Same-day and next-day moves available in {cityName}. We work around your schedule, including weekends.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Phone size={24} className="text-primary" />
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2 text-secondary">Transparent Pricing</h3>
              <p class="text-muted-foreground">
                Clear, upfront quotes for {cityName} moves. No hidden fees, no surprises. Licensed and fully insured.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area Info -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
          Serving All {cityName} Neighborhoods
        </h2>
        <p class="text-muted-foreground text-lg mb-8">
          Whether you're moving to Tallyn's Reach, Southlands, Stapleton, The Landmark, Saddle Rock, or any other {cityName} neighborhood, our experienced movers know the area and can navigate any challenge. We provide the same exceptional service to every {cityName} resident.
        </p>
        <a href="/service-area" class={buttonVariants({ className: 'bg-secondary text-white hover:bg-primary' })}>
          View All Service Areas
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">
          Ready to Move in {cityName}?
        </h2>
        <p class="text-white/90 text-lg mb-8">
          Get your free moving quote today. Our {cityName} moving specialists are standing by to help plan your perfect move.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold' })}>
            Get Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold phone-link' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
