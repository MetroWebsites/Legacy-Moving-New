          </p>
          <a href="tel:7203401849" class={buttonVariants({ className: "bg-primary text-white hover:bg-secondary" })}>
            Call (720) 340-1849
          </a>
        </div>

      </div>
    </div>
  </article>

  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-2xl mb-6">Related Moving Resources</h2>
        <div class="grid md:grid-cols-3 gap-6">
