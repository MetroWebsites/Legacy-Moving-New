  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-12 md:py-16">
    <div class="absolute inset-0 opacity-20">
      <Image src={heroImage} alt="How to save money on your move in Denver Colorado" class="w-full h-full object-cover" />
    </div>
    <div class="container relative z-10">
      <div class="max-w-4xl">
        <p class="text-white/80 mb-3">June 22, 2026 • 13 min read</p>
        <h1 class="font-display font-bold text-3xl md:text-5xl mb-4">
          How to Save Money on Your Move in Denver Without Cutting Corners
        </h1>
        <p class="text-lg text-white/90">
          There's a difference between cutting costs smartly and cutting corners dangerously. Here's how to do the former — practical ways to spend less on your Denver move while actually protecting what matters.
        </p>
      </div>
