            <p class="text-sm text-muted-foreground">Request your moving estimate today</p>
          </a>
          <a href="/services/residential-moving" class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow">
            <h3 class="font-semibold text-lg mb-2 text-secondary">Residential Moving</h3>
