---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Calendar, Clock, ArrowLeft, Phone } from 'lucide-react';
import { buttonVariants } from '@/components/ui/button';
import { Image } from 'astro:assets';
import heroImage from '@/assets/services/hero.jpg';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = new Date(post.data.publishDate).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
});

// Extract TL;DR from content if it exists
const contentText = await post.body;
const tldrMatch = contentText.match(/## TL;DR\s+([\s\S]*?)(?=\n---|\n##|$)/i);
const tldrContent = tldrMatch ? tldrMatch[1].trim() : null;
---

<BaseLayout
  title={`${post.data.title} | Legacy Moving Denver Blog`}
  description={post.data.excerpt}
>
  <!-- Hero Section with Background Image -->
  <section class="relative bg-gradient-to-br from-secondary via-secondary/95 to-secondary/90 text-white py-16 md:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-15">
      <Image 
        src={heroImage} 
        alt={post.data.title}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-4xl mx-auto">
        <a href="/blog" class={buttonVariants({ variant: 'ghost', className: 'text-white hover:bg-white/10 mb-6' })}>
          <ArrowLeft size={16} className="mr-2" />
          Back to Blog
        </a>
        <div class="flex items-center gap-4 text-sm text-white/80 mb-6">
          <div class="flex items-center gap-2">
            <Calendar size={16} />
            <span>{formattedDate}</span>
          </div>
          <div class="flex items-center gap-2">
            <Clock size={16} />
            <span>{post.data.readTime || '10 min read'}</span>
          </div>
        </div>
        <h1 class="font-display font-bold text-3xl md:text-4xl lg:text-5xl mb-6 leading-tight">
          {post.data.title}
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-3xl leading-relaxed">
          {post.data.excerpt}
        </p>
      </div>
    </div>
  </section>

  <!-- TL;DR Section -->
  {tldrContent && (
    <section class="py-8 bg-gradient-to-r from-blue-50 to-indigo-50 border-b-4 border-primary">
      <div class="container">
        <div class="max-w-4xl mx-auto">
          <div class="bg-white rounded-xl shadow-lg p-6 md:p-8 border-l-4 border-primary">
            <h2 class="font-display font-bold text-2xl md:text-3xl text-secondary mb-4 flex items-center gap-3">
              <span class="bg-primary text-white px-3 py-1 rounded-md text-sm font-semibold">TL;DR</span>
              Quick Summary
            </h2>
            <p class="text-lg text-gray-700 leading-relaxed">
              {tldrContent}
            </p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Blog Content -->
  <article class="py-12 md:py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none
          prose-headings:font-display prose-headings:font-bold prose-headings:text-secondary
          prose-h2:text-3xl prose-h2:mt-16 prose-h2:mb-6 prose-h2:pb-3 prose-h2:border-b-2 prose-h2:border-gray-200
          prose-h3:text-2xl prose-h3:mt-10 prose-h3:mb-5 prose-h3:text-primary
          prose-p:text-gray-700 prose-p:leading-relaxed prose-p:mb-6 prose-p:text-[17px]
          prose-a:text-primary prose-a:font-medium prose-a:no-underline hover:prose-a:underline hover:prose-a:text-secondary
          prose-strong:text-secondary prose-strong:font-semibold
          prose-ul:my-6 prose-ul:space-y-3 prose-li:my-0 prose-li:text-gray-700
          prose-ol:my-6 prose-ol:space-y-3
          prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:pl-6 prose-blockquote:italic prose-blockquote:bg-gray-50 prose-blockquote:py-4 prose-blockquote:my-8">
          <Content />
        </div>

        <!-- Helpful Links Section -->
        <div class="mt-16 pt-12 border-t-2 border-gray-200">
          <h2 class="font-display font-bold text-2xl md:text-3xl text-secondary mb-8 text-center">Helpful Resources & Services</h2>
          <div class="grid md:grid-cols-2 gap-6">
            <!-- Services Column -->
            <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
              <h3 class="font-display font-bold text-xl text-secondary mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
                Our Services
              </h3>
              <ul class="space-y-2">
                <li><a href="/services/local-moving" class="text-primary hover:text-secondary hover:underline font-medium">Local Moving Services</a></li>
                <li><a href="/services/long-distance-moving" class="text-primary hover:text-secondary hover:underline font-medium">Long Distance Moving</a></li>
                <li><a href="/services/residential-moving" class="text-primary hover:text-secondary hover:underline font-medium">Residential Moving</a></li>
                <li><a href="/services/commercial-moving" class="text-primary hover:text-secondary hover:underline font-medium">Commercial Moving</a></li>
                <li><a href="/services/packing-services" class="text-primary hover:text-secondary hover:underline font-medium">Professional Packing Services</a></li>
                <li><a href="/services/storage-solutions" class="text-primary hover:text-secondary hover:underline font-medium">Storage Solutions</a></li>
              </ul>
            </div>

            <!-- Cities Column -->
            <div class="bg-gradient-to-br from-orange-50 to-amber-50 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
              <h3 class="font-display font-bold text-xl text-secondary mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                Areas We Serve
              </h3>
              <ul class="space-y-2">
                <li><a href="/cities/denver" class="text-primary hover:text-secondary hover:underline font-medium">Denver</a></li>
                <li><a href="/cities/aurora" class="text-primary hover:text-secondary hover:underline font-medium">Aurora</a></li>
                <li><a href="/cities/lakewood" class="text-primary hover:text-secondary hover:underline font-medium">Lakewood</a></li>
                <li><a href="/cities/arvada" class="text-primary hover:text-secondary hover:underline font-medium">Arvada</a></li>
                <li><a href="/cities/westminster" class="text-primary hover:text-secondary hover:underline font-medium">Westminster</a></li>
                <li><a href="/service-area" class="text-primary hover:text-secondary hover:underline font-medium">View All Service Areas →</a></li>
              </ul>
            </div>
          </div>

          <!-- Additional Resources -->
          <div class="mt-6 grid md:grid-cols-3 gap-4">
            <a href="/moving-tips" class="bg-white border-2 border-gray-200 hover:border-primary rounded-lg p-4 text-center transition-all hover:shadow-md">
              <span class="font-semibold text-gray-800 hover:text-primary">Moving Tips & Guides</span>
            </a>
            <a href="/discounts" class="bg-white border-2 border-gray-200 hover:border-primary rounded-lg p-4 text-center transition-all hover:shadow-md">
              <span class="font-semibold text-gray-800 hover:text-primary">Special Discounts</span>
            </a>
            <a href="/faqs" class="bg-white border-2 border-gray-200 hover:border-primary rounded-lg p-4 text-center transition-all hover:shadow-md">
              <span class="font-semibold text-gray-800 hover:text-primary">Frequently Asked Questions</span>
            </a>
          </div>
        </div>

        <!-- CTA Section -->
        <div class="mt-16 p-8 md:p-12 bg-gradient-to-br from-primary via-primary to-secondary rounded-2xl text-white text-center shadow-2xl">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4">Ready to Get Started?</h2>
          <p class="text-white/90 text-lg md:text-xl mb-8 max-w-2xl mx-auto leading-relaxed">
            Get a free, no-obligation quote from Denver's most trusted moving professionals. We're here to make your move stress-free!
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-primary hover:bg-white/90 hover:scale-105 font-bold shadow-xl transition-transform text-lg px-8 py-4' })}>
              Get Your Free Quote
            </a>
            <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'border-2 border-white text-white hover:bg-white hover:text-primary font-bold transition-all text-lg px-8 py-4' })}>
              <Phone size={20} className="mr-2" />
              (720) 340-1849
            </a>
          </div>
          <p class="mt-6 text-white/80 text-sm">
            Available Monday-Saturday, 8:00am - 6:00pm • <a href="/contact" class="underline hover:text-white">Contact Us</a>
          </p>
        </div>

        <!-- Back to Blog -->
        <div class="mt-12 text-center">
          <a href="/blog" class={buttonVariants({ variant: 'outline', size: 'lg', className: 'font-semibold' })}>
            <ArrowLeft size={16} className="mr-2" />
            Back to All Blog Posts
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
