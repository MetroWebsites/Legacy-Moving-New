---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Calendar, Clock, ArrowLeft, Phone } from 'lucide-react';
import { buttonVariants } from '@/components/ui/button';
import { Image } from 'astro:assets';
import heroImage from '@/assets/services/hero.jpg';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props;

const formattedDate = new Date(post.data.publishDate).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
});

// Extract TL;DR from content for display in styled section
const contentText = post.body;
const tldrMatch = contentText.match(/##\s*TL;DR\s*\n\s*\n([\s\S]*?)\n\s*\n---/i);
const tldrContent = tldrMatch ? tldrMatch[1].trim() : null;

// Render the content and get the HTML
const { Content, remarkPluginFrontmatter } = await post.render();

// Create a component wrapper that will strip TL;DR from rendered output
import { marked } from 'marked';

// Remove TL;DR section from markdown before rendering
let cleanedMarkdown = contentText;
if (tldrContent) {
  cleanedMarkdown = contentText.replace(/##\s*TL;DR\s*\n\s*\n[\s\S]*?\n\s*\n---\s*\n\s*\n/i, '');
}

// Render the cleaned markdown to HTML
const cleanedHtml = marked.parse(cleanedMarkdown);
---

<BaseLayout
  title={`${post.data.title} | Legacy Moving Denver Blog`}
  description={post.data.excerpt}
>
  <!-- Hero Section with Background Image -->
  <section class="relative bg-gradient-to-br from-secondary via-secondary/95 to-secondary/90 text-white py-16 md:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-15">
      <Image 
        src={heroImage} 
        alt={post.data.title}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-4xl mx-auto">
        <a href="/blog" class={buttonVariants({ variant: 'ghost', className: 'text-white hover:bg-white/10 mb-6' })}>
          <ArrowLeft size={16} className="mr-2" />
          Back to Blog
        </a>
        <div class="flex items-center gap-4 text-sm text-white/80 mb-6">
          <div class="flex items-center gap-2">
            <Calendar size={16} />
            <span>{formattedDate}</span>
          </div>
          <div class="flex items-center gap-2">
            <Clock size={16} />
            <span>{post.data.readTime || '10 min read'}</span>
          </div>
        </div>
        <h1 class="font-display font-bold text-3xl md:text-4xl lg:text-5xl mb-6 leading-tight">
          {post.data.title}
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-3xl leading-relaxed">
          {post.data.excerpt}
        </p>
      </div>
    </div>
  </section>

  <!-- TL;DR Section -->
  {tldrContent && (
    <section class="py-8 bg-gradient-to-r from-blue-50 to-indigo-50 border-b-4 border-primary">
      <div class="container">
        <div class="max-w-4xl mx-auto">
          <div class="bg-white rounded-xl shadow-lg p-6 md:p-8 border-l-4 border-primary">
            <h2 class="font-display font-bold text-2xl md:text-3xl text-secondary mb-4 flex items-center gap-3">
              <span class="bg-primary text-white px-3 py-1 rounded-md text-sm font-semibold">TL;DR</span>
              Quick Summary
            </h2>
            <p class="text-lg text-gray-700 leading-relaxed">
              {tldrContent}
            </p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Blog Content -->
  <article class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg md:prose-xl max-w-none
          prose-headings:font-display prose-headings:font-bold prose-headings:text-secondary prose-headings:scroll-mt-20
          prose-h2:text-3xl md:prose-h2:text-4xl prose-h2:mt-24 prose-h2:mb-10 prose-h2:pb-5 prose-h2:border-b-2 prose-h2:border-gray-200
          prose-h3:text-2xl md:prose-h3:text-3xl prose-h3:mt-16 prose-h3:mb-8 prose-h3:text-primary
          prose-p:text-gray-700 prose-p:leading-[2] prose-p:mb-10 prose-p:text-[19px] md:prose-p:text-[20px]
          prose-a:text-primary prose-a:font-medium prose-a:no-underline hover:prose-a:underline hover:prose-a:text-secondary prose-a:transition-colors
          prose-strong:text-secondary prose-strong:font-semibold
          prose-ul:my-10 prose-ul:space-y-5 prose-li:my-0 prose-li:text-gray-700 prose-li:leading-[1.9] prose-li:pl-2 prose-li:text-[18px]
          prose-ol:my-10 prose-ol:space-y-5 prose-ol:pl-6
          prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:pl-8 prose-blockquote:pr-8 prose-blockquote:italic prose-blockquote:bg-gray-50 prose-blockquote:py-8 prose-blockquote:my-12 prose-blockquote:rounded-r-lg
          prose-code:text-primary prose-code:bg-gray-100 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-[16px]
          prose-pre:bg-gray-900 prose-pre:text-gray-100 prose-pre:my-10"
          set:html={cleanedHtml}
        />

        <!-- Helpful Links Section -->
        <div class="mt-24 pt-20 border-t-2 border-gray-200">
          <h2 class="font-display font-bold text-3xl md:text-4xl text-secondary mb-12 text-center">Helpful Resources & Services</h2>
          <div class="grid md:grid-cols-2 gap-6 mb-6">
            <!-- Services Column -->
            <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-6 md:p-8 shadow-sm hover:shadow-md transition-shadow">
              <h3 class="font-display font-bold text-xl md:text-2xl text-secondary mb-6 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
                Our Services
              </h3>
              <ul class="space-y-3">
                <li><a href="/services/local-moving" class="text-primary hover:text-secondary hover:underline font-medium text-lg transition-colors">Local Moving Services</a></li>
                <li><a href="/services/long-distance-moving" class="text-primary hover:text-secondary hover:underline font-medium text-lg transition-colors">Long Distance Moving</a></li>
                <li><a href="/services/residential-moving" class="text-primary hover:text-secondary hover:underline font-medium text-lg transition-colors">Residential Moving</a></li>
                <li><a href="/services/commercial-moving" class="text-primary hover:text-secondary hover:underline font-medium text-lg transition-colors">Commercial Moving</a></li>
                <li><a href="/services/packing-services" class="text-primary hover:text-secondary hover:underline font-medium text-lg transition-colors">Professional Packing Services</a></li>
                <li><a href="/services/storage-solutions" class="text-primary hover:text-secondary hover:underline font-medium text-lg transition-colors">Storage Solutions</a></li>
              </ul>
            </div>

            <!-- Cities Column -->
            <div class="bg-gradient-to-br from-orange-50 to-amber-50 rounded-xl p-6 md:p-8 shadow-sm hover:shadow-md transition-shadow">
              <h3 class="font-display font-bold text-xl md:text-2xl text-secondary mb-6 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                Areas We Serve
              </h3>
              <ul class="space-y-3">
                <li><a href="/cities/denver" class="text-primary hover:text-secondary hover:underline font-medium text-lg transition-colors">Denver</a></li>
                <li><a href="/cities/aurora" class="text-primary hover:text-secondary hover:underline font-medium text-lg transition-colors">Aurora</a></li>
                <li><a href="/cities/lakewood" class="text-primary hover:text-secondary hover:underline font-medium text-lg transition-colors">Lakewood</a></li>
                <li><a href="/cities/arvada" class="text-primary hover:text-secondary hover:underline font-medium text-lg transition-colors">Arvada</a></li>
                <li><a href="/cities/westminster" class="text-primary hover:text-secondary hover:underline font-medium text-lg transition-colors">Westminster</a></li>
                <li><a href="/service-area" class="text-primary hover:text-secondary hover:underline font-medium text-lg transition-colors">View All Service Areas →</a></li>
              </ul>
            </div>
          </div>

          <!-- Additional Resources -->
          <div class="grid md:grid-cols-3 gap-4">
            <a href="/moving-tips" class="bg-white border-2 border-gray-200 hover:border-primary rounded-lg p-5 text-center transition-all hover:shadow-md group">
              <span class="font-semibold text-gray-800 group-hover:text-primary text-lg transition-colors">Moving Tips & Guides</span>
            </a>
            <a href="/discounts" class="bg-white border-2 border-gray-200 hover:border-primary rounded-lg p-5 text-center transition-all hover:shadow-md group">
              <span class="font-semibold text-gray-800 group-hover:text-primary text-lg transition-colors">Special Discounts</span>
            </a>
            <a href="/faqs" class="bg-white border-2 border-gray-200 hover:border-primary rounded-lg p-5 text-center transition-all hover:shadow-md group">
              <span class="font-semibold text-gray-800 group-hover:text-primary text-lg transition-colors">Frequently Asked Questions</span>
            </a>
          </div>
        </div>

        <!-- CTA Section -->
        <div class="mt-24 p-8 md:p-12 bg-gradient-to-br from-primary via-primary to-secondary rounded-2xl text-white text-center shadow-2xl">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4">Ready to Get Started?</h2>
          <p class="text-white/90 text-lg md:text-xl mb-8 max-w-2xl mx-auto leading-relaxed">
            Get a free, no-obligation quote from Denver's most trusted moving professionals. We're here to make your move stress-free!
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-primary hover:bg-white/90 hover:scale-105 font-bold shadow-xl transition-transform text-lg px-8 py-4' })}>
              Get Your Free Quote
            </a>
            <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'border-2 border-white text-white hover:bg-white hover:text-primary font-bold transition-all text-lg px-8 py-4' })}>
              <Phone size={20} className="mr-2" />
              (720) 340-1849
            </a>
          </div>
          <p class="mt-6 text-white/80 text-sm">
            Available Monday-Saturday, 8:00am - 6:00pm • <a href="/contact" class="underline hover:text-white">Contact Us</a>
          </p>
        </div>

        <!-- Back to Blog -->
        <div class="mt-12 text-center">
          <a href="/blog" class={buttonVariants({ variant: 'outline', size: 'lg', className: 'font-semibold' })}>
            <ArrowLeft size={16} className="mr-2" />
            Back to All Blog Posts
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
