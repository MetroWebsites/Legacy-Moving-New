---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Meet the Team | Legacy Moving Denver | Our People"
  description="Get to know the Legacy Moving Denver team — the people behind every stress-free move. Meet our leadership, office staff, and the movers who make it happen every day."
>

  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-secondary via-secondary to-secondary/90 py-16 md:py-20 text-white overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1521737711867-e3b97375f902?w=1400&auto=format&q=80')] bg-cover bg-center opacity-10"></div>
    <div class="container relative z-10 text-center">
      <div class="inline-flex items-center gap-2 bg-primary/20 border border-primary/30 rounded-full px-4 py-1.5 text-sm font-medium mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        The Legacy Family
      </div>
      <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl mb-5 leading-tight">
        Meet the Team Behind<br>
        <span class="text-primary">Every Great Move</span>
      </h1>
      <p class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">
        We're a family-owned Denver moving company built on trust, hard work, and genuine care. Behind every smooth move is a dedicated team that shows up ready — every single time.
      </p>
      <div class="flex flex-wrap justify-center gap-6 mt-10">
        {[["6,000+","Moves Completed"],["5★","Google Rated"],["A","BBB Rating"],["Since 2018","Family Owned"]].map(([n,l]) => (
          <div class="text-center">
            <div class="font-display font-bold text-3xl text-primary">{n}</div>
            <div class="text-white/60 text-xs mt-0.5">{l}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tagline bar -->
  <section class="py-6 bg-primary">
    <div class="container text-center">
      <p class="text-white font-display font-bold text-xl md:text-2xl tracking-wide">
        ⭐ We Make <span class="underline underline-offset-4 decoration-white/60">YOU</span> Look Good. Every Single Move. ⭐
      </p>
    </div>
  </section>

  <!-- Leadership / Office — Coming Soon -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <span class="inline-block bg-primary/10 text-primary text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-4">Leadership & Office</span>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-secondary mb-3">The People Running the Show</h2>
        <p class="text-muted-foreground max-w-xl mx-auto">Full team bios and headshots coming soon. We're putting together something worth waiting for.</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
        {[
          { role: "Owner & Founder", name: "Coming Soon" },
          { role: "Operations Manager", name: "Coming Soon" },
          { role: "Customer Success", name: "Coming Soon" },
          { role: "Sales & Partnerships", name: "Coming Soon" },
          { role: "Lead Dispatcher", name: "Coming Soon" },
          { role: "Office Manager", name: "Coming Soon" },
          { role: "Marketing", name: "Coming Soon" },
          { role: "Account Manager", name: "Coming Soon" },
        ].map(({ role, name }) => (
          <div class="group flex flex-col items-center text-center">
            <!-- Avatar placeholder -->
            <div class="relative w-32 h-32 rounded-2xl bg-gradient-to-br from-gray-100 to-gray-200 border-2 border-dashed border-gray-300 flex flex-col items-center justify-center mb-3 group-hover:border-primary/40 transition-colors overflow-hidden shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-gray-300 mb-1"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <span class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider px-2">Coming Soon</span>
              <!-- Shimmer overlay -->
              <div class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 bg-gradient-to-r from-transparent via-white/40 to-transparent"></div>
            </div>
            <p class="font-display font-bold text-sm text-secondary">{name}</p>
            <p class="text-xs text-muted-foreground mt-0.5">{role}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 text-center">
        <div class="inline-flex items-center gap-2 bg-primary/10 text-primary text-sm font-semibold px-5 py-2.5 rounded-full">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Team bios launching soon — check back!
        </div>
      </div>
    </div>
  </section>

  <!-- Meet Our Movers — Slideshow -->
  <section class="py-16 bg-secondary text-white" id="our-movers">
    <div class="container">
      <div class="text-center mb-10">
        <span class="inline-block bg-white/10 text-white text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-4">Real Crews. Real Moves.</span>
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-3">Meet Our Movers</h2>
        <p class="text-white/75 max-w-xl mx-auto">These are the faces behind every successful move — showing up ready, working hard, and making Legacy proud every single day.</p>
      </div>

      <!-- Slideshow -->
      <div class="relative max-w-3xl mx-auto" id="movers-slideshow">
        <!-- Slides container -->
        <div class="overflow-hidden rounded-2xl shadow-2xl" id="slides-track-wrapper">
          <div class="flex transition-transform duration-500 ease-in-out" id="slides-track">
            {[
              { url: "/assets/team/movers-01.jpg", alt: "Legacy Moving Denver crew with truck" },
              { url: "/assets/team/movers-02.jpg", alt: "Legacy Moving Denver crew at truck rear" },
              { url: "/assets/team/movers-03.jpg", alt: "Legacy Moving Denver movers at house door" },
              { url: "/assets/team/movers-04.jpg", alt: "Legacy Moving Denver crew with truck at house" },
              { url: "/assets/team/movers-05.jpg", alt: "Legacy Moving Denver crew with two trucks" },
              { url: "/assets/team/movers-06.jpg", alt: "Legacy Moving Denver three man crew" },
              { url: "/assets/team/movers-07.jpg", alt: "Legacy Moving Denver crew at truck rear" },
              { url: "/assets/team/movers-08.jpg", alt: "Legacy Moving Denver two movers with truck" },
              { url: "/assets/team/movers-09.jpg", alt: "Legacy Moving Denver three movers in neighborhood" },
              { url: "/assets/team/movers-10.jpg", alt: "Legacy Moving Denver movers with loaded truck" },
              { url: "/assets/team/movers-11.jpg", alt: "Legacy Moving Denver crew with two trucks on street" },
              { url: "/assets/team/movers-12.jpg", alt: "Legacy Moving Denver four man crew" },
              { url: "/assets/team/movers-13.jpg", alt: "Legacy Moving Denver crew with blue truck" },
              { url: "/assets/team/movers-14.jpg", alt: "Legacy Moving Denver four movers with blue truck" },
              { url: "/assets/team/movers-15.jpg", alt: "Legacy Moving Denver three movers with blue truck" },
              { url: "/assets/team/movers-16.jpg", alt: "Legacy Moving Denver three movers" },
              { url: "/assets/team/movers-17.jpg", alt: "Legacy Moving Denver four movers at truck" },
              { url: "/assets/team/movers-18.jpg", alt: "Legacy Moving Denver three movers outside" },
              { url: "/assets/team/movers-19.jpg", alt: "Legacy Moving Denver two movers on truck lift" },
              { url: "/assets/team/movers-20.jpg", alt: "Legacy Moving Denver two movers" },
              { url: "/assets/team/movers-21.jpg", alt: "Legacy Moving Denver two movers at truck" },
            ].map(({ url, alt }) => (
              <div class="min-w-full">
                <img
                  src={url}
                  alt={alt}
                  class="w-full h-72 md:h-96 object-cover"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>

        <!-- Prev / Next buttons -->
        <button
          id="slide-prev"
          aria-label="Previous photo"
          class="absolute left-3 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/75 text-white rounded-full w-10 h-10 flex items-center justify-center transition-colors z-10 backdrop-blur-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button
          id="slide-next"
          aria-label="Next photo"
          class="absolute right-3 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/75 text-white rounded-full w-10 h-10 flex items-center justify-center transition-colors z-10 backdrop-blur-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>

        <!-- Dot indicators -->
        <div class="flex justify-center gap-1.5 mt-4" id="slide-dots"></div>

        <!-- Counter -->
        <p class="text-center text-white/50 text-xs mt-2" id="slide-counter">1 / 21</p>
      </div>

      <!-- Thumbnail strip -->
      <div class="mt-8 max-w-3xl mx-auto overflow-x-auto pb-2 hide-scrollbar">
        <div class="flex gap-2 w-max mx-auto" id="thumb-strip">
          {[
            "/assets/team/movers-01.jpg",
            "/assets/team/movers-02.jpg",
            "/assets/team/movers-03.jpg",
            "/assets/team/movers-04.jpg",
            "/assets/team/movers-05.jpg",
            "/assets/team/movers-06.jpg",
            "/assets/team/movers-07.jpg",
            "/assets/team/movers-08.jpg",
            "/assets/team/movers-09.jpg",
            "/assets/team/movers-10.jpg",
            "/assets/team/movers-11.jpg",
            "/assets/team/movers-12.jpg",
            "/assets/team/movers-13.jpg",
            "/assets/team/movers-14.jpg",
            "/assets/team/movers-15.jpg",
            "/assets/team/movers-16.jpg",
            "/assets/team/movers-17.jpg",
            "/assets/team/movers-18.jpg",
            "/assets/team/movers-19.jpg",
            "/assets/team/movers-20.jpg",
            "/assets/team/movers-21.jpg",
          ].map((url, i) => (
            <button
              class="thumb-btn flex-shrink-0 w-14 h-14 rounded-lg overflow-hidden border-2 border-white/20 hover:border-primary transition-colors opacity-60 hover:opacity-100"
              data-index={i}
              aria-label={`Go to photo ${i + 1}`}
            >
              <img src={url} alt="" class="w-full h-full object-cover" loading="lazy" />
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-14 bg-primary">
    <div class="container text-center">
      <h2 class="font-display font-bold text-3xl md:text-4xl text-white mb-4">Work With a Team That Cares</h2>
      <p class="text-white/85 text-lg mb-8 max-w-xl mx-auto">Every mover on our team is background-checked, trained, and proud to wear the Legacy name.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/get-quote" class="inline-flex items-center gap-2 bg-white text-primary hover:bg-white/90 font-bold py-3.5 px-8 rounded-xl transition-all hover:scale-105 shadow-lg">
          Get a Free Quote
        </a>
        <a href="tel:7203401849" class="inline-flex items-center gap-2 border-2 border-white/40 text-white hover:bg-white/10 font-semibold py-3.5 px-8 rounded-xl transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call (720) 340-1849
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script is:inline>
(function () {
  const TOTAL = 21;
  const track = document.getElementById('slides-track');
  const dotsContainer = document.getElementById('slide-dots');
  const counter = document.getElementById('slide-counter');
  const thumbBtns = document.querySelectorAll('.thumb-btn');
  let current = 0;
  let autoTimer = null;

  // Build dots
  for (let i = 0; i < TOTAL; i++) {
    const dot = document.createElement('button');
    dot.className = 'w-2 h-2 rounded-full transition-all ' + (i === 0 ? 'bg-primary w-4' : 'bg-white/30 hover:bg-white/60');
    dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
    dot.addEventListener('click', () => goTo(i));
    dotsContainer.appendChild(dot);
  }

  function goTo(n) {
    current = (n + TOTAL) % TOTAL;
    track.style.transform = 'translateX(-' + (current * 100) + '%)';
    // Update dots
    dotsContainer.querySelectorAll('button').forEach((d, i) => {
      d.className = 'rounded-full transition-all ' + (i === current ? 'bg-primary w-4 h-2' : 'bg-white/30 hover:bg-white/60 w-2 h-2');
    });
    // Update counter
    counter.textContent = (current + 1) + ' / ' + TOTAL;
    // Update thumbnails
    thumbBtns.forEach((btn, i) => {
      btn.classList.toggle('border-primary', i === current);
      btn.classList.toggle('opacity-100', i === current);
      btn.classList.toggle('border-white/20', i !== current);
      btn.classList.toggle('opacity-60', i !== current);
    });
    // Scroll active thumb into view inside the strip (never scrolls the page)
    const thumbStrip = document.getElementById('thumb-strip');
    const activeThumb = thumbBtns[current];
    if (thumbStrip && activeThumb) {
      const stripRect = thumbStrip.parentElement.getBoundingClientRect();
      const thumbRect = activeThumb.getBoundingClientRect();
      const offset = activeThumb.offsetLeft - thumbStrip.parentElement.scrollLeft;
      const center = offset - (stripRect.width / 2) + (thumbRect.width / 2);
      thumbStrip.parentElement.scrollBy({ left: center, behavior: 'smooth' });
    }
    resetAuto();
  }

  function resetAuto() {
    clearInterval(autoTimer);
    autoTimer = setInterval(() => goTo(current + 1), 4500);
  }

  document.getElementById('slide-prev').addEventListener('click', () => goTo(current - 1));
  document.getElementById('slide-next').addEventListener('click', () => goTo(current + 1));

  thumbBtns.forEach((btn) => {
    btn.addEventListener('click', () => goTo(parseInt(btn.dataset.index)));
  });

  // Swipe support
  let touchStartX = 0;
  const wrapper = document.getElementById('slides-track-wrapper');
  wrapper.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
  wrapper.addEventListener('touchend', (e) => {
    const diff = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) goTo(diff > 0 ? current + 1 : current - 1);
  });

  // Start auto-advance
  resetAuto();
  goTo(0);
})();
</script>
