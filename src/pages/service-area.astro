---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { MapPin } from 'lucide-react';
import heroImage from '../assets/services/hero.jpg';
---

<BaseLayout
  title="Service Area | Legacy Moving Denver | Areas We Serve"
  description="Legacy Moving Denver serves the entire Denver metro area and beyond. Check our complete service area to see if we cover your location for local and long-distance moves."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt="Legacy Moving Denver truck on the road" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">Our Service Area</h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto">
          Legacy Moving Denver proudly serves communities throughout Denver and the surrounding areas. Check if your location is covered by our moving services.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">Communities We Serve</h2>
          <p class="text-muted-foreground max-w-3xl mx-auto">
            Legacy Moving Denver provides exceptional moving services throughout the Denver metropolitan area and beyond. We're your trusted local movers with extensive experience navigating the unique challenges of moving in Colorado.
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 gap-12 mb-16">
          <!-- Local Service Area -->
          <div>
            <div class="flex items-center mb-4">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mr-3">
                <MapPin size={20} className="text-primary" />
              </div>
              <h3 class="font-display font-bold text-2xl text-secondary">Local Service Area</h3>
            </div>
            <p class="text-muted-foreground mb-6">
              Our comprehensive local service area includes Denver and all surrounding communities. Whether you're moving within the city limits or to a neighboring suburb, our team is ready to help make your relocation smooth and stress-free.
            </p>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <div class="grid grid-cols-2 gap-x-4 gap-y-2">
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Denver</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Aurora</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Lakewood</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Arvada</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Westminster</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Thornton</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Centennial</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Highlands Ranch</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Littleton</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Parker</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Broomfield</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Castle Rock</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Wheat Ridge</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Golden</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Northglenn</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Commerce City</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Englewood</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Brighton</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Lone Tree</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Greenwood Village</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Cherry Hills Village</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Lafayette</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Louisville</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
                  <span class="text-secondary">Superior</span>
                </div>
              </div>
              <p class="mt-4 text-muted-foreground text-sm">
                <em>And many more communities throughout the Denver metro area!</em>
              </p>
            </div>
          </div>
          
          <!-- Long Distance Moving -->
          <div>
            <div class="flex items-center mb-4">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mr-3">
                <MapPin size={20} className="text-primary" />
              </div>
              <h3 class="font-display font-bold text-2xl text-secondary">Long Distance Service</h3>
            </div>
            <p class="text-muted-foreground mb-6">
              Beyond our local service area, Legacy Moving Denver provides long-distance moving services to destinations throughout Colorado and to neighboring states. Our experienced team ensures your belongings arrive safely at your new home, no matter the distance.
            </p>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <h4 class="font-semibold text-xl mb-3 text-secondary">Colorado Cities We Serve:</h4>
              <div class="grid grid-cols-2 gap-x-4 gap-y-2 mb-6">
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-secondary rounded-full mr-2"></span>
                  <span class="text-secondary">Boulder</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-secondary rounded-full mr-2"></span>
                  <span class="text-secondary">Colorado Springs</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-secondary rounded-full mr-2"></span>
                  <span class="text-secondary">Fort Collins</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-secondary rounded-full mr-2"></span>
                  <span class="text-secondary">Loveland</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-secondary rounded-full mr-2"></span>
                  <span class="text-secondary">Pueblo</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-secondary rounded-full mr-2"></span>
                  <span class="text-secondary">Grand Junction</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-secondary rounded-full mr-2"></span>
                  <span class="text-secondary">Greeley</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-secondary rounded-full mr-2"></span>
                  <span class="text-secondary">Longmont</span>
                </div>
              </div>
              
              <h4 class="font-semibold text-xl mb-3 text-secondary">Neighboring States:</h4>
              <div class="grid grid-cols-2 gap-x-4 gap-y-2">
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-secondary rounded-full mr-2"></span>
                  <span class="text-secondary">Wyoming</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-secondary rounded-full mr-2"></span>
                  <span class="text-secondary">Nebraska</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-secondary rounded-full mr-2"></span>
                  <span class="text-secondary">Kansas</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-secondary rounded-full mr-2"></span>
                  <span class="text-secondary">New Mexico</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-secondary rounded-full mr-2"></span>
                  <span class="text-secondary">Utah</span>
                </div>
                <div class="flex items-center">
                  <span class="w-2 h-2 bg-secondary rounded-full mr-2"></span>
                  <span class="text-secondary">Arizona</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Specific Area Pages -->
        <div class="bg-gray-50 p-8 rounded-lg border border-gray-100 shadow-md mb-16">
          <h3 class="font-display font-bold text-2xl mb-4 text-secondary text-center">Featured Service Areas</h3>
          <p class="text-muted-foreground mb-6 text-center">
            Learn more about our moving services in these specific communities:
          </p>
          
          <div class="grid md:grid-cols-3 gap-4">
            <a href="/contact/moving-companies-service-area/Arvada" class="bg-white p-4 rounded-lg border border-gray-100 shadow-sm text-center hover:shadow-md transition-shadow">
              <h4 class="font-semibold text-lg text-secondary">Arvada</h4>
              <p class="text-sm text-muted-foreground">Moving services in Arvada</p>
            </a>
            
            <a href="/contact/interstate-move-service-area/Denver" class="bg-white p-4 rounded-lg border border-gray-100 shadow-sm text-center hover:shadow-md transition-shadow">
              <h4 class="font-semibold text-lg text-secondary">Denver</h4>
              <p class="text-sm text-muted-foreground">Interstate moves from Denver</p>
            </a>
            
            <a href="/jefferson-county-co" class="bg-white p-4 rounded-lg border border-gray-100 shadow-sm text-center hover:shadow-md transition-shadow">
              <h4 class="font-semibold text-lg text-secondary">Jefferson County</h4>
              <p class="text-sm text-muted-foreground">Moving services throughout Jefferson County</p>
            </a>
            
            <a href="/contact/local-movers-service-area/Northglenn" class="bg-white p-4 rounded-lg border border-gray-100 shadow-sm text-center hover:shadow-md transition-shadow">
              <h4 class="font-semibold text-lg text-secondary">Northglenn</h4>
              <p class="text-sm text-muted-foreground">Local moving in Northglenn</p>
            </a>
            
            <a href="/contact/moving-companies-service-area/Henderson" class="bg-white p-4 rounded-lg border border-gray-100 shadow-sm text-center hover:shadow-md transition-shadow">
              <h4 class="font-semibold text-lg text-secondary">Henderson</h4>
              <p class="text-sm text-muted-foreground">Moving services in Henderson</p>
            </a>
            
            <a href="/contact" class="bg-white p-4 rounded-lg border border-gray-100 shadow-sm text-center hover:shadow-md transition-shadow">
              <h4 class="font-semibold text-lg text-primary">All Areas</h4>
              <p class="text-sm text-muted-foreground">Contact us about your location</p>
            </a>
          </div>
        </div>
        
        <!-- Not in our service area? -->
        <div class="text-center mb-12">
          <h3 class="font-display font-bold text-2xl mb-4 text-secondary">Not in Our Service Area?</h3>
          <p class="text-muted-foreground max-w-3xl mx-auto mb-6">
            Don't see your location listed? Contact us anyway! We may still be able to accommodate your move or recommend a trusted partner in your area.
          </p>
          <div class="flex justify-center">
            <a href="/contact" class={buttonVariants({ className: 'bg-primary text-white hover:bg-primary/90' })}>
              Contact Us About Your Location
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">Ready to Plan Your Move?</h2>
        <p class="text-white/90 text-lg mb-8">
          Contact our team today to discuss your moving needs and get a customized quote for your location.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/request-quote" class={buttonVariants({ size: 'lg', className: 'bg-white text-secondary hover:bg-primary hover:text-white font-semibold transition-colors' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border border-white text-white hover:bg-primary/80 hover:text-white phone-link transition-colors' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>