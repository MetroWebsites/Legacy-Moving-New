---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Image } from 'astro:assets';
import heroImage from '../assets/services/hero.jpg';
---

<BaseLayout
  title="FAQs | Legacy Moving Denver | Frequently Asked Questions"
  description="Find answers to common questions about moving with Legacy Moving Denver. Learn about our services, pricing, and what to expect on moving day."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt="Legacy Moving Denver truck and movers" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">Frequently Asked Questions</h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto">
          Find answers to common questions about our moving services, pricing, and what to expect on moving day.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ Content -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <!-- General Questions -->
        <div class="mb-12">
          <h2 class="font-display font-bold text-2xl md:text-3xl mb-6 text-secondary">General Questions</h2>
          
          <div class="space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <h3 class="font-semibold text-lg text-secondary mb-2">What areas do you serve?</h3>
              <p class="text-muted-foreground">
                We serve the entire Denver metro area, including all surrounding suburbs like Aurora, Lakewood, Arvada, Westminster, Thornton, Centennial, and more. We also provide long-distance moving services across Colorado and to neighboring states.
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <h3 class="font-semibold text-lg text-secondary mb-2">Are you licensed and insured?</h3>
              <p class="text-muted-foreground">
                Yes, Legacy Moving Denver is fully licensed and insured. We have all required federal and state credentials for both local and long-distance moves. Our U.S. DOT number is #3462023, our MC number is #1189363, and our PUC license is #HHG-00682.
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <h3 class="font-semibold text-lg text-secondary mb-2">How far in advance should I book my move?</h3>
              <p class="text-muted-foreground">
                We recommend booking your move as soon as you know your moving date, especially during peak moving season (May through September). For weekend moves or end-of-month dates, we suggest booking 3-4 weeks in advance. For weekday moves during off-peak seasons, 1-2 weeks is usually sufficient. However, we do offer last-minute and same-day moving services when available.
              </p>
            </div>
          </div>
        </div>
        
        <!-- Pricing and Quotes -->
        <div class="mb-12">
          <h2 class="font-display font-bold text-2xl md:text-3xl mb-6 text-secondary">Pricing and Quotes</h2>
          
          <div class="space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <h3 class="font-semibold text-lg text-secondary mb-2">How do you determine the cost of a move?</h3>
              <p class="text-muted-foreground">
                Our pricing is based on several factors including the size of your move (inventory), distance, accessibility at both locations (stairs, elevators, long carries), and any additional services you request (packing, storage, etc.). We offer both hourly rates for local moves and flat-rate pricing for long-distance moves.
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <h3 class="font-semibold text-lg text-secondary mb-2">Do you offer free quotes?</h3>
              <p class="text-muted-foreground">
                Yes, we provide free, no-obligation quotes for all moves. For most moves, we can provide quotes over the phone or through our online form based on your inventory. For larger or more complex moves, we offer free in-home estimates for the most accurate pricing.
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <h3 class="font-semibold text-lg text-secondary mb-2">Are there any hidden fees or charges?</h3>
              <p class="text-muted-foreground">
                No, we pride ourselves on transparent pricing. Your quote will include all charges, and we'll clearly explain any potential additional costs that might apply to your specific situation. We'll never surprise you with hidden fees or last-minute charges.
              </p>
            </div>
          </div>
        </div>
        
        <!-- Services and Logistics -->
        <div class="mb-12">
          <h2 class="font-display font-bold text-2xl md:text-3xl mb-6 text-secondary">Services and Logistics</h2>
          
          <div class="space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <h3 class="font-semibold text-lg text-secondary mb-2">Do you provide packing services?</h3>
              <p class="text-muted-foreground">
                Yes, we offer full packing, partial packing, and unpacking services. Our professional packers use quality materials and techniques to ensure your belongings are protected during transit. We also offer packing supplies if you prefer to pack yourself.
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <h3 class="font-semibold text-lg text-secondary mb-2">How do you handle furniture and fragile items?</h3>
              <p class="text-muted-foreground">
                Our movers are trained in proper handling techniques for all types of items. We use furniture blankets, stretch wrap, mattress bags, and custom crating for valuable or fragile items. We disassemble and reassemble furniture as needed and place protective coverings on floors and doorways to prevent damage to your home.
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <h3 class="font-semibold text-lg text-secondary mb-2">Do you offer storage solutions?</h3>
              <p class="text-muted-foreground">
                Yes, we provide both short-term and long-term storage options. Our secure, climate-controlled facility can accommodate items of any size, from a few boxes to entire households. We offer flexible storage terms and can coordinate pick-up and delivery to meet your schedule.
              </p>
            </div>
          </div>
        </div>
        
        <!-- Moving Day -->
        <div class="mb-12">
          <h2 class="font-display font-bold text-2xl md:text-3xl mb-6 text-secondary">Moving Day</h2>
          
          <div class="space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <h3 class="font-semibold text-lg text-secondary mb-2">What time will the movers arrive?</h3>
              <p class="text-muted-foreground">
                We typically provide a 1-2 hour arrival window for your move day. Our team will call you 30 minutes before arrival. We strive to be punctual but recommend being prepared for your move day at the start of your scheduled window.
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <h3 class="font-semibold text-lg text-secondary mb-2">How should I prepare for my move?</h3>
              <p class="text-muted-foreground">
                Before moving day, we recommend: 1) Packing all non-essential items if you're doing your own packing, 2) Clearing pathways and removing any tripping hazards, 3) Disconnecting appliances and electronics, 4) Setting aside valuables and important documents to transport yourself, 5) Making arrangements for children and pets to be away during the move if possible, and 6) Having payment ready for the end of the move.
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <h3 class="font-semibold text-lg text-secondary mb-2">What forms of payment do you accept?</h3>
              <p class="text-muted-foreground">
                We accept credit cards, cash, and certified checks. Payment is typically due upon completion of your move. For long-distance moves, we may require a deposit at booking.
              </p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- CTA -->
      <div class="mt-16 text-center">
        <h2 class="font-display font-bold text-2xl mb-4 text-secondary">Still have questions?</h2>
        <p class="text-muted-foreground max-w-2xl mx-auto mb-6">
          Our team is ready to help with any questions or concerns about your upcoming move. Reach out to us directly for personalized assistance.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class={buttonVariants({ className: 'bg-primary text-white hover:bg-primary/90' })}>
            Contact Us
          </a>
          <a href="/request-quote" class={buttonVariants({ className: 'bg-secondary text-white hover:bg-secondary/90' })}>
            Get a Free Quote
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>