---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MoverbaseRedirect from '../components/MoverbaseRedirect.astro';
import { buttonVariants } from "@/components/ui/button";
import { Calculator, DollarSign, TruckIcon, Clock, MapPin, Package } from "lucide-react";
import { Image } from 'astro:assets';
import heroImage from '../assets/services/hero.jpg';
---

<BaseLayout
  title="Denver Movers Cost Calculator | Local Moving Company Cost | Free Estimate"
  description="Calculate your Denver moving costs instantly. Get accurate pricing for local moving company services in Denver Colorado. Free moving cost estimates with transparent rates and no hidden fees."
  ogImage={new URL("/social-preview.jpg", Astro.site)}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-primary to-secondary text-white py-16 md:py-20">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt="Denver movers cost calculator" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <div class="flex justify-center mb-6">
          <div class="w-16 h-16 bg-white/10 backdrop-blur-sm rounded-full flex items-center justify-center">
            <Calculator size={32} className="text-white" />
          </div>
        </div>
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">Denver Moving Cost Calculator</h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto">
          Get an instant estimate for your Denver move. Transparent local moving company costs with no hidden fees or surprise charges.
        </p>
      </div>
    </div>
  </section>

  <!-- Calculator Form Section -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-xl p-8 md:p-12">
          <div class="text-center mb-8">
            <h2 class="font-display font-bold text-3xl text-secondary mb-4">Calculate Your Moving Costs</h2>
            <p class="text-muted-foreground text-lg">
              Fill out the form below to get an exact cost estimate for your Denver area move. Our team will provide a detailed quote within 24 hours.
            </p>
          </div>

          <!-- Moverbase Quote Widget -->
          <div data-version="10" id="J8QDKR-cost-calc"></div>
          <script is:inline>
          (function(r,k) {
            var s = document.createElement('script');
            s.async = true;
            s.defer = true;
            s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
            s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); } );
            document.getElementById(r).appendChild(s);
          })('J8QDKR-cost-calc','JGCB6TGFN7N3NTTDOGMQUK1S9L3A4N73LYF2ZX4H248K97JD');
          </script>
        </div>
      </div>
    </div>
  </section>

  <!-- Local Moving Company Cost Information -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl text-secondary mb-8 text-center">Understanding Denver Movers Cost</h2>
        
        <div class="prose prose-lg max-w-none mb-12">
          <p class="text-muted-foreground text-lg">
            When planning your move in Denver, understanding local moving company costs is essential for budgeting accurately. Legacy Moving Denver provides transparent pricing that reflects the true cost of professional moving services in the Denver metropolitan area.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <!-- Local Moving Costs -->
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
                <MapPin size={24} className="text-primary" />
              </div>
              <h3 class="font-display font-semibold text-xl text-secondary">Local Moving Company Cost</h3>
            </div>
            <p class="text-muted-foreground mb-4">
              Denver local moves (within the metro area) are typically charged by the hour. Our competitive rates include:
            </p>
            <ul class="space-y-2 text-muted-foreground">
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span><strong>2 Movers + Truck:</strong> Competitive hourly rates</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span><strong>3 Movers + Truck:</strong> Competitive hourly rates</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span><strong>4+ Movers:</strong> Custom team pricing</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">✓</span>
                <span>No hidden fees or fuel surcharges</span>
              </li>
            </ul>
          </div>

          <!-- Long Distance Moving Costs -->
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 bg-secondary/10 rounded-full flex items-center justify-center flex-shrink-0">
                <TruckIcon size={24} className="text-secondary" />
              </div>
              <h3 class="font-display font-semibold text-xl text-secondary">Long Distance Moving Cost</h3>
            </div>
            <p class="text-muted-foreground mb-4">
              Out-of-state moves and long-distance relocations are priced based on distance and volume:
            </p>
            <ul class="space-y-2 text-muted-foreground">
              <li class="flex items-start gap-2">
                <span class="text-secondary font-bold">✓</span>
                <span><strong>Distance:</strong> Calculated per mile</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-secondary font-bold">✓</span>
                <span><strong>Weight/Volume:</strong> Based on inventory</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-secondary font-bold">✓</span>
                <span><strong>Custom Services:</strong> Packing, storage options</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-secondary font-bold">✓</span>
                <span>Binding estimates available</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What Affects Moving Costs -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl text-secondary mb-8 text-center">What Affects Denver Movers Cost?</h2>
        
        <div class="grid md:grid-cols-3 gap-6">
          <!-- Factor 1 -->
          <div class="bg-white p-6 rounded-lg shadow-md">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
              <Clock size={24} className="text-primary" />
            </div>
            <h3 class="font-display font-semibold text-lg text-secondary mb-3">Time & Distance</h3>
            <p class="text-muted-foreground text-sm">
              Local moves are billed hourly, while long-distance relocations factor in mileage and estimated travel time between Denver and your destination.
            </p>
          </div>

          <!-- Factor 2 -->
          <div class="bg-white p-6 rounded-lg shadow-md">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
              <Package size={24} className="text-primary" />
            </div>
            <h3 class="font-display font-semibold text-lg text-secondary mb-3">Home Size & Volume</h3>
            <p class="text-muted-foreground text-sm">
              The size of your home and the amount of belongings directly impact local moving company cost. Studio apartments cost less than 4-bedroom homes.
            </p>
          </div>

          <!-- Factor 3 -->
          <div class="bg-white p-6 rounded-lg shadow-md">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
              <DollarSign size={24} className="text-primary" />
            </div>
            <h3 class="font-display font-semibold text-lg text-secondary mb-3">Additional Services</h3>
            <p class="text-muted-foreground text-sm">
              Packing services, specialty item handling (pianos, gun safes), and short-term storage add to the base moving cost.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Average Denver Moving Costs -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl text-secondary mb-8 text-center">Average Denver Moving Costs by Home Size</h2>
        
        <div class="bg-gradient-to-br from-primary/5 to-secondary/5 rounded-lg p-8 mb-8">
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b-2 border-secondary/20">
                  <th class="text-left py-3 px-4 font-display font-semibold text-secondary">Home Size</th>
                  <th class="text-left py-3 px-4 font-display font-semibold text-secondary">Local Move Cost</th>
                  <th class="text-left py-3 px-4 font-display font-semibold text-secondary">Estimated Time</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <tr class="hover:bg-white/50">
                  <td class="py-3 px-4 text-muted-foreground">Studio / 1BR Apartment</td>
                  <td class="py-3 px-4 font-semibold text-secondary">Contact for quote</td>
                  <td class="py-3 px-4 text-muted-foreground">3-4 hours</td>
                </tr>
                <tr class="hover:bg-white/50">
                  <td class="py-3 px-4 text-muted-foreground">2 Bedroom Home</td>
                  <td class="py-3 px-4 font-semibold text-secondary">Contact for quote</td>
                  <td class="py-3 px-4 text-muted-foreground">4-6 hours</td>
                </tr>
                <tr class="hover:bg-white/50">
                  <td class="py-3 px-4 text-muted-foreground">3 Bedroom Home</td>
                  <td class="py-3 px-4 font-semibold text-secondary">Contact for quote</td>
                  <td class="py-3 px-4 text-muted-foreground">6-8 hours</td>
                </tr>
                <tr class="hover:bg-white/50">
                  <td class="py-3 px-4 text-muted-foreground">4+ Bedroom Home</td>
                  <td class="py-3 px-4 font-semibold text-secondary">Contact for quote</td>
                  <td class="py-3 px-4 text-muted-foreground">8-12+ hours</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="bg-secondary/10 border border-secondary/20 rounded-lg p-6">
          <p class="text-sm text-muted-foreground">
            <strong>Note:</strong> These are average estimates for local moving company cost in Denver. Actual Denver movers cost depends on specific factors including stairs, elevator access, parking distance, and specialty items. Request a free quote for an accurate estimate tailored to your move.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Long Distance Moving Costs -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl text-secondary mb-8 text-center">Long Distance Moving Cost From Denver</h2>
        
        <div class="prose prose-lg max-w-none mb-8">
          <p class="text-muted-foreground">
            Long-distance moving costs from Denver vary significantly based on destination and the size of your move. Unlike local moves, long-distance relocations are typically priced based on:
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-8">
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="font-display font-semibold text-xl text-secondary mb-4">Weight-Based Pricing</h3>
            <ul class="space-y-3 text-muted-foreground">
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold mt-1">•</span>
                <span><strong>Average 2BR Home:</strong> 4,000-6,000 lbs</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold mt-1">•</span>
                <span><strong>Average 3BR Home:</strong> 7,000-9,000 lbs</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold mt-1">•</span>
                <span><strong>Cost per pound:</strong> Varies by distance</span>
              </li>
            </ul>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="font-display font-semibold text-xl text-secondary mb-4">Distance Examples</h3>
            <ul class="space-y-3 text-muted-foreground">
              <li class="flex items-start gap-2">
                <span class="text-secondary font-bold mt-1">•</span>
                <span><strong>Denver to Phoenix:</strong> ~600 miles</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-secondary font-bold mt-1">•</span>
                <span><strong>Denver to Los Angeles:</strong> ~1,000 miles</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-secondary font-bold mt-1">•</span>
                <span><strong>Denver to Seattle:</strong> ~1,300 miles</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-md">
          <h3 class="font-display font-semibold text-2xl text-secondary mb-6 text-center">Estimated Long Distance Moving Costs</h3>
          <div class="space-y-4">
            <div class="flex justify-between items-center py-3 border-b border-gray-200">
              <span class="text-muted-foreground"><strong>1 Bedroom</strong> (Denver to 500 miles)</span>
              <span class="font-semibold text-secondary">Contact for quote</span>
            </div>
            <div class="flex justify-between items-center py-3 border-b border-gray-200">
              <span class="text-muted-foreground"><strong>2 Bedroom</strong> (Denver to 1,000 miles)</span>
              <span class="font-semibold text-secondary">Contact for quote</span>
            </div>
            <div class="flex justify-between items-center py-3 border-b border-gray-200">
              <span class="text-muted-foreground"><strong>3 Bedroom</strong> (Denver to 1,500 miles)</span>
              <span class="font-semibold text-secondary">Contact for quote</span>
            </div>
            <div class="flex justify-between items-center py-3">
              <span class="text-muted-foreground"><strong>4+ Bedroom</strong> (Denver to 2,000+ miles)</span>
              <span class="font-semibold text-secondary">Contact for quote</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Legacy Moving Denver -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl text-secondary mb-8 text-center">Why Denver Residents Choose Legacy Moving</h2>
        
        <div class="grid md:grid-cols-2 gap-6 mb-8">
          <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-primary">
            <h3 class="font-display font-semibold text-lg text-secondary mb-3">✓ Transparent Pricing</h3>
            <p class="text-muted-foreground">
              We provide upfront local moving company cost estimates with no surprise fees. What we quote is what you pay.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-primary">
            <h3 class="font-display font-semibold text-lg text-secondary mb-3">✓ Licensed & Insured</h3>
            <p class="text-muted-foreground">
              Fully licensed (DOT #3462023, MC #1189363) and insured for your peace of mind on every Denver move.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-primary">
            <h3 class="font-display font-semibold text-lg text-secondary mb-3">✓ Local Denver Experts</h3>
            <p class="text-muted-foreground">
              We know Denver neighborhoods, building requirements, and the challenges of local moves in Colorado.
            </p>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-primary">
            <h3 class="font-display font-semibold text-lg text-secondary mb-3">✓ Professional Crews</h3>
            <p class="text-muted-foreground">
              Experienced, background-checked movers who treat your belongings with care from start to finish.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-gradient-to-r from-primary to-secondary text-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6">Ready to Get Your Exact Moving Cost?</h2>
        <p class="text-lg text-white/90 mb-8">
          Fill out our form above or call us directly for a detailed quote. We'll provide an accurate Denver movers cost estimate tailored to your specific move.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#J8QDKR-cost-calc" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-gray-100 font-semibold transition-colors' })}>
            Get Your Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary border-2 border-white text-white hover:bg-secondary/80 phone-link transition-colors' })} data-google-link="https://maps.app.goo.gl/9YhGXwHp1TMi6xoG9">
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SEO Content Section -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-2xl md:text-3xl text-secondary mb-6">Understanding Local Moving Company Cost in Denver</h2>
        
        <div class="prose prose-lg max-w-none">
          <p class="text-base md:text-lg text-gray-700 leading-relaxed mb-6">
            When researching Denver movers cost, it's important to understand what factors into professional moving rates. At Legacy Moving Denver, we believe in complete transparency when it comes to local moving company cost.
          </p>
          
          <p class="text-base md:text-lg text-gray-700 leading-relaxed mb-8">
            Our Denver moving cost calculator helps you estimate expenses based on your specific needs, whether you're moving locally within the Denver metro area or planning a long-distance relocation out of Colorado.
          </p>
          
          <h3 class="font-display font-semibold text-xl md:text-2xl text-secondary mb-4">Factors That Determine Denver Movers Cost</h3>
          
          <p class="text-base md:text-lg text-gray-700 leading-relaxed mb-4">
            Several key factors influence the final local moving company cost for your Denver move:
          </p>
          
          <ul class="space-y-3 mb-8 ml-6">
            <li class="text-base md:text-lg text-gray-700 leading-relaxed"><strong>Distance</strong> – Local moves within Denver are charged hourly, while long-distance moves factor in mileage</li>
            <li class="text-base md:text-lg text-gray-700 leading-relaxed"><strong>Home size</strong> – More rooms and belongings require more time and labor</li>
            <li class="text-base md:text-lg text-gray-700 leading-relaxed"><strong>Stairs and elevators</strong> – Multi-story homes or buildings without elevators require additional effort</li>
            <li class="text-base md:text-lg text-gray-700 leading-relaxed"><strong>Specialty items</strong> – Pianos, gun safes, and antiques need special handling</li>
            <li class="text-base md:text-lg text-gray-700 leading-relaxed"><strong>Packing services</strong> – Professional packing adds convenience but increases cost</li>
            <li class="text-base md:text-lg text-gray-700 leading-relaxed"><strong>Time of year</strong> – Summer moves are typically more expensive due to high demand</li>
          </ul>
          
          <h3 class="font-display font-semibold text-xl md:text-2xl text-secondary mb-4">How to Save Money on Your Denver Move</h3>
          
          <p class="text-base md:text-lg text-gray-700 leading-relaxed mb-4">
            While professional Denver movers cost money, there are ways to reduce expenses without sacrificing quality:
          </p>
          
          <ul class="space-y-3 mb-8 ml-6">
            <li class="text-base md:text-lg text-gray-700 leading-relaxed">Book during off-peak seasons (fall and winter) for better rates</li>
            <li class="text-base md:text-lg text-gray-700 leading-relaxed">Declutter before moving to reduce volume and time</li>
            <li class="text-base md:text-lg text-gray-700 leading-relaxed">Do your own packing to save on labor costs</li>
            <li class="text-base md:text-lg text-gray-700 leading-relaxed">Schedule mid-month or mid-week moves for potential discounts</li>
            <li class="text-base md:text-lg text-gray-700 leading-relaxed">Compare quotes from licensed local moving companies</li>
          </ul>
          
          <p class="text-base md:text-lg text-gray-700 leading-relaxed">
            Ready to get started? Use our moving cost calculator above or <a href="/contact" class="text-primary font-semibold hover:underline">contact us</a> for a detailed, no-obligation quote for your Denver move.
          </p>
        </div>
      </div>
    </div>
  </section>
<MoverbaseRedirect />
</BaseLayout>
