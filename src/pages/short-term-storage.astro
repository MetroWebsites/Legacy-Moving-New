---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { Check, CalendarDays, Shield, Truck, Box, Key } from 'lucide-react';
import storageImage from '../assets/services/storage.jpg';
---

<BaseLayout
  title="Short-Term Storage | Legacy Moving Denver | Temporary Storage Solutions"
  description="Flexible short-term storage solutions in Denver. Our secure, climate-controlled facility offers temporary storage for home staging, between moves, and renovations."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={storageImage} 
        alt="Legacy Moving Denver short-term storage solutions" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">Short-Term Storage Solutions</h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Flexible temporary storage options for when you need extra space during transitions, renovations, or between moves.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/request-quote" class={buttonVariants({ size: 'lg', className: 'bg-white text-secondary hover:bg-gray-100 font-semibold' })}>
            Get a Storage Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary text-white hover:bg-primary/90 font-semibold' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
          <div>
            <div class="flex items-center mb-4">
              <CalendarDays size={28} className="text-primary mr-3" />
              <h2 class="font-display font-bold text-3xl text-secondary">Temporary Storage When You Need It</h2>
            </div>
            <p class="text-muted-foreground mb-4">
              Life transitions don't always align perfectly. Sometimes you need a secure place to store your belongings for a few days, weeks, or months. Our short-term storage solutions provide the flexibility you need during these transition periods.
            </p>
            <p class="text-muted-foreground mb-6">
              Whether you're staging your home for sale, renovating, or dealing with lease overlap, our secure Lakewood facility offers convenient, accessible storage with no long-term commitments.
            </p>
            
            <div class="space-y-4 mt-8">
              <div class="flex gap-3">
                <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                  <Check size={16} className="text-primary" />
                </div>
                <p class="text-secondary font-medium">No long-term contracts required</p>
              </div>
              <div class="flex gap-3">
                <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                  <Check size={16} className="text-primary" />
                </div>
                <p class="text-secondary font-medium">Climate-controlled options available</p>
              </div>
              <div class="flex gap-3">
                <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                  <Check size={16} className="text-primary" />
                </div>
                <p class="text-secondary font-medium">24/7 security monitoring</p>
              </div>
              <div class="flex gap-3">
                <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                  <Check size={16} className="text-primary" />
                </div>
                <p class="text-secondary font-medium">Easy access during business hours</p>
              </div>
              <div class="flex gap-3">
                <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                  <Check size={16} className="text-primary" />
                </div>
                <p class="text-secondary font-medium">Pickup and delivery services available</p>
              </div>
            </div>
          </div>
          
          <div>
            <div class="bg-gray-50 p-6 rounded-lg border border-gray-100 shadow-md">
              <h3 class="font-display font-bold text-xl mb-4 text-secondary">Perfect For:</h3>
              <ul class="space-y-3">
                <li class="flex gap-3">
                  <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                    <Box size={20} className="text-primary" />
                  </div>
                  <div>
                    <h4 class="font-semibold text-secondary">Home Staging</h4>
                    <p class="text-muted-foreground text-sm">Temporarily store excess furniture and personal items while your home is on the market</p>
                  </div>
                </li>
                
                <li class="flex gap-3">
                  <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                    <Truck size={20} className="text-primary" />
                  </div>
                  <div>
                    <h4 class="font-semibold text-secondary">Between Moves</h4>
                    <p class="text-muted-foreground text-sm">Bridge the gap when your new home isn't ready but you need to vacate your current residence</p>
                  </div>
                </li>
                
                <li class="flex gap-3">
                  <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                    <Shield size={20} className="text-primary" />
                  </div>
                  <div>
                    <h4 class="font-semibold text-secondary">Home Renovations</h4>
                    <p class="text-muted-foreground text-sm">Protect your belongings during remodeling projects or major home improvements</p>
                  </div>
                </li>
                
                <li class="flex gap-3">
                  <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                    <Key size={20} className="text-primary" />
                  </div>
                  <div>
                    <h4 class="font-semibold text-secondary">Seasonal Storage</h4>
                    <p class="text-muted-foreground text-sm">Store seasonal items like holiday decorations, sports equipment, or summer/winter clothing</p>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
        
        <!-- Storage Options -->
        <div class="mb-16">
          <div class="text-center mb-10">
            <h2 class="font-display font-bold text-3xl mb-4 text-secondary">Our Short-Term Storage Options</h2>
            <p class="text-muted-foreground max-w-3xl mx-auto">
              We offer flexible storage solutions to match your specific needs and timeline.
            </p>
          </div>
          
          <div class="grid md:grid-cols-3 gap-8">
            <!-- Small Storage -->
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 hover:shadow-lg transition-all">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="16" height="16" x="4" y="4" rx="2"></rect><rect width="4" height="4" x="10" y="10" rx="1"></rect><path d="M4 10h4"></path><path d="M16 10h4"></path><path d="M10 4v4"></path><path d="M10 16v4"></path></svg>
              </div>
              <h3 class="font-display font-bold text-xl text-center mb-2 text-secondary">Small Storage Unit</h3>
              <div class="text-center mb-4">
                <span class="text-primary font-semibold">5' x 5' to 5' x 10'</span>
              </div>
              <p class="text-muted-foreground mb-4 text-center">
                Perfect for storing the contents of a small apartment, seasonal items, or business inventory.
              </p>
              <ul class="space-y-2 mb-6">
                <li class="flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span class="text-muted-foreground">Holds approximately 1-2 rooms of items</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span class="text-muted-foreground">Ideal for boxes, small furniture items</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span class="text-muted-foreground">Climate control available</span>
                </li>
              </ul>
              <div class="text-center">
                <a href="/request-quote" class={buttonVariants({ className: 'bg-primary text-white hover:bg-primary/90 w-full justify-center' })}>
                  Get Quote
                </a>
              </div>
            </div>
            
            <!-- Medium Storage -->
            <div class="bg-white p-6 rounded-lg shadow-md border-2 border-primary hover:shadow-lg transition-all">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path><path d="M3 15h18"></path><path d="M9 3v18"></path><path d="M15 3v18"></path></svg>
              </div>
              <h3 class="font-display font-bold text-xl text-center mb-2 text-secondary">Medium Storage Unit</h3>
              <div class="text-center mb-4">
                <span class="text-primary font-semibold">10' x 10' to 10' x 15'</span>
              </div>
              <p class="text-muted-foreground mb-4 text-center">
                Ideal for storing the contents of a 1-2 bedroom apartment, including larger furniture.
              </p>
              <ul class="space-y-2 mb-6">
                <li class="flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span class="text-muted-foreground">Holds full bedroom sets, living room furniture</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span class="text-muted-foreground">Perfect for home staging or renovation storage</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span class="text-muted-foreground">Most popular short-term storage option</span>
                </li>
              </ul>
              <div class="text-center">
                <a href="/request-quote" class={buttonVariants({ className: 'bg-primary text-white hover:bg-primary/90 w-full justify-center' })}>
                  Get Quote
                </a>
              </div>
            </div>
            
            <!-- Large Storage -->
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 hover:shadow-lg transition-all">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="20" height="20" x="2" y="2" rx="2"></rect><path d="M2 12h20"></path><path d="M12 2v20"></path></svg>
              </div>
              <h3 class="font-display font-bold text-xl text-center mb-2 text-secondary">Large Storage Unit</h3>
              <div class="text-center mb-4">
                <span class="text-primary font-semibold">10' x 20' and larger</span>
              </div>
              <p class="text-muted-foreground mb-4 text-center">
                Suitable for storing the contents of a 3-4 bedroom house during moves or renovations.
              </p>
              <ul class="space-y-2 mb-6">
                <li class="flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span class="text-muted-foreground">Accommodates large appliances and furniture</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span class="text-muted-foreground">Ideal for whole-home renovations</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span class="text-muted-foreground">Drive-up access for easy loading</span>
                </li>
              </ul>
              <div class="text-center">
                <a href="/request-quote" class={buttonVariants({ className: 'bg-primary text-white hover:bg-primary/90 w-full justify-center' })}>
                  Get Quote
                </a>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Our Process -->
        <div class="mb-16">
          <div class="text-center mb-10">
            <h2 class="font-display font-bold text-3xl mb-4 text-secondary">Our Storage Process</h2>
            <p class="text-muted-foreground max-w-3xl mx-auto">
              Simple, hassle-free storage from pickup to delivery.
            </p>
          </div>
          
          <div class="max-w-3xl mx-auto relative">
            <!-- Timeline Line -->
            <div class="absolute left-1/2 top-0 bottom-0 w-1 bg-primary/20 transform -translate-x-1/2 hidden md:block"></div>
            
            <!-- Step 1 -->
            <div class="relative mb-12">
              <div class="md:flex items-center">
                <div class="md:w-1/2 pr-0 md:pr-12 text-left md:text-right">
                  <h3 class="font-display font-semibold text-xl mb-2 text-secondary">1. Initial Consultation</h3>
                  <p class="text-muted-foreground">
                    Contact us to discuss your storage needs, timeline, and any special requirements. We'll recommend the appropriate unit size and provide a transparent quote.
                  </p>
                </div>
                <div class="absolute left-0 md:left-1/2 top-0 -translate-x-1/2 w-10 h-10 bg-primary rounded-full z-10 flex items-center justify-center text-white font-bold">1</div>
                <div class="md:w-1/2 pl-12 md:pl-12 hidden md:block"></div>
              </div>
            </div>
            
            <!-- Step 2 -->
            <div class="relative mb-12">
              <div class="md:flex items-center">
                <div class="md:w-1/2 pr-12 hidden md:block"></div>
                <div class="absolute left-0 md:left-1/2 top-0 -translate-x-1/2 w-10 h-10 bg-primary rounded-full z-10 flex items-center justify-center text-white font-bold">2</div>
                <div class="md:w-1/2 pl-12 md:pl-12">
                  <h3 class="font-display font-semibold text-xl mb-2 text-secondary">2. Pickup Service (Optional)</h3>
                  <p class="text-muted-foreground">
                    Our professional team can pick up your items directly from your home or business. We'll carefully wrap, pack, and inventory your belongings before transporting them to our facility.
                  </p>
                </div>
              </div>
            </div>
            
            <!-- Step 3 -->
            <div class="relative mb-12">
              <div class="md:flex items-center">
                <div class="md:w-1/2 pr-0 md:pr-12 text-left md:text-right">
                  <h3 class="font-display font-semibold text-xl mb-2 text-secondary">3. Secure Storage</h3>
                  <p class="text-muted-foreground">
                    Your items are safely stored in our secure, clean facility. Climate-controlled units are available for temperature-sensitive belongings. Access your unit during business hours as needed.
                  </p>
                </div>
                <div class="absolute left-0 md:left-1/2 top-0 -translate-x-1/2 w-10 h-10 bg-primary rounded-full z-10 flex items-center justify-center text-white font-bold">3</div>
                <div class="md:w-1/2 pl-12 md:pl-12 hidden md:block"></div>
              </div>
            </div>
            
            <!-- Step 4 -->
            <div class="relative">
              <div class="md:flex items-center">
                <div class="md:w-1/2 pr-12 hidden md:block"></div>
                <div class="absolute left-0 md:left-1/2 top-0 -translate-x-1/2 w-10 h-10 bg-primary rounded-full z-10 flex items-center justify-center text-white font-bold">4</div>
                <div class="md:w-1/2 pl-12 md:pl-12">
                  <h3 class="font-display font-semibold text-xl mb-2 text-secondary">4. Delivery Service</h3>
                  <p class="text-muted-foreground">
                    When you're ready to retrieve your items, we can deliver them to your specified location. Our team will handle all loading, transportation, and unloading with the same care as the initial pickup.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Short-Term Storage Benefits -->
        <div class="bg-gray-50 p-8 rounded-lg border border-gray-100 shadow-md mb-16">
          <h2 class="font-display font-bold text-2xl mb-6 text-secondary text-center">Benefits of Our Short-Term Storage</h2>
          
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
              <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><circle cx="12" cy="12" r="10"></circle><path d="m8 12 3 3 5-5"></path></svg>
              </div>
              <h3 class="font-semibold text-lg text-secondary mb-2">Flexibility</h3>
              <p class="text-muted-foreground text-sm">
                No long-term commitments. Store your items for as little as a week or as long as needed with easy extension options.
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
              <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path><path d="M9 21v-9"></path><path d="M15 12v9"></path></svg>
              </div>
              <h3 class="font-semibold text-lg text-secondary mb-2">Security</h3>
              <p class="text-muted-foreground text-sm">
                Our facility features 24/7 surveillance, secure access controls, and regular security patrols for complete peace of mind.
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
              <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M17.2 6.8a4 4 0 0 0-5.7 0l-2.9 3-3.8 3.9"></path><path d="M222 2 2 22"></path></svg>
              </div>
              <h3 class="font-semibold text-lg text-secondary mb-2">Convenience</h3>
              <p class="text-muted-foreground text-sm">
                Our optional pickup and delivery services eliminate the need to rent a truck or make multiple trips to a storage facility.
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
              <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path><path d="M12 8v4l2 2"></path></svg>
              </div>
              <h3 class="font-semibold text-lg text-secondary mb-2">Accessibility</h3>
              <p class="text-muted-foreground text-sm">
                Access your belongings during our regular business hours, with extended hours available by appointment for special circumstances.
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
              <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
              </div>
              <h3 class="font-semibold text-lg text-secondary mb-2">Peace of Mind</h3>
              <p class="text-muted-foreground text-sm">
                Rest easy knowing your items are protected by our comprehensive insurance coverage throughout their time in our care.
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
              <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path><path d="M8 11h8"></path><path d="M8 15h8"></path><path d="M11 11v4"></path></svg>
              </div>
              <h3 class="font-semibold text-lg text-secondary mb-2">Professional Handling</h3>
              <p class="text-muted-foreground text-sm">
                Our trained staff expertly handles your belongings, using proper techniques and materials to prevent damage during storage and transit.
              </p>
            </div>
          </div>
        </div>
        
        <!-- FAQ -->
        <div class="mb-16">
          <div class="text-center mb-10">
            <h2 class="font-display font-bold text-3xl mb-4 text-secondary">Frequently Asked Questions</h2>
          </div>
          
          <div class="space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <h3 class="font-semibold text-lg text-secondary mb-2">What is the minimum storage period?</h3>
              <p class="text-muted-foreground">
                Our short-term storage options start at just one week, with no long-term commitments required. You can extend your storage period as needed on a week-to-week or month-to-month basis.
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <h3 class="font-semibold text-lg text-secondary mb-2">Are my items insured while in storage?</h3>
              <p class="text-muted-foreground">
                Yes, we provide basic insurance coverage for all stored items. Additional coverage options are available for high-value belongings. We can discuss insurance details during your consultation.
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <h3 class="font-semibold text-lg text-secondary mb-2">How quickly can I access my stored items?</h3>
              <p class="text-muted-foreground">
                You can access your stored items during our regular business hours (Monday-Saturday, 9am-6pm) with 24 hours' notice. For emergency access outside these hours, please contact our customer service team.
              </p>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
              <h3 class="font-semibold text-lg text-secondary mb-2">What can't be stored in your facility?</h3>
              <p class="text-muted-foreground">
                For safety and regulatory reasons, we cannot accept perishable items, hazardous materials, flammable substances, illegal items, or live plants/animals. Our team can provide a complete list of prohibited items.
              </p>
            </div>
          </div>
        </div>
        
        <!-- Call to Action -->
        <div class="text-center">
          <h2 class="font-display font-bold text-2xl mb-4 text-secondary">Need Short-Term Storage?</h2>
          <p class="text-muted-foreground max-w-2xl mx-auto mb-6">
            Contact our team today to discuss your short-term storage needs and get a personalized quote.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/request-quote" class={buttonVariants({ className: 'bg-primary text-white hover:bg-primary/90' })}>
              Get a Storage Quote
            </a>
            <a href="/storage-services" class={buttonVariants({ className: 'bg-secondary text-white hover:bg-secondary/90' })}>
              View All Storage Options
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
