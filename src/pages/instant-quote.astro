---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MoverbaseRedirect from '../components/MoverbaseRedirect.astro';
import { buttonVariants } from "@/components/ui/button";
---

<BaseLayout
  title="Instant Moving Quote | Legacy Moving Denver | Same-Day Estimates"
  description="Get an instant moving quote from Legacy Moving Denver. Fast, transparent pricing with no hidden fees. Licensed, insured, and 5-star rated Denver movers."
>
  <!-- Trust Bar -->
  <div class="bg-secondary text-white py-2 text-sm">
    <div class="container">
      <div class="flex flex-wrap items-center justify-center gap-4 md:gap-8 text-xs md:text-sm">
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Licensed &amp; Insured
        </span>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          5-Star Rated
        </span>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          Denver Local Experts
        </span>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          6,000+ Moves Completed
        </span>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          A+ Rated on BBB
        </span>
      </div>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-secondary via-secondary to-secondary/90 py-14 md:py-20 text-white overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1400&auto=format&q=80')] bg-cover bg-center opacity-10"></div>
    <!-- Diagonal accent -->
    <div class="absolute bottom-0 right-0 w-1/2 h-full bg-primary/5 clip-diagonal"></div>
    
    <div class="container relative z-10">
      <div class="grid lg:grid-cols-5 gap-8 items-center">
        <!-- Left: Content (3 cols) -->
        <div class="lg:col-span-2">
          <div class="inline-flex items-center gap-2 bg-primary/20 border border-primary/30 rounded-full px-4 py-1.5 text-sm font-medium mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            Denver's #1 Rated Movers
          </div>
          
          <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight">
            Your Move.<br>
            <span class="text-primary">Our Priority.</span>
          </h1>
          
          <p class="text-lg text-white/85 mb-8 max-w-lg">
            Get a fast, accurate quote in minutes — no phone tag, no guessing games. Just honest pricing from Denver's most trusted moving team.
          </p>

          <!-- Stats Row -->
          <div class="grid grid-cols-3 gap-4 mb-8">
            <div class="text-center bg-white/10 rounded-xl p-3 backdrop-blur-sm">
              <div class="font-display font-bold text-2xl text-primary">6K+</div>
              <div class="text-xs text-white/70 mt-0.5">Moves Done</div>
            </div>
            <div class="text-center bg-white/10 rounded-xl p-3 backdrop-blur-sm">
              <div class="font-display font-bold text-2xl text-primary">5★</div>
              <div class="text-xs text-white/70 mt-0.5">Avg Rating</div>
            </div>
            <div class="text-center bg-white/10 rounded-xl p-3 backdrop-blur-sm">
              <div class="font-display font-bold text-2xl text-primary">A</div>
              <div class="text-xs text-white/70 mt-0.5">BBB Rated</div>
            </div>
          </div>

          <!-- Call CTA -->
          <a href="tel:7203401849" class="inline-flex items-center gap-3 bg-primary hover:bg-primary/90 text-white font-semibold py-3.5 px-7 rounded-xl transition-all hover:scale-105 shadow-lg shadow-primary/30">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            Call (720) 340-1849
          </a>
        </div>

        <!-- Right: Quote Form (3 cols) -->
        <div class="lg:col-span-3">
          <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">
            <div class="bg-primary px-8 py-5">
              <h2 class="font-display font-bold text-xl text-white">Get Your Free Instant Quote</h2>
              <p class="text-white/80 text-sm mt-1">Fill in your details — we'll respond fast.</p>
            </div>
            <div class="p-6 md:p-8">
              <div data-version="10" id="J8QDKR-instant"></div>
              <script is:inline>
              (function(r,k) {
                var s = document.createElement('script');
                s.async = true;
                s.defer = true;
                s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
                s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); } );
                document.getElementById(r).appendChild(s);
              })('J8QDKR-instant','JGCB6TGFN7N3NTTDOGMQUK1S9L3A4N73LYF2ZX4H248K97JD');
              </script>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="text-center mb-12">
        <span class="inline-block bg-primary/10 text-primary text-sm font-semibold px-4 py-1.5 rounded-full mb-3">Simple Process</span>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-secondary mb-3">How to Get Your Quote</h2>
        <p class="text-muted-foreground max-w-xl mx-auto">Three easy steps to lock in your move date and pricing.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto relative">
        <!-- Connector line -->
        <div class="hidden md:block absolute top-10 left-1/6 right-1/6 h-0.5 bg-primary/20 z-0"></div>

        <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100 text-center relative z-10">
          <div class="w-16 h-16 bg-primary rounded-2xl flex items-center justify-center text-white font-display font-bold text-2xl mx-auto mb-4 shadow-lg shadow-primary/30">1</div>
          <h3 class="font-display font-semibold text-lg text-secondary mb-2">Submit Your Details</h3>
          <p class="text-muted-foreground text-sm">Fill out the form above with your move date, addresses, and any special items.</p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100 text-center relative z-10">
          <div class="w-16 h-16 bg-primary rounded-2xl flex items-center justify-center text-white font-display font-bold text-2xl mx-auto mb-4 shadow-lg shadow-primary/30">2</div>
          <h3 class="font-display font-semibold text-lg text-secondary mb-2">Receive Your Quote</h3>
          <p class="text-muted-foreground text-sm">Our team reviews your move details and sends back a transparent, all-inclusive estimate.</p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100 text-center relative z-10">
          <div class="w-16 h-16 bg-primary rounded-2xl flex items-center justify-center text-white font-display font-bold text-2xl mx-auto mb-4 shadow-lg shadow-primary/30">3</div>
          <h3 class="font-display font-semibold text-lg text-secondary mb-2">Book Your Move</h3>
          <p class="text-muted-foreground text-sm">Approve the quote and we lock in your move date. Same-week availability often available!</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Included / Features -->
  <section class="py-16">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 items-center max-w-5xl mx-auto">
        <div>
          <span class="inline-block bg-primary/10 text-primary text-sm font-semibold px-4 py-1.5 rounded-full mb-4">What You Get</span>
          <h2 class="font-display font-bold text-3xl md:text-4xl text-secondary mb-6">Every Quote Includes These Guarantees</h2>
          <p class="text-muted-foreground mb-8">We believe in full transparency from the very first number we give you. Here's what's always included:</p>

          <ul class="space-y-4">
            {[
              ["Transparent Flat-Rate Pricing", "No hidden fees, no surprise charges on move day. What we quote is what you pay."],
              ["Professional Uniformed Crew", "Background-checked, uniformed movers who treat your home and belongings with respect."],
              ["Damage Protection Options", "We wrap and pad your furniture as standard. Additional coverage available."],
              ["Flexible Scheduling", "Weekend, weekday, same-week — we work around your timeline."],
              ["No Travel-Time Surprises", "We don't start the clock until we're at your door."],
            ].map(([title, desc]) => (
              <li class="flex items-start gap-4">
                <div class="w-8 h-8 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div>
                  <span class="font-semibold text-secondary">{title}</span>
                  <p class="text-muted-foreground text-sm mt-0.5">{desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Badges / Social proof -->
        <div class="space-y-5">
          <div class="bg-secondary text-white rounded-2xl p-6">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-14 h-14 bg-primary/20 rounded-full flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <div>
                <div class="font-display font-bold text-2xl">6,000+</div>
                <div class="text-white/70 text-sm">Successful Moves Completed</div>
              </div>
            </div>
            <p class="text-white/80 text-sm leading-relaxed">"The Legacy team was on time, careful with everything, and finished under the estimated time. I could not recommend them more."</p>
            <div class="flex items-center gap-1 mt-3">
              {[...Array(5)].map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#f97316" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
              <span class="text-white/60 text-xs ml-2">— Verified Google Review</span>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="bg-primary/5 border border-primary/15 rounded-2xl p-5 text-center">
              <div class="text-3xl font-display font-bold text-primary mb-1">A</div>
              <div class="text-sm font-semibold text-secondary">BBB Rating</div>
              <div class="text-xs text-muted-foreground mt-1">Better Business Bureau</div>
            </div>
            <div class="bg-primary/5 border border-primary/15 rounded-2xl p-5 text-center">
              <div class="text-3xl font-display font-bold text-primary mb-1">5★</div>
              <div class="text-sm font-semibold text-secondary">Google Rating</div>
              <div class="text-xs text-muted-foreground mt-1">1,780+ reviews</div>
            </div>
            <div class="bg-primary/5 border border-primary/15 rounded-2xl p-5 text-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mx-auto mb-1"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <div class="text-sm font-semibold text-secondary">Licensed &amp; Insured</div>
              <div class="text-xs text-muted-foreground mt-1">DOT · MC · PUC</div>
            </div>
            <div class="bg-primary/5 border border-primary/15 rounded-2xl p-5 text-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mx-auto mb-1"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <div class="text-sm font-semibold text-secondary">Same-Week Available</div>
              <div class="text-xs text-muted-foreground mt-1">Call to confirm dates</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-secondary mb-3">Quick-Answer FAQs</h2>
        <p class="text-muted-foreground max-w-xl mx-auto">Everything you need to know before your move.</p>
      </div>

      <div class="max-w-3xl mx-auto space-y-4">
        {[
          ["How quickly will I receive my quote?", "Most quotes are returned within a few hours during business hours. For urgent moves, call us directly at (720) 340-1849 for an immediate estimate."],
          ["Is your pricing truly all-inclusive?", "Yes. Our quotes include crew labor, truck, blankets, shrink wrap, and basic disassembly/reassembly. We'll always flag any exceptions upfront."],
          ["Do you offer last-minute or same-day moves?", "We do our best to accommodate short-notice moves. Same-week and sometimes same-day slots open up — fill out the form or call to check availability."],
          ["Are your movers background-checked?", "Absolutely. Every crew member goes through a thorough background check. We only hire professionals we'd trust in our own homes."],
          ["What if something gets damaged?", "We carry full liability insurance and offer additional coverage options. We document your items before loading and take every precaution to prevent damage."],
        ].map(([q, a]) => (
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
            <h3 class="font-display font-semibold text-lg text-secondary mb-2">{q}</h3>
            <p class="text-muted-foreground">{a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-16 bg-primary">
    <div class="container text-center">
      <h2 class="font-display font-bold text-3xl md:text-4xl text-white mb-4">Ready to Get Moving?</h2>
      <p class="text-white/85 text-lg mb-8 max-w-xl mx-auto">Join over 6,000 Denver families and businesses who've trusted Legacy Moving with their most important belongings.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#top" class="inline-flex items-center gap-2 bg-white text-primary hover:bg-white/90 font-semibold py-3.5 px-8 rounded-xl transition-all hover:scale-105 shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
          Get My Free Quote
        </a>
        <a href="tel:7203401849" class="inline-flex items-center gap-2 border-2 border-white/40 text-white hover:bg-white/10 font-semibold py-3.5 px-8 rounded-xl transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call (720) 340-1849
        </a>
      </div>
    </div>
  </section>

  <MoverbaseRedirect />
</BaseLayout>
