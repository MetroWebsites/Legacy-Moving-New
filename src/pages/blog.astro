            <div class="h-48 relative overflow-hidden">
              <Image
                src={longDistanceImage}
                alt="How to prepare utilities and address changes before moving in Denver"
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-br from-secondary/55 to-primary/50"></div>
            </div>
            <div class="p-6">
              <div class="flex items-center gap-4 text-sm text-muted-foreground mb-3">
                <div class="flex items-center gap-1"><Calendar size={16} /><span>Aug 15, 2026</span></div>
                <div class="flex items-center gap-1"><Clock size={16} /><span>7 min read</span></div>
