---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { Calendar, Clock, ArrowRight } from 'lucide-react';
import heroImage from '../assets/services/hero.jpg';
import longDistanceImage from '../assets/services/longdistance.jpg';
import truckBlogImage from '../assets/truck-in-driveway-legacy-moving-denver_nw_b9c9f7fe.jpeg';
import packingBlogImage from '../assets/working-ad-legacy-moving-denver_nw_c7ceaf8e.jpeg';
import teamBlogImage from '../assets/308748956_459885262825080_6269738357866645302_n_nw_0489b96e.jpg';
import furnitureBlogImage from '../assets/290197457_539473571254356_3082118749704086809_n_nw_a389c17b.jpg';
import img4115Image from '../assets/img_4115-legacy-moving-denver_nw_2e617951.jpeg';
import residentialImage from '../assets/services/residential.jpg';
import packingImage from '../assets/services/packing.jpg';
import commercialImage from '../assets/services/commercial.jpg';
import storageImage from '../assets/services/storage.jpg';
import loadingImage from '../assets/services/loading.jpg';
---

<BaseLayout
  title="Moving Blog | Tips, Advice & Guides | Legacy Moving Denver"
  description="Expert moving advice, tips, and guides from Legacy Moving Denver. Learn about moving to Colorado, packing tips, and professional moving services."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16 md:py-20">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt="Legacy Moving Denver Blog" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">Moving Blog</h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto">
          Expert moving advice, tips, and guides from Denver's trusted moving professionals.
        </p>
      </div>
    </div>
  </section>

  <!-- Blog Posts Grid -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container">
      <div class="max-w-6xl mx-auto">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

          <!-- Blog Post: Best Time of Year to Move in Colorado — May 22 2026 -->
          <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow">
            <div class="h-48 relative overflow-hidden">
              <Image
                src={img4115Image}
                alt="Best time of year to move in Colorado Denver"
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-br from-secondary/60 to-primary/40"></div>
            </div>
            <div class="p-6">
              <div class="flex items-center gap-4 text-sm text-muted-foreground mb-3">
                <div class="flex items-center gap-1"><Calendar size={16} /><span>May 22, 2026</span></div>
                <div class="flex items-center gap-1"><Clock size={16} /><span>9 min read</span></div>
              </div>
              <h2 class="font-display font-bold text-xl text-secondary mb-3 line-clamp-2">Best Time of Year to Move in Colorado</h2>
              <p class="text-muted-foreground mb-4 line-clamp-3">Timing your move right can save you money and reduce stress. A month-by-month breakdown of when to move in Denver — and when to avoid it.</p>
              <a href="/blog/best-time-of-year-to-move-in-colorado" class={buttonVariants({ variant: 'default', className: 'w-full' })}>
                Read More <ArrowRight size={16} className="ml-2" />
              </a>
            </div>
          </article>

          <!-- Blog Post: How to Move a 3 Bedroom Home — May 15 2026 -->
          <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow">
            <div class="h-48 relative overflow-hidden">
              <Image
                src={furnitureBlogImage}
                alt="How to move a 3 bedroom home efficiently Denver"
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-br from-secondary/60 to-primary/40"></div>
            </div>
            <div class="p-6">
              <div class="flex items-center gap-4 text-sm text-muted-foreground mb-3">
                <div class="flex items-center gap-1"><Calendar size={16} /><span>May 15, 2026</span></div>
                <div class="flex items-center gap-1"><Clock size={16} /><span>10 min read</span></div>
              </div>
              <h2 class="font-display font-bold text-xl text-secondary mb-3 line-clamp-2">How to Move a 3-Bedroom Home Efficiently</h2>
              <p class="text-muted-foreground mb-4 line-clamp-3">Three bedrooms is the tipping point where moves get complicated. Here's the room-by-room strategy that keeps your move from turning into a two-day ordeal.</p>
              <a href="/blog/how-to-move-a-3-bedroom-home-efficiently" class={buttonVariants({ variant: 'default', className: 'w-full' })}>
                Read More <ArrowRight size={16} className="ml-2" />
              </a>
