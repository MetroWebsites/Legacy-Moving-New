---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { Calendar, Clock, ArrowRight } from 'lucide-react';
import { getCollection } from 'astro:content';
import blogMetadata from '../data/blog-metadata.json';
import heroImage from '../assets/services/hero.jpg';
import longDistanceImage from '../assets/services/longdistance.jpg';
import truckBlogImage from '../assets/truck-in-driveway-legacy-moving-denver_nw_b9c9f7fe.jpeg';
import packingBlogImage from '../assets/working-ad-legacy-moving-denver_nw_c7ceaf8e.jpeg';
import teamBlogImage from '../assets/308748956_459885262825080_6269738357866645302_n_nw_0489b96e.jpg';
import furnitureBlogImage from '../assets/290197457_539473571254356_3082118749704086809_n_nw_a389c17b.jpg';
import img4115Image from '../assets/img_4115-legacy-moving-denver_nw_2e617951.jpeg';
import residentialImage from '../assets/services/residential.jpg';
import packingImage from '../assets/services/packing.jpg';
import commercialImage from '../assets/services/commercial.jpg';
import storageImage from '../assets/services/storage.jpg';
import loadingImage from '../assets/services/loading.jpg';

// Get blog posts from content collection (markdown files)
const contentPosts = await getCollection('blog');
const contentPostsFormatted = contentPosts.map(post => ({
  slug: post.slug,
  title: post.data.title,
  excerpt: post.data.excerpt,
  publishDate: post.data.publishDate,
  readTime: post.data.readTime || '10 min read',
  source: 'content'
}));

// Get blog posts from pages (astro files) via metadata
const pagePosts = blogMetadata;

// Combine both sources
const allPosts = [...contentPostsFormatted, ...pagePosts];

// Sort by date (newest first)
const sortedPosts = allPosts.sort((a, b) => {
  return new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime();
});

// New truck images for blog variety
const truckDriver1 = '/images/trucks/truck-driver-1.jpg';
const truckDriver2 = '/images/trucks/truck-driver-2.jpg';
const handshake1 = '/images/trucks/handshake-1.jpg';
const handshake2 = '/images/trucks/handshake-2.jpg';
const blueTruckFront = '/images/trucks/blue-truck-front.jpg';
const blueTruckAngle1 = '/images/trucks/blue-truck-angle-1.jpg';
const blueTruckAngle2 = '/images/trucks/blue-truck-angle-2.jpg';
const blueTruckAngle3 = '/images/trucks/blue-truck-angle-3.jpg';
const blueTruckAngle4 = '/images/trucks/blue-truck-angle-4.jpg';
const blueTruckAngle5 = '/images/trucks/blue-truck-angle-5.jpg';
const whiteTruck1 = '/images/trucks/white-truck-1.jpg';
const whiteTruck2 = '/images/trucks/white-truck-2.jpg';
const whiteTruckSide = '/images/trucks/white-truck-side.jpg';
const whiteTruckFront = '/images/trucks/white-truck-front.jpg';
const blueTruckFront2 = '/images/trucks/blue-truck-front-2.jpg';
const blueTruckFront3 = '/images/trucks/blue-truck-front-3.jpg';
const blueTruckSideFull = '/images/trucks/blue-truck-side-full.jpg';
const whiteTruckSideFull = '/images/trucks/white-truck-side-full.jpg';

// Array of images to cycle through for blog posts
const blogImages = [
  storageImage, residentialImage, packingImage, commercialImage, loadingImage,
  longDistanceImage, truckBlogImage, packingBlogImage, teamBlogImage, 
  furnitureBlogImage, img4115Image
];
---

<BaseLayout
  title="Moving Blog | Tips, Advice & Guides | Legacy Moving Denver"
  description="Expert moving advice, tips, and guides from Legacy Moving Denver. Learn about moving to Colorado, packing tips, and professional moving services."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16 md:py-20">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={heroImage} 
        alt="Legacy Moving Denver Blog" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">Moving Blog</h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto">
          Expert moving advice, tips, and guides from Denver's trusted moving professionals.
        </p>
      </div>
    </div>
  </section>

  <!-- Blog Posts Grid -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container">
      <div class="max-w-6xl mx-auto">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedPosts.map((post, index) => {
            const blogImage = blogImages[index % blogImages.length];
            const formattedDate = new Date(post.publishDate).toLocaleDateString('en-US', { 
              month: 'short', 
              day: 'numeric', 
              year: 'numeric' 
            });
            const readTime = post.readTime || '10 min read';
            
            return (
              <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow">
                <div class="h-48 relative overflow-hidden">
                  <Image
                    src={blogImage}
                    alt={post.title}
                    class="w-full h-full object-cover"
                  />
                  <div class="absolute inset-0 bg-gradient-to-br from-primary/50 to-secondary/60"></div>
                </div>
                <div class="p-6">
                  <div class="flex items-center gap-4 text-sm text-muted-foreground mb-3">
                    <div class="flex items-center gap-1"><Calendar size={16} client:load /><span>{formattedDate}</span></div>
                    <div class="flex items-center gap-1"><Clock size={16} client:load /><span>{readTime}</span></div>
                  </div>
                  <h2 class="font-display font-bold text-xl text-secondary mb-3 line-clamp-2">{post.title}</h2>
                  <p class="text-muted-foreground mb-4 line-clamp-3">{post.excerpt}</p>
                  <a href={`/blog/${post.slug}`} class={buttonVariants({ variant: 'default', className: 'w-full' })}>
                    Read More <ArrowRight size={16} className="ml-2" />
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- Google Preferred Source Banner -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="max-w-2xl mx-auto text-center">
        <h3 class="font-display font-bold text-2xl text-secondary mb-4">Stay Updated with Our Moving Tips</h3>
        <p class="text-muted-foreground mb-6">
          Add Legacy Moving Denver as a preferred source on Google to see our moving advice and updates in your search results.
        </p>
        <div google-add-preferred-source-btn data-theme="light"></div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-primary text-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6">Ready to Start Your Move?</h2>
        <p class="text-white/90 text-lg mb-8">
          Get a free quote from Denver's trusted moving professionals today.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold transition-colors' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary border border-white text-white hover:bg-secondary/80 hover:text-white phone-link transition-colors' })} data-google-link="https://maps.app.goo.gl/9YhGXwHp1TMi6xoG9">
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
