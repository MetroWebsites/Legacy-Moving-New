---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { Check, Truck, DollarSign, Users, TrendingUp, Calendar, Heart } from 'lucide-react';
import teamImage from '../assets/308748956_459885262825080_6269738357866645302_n_nw_0489b96e.jpg';
import movingTeamImage from '../assets/316101089_503116645168608_274775893289684396_n_nw_fa94dd6a.jpg';
---

<BaseLayout
  title="Work For Us | Join Legacy Moving Denver | Careers & Jobs"
  description="Join the Legacy Moving Denver team! We're hiring professional movers, drivers, and staff. Great pay, flexible schedules, and growth opportunities. Apply today!"
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16 md:py-20">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={teamImage} 
        alt="Legacy Moving Denver team" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">Work For Us</h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Join the Legacy Moving Denver family and build a rewarding career with Denver's most trusted moving company. We're always looking for dedicated professionals who take pride in exceptional service.
        </p>
        <a href="#apply" class={buttonVariants({ size: 'lg', className: 'bg-primary text-white hover:bg-primary/90 font-semibold' })}>
          Apply Now
        </a>
      </div>
    </div>
  </section>

  <!-- Why Join Our Team -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">Why Join Our Team?</h2>
          <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
            At Legacy Moving Denver, we don't just hire employees—we build a family of professionals dedicated to excellence.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Benefit 1 -->
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
              <DollarSign size={24} className="text-primary" />
            </div>
            <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Competitive Pay</h3>
            <p class="text-muted-foreground">
              Industry-leading wages with opportunities for bonuses, tips, and regular raises based on performance and dedication.
            </p>
          </div>

          <!-- Benefit 2 -->
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
              <Calendar size={24} className="text-primary" />
            </div>
            <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Flexible Scheduling</h3>
            <p class="text-muted-foreground">
              We understand work-life balance. Choose full-time or part-time options and work with management to accommodate your needs.
            </p>
          </div>

          <!-- Benefit 3 -->
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
              <TrendingUp size={24} className="text-primary" />
            </div>
            <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Career Growth</h3>
            <p class="text-muted-foreground">
              We promote from within. Start as a mover and advance to lead mover, driver, supervisor, or management positions.
            </p>
          </div>

          <!-- Benefit 4 -->
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
              <Users size={24} className="text-primary" />
            </div>
            <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Team Environment</h3>
            <p class="text-muted-foreground">
              Work alongside experienced professionals who support each other, share knowledge, and celebrate wins together.
            </p>
          </div>

          <!-- Benefit 5 -->
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
              <Truck size={24} className="text-primary" />
            </div>
            <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Professional Equipment</h3>
            <p class="text-muted-foreground">
              Work with well-maintained trucks, quality moving equipment, and all the tools you need to do the job right.
            </p>
          </div>

          <!-- Benefit 6 -->
          <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
              <Heart size={24} className="text-primary" />
            </div>
            <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Positive Culture</h3>
            <p class="text-muted-foreground">
              Join a company that values respect, integrity, and customer service. We treat our team the way we treat our customers.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Current Positions -->
  <section class="py-16 md:py-24">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">Open Positions</h2>
          <p class="text-muted-foreground text-lg">
            We're always looking for talented individuals to join our growing team.
          </p>
        </div>

        <div class="space-y-8">
          <!-- Position 1: Professional Mover -->
          <div class="bg-white p-8 rounded-lg shadow-md border border-gray-100">
            <div class="flex flex-wrap justify-between items-start gap-4 mb-4">
              <div>
                <h3 class="font-display font-bold text-2xl text-secondary mb-2">Professional Mover</h3>
                <p class="text-muted-foreground">The backbone of our operations</p>
              </div>
              <span class="bg-primary text-white px-4 py-2 rounded-full font-semibold text-sm">Full-Time / Part-Time</span>
            </div>

            <div class="mb-6">
              <h4 class="font-semibold text-secondary mb-3">What You'll Do:</h4>
              <div class="grid md:grid-cols-2 gap-3">
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Load and unload customer belongings safely</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Pack and protect items for transport</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Disassemble and reassemble furniture</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Provide outstanding customer service</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Work efficiently as part of a team</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Maintain professionalism at all times</span>
                </div>
              </div>
            </div>

            <div class="mb-6">
              <h4 class="font-semibold text-secondary mb-3">What We're Looking For:</h4>
              <div class="grid md:grid-cols-2 gap-3">
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Ability to lift 75-100 lbs regularly</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Strong work ethic and reliability</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Good communication skills</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Valid driver's license (preferred)</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Positive attitude and team player</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Previous moving experience (a plus)</span>
                </div>
              </div>
            </div>

            <div class="bg-primary/5 p-4 rounded-lg mb-6">
              <p class="text-secondary font-semibold">💰 Competitive hourly rate + tips + bonuses</p>
            </div>
          </div>

          <!-- Position 2: Moving Truck Driver -->
          <div class="bg-white p-8 rounded-lg shadow-md border border-gray-100">
            <div class="flex flex-wrap justify-between items-start gap-4 mb-4">
              <div>
                <h3 class="font-display font-bold text-2xl text-secondary mb-2">Moving Truck Driver</h3>
                <p class="text-muted-foreground">Lead moves and drive our fleet</p>
              </div>
              <span class="bg-accent text-white px-4 py-2 rounded-full font-semibold text-sm">Full-Time</span>
            </div>

            <div class="mb-6">
              <h4 class="font-semibold text-secondary mb-3">What You'll Do:</h4>
              <div class="grid md:grid-cols-2 gap-3">
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Safely operate moving trucks (16-26ft)</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Lead moving crews and coordinate logistics</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Conduct pre-trip vehicle inspections</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Manage paperwork and customer interactions</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Ensure crew safety and efficiency</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Load and unload with your team</span>
                </div>
              </div>
            </div>

            <div class="mb-6">
              <h4 class="font-semibold text-secondary mb-3">What We're Looking For:</h4>
              <div class="grid md:grid-cols-2 gap-3">
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Valid driver's license (clean record)</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Experience driving large trucks</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Leadership and problem-solving skills</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Moving industry experience (required)</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">Excellent customer service</span>
                </div>
                <div class="flex items-start gap-2">
                  <Check size={18} className="text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-muted-foreground">DOT medical card (or willing to obtain)</span>
                </div>
              </div>
            </div>

            <div class="bg-accent/5 p-4 rounded-lg mb-6">
              <p class="text-secondary font-semibold">💰 Higher pay rate + leadership bonuses + tips</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Application Section -->
  <section id="apply" class="py-16 md:py-24 bg-gradient-to-r from-primary to-secondary text-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6">Ready to Join Our Team?</h2>
        <p class="text-white/90 text-lg mb-8">
          We're excited to meet you! To apply, give us a call or send your resume and a brief introduction about yourself.
        </p>
        
        <div class="bg-white/10 backdrop-blur-sm p-8 rounded-lg border border-white/20 mb-8">
          <div class="grid md:grid-cols-2 gap-6 text-left">
            <div>
              <h3 class="font-semibold text-lg mb-2">📞 Call Us</h3>
              <a href="tel:7203401849" class="text-white hover:text-accent transition-colors text-xl font-bold phone-link">
                (720) 340-1849
              </a>
              <p class="text-white/80 text-sm mt-1">Mon-Sun: 8:00am - 6:00pm</p>
            </div>
            
            <div>
              <h3 class="font-semibold text-lg mb-2">📧 Email Your Resume</h3>
              <a href="mailto:info@legacymovingdenver.com?subject=Job Application" class="text-white hover:text-accent transition-colors text-lg font-bold break-all">
                info@legacymovingdenver.com
              </a>
              <p class="text-white/80 text-sm mt-1">Include "Job Application" in subject</p>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-accent hover:text-white font-semibold transition-colors phone-link' })}>
            Call to Apply
          </a>
          <a href="/contact" class={buttonVariants({ size: 'lg', className: 'bg-transparent border-2 border-white text-white hover:bg-white hover:text-secondary font-semibold transition-colors' })}>
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Expect -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-8 text-secondary text-center">What to Expect</h2>
        
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center mx-auto mb-4 text-2xl font-bold">
              1
            </div>
            <h3 class="font-semibold text-xl mb-2 text-secondary">Application</h3>
            <p class="text-muted-foreground">
              Call or email us with your information. We'll review your experience and schedule a conversation.
            </p>
          </div>
          
          <div class="text-center">
            <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center mx-auto mb-4 text-2xl font-bold">
              2
            </div>
            <h3 class="font-semibold text-xl mb-2 text-secondary">Interview</h3>
            <p class="text-muted-foreground">
              Meet with our team to discuss the role, your experience, and answer any questions you have.
            </p>
          </div>
          
          <div class="text-center">
            <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center mx-auto mb-4 text-2xl font-bold">
              3
            </div>
            <h3 class="font-semibold text-xl mb-2 text-secondary">Get Started</h3>
            <p class="text-muted-foreground">
              Complete onboarding, receive training, and start working with one of Denver's best moving teams!
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
