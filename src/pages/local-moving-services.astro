---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { Check, Home, Calendar, Clock, MapPin, TrendingUp } from 'lucide-react';
import ContactForm from '@/components/ContactForm';
import residentialImage from '../assets/img_4114-legacy-moving-denver_nw_9a9d79b0.jpeg';
---

<BaseLayout
  title="Local Moving Services Denver | Legacy Moving Denver"
  description="Professional local moving services in Denver. Our Denver movers provide affordable, reliable moving solutions for homes and apartments. Get a free quote today."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-primary to-primary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={residentialImage} 
        alt="Legacy Moving Denver local movers in action" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">Local Moving Services</h1>
        <p class="text-xl text-white/90 mb-8 max-w-2xl">
          Professional, affordable moving services for homes and apartments within the Denver metro area. Our local movers provide stress-free relocations.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/request-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-primary hover:bg-secondary hover:text-white font-semibold' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary text-white hover:bg-secondary/80 font-semibold' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
        <div>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">Denver's Premier Local Movers</h2>
          <p class="text-muted-foreground mb-4">
            Legacy Moving Denver specializes in local moves throughout the Denver metro area. Our experienced team knows the city's neighborhoods, streets, and buildings, allowing us to provide efficient, hassle-free moving services.
          </p>
          <p class="text-muted-foreground mb-6">
            Whether you're moving to a new apartment downtown or relocating to a house in the suburbs, our local movers have the expertise and equipment to make your move smooth and stress-free.
          </p>
          
          <div class="space-y-4 mt-8">
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Expert knowledge of Denver neighborhoods</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Fast, efficient service with minimal downtime</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Experienced with apartment and high-rise moves</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Affordable hourly rates with transparent pricing</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Clean, well-maintained trucks and equipment</p>
            </div>
          </div>
        </div>
        
        <div>
          <div class="bg-gray-50 p-6 rounded-lg border border-gray-100 shadow-md">
            <h3 class="font-display font-bold text-xl mb-4 text-secondary">Our Local Moving Services Include:</h3>
            <ul class="space-y-3">
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <Home size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Residential Moves</h4>
                  <p class="text-muted-foreground text-sm">Complete moving services for houses, apartments, and condos in the Denver area</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <Calendar size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Flexible Scheduling</h4>
                  <p class="text-muted-foreground text-sm">Weekend, evening, and same-day moving options to fit your timeline</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <MapPin size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Denver Metro Coverage</h4>
                  <p class="text-muted-foreground text-sm">Service throughout Denver and surrounding communities like Lakewood, Aurora, and Centennial</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <TrendingUp size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Specialized Moves</h4>
                  <p class="text-muted-foreground text-sm">Expert handling for difficult moves involving stairs, elevators, or tight spaces</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-3xl mb-4 text-secondary">Transparent Local Moving Rates</h2>
        <p class="text-muted-foreground max-w-3xl mx-auto">Our local moving services are priced with transparency and fairness. No hidden fees or surprise charges.</p>
      </div>
      
      <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-md overflow-hidden border border-gray-100">
          <div class="bg-secondary text-white p-4">
            <h3 class="font-display font-semibold text-xl">Local Moving Pricing</h3>
          </div>
          <div class="p-6">
            <div class="space-y-4">
              <div class="flex justify-between items-center pb-2 border-b border-gray-100">
                <p class="font-medium text-secondary">2 Professional Movers & Truck</p>
                <p class="font-bold text-primary">Starting at $129/hour*</p>
              </div>
              
              <div class="flex justify-between items-center pb-2 border-b border-gray-100">
                <p class="font-medium text-secondary">3 Professional Movers & Truck</p>
                <p class="font-bold text-primary">Starting at $159/hour*</p>
              </div>
              
              <div class="flex justify-between items-center pb-2 border-b border-gray-100">
                <p class="font-medium text-secondary">4 Professional Movers & Truck</p>
                <p class="font-bold text-primary">Starting at $199/hour*</p>
              </div>
              
              <div class="flex justify-between items-center pb-2 border-b border-gray-100">
                <p class="font-medium text-secondary">Additional Mover</p>
                <p class="font-bold text-primary">$40/hour each</p>
              </div>
              
              <p class="text-xs text-muted-foreground mt-4">
                * Rates are subject to a 2-hour minimum. Travel time charge applies. Packing materials and services are available at additional cost. Special items may require additional fees. Please contact us for a detailed quote specific to your needs.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="bg-primary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">Ready for a Smooth Local Move?</h2>
        <p class="text-white/90 text-lg mb-8">
          Get in touch with our local moving specialists today for a free, detailed quote on your Denver area move.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/request-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold transition-colors' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary border border-white text-white hover:bg-secondary/80 hover:text-white phone-link transition-colors' })} data-google-link="https://maps.app.goo.gl/E3SEsp435kWzLBeQ8">
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>