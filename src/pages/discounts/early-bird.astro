---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from '@/components/ContactForm';
import { buttonVariants } from "@/components/ui/button";
import { Image } from 'astro:assets';
import { Calendar, Phone, DollarSign, Clock, Route, Tag } from "lucide-react";
import movingImage from '../../assets/316550678_506021318211474_228316229773797537_n_nw_727420e9.jpg';
---

<BaseLayout
  title="Early-Bird Out-of-State Moving Discount | Legacy Moving Denver"
  description="Book your out-of-state move 30 days in advance and save with our exclusive Early-Bird discount. Get the best rates on long-distance moving services from Denver's trusted movers."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image src={movingImage} alt="Legacy Moving Denver - Early Bird Discount" class="w-full h-full object-cover" />
    </div>
    <div class="container relative py-16 md:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl leading-tight mb-6">
          Early-Bird <span class="text-primary/90">Out-of-State Savings</span>
        </h1>
        <p class="text-lg md:text-xl text-white/90 mb-8">
          Plan ahead and save big on your next long-distance move. Book your out-of-state move 30 days in advance and enjoy exclusive discounts on our professional moving services.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-primary text-white hover:bg-primary/80 hover:text-white font-semibold' })}>
            Lock In Your Savings
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary/80 border border-primary/20 text-white hover:bg-primary/90 hover:text-white phone-link' })} data-google-link="https://maps.app.goo.gl/E3SEsp435kWzLBeQ8">
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Discount Details -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-xl overflow-hidden border border-primary/10">
          <div class="bg-primary/10 p-6 border-b border-primary/20">
            <div class="flex items-center gap-4">
              <Calendar size={32} className="text-primary" />
              <h2 class="text-2xl md:text-3xl font-bold text-secondary">Early-Bird Out-of-State Discount</h2>
            </div>
          </div>
          <div class="p-6">
            <div class="mb-6">
              <h3 class="text-xl font-semibold text-secondary mb-2">Discount Details:</h3>
              <ul class="space-y-2 text-muted-foreground">
                <li class="flex items-center gap-2">
                  <DollarSign size={18} className="text-primary flex-shrink-0" />
                  <span><strong>15% off</strong> your total long-distance moving costs when you book 30 days or more in advance</span>
                </li>
                <li class="flex items-center gap-2">
                  <Route size={18} className="text-primary flex-shrink-0" />
                  <span>Valid for all out-of-state moves, regardless of destination</span>
                </li>
                <li class="flex items-center gap-2">
                  <Clock size={18} className="text-primary flex-shrink-0" />
                  <span>Promotion valid until December 31, 2025</span>
                </li>
                <li class="flex items-center gap-2">
                  <Tag size={18} className="text-primary flex-shrink-0" />
                  <span>Additional savings available on packing services when added to your early-bird booking</span>
                </li>
              </ul>
            </div>

            <div class="mb-6">
              <h3 class="text-xl font-semibold text-secondary mb-2">How to Claim:</h3>
              <p class="text-muted-foreground mb-4">
                To take advantage of our Early-Bird discount, simply request a quote and schedule your out-of-state move at least 30 days before your moving date. Mention this promotion when speaking with our team to ensure the discount is applied to your estimate.
              </p>
            </div>

            <div class="bg-gray-50 p-4 rounded-md border border-gray-200 mb-6">
              <p class="text-sm text-muted-foreground">
                <strong>Note:</strong> This discount applies only to out-of-state moves scheduled 30 days or more in advance. Cannot be combined with other promotional offers. Subject to availability. Discount applies to labor costs only and excludes materials, long carries, or other additional services.
              </p>
            </div>

            <div class="text-center">
              <a 
                href="/get-quote" 
                class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-primary text-white font-medium hover:bg-primary/90 transition-colors"
              >
                Get Your Discounted Quote
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold text-secondary text-center mb-8">Why Plan Your Move Early?</h2>
        
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white rounded-lg p-6 shadow-md">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path></svg>
              </div>
              <h3 class="text-xl font-semibold text-secondary">Better Availability</h3>
            </div>
            <p class="text-muted-foreground">
              Booking early ensures you get your preferred moving date and time, especially during peak moving seasons when schedules fill up quickly.
            </p>
          </div>
          
          <div class="bg-white rounded-lg p-6 shadow-md">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M20.91 8.84 8.56 2.23a1.93 1.93 0 0 0-1.81 0L3.1 4.13a1.93 1.93 0 0 0-.97 1.68v5.7c0 .7.4 1.32 1.03 1.63l9.8 4.89c.56.28 1.22.28 1.78 0l9.19-4.6a1.93 1.93 0 0 0 1.07-1.74V10.5c0-.69-.38-1.32-1.09-1.66Z"></path><path d="M3.09 9.84v4.69c0 .69.38 1.32 1.03 1.63l9.8 4.89c.56.28 1.22.28 1.78 0l9.19-4.6c.71-.35 1.1-.99 1.1-1.74V9.84"></path><path d="M20.91 8.84 8.56 2.23a1.93 1.93 0 0 0-1.81 0L3.1 4.13a1.93 1.93 0 0 0-.97 1.68v5.7c0 .7.4 1.32 1.03 1.63l9.8 4.89c.56.28 1.22.28 1.78 0l9.19-4.6a1.93 1.93 0 0 0 1.07-1.74V10.5c0-.69-.38-1.32-1.09-1.66Z"></path><path d="M12 22V12"></path></svg>
              </div>
              <h3 class="text-xl font-semibold text-secondary">Reduced Stress</h3>
            </div>
            <p class="text-muted-foreground">
              With more time to prepare, you can tackle your move methodically rather than rushing. This leads to a smoother, less stressful experience for everyone involved.
            </p>
          </div>
          
          <div class="bg-white rounded-lg p-6 shadow-md">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><circle cx="12" cy="12" r="10"></circle><path d="m8 14 2.5-2.5c.83-.83 2.17-.83 3 0L16 14"></path><path d="m8 10 2.5-2.5c.83-.83 2.17-.83 3 0L16 10"></path></svg>
              </div>
              <h3 class="text-xl font-semibold text-secondary">Better Planning</h3>
            </div>
            <p class="text-muted-foreground">
              Early booking gives you time to properly inventory your belongings, declutter before the move, and ensure everything is ready for moving day.
            </p>
          </div>
          
          <div class="bg-white rounded-lg p-6 shadow-md">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 2v8"></path><path d="m4.93 10.93 1.41 1.41"></path><path d="M2 18h2"></path><path d="M20 18h2"></path><path d="m19.07 10.93-1.41 1.41"></path><path d="M22 22H2"></path><path d="M16 6 8 14"></path><path d="m16 14-2-3-3-1-3 3"></path></svg>
              </div>
              <h3 class="text-xl font-semibold text-secondary">Significant Savings</h3>
            </div>
            <p class="text-muted-foreground">
              Beyond our Early-Bird discount, planning ahead allows you to budget more effectively and potentially save on related expenses like temporary housing or storage.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote Form -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="bg-white shadow-xl rounded-lg overflow-hidden">
          <div class="bg-secondary text-white p-6 text-center">
            <h2 class="text-2xl md:text-3xl font-bold mb-2">Plan Ahead & Save Big</h2>
            <p class="text-white/90">Fill out the form below to lock in your Early-Bird discount. Be sure to mention your planned moving date!</p>
          </div>
          <div class="p-6">
            <!-- KEEP ALL FORMS client:load !! DO NOT USE client:visible AS THIS CAUSES HYDRATION ISSUES!!-->
            <ContactForm client:load />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>