---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from '@/components/ContactForm';
import { buttonVariants } from "@/components/ui/button";
import { Image } from 'astro:assets';
import { Medal, Phone, Shield, Truck, Users, Clock } from "lucide-react";
import movingImage from '../../assets/290197457_539473571254356_3082118749704086809_n_nw_a389c17b.jpg';
---

<BaseLayout
  title="Military Discount | Legacy Moving Denver - Serving Those Who Serve"
  description="Legacy Moving Denver offers special discounts to active duty military, veterans, and their families. Thank you for your service - enjoy exclusive savings on your next move!"
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image src={movingImage} alt="Legacy Moving Denver - Military Discount" class="w-full h-full object-cover" />
    </div>
    <div class="container relative py-16 md:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl leading-tight mb-6">
          Military & Veteran <span class="text-primary/90">Moving Discounts</span>
        </h1>
        <p class="text-lg md:text-xl text-white/90 mb-8">
          Thank you for your service. We're honored to offer special discounts to active military, veterans, and their families as our way of showing appreciation for your sacrifice and dedication.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-primary text-white hover:bg-primary/80 hover:text-white font-semibold' })}>
            Claim Your Discount
          </a>
          <a href="tel:9706164481" class={buttonVariants({ size: 'lg', className: 'bg-secondary/80 border border-primary/20 text-white hover:bg-primary/90 hover:text-white phone-link' })} data-google-link="https://maps.app.goo.gl/guTYTjBgBgSYpH5L9">
            Call (970) 616-4481
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Discount Details -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-xl overflow-hidden border border-primary/10">
          <div class="bg-primary/10 p-6 border-b border-primary/20">
            <div class="flex items-center gap-4">
              <Medal size={32} className="text-primary" />
              <h2 class="text-2xl md:text-3xl font-bold text-secondary">Military & Veteran Discount</h2>
            </div>
          </div>
          <div class="p-6">
            <div class="mb-6">
              <h3 class="text-xl font-semibold text-secondary mb-2">Discount Details:</h3>
              <ul class="space-y-2 text-muted-foreground">
                <li class="flex items-center gap-2">
                  <Shield size={18} className="text-primary flex-shrink-0" />
                  <span><strong>10% off</strong> your total moving costs for all active duty military, veterans, and their immediate families</span>
                </li>
                <li class="flex items-center gap-2">
                  <Clock size={18} className="text-primary flex-shrink-0" />
                  <span>Valid for moves scheduled before December 31, 2025</span>
                </li>
                <li class="flex items-center gap-2">
                  <Truck size={18} className="text-primary flex-shrink-0" />
                  <span>Applicable to all our moving services: local moves, long-distance, packing, and labor-only services</span>
                </li>
                <li class="flex items-center gap-2">
                  <Users size={18} className="text-primary flex-shrink-0" />
                  <span>Available to active duty military, veterans, reserves, National Guard, and immediate family members</span>
                </li>
              </ul>
            </div>

            <div class="mb-6">
              <h3 class="text-xl font-semibold text-secondary mb-2">How to Claim:</h3>
              <p class="text-muted-foreground mb-4">
                To claim your military discount, simply mention this offer when you request a quote or call us to schedule your move. We'll ask for valid military ID or proof of service (DD-214 or other documentation) on the day of your move.
              </p>
            </div>

            <div class="bg-gray-50 p-4 rounded-md border border-gray-200 mb-6">
              <p class="text-sm text-muted-foreground">
                <strong>Note:</strong> This discount cannot be combined with other promotional offers. Valid military ID or proof of service required. Discount applies to labor costs only and excludes materials, long carries, or other additional services.
              </p>
            </div>

            <div class="text-center">
              <a 
                href="/get-quote" 
                class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-primary text-white font-medium hover:bg-primary/90 transition-colors"
              >
                Request Your Discounted Quote
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold text-secondary text-center mb-8">Why Military Families Choose Legacy Moving</h2>
        
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white rounded-lg p-6 shadow-md">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="m12 8-9.04 9.06a2.82 2.82 0 1 0 3.98 3.98L16 12"></path><circle cx="17" cy="7" r="5"></circle></svg>
              </div>
              <h3 class="text-xl font-semibold text-secondary">Experienced with Military Moves</h3>
            </div>
            <p class="text-muted-foreground">
              Our team understands the unique challenges of military relocations, including tight timelines and specific requirements. We've helped numerous military families move smoothly and efficiently.
            </p>
          </div>
          
          <div class="bg-white rounded-lg p-6 shadow-md">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path></svg>
              </div>
              <h3 class="text-xl font-semibold text-secondary">Secure and Reliable</h3>
            </div>
            <p class="text-muted-foreground">
              Your belongings are in safe hands with our professional team. We treat your possessions with the utmost care and respect, ensuring they arrive at your new home intact.
            </p>
          </div>
          
          <div class="bg-white rounded-lg p-6 shadow-md">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
              </div>
              <h3 class="text-xl font-semibold text-secondary">We Value Your Service</h3>
            </div>
            <p class="text-muted-foreground">
              Our military discount isn't just a promotion—it's our way of saying thank you for your dedication and sacrifice to our country. We're proud to serve those who serve.
            </p>
          </div>
          
          <div class="bg-white rounded-lg p-6 shadow-md">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 2v8"></path><path d="m4.93 10.93 1.41 1.41"></path><path d="M2 18h2"></path><path d="M20 18h2"></path><path d="m19.07 10.93-1.41 1.41"></path><path d="M22 22H2"></path><path d="M16 6 8 14"></path><path d="m16 14-2-3-3-1-3 3"></path></svg>
              </div>
              <h3 class="text-xl font-semibold text-secondary">Transparent Pricing</h3>
            </div>
            <p class="text-muted-foreground">
              No hidden fees or surprises. We provide clear, detailed estimates and apply your military discount upfront so you know exactly what to expect on moving day.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote Form -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="bg-white shadow-xl rounded-lg overflow-hidden">
          <div class="bg-secondary text-white p-6 text-center">
            <h2 class="text-2xl md:text-3xl font-bold mb-2">Request Your Military Discount</h2>
            <p class="text-white/90">Fill out the form below to get your discounted quote. Remember to mention your military status!</p>
          </div>
          <div class="p-6">
            <!-- KEEP ALL FORMS client:load !! DO NOT USE client:visible AS THIS CAUSES HYDRATION ISSUES!!-->
            <ContactForm client:load />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>