---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { Check, Package, Truck, Clock, MapPin, Home, ShieldCheck } from 'lucide-react';
import residentialImage from '../assets/img_4114-legacy-moving-denver_nw_9a9d79b0.jpeg';
---

<BaseLayout
  title="Residential Moving Services Denver | Legacy Moving Denver"
  description="Professional residential moving services in Denver. Our local movers provide affordable, reliable home moving solutions. Get a free quote for your Denver residential move."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={residentialImage} 
        alt="Legacy Moving Denver residential movers in action" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">Residential Moving Services</h1>
        <p class="text-xl text-white/90 mb-8 max-w-2xl">
          Professional, affordable home moving services in Denver. Our experienced team makes your residential move easy and stress-free.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-primary text-white hover:bg-primary/90 font-semibold' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-gray-100 font-semibold' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
        <div>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">Denver's Trusted Residential Movers</h2>
          <p class="text-muted-foreground mb-4">
            Since 2018, Legacy Moving Denver has provided top-quality residential moving services to the Denver metro area. Our experienced team specializes in making your home move easy, efficient, and stress-free.
          </p>
          <p class="text-muted-foreground mb-6">
            Whether you're moving from a studio apartment or a large family home, our professional movers provide the care, expertise, and reliability you need for a smooth transition to your new residence.
          </p>
          
          <div class="space-y-4 mt-8">
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Fully licensed and insured residential movers</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Professional, trained moving crews</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Careful handling of all your belongings</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Clean, well-maintained moving trucks</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Transparent, upfront pricing - no hidden fees</p>
            </div>
          </div>
        </div>
        
        <div>
          <div class="bg-gray-50 p-6 rounded-lg border border-gray-100 shadow-md">
            <h3 class="font-display font-bold text-xl mb-4 text-secondary">Our Residential Moving Services Include:</h3>
            <ul class="space-y-3">
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <Home size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Local Home Moves</h4>
                  <p class="text-muted-foreground text-sm">Complete moving services for apartments, condos, and houses in the Denver area</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <Package size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Packing & Unpacking</h4>
                  <p class="text-muted-foreground text-sm">Professional packing services with quality materials to protect your belongings</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <Truck size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Loading & Transport</h4>
                  <p class="text-muted-foreground text-sm">Careful loading, secure transport, and precise placement at your new home</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <ShieldCheck size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Furniture Protection</h4>
                  <p class="text-muted-foreground text-sm">Specialized padding and wrapping for furniture and fragile items</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="bg-primary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">Ready for Your Hassle-Free Move?</h2>
        <p class="text-white/90 text-lg mb-8">
          Get in touch with our residential moving specialists today for a free, detailed quote on your local Denver move.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/request-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-primary hover:bg-secondary hover:text-white font-semibold transition-colors' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary border border-white text-white hover:bg-secondary/80 hover:text-white phone-link transition-colors' })} data-google-link="https://maps.app.goo.gl/E3SEsp435kWzLBeQ8">
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>