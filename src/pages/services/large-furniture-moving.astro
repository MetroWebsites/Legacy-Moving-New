---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Image } from "astro:assets";
import movingImage from "../../assets/services/residential.jpg";
---

<BaseLayout
  title="Large Furniture Moving Denver | Oversized Furniture Movers Colorado | Legacy Moving"
  description="Professional large and oversized furniture moving in Denver and across Colorado. Sectional sofas, armoires, oversized beds, entertainment centers, and custom pieces that require disassembly, stair navigation, or tight-space expertise. Free quotes."
>
  <!-- Hero Section -->
  <section class="relative bg-secondary py-16 md:py-24 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-15 mix-blend-overlay">
      <Image src={movingImage} alt="Legacy Moving Denver movers carefully maneuvering an oversized sectional sofa through a doorway" class="w-full h-full object-cover" loading="eager" />
    </div>
    <div class="container relative z-10">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div class="text-center lg:text-left">
          <span class="inline-block px-4 py-1 mb-5 rounded-full bg-primary/25 text-white text-sm font-semibold">Oversized Furniture Moving Specialists</span>
          <h1 class="font-display font-bold text-4xl md:text-5xl mb-6 leading-tight">
            Large & Oversized Furniture <span class="text-primary">Moving in Denver</span>
          </h1>
          <p class="text-lg md:text-xl text-white/90 max-w-xl mx-auto lg:mx-0 mb-8">
            Not all furniture fits neatly through standard doorways or around tight corners. We specialize in the oversized, the awkward, and the "there's no way this fits" pieces — and we get them there without damaging your furniture or your home.
          </p>
          <div class="hidden lg:flex flex-col sm:flex-row gap-4">
            <a href="#quote-form" class={buttonVariants({ size: "lg", className: "bg-primary text-white hover:bg-primary/90 font-semibold" })}>Get a Free Quote</a>
            <a href="tel:7203401849" class={buttonVariants({ size: "lg", className: "bg-white !text-secondary hover:bg-white/90 font-semibold phone-link" })}>Call (720) 340-1849</a>
          </div>
        </div>
        <div id="quote-form" class="bg-white rounded-2xl shadow-2xl p-6 md:p-8">
          <p class="font-display font-bold text-xl text-secondary mb-4 text-center">Get Your Free Furniture Moving Quote</p>
          <div data-version="4" id="56AIR8-furniture"></div>
          <script is:inline>
            (function(r,k) {
              var s = document.createElement('script');
              s.async = true;
              s.defer = true;
              s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
              s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
              document.getElementById(r).appendChild(s);
            })('56AIR8-furniture','PE277BJIM3OAT6PP0J8IF0BJ5VH5WR8SG2NIKF7AD92OR5EF');
          </script>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 lg:hidden">
          <a href="#quote-form" class={buttonVariants({ size: "lg", className: "bg-primary text-white hover:bg-primary/90 font-semibold" })}>Get a Free Quote</a>
          <a href="tel:7203401849" class={buttonVariants({ size: "lg", className: "bg-white !text-secondary hover:bg-white/90 font-semibold phone-link" })}>Call (720) 340-1849</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <section class="py-8 bg-gray-50 border-b border-gray-100">
    <div class="container">
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12">
        <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span class="font-medium text-secondary">Licensed & Insured</span></div>
        <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg><span class="font-medium text-secondary">1,700+ Five-Star Reviews</span></div>
        <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg><span class="font-medium text-secondary">Disassembly & Reassembly</span></div>
        <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><span class="font-medium text-secondary">Floor & Wall Protection</span></div>
      </div>
    </div>
  </section>

  <!-- Why Large Furniture Is Challenging -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container max-w-5xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
            The Challenge with <span class="text-primary">Oversized Furniture</span>
          </h2>
          <div class="space-y-5 text-gray-700">
            <p>
              Modern homes often have wide-open main floors but narrow doorways, tight stair landings, or hallways that simply weren't designed for today's oversized sectional sofas and California King bedroom suites. Getting large furniture in — or out — of these spaces requires planning, the right technique, and sometimes creative problem-solving.
            </p>
            <p>
              Sectional sofas present one of the most common challenges. The individual sections are manageable, but the connecting hardware and cushion configurations mean they can only be disassembled so far. Getting the pieces around a 90-degree corner staircase requires careful angle calculation and controlled tipping. Done wrong, the result is gouged walls, broken furniture feet, or a sofa that doesn't fit.
            </p>
            <p>
              Armoires, wardrobe cabinets, and tall entertainment centers present similar issues — they're heavy, the center of gravity is high, and they need to travel through doors with limited clearance. Our crews are skilled at safe tipping, angle analysis, and furniture slider techniques that protect both the piece and your floors.
            </p>
          </div>
        </div>
        <div class="space-y-4">
          <div class="bg-primary/5 border border-primary/20 rounded-xl p-6">
            <h3 class="font-display font-bold text-xl text-secondary mb-4">Large Items We Specialize In</h3>
            <ul class="space-y-3">
              {[
                ["Sectional Sofas", "Multi-piece sectionals, modular sofas, and curved sectionals requiring angle navigation"],
                ["Armoires & Wardrobes", "Tall, heavy cabinets that require safe tipping and careful door clearance management"],
                ["Oversized Beds", "California King, Split King, and custom platform beds with headboards too large for standard doors"],
                ["Entertainment Centers", "Built-in style media centers and large wall unit components"],
                ["Dining Room Sets", "Oversized farm tables, extension tables with heavy bases, and large buffet cabinets"],
                ["Custom & One-of-a-Kind Pieces", "Handmade, custom-ordered furniture that can't be replaced if damaged"],
                ["Murphy Beds & Wall Beds", "Disassembly and reassembly of fold-down bed systems"],
              ].map(([type, desc]) => (
                <li class="flex gap-3 items-start">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-0.5 flex-shrink-0"><path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
                  <div>
                    <span class="font-semibold text-secondary text-sm">{type}</span>
                    <span class="text-gray-600 text-sm"> — {desc}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-16 md:py-20 bg-gray-50">
    <div class="container max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
          Our Large Furniture <span class="text-primary">Moving Process</span>
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {[
          ["Pre-Move Measurement & Planning", "We discuss dimensions, doorway widths, stair clearances, and target room access before move day. No surprises when we arrive."],
          ["Floor & Doorway Protection", "Moving blankets, floor runners, and door jamb foam protect your home. Furniture sliders go under legs before dragging becomes necessary."],
          ["Strategic Disassembly", "Legs removed, beds disassembled, mirror/hutch tops separated from bases, shelf units broken down. We disassemble exactly what needs to come apart — no more, no less."],
          ["Angle Analysis for Stairs & Corners", "Tight corners and stair landings require careful angle calculation. Our crew walks the path first and plans the moves before attempting them."],
          ["Wrapping & Padding", "All pieces wrapped in furniture blankets before loading. Finished surfaces never touch metal or concrete."],
          ["Reassembly at Destination", "Furniture reassembled at the destination — legs reinstalled, beds built, cabinets reconnected. We don't leave you with a pile of parts."],
        ].map(([step, desc], i) => (
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 flex gap-4">
            <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center flex-shrink-0 font-bold text-white">{i + 1}</div>
            <div>
              <h3 class="font-display font-bold text-lg text-secondary mb-2">{step}</h3>
              <p class="text-gray-600 text-sm">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container max-w-3xl mx-auto">
      <h2 class="font-display font-bold text-3xl md:text-4xl mb-10 text-secondary text-center">Large Furniture Moving <span class="text-primary">FAQs</span></h2>
      <div class="space-y-4">
        {[
          ["What if my furniture doesn't fit through the door?", "There are usually more options than people realize — removing door hinges gains an inch, removing the door entirely gains two inches, and carefully tilting furniture at specific angles often creates clearance that wasn't apparent. In extreme cases, large windows can be used for entry if the framing allows. We've solved this problem many times."],
          ["Do you disassemble and reassemble furniture?", "Yes. Standard disassembly and reassembly (legs, mirrors, headboards, removable shelving) is included in our service. Complex built-in units or furniture requiring specialist tools may be priced as an add-on — we'll discuss this during your quote."],
          ["Can you move furniture to a new room within my current home?", "Yes. We handle in-home furniture rearrangements as well as full moves. If you've just received a new sofa and need the old one repositioned, or you're redesigning a room layout, we can help."],
          ["What's the best way to protect my hardwood floors when moving heavy furniture?", "We use furniture sliders under all legs before moving any heavy piece. Moving blankets protect surfaces during transit, and we place floor runners in traffic areas. The key is never dragging furniture directly on hardwood — always using sliders."],
          ["Can you handle furniture that needs to go through a second-floor window?", "For truly oversized pieces that cannot navigate stairs or hallways, window entry is occasionally necessary. This requires proper rigging equipment and crew experience. Let us know about extreme access challenges when requesting your quote so we can plan accordingly."],
          ["What items can't you disassemble?", "Some furniture — particularly antiques, custom upholstered pieces, or units without visible hardware — shouldn't be disassembled. We assess each piece honestly and will tell you if disassembly isn't advisable for a particular item."],
        ].map(([q, a]) => (
          <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
            <button class="w-full p-6 text-left flex items-center justify-between cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary focus:ring-inset hover:bg-gray-50 transition-colors" onclick="this.parentElement.querySelector('.faq-answer').classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');">
              <h3 class="font-display font-semibold text-lg text-secondary pr-4">{q}</h3>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 flex-shrink-0"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="faq-answer hidden">
              <div class="p-6 pt-0 border-t border-gray-100"><p class="text-muted-foreground">{a}</p></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-primary text-white">
    <div class="container text-center max-w-3xl mx-auto">
      <h2 class="font-display font-bold text-3xl md:text-4xl mb-6">Need to Move a Large or Awkward Piece?</h2>
      <p class="text-white/90 text-lg mb-8">Call Legacy Moving — Denver's experts in oversized furniture moves. Free quotes, no obligation.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:7203401849" class={buttonVariants({ size: "lg", className: "bg-white !text-secondary hover:bg-white/90 font-semibold phone-link" })}>Call (720) 340-1849</a>
        <a href="#quote-form" class={buttonVariants({ size: "lg", className: "bg-secondary border border-white text-white hover:bg-secondary/80" })}>Get a Free Quote</a>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="py-12 bg-white border-t border-gray-100">
    <div class="container max-w-4xl mx-auto text-center">
      <h3 class="font-display font-bold text-xl text-secondary mb-5">More Specialty Moving Services</h3>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/services/specialty-items" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">All Specialty Moving</a>
        <a href="/services/pool-table-moving" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">Pool Table Moving</a>
        <a href="/services/piano-moving" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">Piano Moving</a>
        <a href="/services/fitness-equipment-moving" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">Fitness Equipment</a>
        <a href="/services/residential-moving" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">Residential Moving</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Large Furniture Moving Services Denver",
    "description": "Professional large and oversized furniture moving in Denver, Colorado. Sectional sofas, armoires, oversized beds, entertainment centers. Disassembly, stair navigation, tight-space expertise.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Legacy Moving Denver",
      "telephone": "+17203401849",
      "address": { "@type": "PostalAddress", "streetAddress": "8805 W. 14th Ave, Suite 300", "addressLocality": "Lakewood", "addressRegion": "CO", "postalCode": "80215", "addressCountry": "US" }
    },
    "areaServed": { "@type": "City", "name": "Denver" },
    "serviceType": "Large Furniture Moving"
  }
  </script>
</BaseLayout>
