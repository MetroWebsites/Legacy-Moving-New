---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Image } from "astro:assets";
import movingImage from "../../assets/services/loading.jpg";
---

<BaseLayout
  title="Fitness Equipment Moving Denver | Gym Equipment Movers Colorado | Legacy Moving"
  description="Professional fitness equipment moving in Denver and across Colorado. Treadmills, weight racks, cable machines, Pelotons, ellipticals, and full home gym setups. Proper disassembly, floor protection, and reassembly. Free quotes, fully insured."
>
  <!-- Hero Section -->
  <section class="relative bg-secondary py-16 md:py-24 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-15 mix-blend-overlay">
      <Image src={movingImage} alt="Legacy Moving Denver fitness equipment movers safely loading a treadmill and weight equipment onto a moving truck" class="w-full h-full object-cover" loading="eager" />
    </div>
    <div class="container relative z-10">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div class="text-center lg:text-left">
          <span class="inline-block px-4 py-1 mb-5 rounded-full bg-primary/25 text-white text-sm font-semibold">Gym & Fitness Equipment Moving</span>
          <h1 class="font-display font-bold text-4xl md:text-5xl mb-6 leading-tight">
            Fitness Equipment Moving in Denver — <span class="text-primary">Your Gym, Moved Right</span>
          </h1>
          <p class="text-lg md:text-xl text-white/90 max-w-xl mx-auto lg:mx-0 mb-8">
            Home gym equipment is heavy, expensive, and often awkward to move. Treadmills don't fold easily. Cable machines weigh hundreds of pounds. Weight racks require complete breakdown. We've done this before — and we'll do it right.
          </p>
          <div class="hidden lg:flex flex-col sm:flex-row gap-4">
            <a href="#quote-form" class={buttonVariants({ size: "lg", className: "bg-primary text-white hover:bg-primary/90 font-semibold" })}>Get a Free Quote</a>
            <a href="tel:7203401849" class={buttonVariants({ size: "lg", className: "bg-white !text-secondary hover:bg-white/90 font-semibold phone-link" })}>Call (720) 340-1849</a>
          </div>
        </div>
        <div id="quote-form" class="bg-white rounded-2xl shadow-2xl p-6 md:p-8">
          <p class="font-display font-bold text-xl text-secondary mb-4 text-center">Get Your Free Fitness Equipment Moving Quote</p>
          <div data-version="4" id="56AIR8-fitness"></div>
          <script is:inline>
            (function(r,k) {
              var s = document.createElement('script');
              s.async = true;
              s.defer = true;
              s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
              s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
              document.getElementById(r).appendChild(s);
            })('56AIR8-fitness','PE277BJIM3OAT6PP0J8IF0BJ5VH5WR8SG2NIKF7AD92OR5EF');
          </script>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 lg:hidden">
          <a href="#quote-form" class={buttonVariants({ size: "lg", className: "bg-primary text-white hover:bg-primary/90 font-semibold" })}>Get a Free Quote</a>
          <a href="tel:7203401849" class={buttonVariants({ size: "lg", className: "bg-white !text-secondary hover:bg-white/90 font-semibold phone-link" })}>Call (720) 340-1849</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <section class="py-8 bg-gray-50 border-b border-gray-100">
    <div class="container">
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12">
        <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span class="font-medium text-secondary">Licensed & Insured</span></div>
        <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg><span class="font-medium text-secondary">1,700+ Five-Star Reviews</span></div>
        <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg><span class="font-medium text-secondary">Disassembly & Reassembly</span></div>
        <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><span class="font-medium text-secondary">Floor Protection Included</span></div>
      </div>
    </div>
  </section>

  <!-- Why Fitness Equipment Needs Specialists -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container max-w-5xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
            Moving Fitness Equipment Is <span class="text-primary">Harder Than It Looks</span>
          </h2>
          <div class="space-y-5 text-gray-700">
            <p>
              A home gym represents thousands of dollars in equipment. Treadmills weigh 150–300 lbs and have folding mechanisms that must be properly secured for transport. Cable machines with weight stacks can exceed 500 lbs and require complete disassembly to safely move. Even a Peloton, for all its sleek design, is a 140-lb piece of precision technology that can be damaged by a single impact to its display monitor.
            </p>
            <p>
              The floor protection challenge is equally important. Rubber gym flooring, hardwood, and tile can all be damaged by heavy equipment dragged or dropped carelessly. Olympic weight plates can chip tile if dropped. Power rack bases will gouge hardwood if slid without furniture sliders. Our crew uses proper floor protection throughout every fitness equipment move.
            </p>
            <p>
              Beyond weight, home gym equipment often lives in basement spaces with low ceilings, narrow doorways, and stairs with tight turns — exactly the kind of access challenge that requires experience to navigate safely. We assess these variables in advance and plan accordingly, so the equipment arrives at its new home intact and ready to use.
            </p>
          </div>
        </div>
        <div class="space-y-4">
          <div class="bg-primary/5 border border-primary/20 rounded-xl p-6">
            <h3 class="font-display font-bold text-xl text-secondary mb-4">Fitness Equipment We Move</h3>
            <ul class="space-y-3">
              {[
                ["Treadmills", "Commercial and residential treadmills — folded, secured, and protected"],
                ["Ellipticals & Rowers", "Large cardio machines requiring careful floor protection and door clearance"],
                ["Cable & Functional Trainers", "Weight stack machines fully disassembled for safe transport"],
                ["Power Racks & Squat Racks", "Complete breakdown and reassembly — every bolt accounted for"],
                ["Olympic Weight Sets", "Individual plate transport, barbell padding, and weight tree relocation"],
                ["Peloton & Smart Bikes", "Monitor-first protection, proper padding, and careful handling"],
                ["Multi-Station Gyms", "Complex multi-function home gym systems fully disassembled and rebuilt"],
                ["Commercial-Grade Equipment", "Gym relocation for small fitness studios and personal training facilities"],
              ].map(([type, desc]) => (
                <li class="flex gap-3 items-start">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-0.5 flex-shrink-0"><path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
                  <div>
                    <span class="font-semibold text-secondary text-sm">{type}</span>
                    <span class="text-gray-600 text-sm"> — {desc}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-16 md:py-20 bg-gray-50">
    <div class="container max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
          Our Fitness Equipment <span class="text-primary">Moving Process</span>
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {[
          ["Equipment Inventory & Assessment", "We review the full list of equipment being moved — types, sizes, weights, and any special considerations (monitors, weight stacks, calibration requirements)."],
          ["Floor Protection First", "Before any piece moves, floor runners or plywood protection goes down. Finished floors and rubber gym flooring are both protected from the first item to the last."],
          ["Strategic Disassembly", "Power racks come apart into uprights, crossmembers, and hardware. Cable machines have weight stacks removed individually. Monitors on cardio equipment are padded and secured before the machine moves."],
          ["Careful Loading & Padding", "Each piece is padded and loaded based on weight and fragility. Monitors, screens, and display panels get extra protection against vibration and impact."],
          ["Secure Transport", "Heavy equipment is strapped down in the truck to prevent any shifting. Weight plates are boxed or stacked securely — never loose in the truck bed."],
          ["Reassembly at New Location", "At the destination, we reassemble equipment according to the original configuration. Power racks are rebuilt, cable machines reconnected, and cardio equipment tested for smooth operation before we leave."],
        ].map(([step, desc], i) => (
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 flex gap-4">
            <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center flex-shrink-0 font-bold text-white">{i + 1}</div>
            <div>
              <h3 class="font-display font-bold text-lg text-secondary mb-2">{step}</h3>
              <p class="text-gray-600 text-sm">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container max-w-3xl mx-auto">
      <h2 class="font-display font-bold text-3xl md:text-4xl mb-10 text-secondary text-center">Fitness Equipment Moving <span class="text-primary">FAQs</span></h2>
      <div class="space-y-4">
        {[
          ["How much does it cost to move fitness equipment in Denver?", "Cost depends on the volume and type of equipment, stair access, and distance. Every situation is different, so we provide customized quotes. Contact us for a free itemized estimate tailored to your specific equipment."],
          ["Do you disassemble and reassemble power racks and cable machines?", "Yes. Full disassembly and reassembly is included in our fitness equipment moving service. We document the configuration before disassembly (photos of cable routing, pin positions, etc.) so everything goes back together exactly as it was."],
          ["Can you move gym equipment between rooms in my home?", "Absolutely. In-home gym relocations are a common service — particularly when converting a basement gym room or setting up a new workout space. We handle single-item moves and full room reconfigurations."],
          ["Will you move a Peloton or other connected fitness equipment?", "Yes. Pelotons, Mirror, Tonal, and other smart fitness equipment require careful handling to protect screens and monitors. We wrap displays first, secure the machine for transport, and handle delivery with the same care as any other high-value item."],
          ["What if my home gym is in the basement with tight stairs?", "This is the most common access challenge for fitness equipment moves. We assess stair dimensions during the quote process and plan accordingly — sometimes equipment needs to come apart further than usual to navigate tight landings. We've solved this challenge many times across Denver."],
          ["Do you move commercial gym equipment?", "Yes. If you're operating a small fitness studio, personal training space, or corporate fitness room, we can relocate your commercial-grade equipment. Larger commercial gym relocations may require a custom quote and additional crew — contact us to discuss."],
        ].map(([q, a]) => (
          <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
            <button class="w-full p-6 text-left flex items-center justify-between cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary focus:ring-inset hover:bg-gray-50 transition-colors" onclick="this.parentElement.querySelector('.faq-answer').classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');">
              <h3 class="font-display font-semibold text-lg text-secondary pr-4">{q}</h3>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 flex-shrink-0"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="faq-answer hidden">
              <div class="p-6 pt-0 border-t border-gray-100"><p class="text-muted-foreground">{a}</p></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-primary text-white">
    <div class="container text-center max-w-3xl mx-auto">
      <h2 class="font-display font-bold text-3xl md:text-4xl mb-6">Ready to Move Your Home Gym?</h2>
      <p class="text-white/90 text-lg mb-8">Call Legacy Moving for expert fitness equipment moving in Denver. Free quotes — no obligation.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:7203401849" class={buttonVariants({ size: "lg", className: "bg-white !text-secondary hover:bg-white/90 font-semibold phone-link" })}>Call (720) 340-1849</a>
        <a href="#quote-form" class={buttonVariants({ size: "lg", className: "bg-secondary border border-white text-white hover:bg-secondary/80" })}>Get a Free Quote</a>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="py-12 bg-white border-t border-gray-100">
    <div class="container max-w-4xl mx-auto text-center">
      <h3 class="font-display font-bold text-xl text-secondary mb-5">More Specialty Moving Services</h3>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/services/specialty-items" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">All Specialty Moving</a>
        <a href="/services/pool-table-moving" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">Pool Table Moving</a>
        <a href="/services/large-furniture-moving" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">Large Furniture</a>
        <a href="/services/gun-safe-moving" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">Gun Safe Moving</a>
        <a href="/services/commercial-moving" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">Commercial Moving</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Fitness Equipment Moving Services Denver",
    "description": "Professional fitness equipment moving in Denver, Colorado. Treadmills, weight racks, cable machines, Pelotons, and full home gym setups. Disassembly, floor protection, and reassembly included.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Legacy Moving Denver",
      "telephone": "+17203401849",
      "address": { "@type": "PostalAddress", "streetAddress": "8805 W. 14th Ave, Suite 300", "addressLocality": "Lakewood", "addressRegion": "CO", "postalCode": "80215", "addressCountry": "US" }
    },
    "areaServed": { "@type": "City", "name": "Denver" },
    "serviceType": "Fitness Equipment Moving"
  }
  </script>
</BaseLayout>
