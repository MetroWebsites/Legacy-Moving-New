---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Image } from "astro:assets";
import { Wrench, CheckCircle, Clock, DollarSign, Shield, Users } from "lucide-react";
import movingImage from "../../assets/services/residential.jpg";

const pageTitle = "Furniture Disassembly & Reassembly Moving Services Denver | Legacy Moving";
const pageDescription = "Professional furniture disassembly and reassembly as part of your move in Denver, Aurora, Lakewood, and surrounding areas. We disassemble at origin, safely transport, and reassemble at your new location.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="relative min-h-[500px] flex items-center justify-center overflow-hidden">
    <Image
      src={movingImage}
      alt="Professional furniture assembly services in Denver"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      width={1920}
      height={800}
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary/95 via-primary/85 to-primary/75"></div>
    
    <div class="container relative z-10">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <!-- Left Column - Content -->
        <div class="text-white space-y-6">
          <div class="inline-block">
            <span class="bg-white/20 backdrop-blur-sm text-white px-4 py-2 rounded-full text-sm font-semibold">
              Complete Moving Service Including Disassembly & Reassembly
            </span>
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
            Furniture <span class="text-accent">Disassembly & Reassembly</span> Moving Services
          </h1>
          
          <p class="text-lg md:text-xl text-white/90 max-w-2xl">
            We disassemble your furniture at your current location, safely transport it, and reassemble it at your new home or office. Serving Denver, Aurora, Lakewood, and all surrounding areas.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 pt-4">
            <a
              href="tel:7203401849"
              class={`${buttonVariants({ size: "lg" })} bg-accent hover:bg-accent/90 text-white text-lg px-8 shadow-xl`}
            >
              <span class="mr-2">📞</span> Call (720) 340-1849
            </a>
          </div>

          <!-- Mobile CTA Buttons -->
          <div class="flex gap-3 pt-2 lg:hidden">
            <a
              href="#quote-form"
              class={buttonVariants({ variant: "secondary", size: "lg" })}
            >
              Get a Free Quote
            </a>
            <a
              href="tel:7203401849"
              class={buttonVariants({ variant: "outline", size: "lg" })}
            >
              Call Now
            </a>
          </div>
        </div>

        <!-- Right Column - Quote Form (Desktop) -->
        <div class="hidden lg:block">
          <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md md:max-w-xl">
            <h2 class="text-2xl font-bold text-primary mb-4">Request Assembly Service</h2>
            <div data-version="10" id="J8QDKR-furniture"></div>
            <script is:inline>
              (function(r,k) {
                var s = document.createElement('script');
                s.async = true;
                s.defer = true;
                s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
                s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
                document.getElementById(r).appendChild(s);
              })('J8QDKR-furniture','JGCB6TGFN7N3NTTDOGMQUK1S9L3A4N73LYF2ZX4H248K97JD');
            </script>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Our Assembly Services -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-4">
          Complete Disassembly & Reassembly as Part of Your Move
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          We handle the entire process from start to finish - disassemble at origin, safely transport, and reassemble at destination
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Wrench class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Expert Disassembly</h3>
          <p class="text-gray-600">
            Our movers carefully disassemble beds, tables, desks, and large furniture at your current location to ensure safe transport.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Shield class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Protected Transport</h3>
          <p class="text-gray-600">
            All disassembled pieces are wrapped, protected, and carefully loaded onto our trucks for safe transportation.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <CheckCircle class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Professional Reassembly</h3>
          <p class="text-gray-600">
            Once at your new home or office, we reassemble everything exactly where you want it, fully functional and ready to use.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Clock class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">All-Inclusive Service</h3>
          <p class="text-gray-600">
            Disassembly and reassembly are included as part of your move - no separate service charges or appointments needed.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <DollarSign class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">No Extra Hassle</h3>
          <p class="text-gray-600">
            We keep track of all hardware and parts during transport so reassembly is quick and seamless at your new location.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Users class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Experienced Team</h3>
          <p class="text-gray-600">
            Our Denver-based movers have the tools and expertise to handle any furniture disassembly and reassembly job.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services We Provide -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-8 text-center">
          Furniture We Disassemble & Reassemble During Your Move
        </h2>
        
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Beds & Bed Frames</h3>
            <p class="text-gray-600">All sizes from twin to king, platform beds, canopy beds, bunk beds</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Dining Tables & Chairs</h3>
            <p class="text-gray-600">Large dining sets, extension tables, conference tables</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Office Desks & Workstations</h3>
            <p class="text-gray-600">L-shaped desks, standing desks, executive desks, cubicle systems</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Entertainment Centers</h3>
            <p class="text-gray-600">TV stands, media consoles, wall units, shelving systems</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Sectional Sofas</h3>
            <p class="text-gray-600">Large sectionals that need to be broken down for doorways and stairs</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Bookcases & Storage Units</h3>
            <p class="text-gray-600">Tall bookcases, modular storage systems, wardrobe closets</p>
          </div>
        </div>

        <div class="mt-8 bg-accent/10 border-l-4 border-accent rounded-lg p-6">
          <h3 class="text-xl font-bold text-primary mb-2">🔧 How It Works:</h3>
          <p class="text-gray-700 mb-4">
            <strong>At Your Current Location:</strong> We assess which furniture needs disassembly, carefully take it apart, label all hardware and parts, 
            wrap and protect each piece, and load everything safely onto our truck.
          </p>
          <p class="text-gray-700">
            <strong>At Your New Location:</strong> We unload all furniture and parts, reassemble everything in the rooms you specify, 
            ensure everything is sturdy and functional, and haul away all packing materials. All as part of your complete moving service!
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Areas We Serve -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-6">
          Serving Denver Metro & Surrounding Areas
        </h2>
        <p class="text-lg text-gray-600 mb-8">
          Professional furniture assembly services throughout the Denver metropolitan area
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-gray-700">
          <div>Denver</div>
          <div>Aurora</div>
          <div>Lakewood</div>
          <div>Littleton</div>
          <div>Arvada</div>
          <div>Westminster</div>
          <div>Thornton</div>
          <div>Centennial</div>
          <div>Englewood</div>
          <div>Highlands Ranch</div>
          <div>Boulder</div>
          <div>Golden</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-primary to-primary-dark text-white">
    <div class="container text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        Ready to Move? We'll Handle the Disassembly & Reassembly
      </h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto text-white/90">
        Get your free moving quote today - furniture disassembly and reassembly included as part of our complete service!
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="tel:7203401849"
          class={`${buttonVariants({ size: "lg" })} bg-accent hover:bg-accent/90 text-white text-lg px-8`}
        >
          📞 Call (720) 340-1849
        </a>
        <a
          href="sms:7203401849"
          class={`${buttonVariants({ size: "lg", variant: "secondary" })} text-lg px-8`}
        >
          💬 Text Us
        </a>
      </div>
      <p class="mt-6 text-white/80">
        📍 8805 W. 14th Ave, Suite 300, Lakewood, CO 80215<br />
        🕒 Monday - Sunday: 8:00am - 6:00pm
      </p>
    </div>
  </section>
</BaseLayout>
