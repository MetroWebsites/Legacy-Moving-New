---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Image } from "astro:assets";
import { Wrench, CheckCircle, Clock, DollarSign, Shield, Users } from "lucide-react";
import movingImage from "../../assets/services/residential.jpg";

const pageTitle = "Furniture Assembly & Disassembly Services Denver | Expert Assembly";
const pageDescription = "Professional furniture assembly and disassembly services in Denver, Aurora, Lakewood, and surrounding areas. Expert assembly for IKEA, Wayfair, Amazon furniture. Fast, reliable, and affordable.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="relative min-h-[500px] flex items-center justify-center overflow-hidden">
    <Image
      src={movingImage}
      alt="Professional furniture assembly services in Denver"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      width={1920}
      height={800}
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary/95 via-primary/85 to-primary/75"></div>
    
    <div class="container relative z-10">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <!-- Left Column - Content -->
        <div class="text-white space-y-6">
          <div class="inline-block">
            <span class="bg-white/20 backdrop-blur-sm text-white px-4 py-2 rounded-full text-sm font-semibold">
              Denver's Furniture Assembly Experts
            </span>
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
            Professional Furniture <span class="text-accent">Assembly & Disassembly</span>
          </h1>
          
          <p class="text-lg md:text-xl text-white/90 max-w-2xl">
            Expert assembly and disassembly services for all furniture types. Serving Denver, Aurora, Lakewood, Littleton, and surrounding areas.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 pt-4">
            <a
              href="tel:7203401849"
              class={`${buttonVariants({ size: "lg" })} bg-accent hover:bg-accent/90 text-white text-lg px-8 shadow-xl`}
            >
              <span class="mr-2">📞</span> Call (720) 340-1849
            </a>
          </div>

          <!-- Mobile CTA Buttons -->
          <div class="flex gap-3 pt-2 lg:hidden">
            <a
              href="#quote-form"
              class={buttonVariants({ variant: "secondary", size: "lg" })}
            >
              Get a Free Quote
            </a>
            <a
              href="tel:7203401849"
              class={buttonVariants({ variant: "outline", size: "lg" })}
            >
              Call Now
            </a>
          </div>
        </div>

        <!-- Right Column - Quote Form (Desktop) -->
        <div class="hidden lg:block">
          <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md md:max-w-xl">
            <h2 class="text-2xl font-bold text-primary mb-4">Request Assembly Service</h2>
            <div data-version="10" id="J8QDKR-furniture"></div>
            <script is:inline>
              (function(r,k) {
                var s = document.createElement('script');
                s.async = true;
                s.defer = true;
                s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
                s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
                document.getElementById(r).appendChild(s);
              })('J8QDKR-furniture','JGCB6TGFN7N3NTTDOGMQUK1S9L3A4N73LYF2ZX4H248K97JD');
            </script>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Our Assembly Services -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-4">
          Why Choose Legacy Moving for Furniture Assembly?
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Professional assembly services for all major furniture brands serving Denver and surrounding communities
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Wrench class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Expert Technicians</h3>
          <p class="text-gray-600">
            Trained professionals with years of experience assembling all furniture types - IKEA, Wayfair, Amazon, and more.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Clock class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Fast & Efficient</h3>
          <p class="text-gray-600">
            Quick turnaround times with same-day and next-day service available throughout Denver metro area.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Shield class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Fully Insured</h3>
          <p class="text-gray-600">
            Licensed and insured with comprehensive coverage protecting your furniture during assembly.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <DollarSign class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Transparent Pricing</h3>
          <p class="text-gray-600">
            Upfront, honest pricing with no hidden fees. Know exactly what you'll pay before we start.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <CheckCircle class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Quality Guaranteed</h3>
          <p class="text-gray-600">
            We guarantee proper assembly following manufacturer specifications. Your satisfaction is our priority.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Users class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Local Denver Team</h3>
          <p class="text-gray-600">
            Denver-based team serving Aurora, Lakewood, Littleton, Highlands Ranch, and all surrounding cities.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services We Provide -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-8 text-center">
          Furniture Assembly Services We Provide
        </h2>
        
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Bedroom Furniture</h3>
            <p class="text-gray-600">Beds, dressers, nightstands, armoires, and wardrobes</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Living Room Furniture</h3>
            <p class="text-gray-600">Sofas, sectionals, entertainment centers, coffee tables</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Office Furniture</h3>
            <p class="text-gray-600">Desks, filing cabinets, bookcases, office chairs</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Dining Furniture</h3>
            <p class="text-gray-600">Dining tables, chairs, buffets, and china cabinets</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Outdoor Furniture</h3>
            <p class="text-gray-600">Patio sets, gazebos, outdoor storage, and grills</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Furniture Disassembly</h3>
            <p class="text-gray-600">Safe disassembly for moving or storage purposes</p>
          </div>
        </div>

        <div class="mt-8 bg-accent/10 border-l-4 border-accent rounded-lg p-6">
          <h3 class="text-xl font-bold text-primary mb-2">Popular Brands We Assemble:</h3>
          <p class="text-gray-700">
            IKEA, Wayfair, Amazon Basics, West Elm, Pottery Barn, Ashley Furniture, Bob's Furniture, 
            Room & Board, Crate & Barrel, Target, Walmart, and many more!
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Areas We Serve -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-6">
          Serving Denver Metro & Surrounding Areas
        </h2>
        <p class="text-lg text-gray-600 mb-8">
          Professional furniture assembly services throughout the Denver metropolitan area
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-gray-700">
          <div>Denver</div>
          <div>Aurora</div>
          <div>Lakewood</div>
          <div>Littleton</div>
          <div>Arvada</div>
          <div>Westminster</div>
          <div>Thornton</div>
          <div>Centennial</div>
          <div>Englewood</div>
          <div>Highlands Ranch</div>
          <div>Boulder</div>
          <div>Golden</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-primary to-primary-dark text-white">
    <div class="container text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        Ready for Professional Furniture Assembly?
      </h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto text-white/90">
        Get your furniture assembled quickly and correctly. Contact us today for same-day service!
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="tel:7203401849"
          class={`${buttonVariants({ size: "lg" })} bg-accent hover:bg-accent/90 text-white text-lg px-8`}
        >
          📞 Call (720) 340-1849
        </a>
        <a
          href="sms:7203401849"
          class={`${buttonVariants({ size: "lg", variant: "secondary" })} text-lg px-8`}
        >
          💬 Text Us
        </a>
      </div>
      <p class="mt-6 text-white/80">
        📍 8805 W. 14th Ave, Suite 300, Lakewood, CO 80215<br />
        🕒 Monday - Sunday: 8:00am - 6:00pm
      </p>
    </div>
  </section>
</BaseLayout>
