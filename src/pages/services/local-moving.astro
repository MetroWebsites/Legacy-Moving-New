---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import LocalMoveForm from '@/components/LocalMoveForm';
import { Home, MapPin, Box, Phone, Clock, Truck, CheckSquare, ShieldCheck } from "lucide-react";
import { Image } from 'astro:assets';
import residentialImage from '../../assets/services/residential.jpg';
import movingImage from '../../assets/img_4114-legacy-moving-denver_nw_9a9d79b0.jpeg';
---

<BaseLayout
  title="Local Moving Services Denver | Fast & Reliable Denver Movers | Legacy Moving"
  description="Professional local moving services in Denver. Fast, reliable, and affordable moving for homes and apartments. Get a free quote for your next local move with Denver's top-rated movers."
>
  <!-- Hero Section with Form -->
  <section class="relative bg-secondary py-12 md:py-20 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image src={movingImage} alt="Legacy Moving Denver professional movers handling furniture" class="w-full h-full object-cover" />
    </div>
    <div class="container relative z-10">
      <div class="grid lg:grid-cols-2 gap-8 items-center">
        <div class="text-center lg:text-left">
          <span class="inline-block px-4 py-1 mb-4 rounded-full bg-primary/20 text-white text-sm font-medium">Denver's #1 Rated Local Movers</span>
          <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
            Local Moving Services<br class="hidden sm:block"> <span class="text-primary">In Denver</span>
          </h1>
          <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto lg:mx-0">
            Fast, reliable, and stress-free local moves with 1,700+ 5-star reviews. Get your free quote today and experience the Denver difference.
          </p>
          <div class="hidden lg:flex flex-col sm:flex-row gap-4 mt-8">
            <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold phone-link' })}>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              Call (720) 340-1849
            </a>
          </div>
          <!-- Mobile only action buttons -->
          <div class="flex flex-col sm:flex-row gap-4 mt-8 lg:hidden justify-center">
            <a href="#quote-form" class={buttonVariants({ size: 'lg', className: 'bg-primary text-white hover:bg-primary/90 font-semibold' })}>
              Get a Free Quote
            </a>
            <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-white/90 font-semibold phone-link' })}>
              Call Now
            </a>
          </div>
        </div>
        <div>
          <div id="quote-form" class="bg-white p-6 rounded-lg shadow-xl mt-8 lg:mt-0">
            <LocalMoveForm client:load />
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Trust Badges -->
  <section class="py-8 bg-gray-50 border-b border-gray-100">
    <div class="container">
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M7 11V7a5 5 0 0 1 10 0v4"></path><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect></svg>
          <span class="font-medium text-secondary">Licensed & Insured</span>
        </div>
        
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
          <span class="font-medium text-secondary">4.8 Stars (1,700+ Reviews)</span>
        </div>
        
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
          <span class="font-medium text-secondary">Satisfaction Guaranteed</span>
        </div>
        
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <span class="font-medium text-secondary">Same-Day Service Available</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Features -->
  <section class="py-16">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">Why Choose Legacy Moving <span class="text-primary">for Your Local Move</span></h2>
        <p class="text-muted-foreground max-w-2xl mx-auto">
          With over 1,700 5-star reviews, we've built our reputation on reliability, care, and exceptional service. See why Denver residents trust us for their local moves.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-lg shadow-md border border-gray-100 text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg>
          </div>
          <h3 class="font-display font-bold text-xl mb-2 text-secondary">No Hidden Fees</h3>
          <p class="text-gray-600">Transparent pricing with detailed quotes. What we quote is what you pay - no surprises or hidden charges.</p>
        </div>
        
        <div class="bg-white p-8 rounded-lg shadow-md border border-gray-100 text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <h3 class="font-display font-bold text-xl mb-2 text-secondary">Expert Local Movers</h3>
          <p class="text-gray-600">Our professionally trained team has extensive experience with Denver's neighborhoods, buildings, and moving challenges.</p>
        </div>
        
        <div class="bg-white p-8 rounded-lg shadow-md border border-gray-100 text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.29 7 12 12 20.71 7"></polyline><line x1="12" y1="22" x2="12" y2="12"></line></svg>
          </div>
          <h3 class="font-display font-bold text-xl mb-2 text-secondary">Full-Service Options</h3>
          <p class="text-gray-600">From packing and loading to furniture assembly and junk removal, we handle every aspect of your local move.</p>
        </div>
        
        <div class="bg-white p-8 rounded-lg shadow-md border border-gray-100 text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4c0-1.1.9-2 2-2h8a2 2 0 0 1 2 2v5Z"></path><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"></path></svg>
          </div>
          <h3 class="font-display font-bold text-xl mb-2 text-secondary">Responsive Service</h3>
          <p class="text-gray-600">Quick communication, on-time arrival, and flexible scheduling to accommodate your moving needs.</p>
        </div>
        
        <div class="bg-white p-8 rounded-lg shadow-md border border-gray-100 text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"></path><path d="m9 12 2 2 4-4"></path></svg>
          </div>
          <h3 class="font-display font-bold text-xl mb-2 text-secondary">Quality Equipment</h3>
          <p class="text-gray-600">Well-maintained trucks, proper moving equipment, and quality packing materials to protect your belongings.</p>
        </div>
        
        <div class="bg-white p-8 rounded-lg shadow-md border border-gray-100 text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
          </div>
          <h3 class="font-display font-bold text-xl mb-2 text-secondary">Care & Respect</h3>
          <p class="text-gray-600">We treat your belongings with the utmost care and respect your home, using proper protection for floors and doorways.</p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Testimonials Section -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">What Our <span class="text-primary">Customers Say</span></h2>
        <p class="text-muted-foreground max-w-2xl mx-auto">
          Read what Denver residents have to say about their local moving experience with Legacy Moving.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Testimonial 1 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="flex mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FBBC05" stroke="#FBBC05" stroke-width="0.5" class="mr-1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FBBC05" stroke="#FBBC05" stroke-width="0.5" class="mr-1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FBBC05" stroke="#FBBC05" stroke-width="0.5" class="mr-1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FBBC05" stroke="#FBBC05" stroke-width="0.5" class="mr-1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FBBC05" stroke="#FBBC05" stroke-width="0.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          </div>
          <p class="text-gray-600 mb-4 italic">"Legacy Moving made our move across Denver so easy. Their team was professional, efficient, and took great care with all our belongings. They finished ahead of schedule and the price was exactly as quoted."</p>
          <div class="flex items-center">
            <div class="ml-3">
              <h4 class="font-semibold text-secondary">Michael Thompson</h4>
              <p class="text-sm text-gray-500">Denver, CO</p>
            </div>
          </div>
        </div>
        
        <!-- Testimonial 2 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="flex mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FBBC05" stroke="#FBBC05" stroke-width="0.5" class="mr-1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FBBC05" stroke="#FBBC05" stroke-width="0.5" class="mr-1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FBBC05" stroke="#FBBC05" stroke-width="0.5" class="mr-1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FBBC05" stroke="#FBBC05" stroke-width="0.5" class="mr-1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FBBC05" stroke="#FBBC05" stroke-width="0.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          </div>
          <p class="text-gray-600 mb-4 italic">"I needed a last-minute move and Legacy came through! They were able to accommodate my schedule, arrived on time, and worked efficiently. The team was friendly and professional. Highly recommend!"</p>
          <div class="flex items-center">
            <div class="ml-3">
              <h4 class="font-semibold text-secondary">Sarah Johnson</h4>
              <p class="text-sm text-gray-500">Lakewood, CO</p>
            </div>
          </div>
        </div>
        
        <!-- Testimonial 3 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="flex mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FBBC05" stroke="#FBBC05" stroke-width="0.5" class="mr-1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FBBC05" stroke="#FBBC05" stroke-width="0.5" class="mr-1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FBBC05" stroke="#FBBC05" stroke-width="0.5" class="mr-1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FBBC05" stroke="#FBBC05" stroke-width="0.5" class="mr-1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FBBC05" stroke="#FBBC05" stroke-width="0.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          </div>
          <p class="text-gray-600 mb-4 italic">"This is the second time I've used Legacy Moving for a local move in Denver, and they were fantastic both times. Their team is careful with belongings, efficient, and reasonably priced. Wouldn't use anyone else!"</p>
          <div class="flex items-center">
            <div class="ml-3">
              <h4 class="font-semibold text-secondary">David Rodriguez</h4>
              <p class="text-sm text-gray-500">Aurora, CO</p>
            </div>
          </div>
        </div>
      </div>
      
      <div class="text-center mt-8">
        <a href="https://maps.app.goo.gl/E3SEsp435kWzLBeQ8" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-primary font-medium hover:underline">
          Read more customer reviews on Google
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Areas We Serve Section -->
  <section class="py-16">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">Areas We <span class="text-primary">Serve</span></h2>
        <p class="text-muted-foreground max-w-2xl mx-auto">
          We provide professional local moving services throughout the Denver metro area and surrounding communities.
        </p>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <a href="/cities/denver" class="bg-white p-4 rounded-lg border border-gray-200 text-center hover:border-primary hover:shadow-md transition-all">
          <h3 class="font-medium text-secondary hover:text-primary">Denver</h3>
        </a>
        <a href="/cities/aurora" class="bg-white p-4 rounded-lg border border-gray-200 text-center hover:border-primary hover:shadow-md transition-all">
          <h3 class="font-medium text-secondary hover:text-primary">Aurora</h3>
        </a>
        <a href="/cities/lakewood" class="bg-white p-4 rounded-lg border border-gray-200 text-center hover:border-primary hover:shadow-md transition-all">
          <h3 class="font-medium text-secondary hover:text-primary">Lakewood</h3>
        </a>
        <a href="/cities/arvada" class="bg-white p-4 rounded-lg border border-gray-200 text-center hover:border-primary hover:shadow-md transition-all">
          <h3 class="font-medium text-secondary hover:text-primary">Arvada</h3>
        </a>
        <a href="/cities/westminster" class="bg-white p-4 rounded-lg border border-gray-200 text-center hover:border-primary hover:shadow-md transition-all">
          <h3 class="font-medium text-secondary hover:text-primary">Westminster</h3>
        </a>
        <a href="/cities/thornton" class="bg-white p-4 rounded-lg border border-gray-200 text-center hover:border-primary hover:shadow-md transition-all">
          <h3 class="font-medium text-secondary hover:text-primary">Thornton</h3>
        </a>
        <a href="/cities/centennial" class="bg-white p-4 rounded-lg border border-gray-200 text-center hover:border-primary hover:shadow-md transition-all">
          <h3 class="font-medium text-secondary hover:text-primary">Centennial</h3>
        </a>
        <a href="/cities/highlands-ranch" class="bg-white p-4 rounded-lg border border-gray-200 text-center hover:border-primary hover:shadow-md transition-all">
          <h3 class="font-medium text-secondary hover:text-primary">Highlands Ranch</h3>
        </a>
        <a href="/cities/littleton" class="bg-white p-4 rounded-lg border border-gray-200 text-center hover:border-primary hover:shadow-md transition-all">
          <h3 class="font-medium text-secondary hover:text-primary">Littleton</h3>
        </a>
        <a href="/cities/englewood" class="bg-white p-4 rounded-lg border border-gray-200 text-center hover:border-primary hover:shadow-md transition-all">
          <h3 class="font-medium text-secondary hover:text-primary">Englewood</h3>
        </a>
        <a href="/cities/golden" class="bg-white p-4 rounded-lg border border-gray-200 text-center hover:border-primary hover:shadow-md transition-all">
          <h3 class="font-medium text-secondary hover:text-primary">Golden</h3>
        </a>
        <a href="/cities/boulder" class="bg-white p-4 rounded-lg border border-gray-200 text-center hover:border-primary hover:shadow-md transition-all">
          <h3 class="font-medium text-secondary hover:text-primary">Boulder</h3>
        </a>
      </div>
      
      <div class="mt-8 text-center">
        <p class="text-muted-foreground">Need to move to or from an area not listed? <a href="tel:7203401849" class="text-primary font-medium hover:underline phone-link" data-google-link="https://maps.app.goo.gl/E3SEsp435kWzLBeQ8">Call us</a> to check availability.</p>
      </div>
    </div>
