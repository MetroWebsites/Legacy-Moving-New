---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import ContactForm from '@/components/ContactForm';
import { Home, MapPin, Box, Phone, Clock, Truck, CheckSquare, ShieldCheck } from "lucide-react";
import { Image } from 'astro:assets';
import residentialImage from '../../assets/services/residential.jpg';
import movingImage from '../../assets/img_4114-legacy-moving-denver_nw_9a9d79b0.jpeg';
---

<BaseLayout
  title="Local Moving Services Denver | Fast & Reliable Denver Movers | Legacy Moving"
  description="Professional local moving services in Denver. Fast, reliable, and affordable moving for homes and apartments. Get a free quote for your next local move with Denver's top-rated movers."
>
  <!-- Hero Section -->
  <section class="relative bg-secondary py-20 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image src={movingImage} alt="Legacy Moving Denver professional movers handling furniture" class="w-full h-full object-cover" />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Denver's Premier Local Moving Service
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto">
          Fast, reliable, and stress-free local moves throughout Denver and the surrounding areas. Our experienced team ensures your belongings arrive safely to your new home.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-primary text-white hover:bg-primary/80 hover:text-white font-semibold' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary/80 border border-white/20 text-white hover:bg-secondary hover:text-white phone-link' })} data-google-link="https://maps.app.goo.gl/E3SEsp435kWzLBeQ8">
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 md:py-24">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-6">
            <Home size={32} className="text-primary" />
          </div>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">Local Moving Made Simple</h2>
          <div class="space-y-4">
            <p class="text-muted-foreground">
              At Legacy Moving Denver, we specialize in stress-free local moves throughout Denver and the surrounding areas. Whether you're moving to a new apartment across town or a house in a neighboring suburb, our experienced team will make your move quick, efficient, and hassle-free.
            </p>
            <p class="text-muted-foreground">
              With our professional local moving services, you can focus on settling into your new home while we handle the heavy lifting.
            </p>
            <div class="space-y-2 pt-2">
              <div class="flex items-start gap-2">
                <div class="text-primary mt-1">✓</div>
                <p class="text-muted-foreground">Fast, reliable service with flexible scheduling options</p>
              </div>
              <div class="flex items-start gap-2">
                <div class="text-primary mt-1">✓</div>
                <p class="text-muted-foreground">Careful handling of all your belongings, from furniture to fragile items</p>
              </div>
              <div class="flex items-start gap-2">
                <div class="text-primary mt-1">✓</div>
                <p class="text-muted-foreground">Clear, upfront pricing with no hidden fees</p>
              </div>
              <div class="flex items-start gap-2">
                <div class="text-primary mt-1">✓</div>
                <p class="text-muted-foreground">Local expertise that ensures smooth, efficient moves</p>
              </div>
            </div>
            <div class="pt-4">
              <a href="/get-quote" class={buttonVariants({ className: 'mt-2' })}>
                Get a Free Quote
              </a>
            </div>
          </div>
        </div>
        <div class="rounded-lg overflow-hidden shadow-xl">
          <Image 
            src={residentialImage} 
            alt="Legacy Moving Denver local moving services"
            class="w-full h-auto object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Our Local Moving Services -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">Our Local Moving Services</h2>
        <p class="text-muted-foreground">
          We offer a complete range of local moving services to make your move as smooth as possible, whether you're moving a small apartment or a large family home.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Service 1 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <Home size={24} className="text-primary" />
          </div>
          <h3 class="font-display font-semibold text-xl mb-2 text-secondary">Residential Moving</h3>
          <p class="text-muted-foreground mb-4">Complete home moving services for houses, apartments, and condos of all sizes. We handle everything from planning to final placement of furniture.</p>
        </div>
        
        <!-- Service 2 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <Box size={24} className="text-primary" />
          </div>
          <h3 class="font-display font-semibold text-xl mb-2 text-secondary">Packing Services</h3>
          <p class="text-muted-foreground mb-4">Our professional packers use high-quality materials to ensure your belongings are protected during your local move. We can pack your entire home or just specific items.</p>
        </div>
        
        <!-- Service 3 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <Truck size={24} className="text-primary" />
          </div>
          <h3 class="font-display font-semibold text-xl mb-2 text-secondary">Loading & Unloading</h3>
          <p class="text-muted-foreground mb-4">Need help with just the heavy lifting? Our team can efficiently load and unload your rental truck or storage container with care and precision.</p>
        </div>
        
        <!-- Service 4 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path></svg>
          </div>
          <h3 class="font-display font-semibold text-xl mb-2 text-secondary">Specialty Item Moving</h3>
          <p class="text-muted-foreground mb-4">From pianos to antiques and artwork, we have the expertise and equipment to move your valuable specialty items safely within the Denver area.</p>
        </div>
        
        <!-- Service 5 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M2 12a5 5 0 0 0 5 5 8 8 0 0 1 5 2 8 8 0 0 1 5-2 5 5 0 0 0 5-5V7H2Z"></path></svg>
          </div>
          <h3 class="font-display font-semibold text-xl mb-2 text-secondary">Same-Day Services</h3>
          <p class="text-muted-foreground mb-4">Need to move quickly? We offer same-day and next-day local moving services for those unexpected situations when you need to relocate right away.</p>
        </div>
        
        <!-- Service 6 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <ShieldCheck size={24} className="text-primary" />
          </div>
          <h3 class="font-display font-semibold text-xl mb-2 text-secondary">Furniture Assembly</h3>
          <p class="text-muted-foreground mb-4">We disassemble your furniture before moving and reassemble it at your new home, ensuring everything is set up just the way you want it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 md:py-24">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="order-2 md:order-1">
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-xl mb-1 text-secondary">Local Denver Expertise</h3>
                <p class="text-muted-foreground">As Denver locals, we know the area inside and out. We understand the challenges of moving in different neighborhoods and can navigate the city efficiently.</p>
              </div>
            </div>
            
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-xl mb-1 text-secondary">Transparent Pricing</h3>
                <p class="text-muted-foreground">No hidden fees or surprise charges. We provide clear, detailed estimates upfront so you know exactly what to expect on moving day.</p>
              </div>
            </div>
            
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-xl mb-1 text-secondary">Highly Rated Service</h3>
                <p class="text-muted-foreground">With over 1,700 five-star reviews, our reputation speaks for itself. Our customers consistently praise our professionalism, efficiency, and care.</p>
              </div>
            </div>
            
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-xl mb-1 text-secondary">Efficient & Reliable</h3>
                <p class="text-muted-foreground">We respect your time and work efficiently to complete your move as quickly as possible without sacrificing care or quality.</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="order-1 md:order-2">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">Why Choose Legacy Moving for Your Local Move</h2>
          <p class="text-muted-foreground mb-8">
            When it comes to local moving in Denver, experience matters. Since 2018, we've helped thousands of Denver residents move safely and efficiently across the city and surrounding areas.
          </p>
          <CheckSquare size={24} className="text-primary mb-4" />
          <blockquote class="text-lg italic text-muted-foreground">
            "Legacy Moving made our local move incredibly easy. The crew was professional, efficient, and took great care with all our belongings. They finished ahead of schedule and the price was exactly as quoted. Highly recommended!"
            <footer class="mt-2 text-sm not-italic">
              - Michael T., Denver
            </footer>
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="bg-primary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">Ready for a Stress-Free Local Move?</h2>
        <p class="text-white/90 text-lg mb-8">
          Get a free quote today and experience the Legacy Moving difference for your Denver area move.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white text-secondary hover:bg-primary hover:text-white font-semibold transition-colors' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary border border-white text-white hover:bg-secondary/80 hover:text-white phone-link transition-colors' })} data-google-link="https://maps.app.goo.gl/E3SEsp435kWzLBeQ8">
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-10 text-secondary text-center">
          Frequently Asked Questions
        </h2>
        
        <div class="space-y-4">
          <!-- FAQ 1 -->
          <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
            <button 
              class="w-full p-6 text-left flex items-center justify-between cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary focus:ring-inset hover:bg-gray-50 transition-colors" 
              onclick="this.parentElement.querySelector('.faq-answer').classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');"
            >
              <h3 class="font-display font-semibold text-xl text-secondary">How much does a local move cost in Denver?</h3>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200">
                <path d="m18 15-6-6-6 6"/>
              </svg>
            </button>
            <div class="faq-answer hidden">
              <div class="p-6 pt-0 border-t border-gray-100">
                <p class="text-muted-foreground">
                  Local moving costs in Denver typically range from $100-200 per hour depending on the size of your move and number of movers needed. A small apartment might take 2-3 hours with 2 movers, while a larger home could require 4-6 hours with 3-4 movers. We provide detailed, transparent quotes based on your specific needs.
                </p>
              </div>
            </div>
          </div>
          
          <!-- FAQ 2 -->
          <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
            <button 
              class="w-full p-6 text-left flex items-center justify-between cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary focus:ring-inset hover:bg-gray-50 transition-colors" 
              onclick="this.parentElement.querySelector('.faq-answer').classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');"
            >
              <h3 class="font-display font-semibold text-xl text-secondary">How far in advance should I book my local move?</h3>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200">
                <path d="m18 15-6-6-6 6"/>
              </svg>
            </button>
            <div class="faq-answer hidden">
              <div class="p-6 pt-0 border-t border-gray-100">
                <p class="text-muted-foreground">
                  We recommend booking 2-3 weeks in advance for local moves, especially during peak season (May-September). However, we understand that plans can change quickly, and we do our best to accommodate last-minute and even same-day moving requests when our schedule allows.
                </p>
              </div>
            </div>
          </div>
          
          <!-- FAQ 3 -->
          <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
            <button 
              class="w-full p-6 text-left flex items-center justify-between cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary focus:ring-inset hover:bg-gray-50 transition-colors" 
              onclick="this.parentElement.querySelector('.faq-answer').classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');"
            >
              <h3 class="font-display font-semibold text-xl text-secondary">What areas around Denver do you service?</h3>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200">
                <path d="m18 15-6-6-6 6"/>
              </svg>
            </button>
            <div class="faq-answer hidden">
              <div class="p-6 pt-0 border-t border-gray-100">
                <p class="text-muted-foreground">
                  We provide local moving services throughout the Denver metro area, including Denver, Aurora, Lakewood, Arvada, Westminster, Thornton, Centennial, Highlands Ranch, Littleton, Englewood, Golden, and Boulder. If you're located outside these areas, please contact us to discuss your specific location.
                </p>
              </div>
            </div>
          </div>
          
          <!-- FAQ 4 -->
          <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
            <button 
              class="w-full p-6 text-left flex items-center justify-between cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary focus:ring-inset hover:bg-gray-50 transition-colors" 
              onclick="this.parentElement.querySelector('.faq-answer').classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');"
            >
              <h3 class="font-display font-semibold text-xl text-secondary">Are your movers licensed and insured?</h3>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200">
                <path d="m18 15-6-6-6 6"/>
              </svg>
            </button>
            <div class="faq-answer hidden">
              <div class="p-6 pt-0 border-t border-gray-100">
                <p class="text-muted-foreground">
                  Yes, Legacy Moving Denver is fully licensed and insured. We carry comprehensive commercial liability insurance and workers' compensation for all our employees. Our movers are professionally trained and experienced in handling all types of moves and items with care.
                </p>
              </div>
            </div>
          </div>
          
          <!-- FAQ 5 -->
          <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
            <button 
              class="w-full p-6 text-left flex items-center justify-between cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary focus:ring-inset hover:bg-gray-50 transition-colors" 
              onclick="this.parentElement.querySelector('.faq-answer').classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');"
            >
              <h3 class="font-display font-semibold text-xl text-secondary">Do you offer packing services for local moves?</h3>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200">
                <path d="m18 15-6-6-6 6"/>
              </svg>
            </button>
            <div class="faq-answer hidden">
              <div class="p-6 pt-0 border-t border-gray-100">
                <p class="text-muted-foreground">
                  Absolutely! We offer full-service packing, partial packing, and unpacking services. Our professional packers use high-quality materials and efficient techniques to ensure your belongings are protected during the move. We can pack your entire home or just specific items that require special care.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="py-16 md:py-24">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">Get Your Free Local Moving Quote</h2>
          <p class="text-muted-foreground mb-8">
            Ready to plan your local move? Fill out the form for a detailed quote, or call us directly to speak with our local moving specialists.
          </p>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 w-10 h-10 bg-primary/10 text-primary rounded-full flex items-center justify-center">
                <MapPin size={20} />
              </div>
              <div>
                <h3 class="font-semibold text-secondary">Our Location</h3>
                <p class="text-muted-foreground">8805 W. 14th Ave, Suite 300, Lakewood, CO 80215</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 w-10 h-10 bg-primary/10 text-primary rounded-full flex items-center justify-center">
                <Phone size={20} />
              </div>
              <div>
                <h3 class="font-semibold text-secondary">Call Us</h3>
                <a href="tel:7203401849" class="text-primary hover:underline phone-link" data-google-link="https://maps.app.goo.gl/E3SEsp435kWzLBeQ8">
                  (720) 340-1849
                </a>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 w-10 h-10 bg-primary/10 text-primary rounded-full flex items-center justify-center">
                <Clock size={20} />
              </div>
              <div>
                <h3 class="font-semibold text-secondary">Hours</h3>
                <p class="text-muted-foreground">Mon-Sun: 8:00am - 6:00pm</p>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-xl">
          <h3 class="text-secondary font-display font-bold text-2xl mb-4">Request a Quote</h3>
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>