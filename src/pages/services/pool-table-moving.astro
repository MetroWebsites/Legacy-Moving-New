---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Image } from "astro:assets";
import movingImage from "../../assets/services/residential.jpg";
---

<BaseLayout
  title="Pool Table Moving Denver | Professional Pool Table Movers Colorado | Legacy Moving"
  description="Expert pool table moving in Denver and across Colorado. Professional disassembly, slate handling, transport, and re-leveling. We protect your felt and ensure your table plays like new. Fully insured. Free quotes."
>
  <!-- Hero Section -->
  <section class="relative bg-secondary py-16 md:py-24 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-15 mix-blend-overlay">
      <Image src={movingImage} alt="Legacy Moving Denver pool table movers carefully disassembling and moving a billiard table" class="w-full h-full object-cover" loading="eager" />
    </div>
    <div class="container relative z-10">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div class="text-center lg:text-left">
          <span class="inline-block px-4 py-1 mb-5 rounded-full bg-primary/25 text-white text-sm font-semibold">Denver's Pool Table Moving Experts</span>
          <h1 class="font-display font-bold text-4xl md:text-5xl mb-6 leading-tight">
            Pool Table Moving <span class="text-primary">Done Right</span> in Denver
          </h1>
          <p class="text-lg md:text-xl text-white/90 max-w-xl mx-auto lg:mx-0 mb-8">
            Pool tables can't simply be loaded onto a truck. They require careful disassembly, precise slate handling, and expert reassembly to play correctly. Our crew does this every week — and does it right.
          </p>
          <div class="hidden lg:flex flex-col sm:flex-row gap-4">
            <a href="#quote-form" class={buttonVariants({ size: "lg", className: "bg-primary text-white hover:bg-primary/90 font-semibold" })}>
              Get a Free Quote
            </a>
            <a href="tel:7203401849" class={buttonVariants({ size: "lg", className: "bg-white !text-secondary hover:bg-white/90 font-semibold phone-link" })}>
              Call (720) 340-1849
            </a>
          </div>
        </div>
        <div id="quote-form" class="bg-white rounded-2xl shadow-2xl p-6 md:p-8">
          <p class="font-display font-bold text-xl text-secondary mb-4 text-center">Get Your Free Pool Table Moving Quote</p>
          <div data-version="4" id="56AIR8-pool"></div>
          <script is:inline>
            (function(r,k) {
              var s = document.createElement('script');
              s.async = true;
              s.defer = true;
              s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
              s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
              document.getElementById(r).appendChild(s);
            })('56AIR8-pool','PE277BJIM3OAT6PP0J8IF0BJ5VH5WR8SG2NIKF7AD92OR5EF');
          </script>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 lg:hidden">
          <a href="#quote-form" class={buttonVariants({ size: "lg", className: "bg-primary text-white hover:bg-primary/90 font-semibold" })}>Get a Free Quote</a>
          <a href="tel:7203401849" class={buttonVariants({ size: "lg", className: "bg-white !text-secondary hover:bg-white/90 font-semibold phone-link" })}>Call (720) 340-1849</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <section class="py-8 bg-gray-50 border-b border-gray-100">
    <div class="container">
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12">
        <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span class="font-medium text-secondary">Licensed & Insured</span></div>
        <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg><span class="font-medium text-secondary">1,700+ Five-Star Reviews</span></div>
        <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><span class="font-medium text-secondary">Proper Re-Leveling Included</span></div>
        <div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><span class="font-medium text-secondary">Felt Protection Guaranteed</span></div>
      </div>
    </div>
  </section>

  <!-- Why Pool Tables Need Professionals -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container max-w-5xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
            Why Pool Tables Can't Be <span class="text-primary">Simply Moved</span>
          </h2>
          <div class="space-y-5 text-gray-700">
            <p>
              A pool table looks like heavy furniture. It isn't. It's a precision instrument. The playing surface consists of one to three pieces of slate — each weighing 150–250 pounds — laid perfectly flat and then covered with tightly stretched felt cloth. The entire assembly is engineered to produce a consistent, true roll across every inch of the table.
            </p>
            <p>
              Attempting to move a pool table intact is dangerous (they weigh 650–1,000 lbs) and damaging. The slate will crack or separate. The felt will tear. The legs and frame will flex under the stress. And when you try to use it at the destination, you'll find it doesn't play right — because it isn't level, or the slate joints have shifted.
            </p>
            <p>
              The correct approach requires full disassembly: pockets removed, felt carefully detached or marked, slate lifted individually and transported flat, frame broken down. At the destination, the process reverses — slate is re-laid, leveled with a precision level, joints sealed with beeswax, and felt re-stretched or replaced. Our crew handles all of it.
            </p>
          </div>
        </div>
        <div class="space-y-4">
          <div class="bg-primary/5 border border-primary/20 rounded-xl p-6">
            <h3 class="font-display font-bold text-xl text-secondary mb-4">What's Included in Our Pool Table Move</h3>
            <ul class="space-y-3">
              {[
                "Complete disassembly — pockets, rails, slate, and frame",
                "Individual slate wrapping and flat transport",
                "Felt assessment — protect existing felt when possible",
                "Reassembly at destination",
                "Precision leveling with a quality level",
                "Slate joint beeswax sealing",
                "All hardware reinstalled and inspected",
              ].map(item => (
                <li class="flex gap-3 items-start text-gray-700">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-0.5 flex-shrink-0"><path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
                  <span class="text-sm">{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-gray-50 rounded-xl p-6">
            <h3 class="font-display font-bold text-lg text-secondary mb-3">Note on Felt</h3>
            <p class="text-sm text-gray-600">Moving a pool table is an excellent opportunity to replace worn or damaged felt. We can advise on this during your quote — new felt installation is available as an add-on service.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-16 md:py-20 bg-gray-50">
    <div class="container max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
          Our Pool Table Moving <span class="text-primary">Process</span>
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {[
          ["Assessment & Quote", "We ask about your table size (7-foot, 8-foot, or 9-foot), slate count, current and destination locations, stair access, and any tight hallways or doorways. Your quote is accurate before we arrive."],
          ["Protect the Surrounding Area", "Moving blankets on floors, wall padding on door jambs, and furniture moved clear before disassembly begins."],
          ["Disassemble the Table", "Pockets removed, rails detached, felt carefully pulled (or scored for replacement). Slate pieces lifted individually with two-person teams using proper grip techniques."],
          ["Wrap & Load Slate Flat", "Each slate section is wrapped in moving blankets and carried flat to the truck. Slate stored horizontally — never upright — to prevent cracking."],
          ["Transport to Destination", "Frame, legs, rails, and slate transported in our padded moving truck. Careful driving to minimize vibration."],
          ["Reassemble & Level", "Frame assembled, slate re-laid and shimmed to true level. Slate joints filled with beeswax. Rails and pockets reinstalled. Final level check before we leave."],
        ].map(([step, desc], i) => (
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 flex gap-4">
            <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center flex-shrink-0 font-bold text-white">{i + 1}</div>
            <div>
              <h3 class="font-display font-bold text-lg text-secondary mb-2">{step}</h3>
              <p class="text-gray-600 text-sm">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container max-w-3xl mx-auto">
      <h2 class="font-display font-bold text-3xl md:text-4xl mb-10 text-secondary text-center">
        Pool Table Moving <span class="text-primary">FAQs</span>
      </h2>
      <div class="space-y-4">
        {[
          ["How much does it cost to move a pool table in Denver?", "Pool table moves in Denver typically range from $350–$700 for a local move, depending on table size, slate count, stair access, distance, and whether felt replacement is needed. Contact us for a free, itemized quote."],
          ["Can I keep my existing felt when the table is moved?", "In many cases, yes. Our crew carefully detaches the felt to preserve it. However, if the felt is old, worn, or has been previously stapled multiple times, a move is a great opportunity to replace it. We can advise you during the assessment."],
          ["How long does a pool table move take?", "A typical local pool table move takes 3–5 hours — roughly 1–1.5 hours for disassembly, 1 hour for transport, and 1.5–2 hours for reassembly and leveling. Add time for stairs or longer carry distances."],
          ["Do you move pool tables to storage?", "Yes. We can move your pool table to a storage unit. We recommend climate-controlled storage to protect the felt and wood components from humidity changes common in Colorado."],
          ["My pool table has three slate pieces. Is that more expensive?", "Three-piece slate tables require more careful handling and additional leveling time at reassembly compared to one-piece slate tables. We account for this in your quote — three-piece moves are typically priced $75–$150 higher."],
          ["Will you move just the table, or can you move the rest of the room?", "We handle full-service moves and individual item moves. We can move just your pool table or your entire home or game room. Let us know what you need when you request your quote."],
        ].map(([q, a]) => (
          <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
            <button class="w-full p-6 text-left flex items-center justify-between cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary focus:ring-inset hover:bg-gray-50 transition-colors" onclick="this.parentElement.querySelector('.faq-answer').classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');">
              <h3 class="font-display font-semibold text-lg text-secondary pr-4">{q}</h3>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 flex-shrink-0"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="faq-answer hidden">
              <div class="p-6 pt-0 border-t border-gray-100"><p class="text-muted-foreground">{a}</p></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-primary text-white">
    <div class="container text-center max-w-3xl mx-auto">
      <h2 class="font-display font-bold text-3xl md:text-4xl mb-6">Ready to Move Your Pool Table?</h2>
      <p class="text-white/90 text-lg mb-8">Contact Denver's pool table moving specialists for a free, accurate quote today.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:7203401849" class={buttonVariants({ size: "lg", className: "bg-white !text-secondary hover:bg-white/90 font-semibold phone-link" })}>Call (720) 340-1849</a>
        <a href="#quote-form" class={buttonVariants({ size: "lg", className: "bg-secondary border border-white text-white hover:bg-secondary/80" })}>Get a Free Quote</a>
      </div>
      <p class="mt-6 text-white/80 text-sm">📍 8805 W. 14th Ave, Suite 300, Lakewood, CO 80215 &nbsp;|&nbsp; 🕒 Mon–Sat: 8am–6pm</p>
    </div>
  </section>

  <!-- Related Services -->
  <section class="py-12 bg-white border-t border-gray-100">
    <div class="container max-w-4xl mx-auto text-center">
      <h3 class="font-display font-bold text-xl text-secondary mb-5">More Specialty Moving Services</h3>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/services/specialty-items" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">All Specialty Moving</a>
        <a href="/services/piano-moving" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">Piano Moving</a>
        <a href="/services/gun-safe-moving" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">Gun Safe Moving</a>
        <a href="/services/large-furniture-moving" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">Large Furniture</a>
        <a href="/services/fitness-equipment-moving" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">Fitness Equipment</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Pool Table Moving Services Denver",
    "description": "Professional pool table moving services in Denver, Colorado. Complete disassembly, slate handling, transport, reassembly, and precision leveling. Felt protection guaranteed.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Legacy Moving Denver",
      "telephone": "+17203401849",
      "address": { "@type": "PostalAddress", "streetAddress": "8805 W. 14th Ave, Suite 300", "addressLocality": "Lakewood", "addressRegion": "CO", "postalCode": "80215", "addressCountry": "US" }
    },
    "areaServed": { "@type": "City", "name": "Denver" },
    "serviceType": "Pool Table Moving"
  }
  </script>
</BaseLayout>
