---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Image } from "astro:assets";
import movingImage from "../../assets/services/residential.jpg";
---

<BaseLayout
  title="Piano Moving Services Denver | Professional Piano Movers Colorado | Legacy Moving"
  description="Expert piano moving in Denver, Aurora, Lakewood, Boulder, and across Colorado's Front Range. Grand pianos, baby grands, upright pianos, and organs moved safely by trained specialists. Fully insured. Get a free quote today."
>
  <!-- Hero Section -->
  <section class="relative bg-secondary py-16 md:py-24 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-15 mix-blend-overlay">
      <Image src={movingImage} alt="Legacy Moving Denver piano movers carefully loading a grand piano onto a moving truck" class="w-full h-full object-cover" loading="eager" />
    </div>
    <div class="container relative z-10">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div class="text-center lg:text-left">
          <span class="inline-block px-4 py-1 mb-5 rounded-full bg-primary/25 text-white text-sm font-semibold">Denver's Piano Moving Specialists</span>
          <h1 class="font-display font-bold text-4xl md:text-5xl mb-6 leading-tight">
            Professional <span class="text-primary">Piano Moving</span> Services in Denver
          </h1>
          <p class="text-lg md:text-xl text-white/90 max-w-xl mx-auto lg:mx-0 mb-8">
            A piano is one of the heaviest, most complex items in any home. Our trained piano movers use purpose-built equipment and proven techniques to move yours safely — every time.
          </p>
          <div class="hidden lg:flex flex-col sm:flex-row gap-4">
            <a href="#quote-form" class={buttonVariants({ size: "lg", className: "bg-primary text-white hover:bg-primary/90 font-semibold" })}>
              Get a Free Quote
            </a>
            <a href="tel:7203401849" class={buttonVariants({ size: "lg", className: "bg-white !text-secondary hover:bg-white/90 font-semibold phone-link" })}>
              Call (720) 340-1849
            </a>
          </div>
        </div>
        <div id="quote-form" class="bg-white rounded-2xl shadow-2xl p-6 md:p-8">
          <p class="font-display font-bold text-xl text-secondary mb-4 text-center">Get Your Free Piano Moving Quote</p>
          <div data-version="4" id="56AIR8-piano"></div>
          <script is:inline>
            (function(r,k) {
              var s = document.createElement('script');
              s.async = true;
              s.defer = true;
              s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
              s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
              document.getElementById(r).appendChild(s);
            })('56AIR8-piano','PE277BJIM3OAT6PP0J8IF0BJ5VH5WR8SG2NIKF7AD92OR5EF');
          </script>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 lg:hidden">
          <a href="#quote-form" class={buttonVariants({ size: "lg", className: "bg-primary text-white hover:bg-primary/90 font-semibold" })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: "lg", className: "bg-white !text-secondary hover:bg-white/90 font-semibold phone-link" })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <section class="py-8 bg-gray-50 border-b border-gray-100">
    <div class="container">
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span class="font-medium text-secondary">Licensed & Insured</span>
        </div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
          <span class="font-medium text-secondary">1,700+ Five-Star Reviews</span>
        </div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
          <span class="font-medium text-secondary">Piano-Specific Training</span>
        </div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          <span class="font-medium text-secondary">Specialized Equipment</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Professional Piano Movers -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container max-w-5xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">
            Why Piano Moving Requires <span class="text-primary">Specialists</span>
          </h2>
          <div class="space-y-5 text-gray-700">
            <p>
              Pianos are deceptive. An upright piano looks manageable, but most weigh between 400 and 900 pounds — with a center of gravity that shifts unpredictably as it's tilted or rolled. A baby grand must be tipped onto its side, the legs removed, and the cabinet secured on a specialized piano board before it can safely move anywhere. Without proper training and equipment, a piano can injure movers, destroy flooring, and damage the instrument beyond repair.
            </p>
            <p>
              Beyond the weight, pianos are mechanically intricate. The soundboard, strings, and action mechanism don't tolerate sudden impacts or improper positioning during transport. Even a "minor" incident can knock the instrument significantly out of tune — or cause structural damage that requires expensive repairs.
            </p>
            <p>
              Legacy Moving's piano crews receive dedicated training on instrument mechanics, correct lifting and rolling techniques, safe stair navigation, and the proper use of piano boards, dollies, and protective padding. We treat your piano the same way a concert hall treats its Steinway.
            </p>
          </div>
        </div>
        <div class="bg-gray-50 rounded-2xl p-8 space-y-4">
          <h3 class="font-display font-bold text-xl text-secondary">Piano Types We Move</h3>
          <ul class="space-y-3">
            {[
              ["Grand Piano", "Concert grands, semi-concert grands, parlor grands — fully disassembled and piano-boarded"],
              ["Baby Grand Piano", "Lid removed, legs off, secured on piano board for safe horizontal transport"],
              ["Upright Piano", "Full-size uprights, studio pianos, professional uprights up to 800+ lbs"],
              ["Console & Spinet Piano", "Smaller uprights requiring extra care around the shorter pedal lyre"],
              ["Player Piano", "Delicate mechanism secured before any movement"],
              ["Digital & Stage Pianos", "Large weighted keyboards requiring proper padding and tie-down"],
              ["Organ", "Electronic organs and Hammond organs with complex internal components"],
            ].map(([type, desc]) => (
              <li class="flex gap-3 items-start">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-0.5 flex-shrink-0"><path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
                <div>
                  <span class="font-semibold text-secondary">{type}</span>
                  <span class="text-gray-600"> — {desc}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Process -->
  <section class="py-16 md:py-20 bg-gray-50">
    <div class="container max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
          Our Piano Moving <span class="text-primary">Process</span>
        </h2>
        <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
          Every piano move follows a methodical, step-by-step process designed to protect both your instrument and your home.
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {[
          ["Pre-Move Assessment", "We discuss your piano type, current location, stair count, door widths, and destination layout so we arrive fully prepared with the right equipment and crew."],
          ["Floor & Doorway Protection", "Moving blankets, door jamb pads, and floor runners are placed before we ever touch the piano. Your home is protected from the first step."],
          ["Safe Disassembly", "For grand pianos, the lid, music desk, and pedal lyre are removed. The legs come off one at a time and the cabinet is carefully lowered onto a padded piano board."],
          ["Secure Loading", "The piano board is strapped securely to our moving dolly and rolled to the truck. The instrument is positioned for minimal movement during transport."],
          ["Careful Transport", "Soft padding is wrapped around the entire instrument inside the truck. The load is secured with multiple straps to prevent any shifting in transit."],
          ["Placement & Reassembly", "At the destination, we navigate carefully to the piano's final position. Legs are reinstalled, hardware reattached, and the piano placed exactly where you want it."],
        ].map(([step, desc], i) => (
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 flex gap-4">
            <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center flex-shrink-0 font-bold text-white">{i + 1}</div>
            <div>
              <h3 class="font-display font-bold text-lg text-secondary mb-2">{step}</h3>
              <p class="text-gray-600 text-sm">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Legacy -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">
          Why Denver Chooses <span class="text-primary">Legacy Moving</span> for Pianos
        </h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {[
          ["Piano Boards & Dollies", "We own and maintain professional piano boards, heavy-duty dollies, and strap systems specifically designed for piano transport."],
          ["Stair-Navigation Expertise", "Denver's older homes often have narrow, steep staircases. Our crews are trained in controlled two-person stair techniques for uprights and grand piano boards."],
          ["No Travel Time Charges", "Unlike some competitors, we don't charge for travel time to your home. The rate starts when we arrive."],
          ["Fully Insured", "Comprehensive liability and cargo insurance protects your instrument throughout the entire move — from first touch to final placement."],
          ["Free Supplies Included", "Shrink wrap, moving blankets, and protective padding are included in your quote. Nothing extra to pay for."],
          ["Transparent Pricing", "The quote we give you is the price you pay. We build stair fees, long carries, and disassembly into the upfront estimate."],
        ].map(([title, desc]) => (
          <div class="bg-gray-50 rounded-xl p-6 hover:shadow-md transition-shadow">
            <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
            </div>
            <h3 class="font-display font-bold text-lg text-secondary mb-2">{title}</h3>
            <p class="text-gray-600 text-sm">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-16 md:py-20 bg-gray-50">
    <div class="container max-w-3xl mx-auto">
      <h2 class="font-display font-bold text-3xl md:text-4xl mb-10 text-secondary text-center">
        Piano Moving <span class="text-primary">FAQs</span>
      </h2>
      <div class="space-y-4">
        {[
          ["How much does it cost to move a piano in Denver?", "Piano moving costs vary based on the type (upright vs. grand), distance, stair count, and any special requirements. Upright moves within Denver typically range from $150–$350; grand piano moves are usually $250–$600 or more depending on complexity. Contact us for a free, accurate quote specific to your situation."],
          ["Do I need to have the piano tuned after it's moved?", "Yes — all pianos should be tuned after a move. The change in environment, humidity, and slight vibrations during transport will affect tuning. We recommend waiting 2–4 weeks after the move before scheduling a tuner to allow the piano to acclimate to its new space."],
          ["Can you move a piano up or down stairs?", "Yes. Stair moves are among our most common piano jobs in Denver. We account for stair counts during quoting and bring the appropriate crew size. Narrow or winding staircases may require additional planning — tell us about them when you request your quote."],
          ["How far in advance should I schedule a piano move?", "We recommend booking at least one week ahead for piano moves, and two weeks or more during peak summer season. That said, we accommodate shorter notice when our schedule allows — call us and we'll do our best."],
          ["Do you move pianos to storage?", "Yes. We can move your piano to our partner storage facilities or any climate-controlled storage unit you've arranged. Piano storage requires climate control to prevent humidity damage — we can advise on suitable options."],
          ["Will you disconnect or reconnect a player piano mechanism?", "Our crew will safely transport the piano and handle all structural assembly and disassembly. For proprietary electronic mechanisms on player pianos, we recommend having the original manufacturer or a qualified technician handle those specific connections."],
        ].map(([q, a]) => (
          <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
            <button
              class="w-full p-6 text-left flex items-center justify-between cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary focus:ring-inset hover:bg-gray-50 transition-colors"
              onclick="this.parentElement.querySelector('.faq-answer').classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');"
            >
              <h3 class="font-display font-semibold text-lg text-secondary pr-4">{q}</h3>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 flex-shrink-0"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="faq-answer hidden">
              <div class="p-6 pt-0 border-t border-gray-100">
                <p class="text-muted-foreground">{a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-16 bg-primary text-white">
    <div class="container text-center max-w-3xl mx-auto">
      <h2 class="font-display font-bold text-3xl md:text-4xl mb-6">Ready to Move Your Piano?</h2>
      <p class="text-white/90 text-lg mb-8">Call Denver's most trusted piano movers for a free, no-obligation quote today.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:7203401849" class={buttonVariants({ size: "lg", className: "bg-white !text-secondary hover:bg-white/90 font-semibold phone-link" })}>
          Call (720) 340-1849
        </a>
        <a href="#quote-form" class={buttonVariants({ size: "lg", className: "bg-secondary border border-white text-white hover:bg-secondary/80" })}>
          Get a Free Quote
        </a>
      </div>
      <p class="mt-6 text-white/80 text-sm">📍 8805 W. 14th Ave, Suite 300, Lakewood, CO 80215 &nbsp;|&nbsp; 🕒 Mon–Sat: 8am–6pm</p>
    </div>
  </section>

  <!-- Related Services -->
  <section class="py-12 bg-white border-t border-gray-100">
    <div class="container max-w-4xl mx-auto text-center">
      <h3 class="font-display font-bold text-xl text-secondary mb-5">Related Specialty Services</h3>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/services/specialty-items" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">All Specialty Moving</a>
        <a href="/services/grandfather-clock-moving" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">Grandfather Clocks</a>
        <a href="/services/fine-art-moving" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">Fine Art Moving</a>
        <a href="/services/antique-moving" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">Antique Moving</a>
        <a href="/services/local-moving" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">Local Moving</a>
        <a href="/services/residential-moving" class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">Residential Moving</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Piano Moving Services Denver",
    "description": "Professional piano moving services in Denver, Aurora, Lakewood, Boulder, and across Colorado's Front Range. Grand pianos, baby grands, upright pianos, and organs moved safely by trained specialists.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Legacy Moving Denver",
      "telephone": "+17203401849",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "8805 W. 14th Ave, Suite 300",
        "addressLocality": "Lakewood",
        "addressRegion": "CO",
        "postalCode": "80215",
        "addressCountry": "US"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "reviewCount": "1700"
      }
    },
    "areaServed": {"@type": "City", "name": "Denver"},
    "serviceType": "Piano Moving"
  }
  </script>
</BaseLayout>
