---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Image } from "astro:assets";
import { Building2, Clock, DollarSign, Shield, Truck, Users } from "lucide-react";
import movingImage from "../../assets/services/residential.jpg";

const pageTitle = "Apartment Moving Services Denver | Professional Apartment Movers Colorado";
const pageDescription = "Expert apartment moving services in Denver, Aurora, Lakewood, Boulder, and surrounding areas. Experienced with stairs, elevators, tight spaces. Fast, affordable apartment relocation throughout Colorado.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="relative min-h-[500px] flex items-center justify-center overflow-hidden">
    <Image
      src={movingImage}
      alt="Professional apartment moving services in Denver"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      width={1920}
      height={800}
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary/95 via-primary/85 to-primary/75"></div>
    
    <div class="container relative z-10">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <!-- Left Column - Content -->
        <div class="text-white space-y-6">
          <div class="inline-block">
            <span class="bg-white/20 backdrop-blur-sm text-white px-4 py-2 rounded-full text-sm font-semibold">
              Denver's Apartment Moving Experts
            </span>
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
            Professional <span class="text-accent">Apartment Moving</span> Services
          </h1>
          
          <p class="text-lg md:text-xl text-white/90 max-w-2xl">
            Fast, affordable apartment moving in Denver, Aurora, Lakewood, Boulder, and all surrounding areas. Experienced with stairs, elevators, and tight spaces.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 pt-4">
            <a
              href="tel:7203401849"
              class={`${buttonVariants({ size: "lg" })} bg-accent hover:bg-accent/90 text-white text-lg px-8 shadow-xl`}
            >
              <span class="mr-2">📞</span> Call (720) 340-1849
            </a>
          </div>

          <!-- Mobile CTA Buttons -->
          <div class="flex gap-3 pt-2 lg:hidden">
            <a
              href="#quote-form"
              class={buttonVariants({ variant: "secondary", size: "lg" })}
            >
              Get Free Quote
            </a>
            <a
              href="tel:7203401849"
              class={buttonVariants({ variant: "outline", size: "lg" })}
            >
              Call Now
            </a>
          </div>
        </div>

        <!-- Right Column - Quote Form (Desktop) -->
        <div class="hidden lg:block">
          <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md md:max-w-xl">
            <h2 class="text-2xl font-bold text-primary mb-4">Get Your Apartment Moving Quote</h2>
            <div data-version="10" id="J8QDKR-apartment"></div>
            <script is:inline>
              (function(r,k) {
                var s = document.createElement('script');
                s.async = true;
                s.defer = true;
                s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
                s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
                document.getElementById(r).appendChild(s);
              })('J8QDKR-apartment','JGCB6TGFN7N3NTTDOGMQUK1S9L3A4N73LYF2ZX4H248K97JD');
            </script>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-4">
          Why Choose Legacy Moving for Apartment Moves?
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Denver's trusted apartment moving specialists serving all metro area complexes
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Building2 class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Apartment Specialists</h3>
          <p class="text-gray-600">
            Experienced with apartment complexes, high-rises, walk-ups, and all building types throughout Denver metro.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Clock class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Fast & Efficient</h3>
          <p class="text-gray-600">
            Quick turnaround perfect for tight move-out/move-in schedules and lease end dates.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <DollarSign class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Affordable Rates</h3>
          <p class="text-gray-600">
            Competitive pricing with transparent quotes. No hidden fees or surprise charges on moving day.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Truck class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Right-Sized Equipment</h3>
          <p class="text-gray-600">
            Properly sized trucks and equipment for efficient apartment moves - from studios to 3-bedroom units.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Shield class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Building Protection</h3>
          <p class="text-gray-600">
            We protect walls, floors, and common areas. Familiar with building requirements and regulations.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Users class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Local Experts</h3>
          <p class="text-gray-600">
            We know Denver apartment complexes inside and out - from parking to elevator reservations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-8 text-center">
          Apartment Moving Services
        </h2>
        
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Studio & 1-Bedroom</h3>
            <p class="text-gray-600">Efficient moves for smaller apartments and studios</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ 2 & 3-Bedroom Units</h3>
            <p class="text-gray-600">Full-service moves for larger apartments and townhomes</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ High-Rise Buildings</h3>
            <p class="text-gray-600">Experienced with elevator moves and high-rise logistics</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Walk-Up Apartments</h3>
            <p class="text-gray-600">Expert stair navigation for 2nd, 3rd, 4th floor units</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Same-Day Moves</h3>
            <p class="text-gray-600">Last-minute availability for urgent apartment relocations</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Packing Services</h3>
            <p class="text-gray-600">Full or partial packing available to speed up your move</p>
          </div>
        </div>

        <div class="mt-8 bg-accent/10 border-l-4 border-accent rounded-lg p-6">
          <h3 class="text-xl font-bold text-primary mb-2">🏢 Apartment Complexes We Serve:</h3>
          <p class="text-gray-700">
            We regularly service all major apartment communities throughout Denver including The Coloradan, 
            Camden properties, Greystar apartments, Aimco communities, Equity Residential, Alliance Residential, 
            and hundreds of independent apartment buildings across Denver, Aurora, Lakewood, Boulder, and surrounding cities.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-6">
          Apartment Moving Throughout Denver Metro
        </h2>
        <p class="text-lg text-gray-600 mb-8">
          Professional apartment moving services across the entire Denver metropolitan area
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-gray-700">
          <div>Denver</div>
          <div>Aurora</div>
          <div>Lakewood</div>
          <div>Boulder</div>
          <div>Littleton</div>
          <div>Highlands Ranch</div>
          <div>Centennial</div>
          <div>Arvada</div>
          <div>Westminster</div>
          <div>Thornton</div>
          <div>Englewood</div>
          <div>Golden</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-primary to-primary-dark text-white">
    <div class="container text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        Ready to Book Your Apartment Move?
      </h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto text-white/90">
        Get your free quote today and experience stress-free apartment moving!
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="tel:7203401849"
          class={`${buttonVariants({ size: "lg" })} bg-accent hover:bg-accent/90 text-white text-lg px-8`}
        >
          📞 Call (720) 340-1849
        </a>
        <a
          href="sms:7203401849"
          class={`${buttonVariants({ size: "lg", variant: "secondary" })} text-lg px-8`}
        >
          💬 Text Us
        </a>
      </div>
      <p class="mt-6 text-white/80">
        📍 8805 W. 14th Ave, Suite 300, Lakewood, CO 80215<br />
        🕒 Monday - Sunday: 8:00am - 6:00pm
      </p>
    </div>
  </section>
</BaseLayout>
