---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MoverbaseRedirect from '../../components/MoverbaseRedirect.astro';
import { buttonVariants } from "@/components/ui/button";
import { Image } from "astro:assets";
import { Package, Clock, DollarSign, Shield, Truck, CheckCircle } from "lucide-react";
import movingImage from "../../assets/services/loading.jpg";

const pageTitle = "Small Moves Denver | Small Load Movers Colorado | Affordable Small Moving Services";
const pageDescription = "Affordable small move services in Denver, Aurora, Lakewood, and surrounding areas. Perfect for furniture delivery, single items, small apartments, dorm rooms. No minimum required. Fast, efficient small load moving.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="relative min-h-[500px] flex items-center justify-center overflow-hidden">
    <Image
      src={movingImage}
      alt="Small move services in Denver"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      width={1920}
      height={800}
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary/95 via-primary/85 to-primary/75"></div>
    
    <div class="container relative z-10">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <!-- Left Column - Content -->
        <div class="text-white space-y-6">
          <div class="inline-block">
            <span class="bg-white/20 backdrop-blur-sm text-white px-4 py-2 rounded-full text-sm font-semibold">
              Denver's Small Move Specialists
            </span>
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
            Small Move <span class="text-accent">Services</span>
          </h1>
          
          <p class="text-lg md:text-xl text-white/90 max-w-2xl">
            Affordable small load moving in Denver, Aurora, Lakewood, and surrounding areas. Perfect for furniture delivery, single items, or small apartment moves.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 pt-4">
            <a
              href="tel:7203401849"
              class={`${buttonVariants({ size: "lg" })} bg-accent hover:bg-accent/90 text-white text-lg px-8 shadow-xl`}
            >
              <span class="mr-2">📞</span> Call (720) 340-1849
            </a>
          </div>

          <!-- Mobile CTA Buttons -->
          <div class="flex gap-3 pt-2 lg:hidden">
            <a
              href="#quote-form"
              class={buttonVariants({ variant: "secondary", size: "lg" })}
            >
              Get Free Quote
            </a>
            <a
              href="tel:7203401849"
              class={buttonVariants({ variant: "outline", size: "lg" })}
            >
              Call Now
            </a>
          </div>
        </div>

        <!-- Right Column - Quote Form (Desktop) -->
        <div class="hidden lg:block">
          <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md md:max-w-xl">
            <div data-version="10" id="J8QDKR-small"></div>
            <script is:inline>
              (function(r,k) {
                var s = document.createElement('script');
                s.async = true;
                s.defer = true;
                s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
                s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
                document.getElementById(r).appendChild(s);
              })('J8QDKR-small','JGCB6TGFN7N3NTTDOGMQUK1S9L3A4N73LYF2ZX4H248K97JD');
            </script>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mobile Quote Form -->
  <section id="quote-form" class="py-8 bg-gray-50 lg:hidden">
    <div class="container">
      <div class="bg-white rounded-2xl shadow-2xl p-6 max-w-2xl mx-auto">
        <div data-version="10" id="J8QDKR-small-mobile"></div>
        <script is:inline>
          (function(r,k) {
            var s = document.createElement('script');
            s.async = true;
            s.defer = true;
            s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
            s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
            document.getElementById(r).appendChild(s);
          })('J8QDKR-small-mobile','JGCB6TGFN7N3NTTDOGMQUK1S9L3A4N73LYF2ZX4H248K97JD');
        </script>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-4">
          Why Choose Legacy Moving for Small Moves?
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Professional small load moving services throughout Denver and Colorado
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <DollarSign class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Affordable Pricing</h3>
          <p class="text-gray-600">
            Pay only for what you need. No minimum requirements. Cost-effective rates for small loads and single items.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Clock class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Quick Service</h3>
          <p class="text-gray-600">
            Fast turnaround with same-day and next-day availability. Perfect for urgent furniture deliveries.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Truck class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Right-Sized Trucks</h3>
          <p class="text-gray-600">
            Smaller trucks perfect for small moves - you won't pay for unused space in a large moving truck.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Package class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Careful Handling</h3>
          <p class="text-gray-600">
            Professional care for every item, no matter how small. Your belongings are protected throughout transit.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Shield class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Fully Insured</h3>
          <p class="text-gray-600">
            Licensed and insured professional movers. Complete protection for small and large moves alike.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <CheckCircle class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">No Job Too Small</h3>
          <p class="text-gray-600">
            We handle moves other companies turn away. Single furniture pieces to studio apartments - we do it all.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-8 text-center">
          Small Moving Services We Provide
        </h2>
        
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Single Furniture Items</h3>
            <p class="text-gray-600">Couches, beds, dressers, tables, desks - one item or several</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Furniture Delivery</h3>
            <p class="text-gray-600">IKEA, Wayfair, Amazon, or store purchases delivered to your home</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Studio Apartments</h3>
            <p class="text-gray-600">Complete small apartment and studio moves</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Dorm Room Moves</h3>
            <p class="text-gray-600">College student moves and dorm room relocations</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Estate Sale Pickups</h3>
            <p class="text-gray-600">Pickup and delivery of items purchased at estate sales or auctions</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Marketplace Purchases</h3>
            <p class="text-gray-600">Facebook Marketplace, Craigslist, OfferUp item pickup and delivery</p>
          </div>
        </div>

        <div class="mt-8 bg-accent/10 border-l-4 border-accent rounded-lg p-6">
          <h3 class="text-xl font-bold text-primary mb-2">📦 Perfect For:</h3>
          <p class="text-gray-700">
            Furniture purchases from IKEA, Target, Walmart, Wayfair, Amazon, local furniture stores, estate sales, 
            garage sales, Facebook Marketplace, Craigslist, OfferUp, and any other small moving or delivery needs. 
            No minimum load size required - call us for any size job!
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-6">
          Small Move Services Throughout Denver Metro
        </h2>
        <p class="text-lg text-gray-600 mb-8">
          Fast, affordable small load moving across the Denver metropolitan area
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-gray-700">
          <div><a href="/cities/denver" class="hover:text-primary transition-colors">Denver</a></div>
          <div><a href="/cities/aurora" class="hover:text-primary transition-colors">Aurora</a></div>
          <div><a href="/cities/lakewood" class="hover:text-primary transition-colors">Lakewood</a></div>
          <div><a href="/cities/boulder" class="hover:text-primary transition-colors">Boulder</a></div>
          <div><a href="/cities/littleton" class="hover:text-primary transition-colors">Littleton</a></div>
          <div><a href="/cities/highlands-ranch" class="hover:text-primary transition-colors">Highlands Ranch</a></div>
          <div><a href="/cities/centennial" class="hover:text-primary transition-colors">Centennial</a></div>
          <div><a href="/cities/arvada" class="hover:text-primary transition-colors">Arvada</a></div>
          <div><a href="/cities/westminster" class="hover:text-primary transition-colors">Westminster</a></div>
          <div><a href="/cities/thornton" class="hover:text-primary transition-colors">Thornton</a></div>
          <div><a href="/cities/englewood" class="hover:text-primary transition-colors">Englewood</a></div>
          <div><a href="/cities/golden" class="hover:text-primary transition-colors">Golden</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-primary to-primary-dark text-white">
    <div class="container text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        Need Help With a Small Move?
      </h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto text-white/90">
        No job is too small! Get your free quote today for affordable small load moving.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="tel:7203401849"
          class={`${buttonVariants({ size: "lg" })} bg-accent hover:bg-accent/90 text-white text-lg px-8`}
        >
          📞 Call (720) 340-1849
        </a>
        <a
          href="sms:7203401849"
          class={`${buttonVariants({ size: "lg", variant: "secondary" })} text-lg px-8`}
        >
          💬 Text Us
        </a>
      </div>
      <p class="mt-6 text-white/80">
        📍 8805 W. 14th Ave, Suite 300, Lakewood, CO 80215<br />
        🕒 Monday - Sunday: 8:00am - 6:00pm
      </p>
    </div>
  </section>
<MoverbaseRedirect />
</BaseLayout>
