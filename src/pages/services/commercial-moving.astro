---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import ContactForm from '@/components/ContactForm';
import { Building, MapPin, Briefcase, Phone, Clock, Users, CheckSquare, Calendar } from "lucide-react";
import { Image } from 'astro:assets';
import commercialImage from '../../assets/services/commercial.jpg';
import movingImage from '../../assets/316550678_506021318211474_228316229773797537_n_nw_727420e9.jpg';
---

<BaseLayout
  title="Commercial Moving Services Denver | Office Movers | Legacy Moving"
  description="Professional commercial moving services in Denver. Our office movers provide efficient business relocations, minimizing downtime with expert equipment handling and strategic planning."
>
  <!-- Hero Section -->
  <section class="relative bg-secondary py-20 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image src={movingImage} alt="Legacy Moving Denver professional commercial movers handling office equipment" class="w-full h-full object-cover" />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">
          Professional Commercial Moving Services
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto">
          Minimize downtime and keep your business running with our efficient office and commercial moving solutions. Denver's trusted business movers.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-primary text-white hover:bg-primary/80 hover:text-white font-semibold' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary/80 border border-white/20 text-white hover:bg-secondary hover:text-white phone-link' })} data-google-link="https://maps.app.goo.gl/E3SEsp435kWzLBeQ8">
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 md:py-24">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-6">
            <Building size={32} className="text-primary" />
          </div>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">Denver's Trusted Commercial Movers</h2>
          <div class="space-y-4">
            <p class="text-muted-foreground">
              At Legacy Moving Denver, we understand that business relocations require specialized planning, precise execution, and minimal disruption. Our commercial moving services are designed to keep your business operations running smoothly during your transition to a new space.
            </p>
            <p class="text-muted-foreground">
              Whether you're relocating a small office or an entire corporate headquarters, our experienced team handles your business move with the professionalism and efficiency you expect.
            </p>
            <div class="space-y-2 pt-2">
              <div class="flex items-start gap-2">
                <div class="text-primary mt-1">✓</div>
                <p class="text-muted-foreground">Specialized office moving and equipment handling</p>
              </div>
              <div class="flex items-start gap-2">
                <div class="text-primary mt-1">✓</div>
                <p class="text-muted-foreground">Strategic planning to minimize business downtime</p>
              </div>
              <div class="flex items-start gap-2">
                <div class="text-primary mt-1">✓</div>
                <p class="text-muted-foreground">IT equipment transport with proper protection</p>
              </div>
              <div class="flex items-start gap-2">
                <div class="text-primary mt-1">✓</div>
                <p class="text-muted-foreground">Weekend & after-hours moves to avoid disruption</p>
              </div>
            </div>
            <div class="pt-4">
              <a href="/get-quote" class={buttonVariants({ className: 'mt-2' })}>
                Get a Free Quote
              </a>
            </div>
          </div>
        </div>
        <div class="rounded-lg overflow-hidden shadow-xl">
          <Image 
            src={commercialImage} 
            alt="Legacy Moving Denver commercial moving services"
            class="w-full h-auto object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Our Commercial Services -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">Comprehensive Commercial Moving Solutions</h2>
        <p class="text-muted-foreground">
          From detailed planning to specialized equipment handling, we provide everything needed for a successful business relocation.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Service 1 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <Calendar size={24} className="text-primary" />
          </div>
          <h3 class="font-display font-semibold text-xl mb-2 text-secondary">Strategic Move Planning</h3>
          <p class="text-muted-foreground mb-4">We work closely with your team to develop a customized moving strategy that minimizes disruption to your business operations and ensures a smooth transition to your new location.</p>
        </div>
        
        <!-- Service 2 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="8" height="16" x="2" y="4" rx="1"></rect><rect width="8" height="16" x="14" y="4" rx="1"></rect></svg>
          </div>
          <h3 class="font-display font-semibold text-xl mb-2 text-secondary">IT & Equipment Relocation</h3>
          <p class="text-muted-foreground mb-4">Our team specializes in safely disconnecting, packing, transporting, and reconnecting computers, servers, printers, and other sensitive technology with proper care and handling protocols.</p>
        </div>
        
        <!-- Service 3 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16"></path><path d="M3 7h18"></path><path d="M9 21v-7"></path><path d="M15 21v-7"></path></svg>
          </div>
          <h3 class="font-display font-semibold text-xl mb-2 text-secondary">Office Furniture Disassembly</h3>
          <p class="text-muted-foreground mb-4">We expertly disassemble, pack, transport, and reassemble desks, cubicles, conference tables, and all office furniture to maintain their condition and functionality in your new space.</p>
        </div>
        
        <!-- Service 4 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <Briefcase size={24} className="text-primary" />
          </div>
          <h3 class="font-display font-semibold text-xl mb-2 text-secondary">File & Document Management</h3>
          <p class="text-muted-foreground mb-4">Our secure document handling procedures ensure your confidential files, records, and documents are properly packed, organized, and transported with utmost security and care.</p>
        </div>
        
        <!-- Service 5 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M3 6v18h18V6"></path><path d="M19 6V2H3v4"></path><path d="M10 16a2 2 0 1 0 4 0 2 2 0 0 0-4 0z"></path></svg>
          </div>
          <h3 class="font-display font-semibold text-xl mb-2 text-secondary">After-Hours Service</h3>
          <p class="text-muted-foreground mb-4">We offer evening, weekend, and holiday moving services to minimize disruption to your regular business hours, allowing you to maintain productivity during the relocation process.</p>
        </div>
        
        <!-- Service 6 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <Users size={24} className="text-primary" />
          </div>
          <h3 class="font-display font-semibold text-xl mb-2 text-secondary">Project Management</h3>
          <p class="text-muted-foreground mb-4">Our dedicated move coordinators oversee every aspect of your commercial move, serving as your single point of contact and ensuring all details are handled professionally and efficiently.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Value Proposition Banner -->
  <section class="py-6 bg-gradient-to-r from-primary to-secondary">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-white text-base md:text-lg font-semibold mb-3">
          What Sets Us Apart?
        </p>
        <p class="text-white/95 text-sm md:text-base">
          No travel time charges • Free tape & shrink wrap • No fuel surcharges • Zero hidden fees • Accurate quotes you can trust
        </p>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 md:py-24">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="order-2 md:order-1">
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path><path d="M13 5v2"></path><path d="M13 17v2"></path><path d="M13 11v2"></path></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-xl mb-1 text-secondary">Business Continuity Focus</h3>
                <p class="text-muted-foreground">We understand that minimizing downtime is crucial. Our commercial moving processes are designed to keep your business operations running smoothly throughout the transition.</p>
              </div>
            </div>
            
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 20H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2"></path><path d="M12 14H7"></path><path d="M9 18H7"></path><path d="M21 12h-4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2z"></path><path d="M16 14h.01"></path><path d="M16 20h.01"></path><path d="M18 16h.01"></path><path d="M18 18h.01"></path><path d="M20 14h.01"></path><path d="M20 20h.01"></path></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-xl mb-1 text-secondary">Technology Expertise</h3>
                <p class="text-muted-foreground">Our teams have specialized training in handling and transporting technology and sensitive equipment, ensuring your IT infrastructure is protected throughout the move.</p>
              </div>
            </div>
            
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-xl mb-1 text-secondary">Transparent Pricing</h3>
                <p class="text-muted-foreground">We provide detailed quotes with no hidden fees. Our commercial moving rates are competitive and tailored to the specific needs of your business relocation.</p>
              </div>
            </div>
            
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 4 3 12h14l3-12-6 7-4-7-4 7-6-7Z"></path><path d="m4 16 8 6 8-6"></path></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-xl mb-1 text-secondary">Flexible Scheduling</h3>
                <p class="text-muted-foreground">We work around your business hours to minimize disruption. Our commercial movers are available evenings, weekends, and holidays to accommodate your specific timeline needs.</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="order-1 md:order-2">
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">Why Denver Businesses Choose Legacy Moving</h2>
          <p class="text-muted-foreground mb-8">
            Since 2018, we've helped businesses of all sizes relocate efficiently across Denver and beyond. Our commercial moving services are built on a foundation of reliability, expertise, and customer focus:
          </p>
          <CheckSquare size={24} className="text-primary mb-4" />
          <blockquote class="text-lg italic text-muted-foreground">
            "Legacy Moving handled our office relocation flawlessly. They moved 50+ employees over a weekend with zero disruption to our operations. Everything was set up and ready Monday morning. Their team was professional, efficient, and incredibly organized."
            <footer class="mt-2 text-sm not-italic">
              - Michael T., Operations Director
            </footer>
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="bg-primary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">Ready to Relocate Your Business?</h2>
        <p class="text-white/90 text-lg mb-8">
          Contact our commercial moving specialists today for a free, customized quote on your business relocation.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/get-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-secondary hover:bg-primary hover:text-white font-semibold transition-colors' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary border border-white text-white hover:bg-secondary/80 hover:text-white phone-link transition-colors' })} data-google-link="https://maps.app.goo.gl/E3SEsp435kWzLBeQ8">
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-10 text-secondary text-center">
          Frequently Asked Questions About Commercial Moving
        </h2>
        
        <div class="space-y-6">
          <!-- FAQ 1 -->
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-display font-semibold text-xl mb-3 text-secondary">How far in advance should we plan our business relocation?</h3>
            <p class="text-muted-foreground">
              We recommend planning your commercial move at least 2-3 months in advance. This allows adequate time for strategic planning, coordination with building management, and minimal disruption to your operations. For larger offices, 4-6 months of planning is ideal.
            </p>
          </div>
          
          <!-- FAQ 2 -->
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-display font-semibold text-xl mb-3 text-secondary">How do you handle IT equipment and sensitive technology?</h3>
            <p class="text-muted-foreground">
              Our commercial movers are trained in proper IT handling procedures. We use specialized packing materials, anti-static wrapping, and secure transport methods. We can work with your IT team to plan disconnection and reconnection procedures, or handle the entire process ourselves.
            </p>
          </div>
          
          <!-- FAQ 3 -->
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Can you move our business over a weekend to avoid downtime?</h3>
            <p class="text-muted-foreground">
              Yes, weekend moves are one of our specialties for commercial clients. We can schedule your move to begin after business hours on Friday and complete setup by Sunday evening, ensuring you're ready for business Monday morning with minimal disruption.
            </p>
          </div>
          
          <!-- FAQ 4 -->
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Do you provide storage for office furniture and equipment?</h3>
            <p class="text-muted-foreground">
              Yes, we offer both short-term and long-term storage solutions for businesses. This is particularly useful during phased moves, downsizing, or when your new space isn't ready yet. Our climate-controlled facilities ensure your equipment and furniture remain in perfect condition.
            </p>
          </div>
          
          <!-- FAQ 5 -->
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <h3 class="font-display font-semibold text-xl mb-3 text-secondary">How do you handle office cubicle and workstation moves?</h3>
            <p class="text-muted-foreground">
              Our teams are experienced in disassembly, transport, and reassembly of modular office furniture and cubicles. We work from detailed floor plans of your new space, and can collaborate with furniture vendors or manufacturers when needed to ensure proper reinstallation.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="py-16 md:py-24">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">Get Your Free Commercial Moving Quote</h2>
          <p class="text-muted-foreground mb-8">
            Our team is ready to help with your business relocation. Fill out the form for a detailed quote, or call us directly to speak with our commercial moving specialists.
          </p>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 w-10 h-10 bg-primary/10 text-primary rounded-full flex items-center justify-center">
                <MapPin size={20} />
              </div>
              <div>
                <h3 class="font-semibold text-secondary">Our Location</h3>
                <p class="text-muted-foreground">8805 W. 14th Ave, Suite 300, Lakewood, CO 80215</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 w-10 h-10 bg-primary/10 text-primary rounded-full flex items-center justify-center">
                <Phone size={20} />
              </div>
              <div>
                <h3 class="font-semibold text-secondary">Call Us</h3>
                <a href="tel:7203401849" class="text-primary hover:underline phone-link" data-google-link="https://maps.app.goo.gl/E3SEsp435kWzLBeQ8">
                  (720) 340-1849
                </a>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 w-10 h-10 bg-primary/10 text-primary rounded-full flex items-center justify-center">
                <Clock size={20} />
              </div>
              <div>
                <h3 class="font-semibold text-secondary">Hours</h3>
                <p class="text-muted-foreground">Mon-Sun: 8:00am - 6:00pm</p>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-xl">
          <h3 class="text-secondary font-display font-bold text-2xl mb-4">Request a Quote</h3>
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>