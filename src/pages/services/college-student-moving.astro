---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Image } from "astro:assets";
import { GraduationCap, DollarSign, Clock, Truck, Shield, Calendar } from "lucide-react";
import movingImage from "../../assets/services/residential.jpg";

const pageTitle = "College Student Moving Services Denver | Affordable Dorm & Apartment Movers";
const pageDescription = "Affordable college student moving services in Denver, Boulder, Aurora, and surrounding areas. Dorm moves, apartment moves, and storage solutions. Flexible scheduling for students at CU Boulder, DU, Metro State, and more.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="relative min-h-[500px] flex items-center justify-center overflow-hidden">
    <Image
      src={movingImage}
      alt="College student moving services in Denver and Boulder"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      width={1920}
      height={800}
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary/95 via-primary/85 to-primary/75"></div>
    
    <div class="container relative z-10">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <!-- Left Column - Content -->
        <div class="text-white space-y-6">
          <div class="inline-block">
            <span class="bg-white/20 backdrop-blur-sm text-white px-4 py-2 rounded-full text-sm font-semibold">
              Student-Friendly Moving Services
            </span>
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
            College Student <span class="text-accent">Moving Services</span>
          </h1>
          
          <p class="text-lg md:text-xl text-white/90 max-w-2xl">
            Affordable, flexible moving services for students in Denver, Boulder, Aurora, and surrounding areas. Dorm moves, apartment moves, and storage solutions.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 pt-4">
            <a
              href="tel:7203401849"
              class={`${buttonVariants({ size: "lg" })} bg-accent hover:bg-accent/90 text-white text-lg px-8 shadow-xl`}
            >
              <span class="mr-2">📞</span> Call (720) 340-1849
            </a>
          </div>

          <!-- Mobile CTA Buttons -->
          <div class="flex gap-3 pt-2 lg:hidden">
            <a
              href="#quote-form"
              class={buttonVariants({ variant: "secondary", size: "lg" })}
            >
              Get Student Discount
            </a>
            <a
              href="tel:7203401849"
              class={buttonVariants({ variant: "outline", size: "lg" })}
            >
              Call Now
            </a>
          </div>
        </div>

        <!-- Right Column - Quote Form (Desktop) -->
        <div class="hidden lg:block">
          <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md md:max-w-xl">
            <div data-version="10" id="J8QDKR-college"></div>
            <script is:inline>
              (function(r,k) {
                var s = document.createElement('script');
                s.async = true;
                s.defer = true;
                s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
                s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
                document.getElementById(r).appendChild(s);
              })('J8QDKR-college','JGCB6TGFN7N3NTTDOGMQUK1S9L3A4N73LYF2ZX4H248K97JD');
            </script>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mobile Quote Form -->
  <section id="quote-form" class="py-8 bg-gray-50 lg:hidden">
    <div class="container">
      <div class="bg-white rounded-2xl shadow-2xl p-6 max-w-2xl mx-auto">
        <div data-version="10" id="J8QDKR-college-mobile"></div>
        <script is:inline>
          (function(r,k) {
            var s = document.createElement('script');
            s.async = true;
            s.defer = true;
            s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
            s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
            document.getElementById(r).appendChild(s);
          })('J8QDKR-college-mobile','JGCB6TGFN7N3NTTDOGMQUK1S9L3A4N73LYF2ZX4H248K97JD');
        </script>
      </div>
    </div>
  </section>

  <!-- Why Choose Us for Student Moves -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-4">
          Why Students Choose Legacy Moving
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          We understand student budgets and schedules. Serving CU Boulder, DU, Metro State, Regis, and all Denver-area colleges.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <DollarSign class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Student Discounts</h3>
          <p class="text-gray-600">
            Special affordable rates for college students. We work with your budget without sacrificing quality service.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Calendar class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Flexible Scheduling</h3>
          <p class="text-gray-600">
            Weekend and evening availability to fit your class schedule. Peak season booking for semester transitions.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Truck class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Right-Sized Vehicles</h3>
          <p class="text-gray-600">
            From small dorm moves to full apartments. We have the right size truck to keep your costs down.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Clock class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Quick Moves</h3>
          <p class="text-gray-600">
            Fast, efficient service perfect for dorm check-out deadlines and lease end dates.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Shield class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Licensed & Insured</h3>
          <p class="text-gray-600">
            Fully licensed and insured professional movers. Your belongings are protected throughout the move.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <GraduationCap class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Local Experts</h3>
          <p class="text-gray-600">
            We know all the Denver-area campuses, dorms, and student housing complexes inside and out.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Student Moving Services -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-8 text-center">
          Student Moving Services We Provide
        </h2>
        
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Dorm Room Moves</h3>
            <p class="text-gray-600">Moving in and out of campus dorms at semester start and end</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Apartment Moves</h3>
            <p class="text-gray-600">Off-campus housing, shared apartments, and student complexes</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Summer Storage Moves</h3>
            <p class="text-gray-600">Moving belongings to and from storage between semesters</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Interstate Moves</h3>
            <p class="text-gray-600">Coming to or leaving Colorado for college - long distance moves</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Loading & Unloading</h3>
            <p class="text-gray-600">Help with rental trucks - we do the heavy lifting</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Furniture Assembly</h3>
            <p class="text-gray-600">Assembly and disassembly of beds, desks, and furniture</p>
          </div>
        </div>

        <div class="mt-8 bg-accent/10 border-l-4 border-accent rounded-lg p-6">
          <h3 class="text-xl font-bold text-primary mb-2">🎓 Colleges & Universities We Serve:</h3>
          <p class="text-gray-700">
            University of Colorado Boulder (CU Boulder), University of Denver (DU), Metropolitan State University (MSU Denver), 
            Colorado School of Mines, Regis University, Community College of Denver, Red Rocks Community College, 
            Front Range Community College, and all Denver-area colleges!
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-6">
          Serving Denver Metro College Communities
        </h2>
        <p class="text-lg text-gray-600 mb-8">
          Student moving services throughout Denver, Boulder, and surrounding areas
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-gray-700">
          <div><a href="/cities/boulder" class="hover:text-primary transition-colors">Boulder</a></div>
          <div><a href="/cities/denver" class="hover:text-primary transition-colors">Denver</a></div>
          <div><a href="/cities/aurora" class="hover:text-primary transition-colors">Aurora</a></div>
          <div><a href="/cities/lakewood" class="hover:text-primary transition-colors">Lakewood</a></div>
          <div><a href="/cities/golden" class="hover:text-primary transition-colors">Golden</a></div>
          <div><a href="/cities/westminster" class="hover:text-primary transition-colors">Westminster</a></div>
          <div><a href="/cities/arvada" class="hover:text-primary transition-colors">Arvada</a></div>
          <div><a href="/cities/littleton" class="hover:text-primary transition-colors">Littleton</a></div>
          <div><a href="/cities/englewood" class="hover:text-primary transition-colors">Englewood</a></div>
          <div><a href="/cities/highlands-ranch" class="hover:text-primary transition-colors">Highlands Ranch</a></div>
          <div><a href="/cities/centennial" class="hover:text-primary transition-colors">Centennial</a></div>
          <div><a href="/cities/thornton" class="hover:text-primary transition-colors">Thornton</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-primary to-primary-dark text-white">
    <div class="container text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        Ready to Book Your Student Move?
      </h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto text-white/90">
        Get your free quote today and take advantage of our student discount rates!
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="tel:7203401849"
          class={`${buttonVariants({ size: "lg" })} bg-accent hover:bg-accent/90 text-white text-lg px-8`}
        >
          📞 Call (720) 340-1849
        </a>
        <a
          href="sms:7203401849"
          class={`${buttonVariants({ size: "lg", variant: "secondary" })} text-lg px-8`}
        >
          💬 Text Us
        </a>
      </div>
      <p class="mt-6 text-white/80">
        📍 8805 W. 14th Ave, Suite 300, Lakewood, CO 80215<br />
        🕒 Monday - Sunday: 8:00am - 6:00pm
      </p>
    </div>
  </section>
</BaseLayout>
