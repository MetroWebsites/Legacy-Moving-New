---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Image } from "astro:assets";
import { Palette, Shield, Package, Clock, Award, Users } from "lucide-react";
import movingImage from "../../assets/services/packing.jpg";

const pageTitle = "Art & Antique Moving Services Denver | Fine Art & Antique Movers";
const pageDescription = "Expert art and antique moving services in Denver, Aurora, Lakewood, and surrounding areas. Climate-controlled transport, custom crating, white-glove service. Professional handling of paintings, sculptures, antiques, and collectibles.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="relative min-h-[500px] flex items-center justify-center overflow-hidden">
    <Image
      src={movingImage}
      alt="Professional art and antique moving services in Denver"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      width={1920}
      height={800}
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary/95 via-primary/85 to-primary/75"></div>
    
    <div class="container relative z-10">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <!-- Left Column - Content -->
        <div class="text-white space-y-6">
          <div class="inline-block">
            <span class="bg-white/20 backdrop-blur-sm text-white px-4 py-2 rounded-full text-sm font-semibold">
              White-Glove Art & Antique Services
            </span>
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
            Art & Antique <span class="text-accent">Moving Specialists</span>
          </h1>
          
          <p class="text-lg md:text-xl text-white/90 max-w-2xl">
            Expert handling and transport of fine art, antiques, and valuable collectibles. Serving Denver, Cherry Creek, Greenwood Village, and all surrounding areas.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 pt-4">
            <a
              href="tel:7203401849"
              class={`${buttonVariants({ size: "lg" })} bg-accent hover:bg-accent/90 text-white text-lg px-8 shadow-xl`}
            >
              <span class="mr-2">📞</span> Call (720) 340-1849
            </a>
          </div>

          <!-- Mobile CTA Buttons -->
          <div class="flex gap-3 pt-2 lg:hidden">
            <a
              href="#quote-form"
              class={buttonVariants({ variant: "secondary", size: "lg" })}
            >
              Get Free Consultation
            </a>
            <a
              href="tel:7203401849"
              class={buttonVariants({ variant: "outline", size: "lg" })}
            >
              Call Now
            </a>
          </div>
        </div>

        <!-- Right Column - Quote Form (Desktop) -->
        <div class="hidden lg:block">
          <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md md:max-w-xl">
            <h2 class="text-2xl font-bold text-primary mb-4">Request Art Moving Service</h2>
            <div data-version="10" id="J8QDKR-art"></div>
            <script is:inline>
              (function(r,k) {
                var s = document.createElement('script');
                s.async = true;
                s.defer = true;
                s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
                s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
                document.getElementById(r).appendChild(s);
              })('J8QDKR-art','JGCB6TGFN7N3NTTDOGMQUK1S9L3A4N73LYF2ZX4H248K97JD');
            </script>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mobile Quote Form -->
  <section id="quote-form" class="py-8 bg-gray-50 lg:hidden">
    <div class="container">
      <div class="bg-white rounded-2xl shadow-2xl p-6 max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-primary mb-4 text-center">Request Art Moving Service</h2>
        <div data-version="10" id="J8QDKR-art-mobile"></div>
        <script is:inline>
          (function(r,k) {
            var s = document.createElement('script');
            s.async = true;
            s.defer = true;
            s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
            s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
            document.getElementById(r).appendChild(s);
          })('J8QDKR-art-mobile','JGCB6TGFN7N3NTTDOGMQUK1S9L3A4N73LYF2ZX4H248K97JD');
        </script>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-4">
          Why Choose Legacy Moving for Fine Art & Antiques?
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Specialized expertise in handling valuable and irreplaceable items throughout Denver and Colorado
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Palette class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Fine Art Specialists</h3>
          <p class="text-gray-600">
            Trained professionals experienced in handling paintings, sculptures, prints, and delicate artwork of all types.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Package class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Custom Crating</h3>
          <p class="text-gray-600">
            Museum-quality custom crating and packing materials designed specifically for your valuable items.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Shield class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Climate Control</h3>
          <p class="text-gray-600">
            Temperature and humidity-controlled transport to protect sensitive antiques and artwork during transit.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Award class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">White-Glove Service</h3>
          <p class="text-gray-600">
            Premium, attentive care for every piece. We treat your valuables as if they were our own.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Users class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Expert Team</h3>
          <p class="text-gray-600">
            Experienced handlers with specialized training in fine art and antique moving techniques.
          </p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <Clock class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Flexible Scheduling</h3>
          <p class="text-gray-600">
            Accommodating scheduling for gallery installations, estate sales, and private collections.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-8 text-center">
          Specialized Art & Antique Services
        </h2>
        
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Fine Art Transport</h3>
            <p class="text-gray-600">Paintings, sculptures, prints, and mixed media artwork</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Antique Furniture</h3>
            <p class="text-gray-600">Delicate period furniture, heirlooms, and vintage pieces</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Gallery & Museum Moves</h3>
            <p class="text-gray-600">Installation and de-installation services for exhibitions</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Estate Sales Support</h3>
            <p class="text-gray-600">Careful handling during estate liquidations and auctions</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Collectibles & Valuables</h3>
            <p class="text-gray-600">China, crystal, porcelain, and precious collectibles</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-bold text-primary mb-3">✓ Specialized Packing</h3>
            <p class="text-gray-600">Archival materials and custom solutions for unique items</p>
          </div>
        </div>

        <div class="mt-8 bg-accent/10 border-l-4 border-accent rounded-lg p-6">
          <h3 class="text-xl font-bold text-primary mb-2">🎨 Items We Specialize In:</h3>
          <p class="text-gray-700">
            Oil paintings, watercolors, bronze sculptures, marble statues, porcelain, crystal, antique furniture, 
            vintage instruments, rare books, fine china, oriental rugs, chandeliers, mirrors, and all valuable collectibles.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-6">
          Serving Denver's Premier Neighborhoods
        </h2>
        <p class="text-lg text-gray-600 mb-8">
          White-glove art and antique moving services throughout the Denver metro area
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-gray-700">
          <div>Cherry Creek</div>
          <div>Denver</div>
          <div>Greenwood Village</div>
          <div>Castle Rock</div>
          <div>Highlands Ranch</div>
          <div>Littleton</div>
          <div>Aurora</div>
          <div>Lakewood</div>
          <div>Boulder</div>
          <div>Golden</div>
          <div>Centennial</div>
          <div>Englewood</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-primary to-primary-dark text-white">
    <div class="container text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        Trust Your Valuables to the Experts
      </h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto text-white/90">
        Contact us today for a free consultation on your art and antique moving needs.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="tel:7203401849"
          class={`${buttonVariants({ size: "lg" })} bg-accent hover:bg-accent/90 text-white text-lg px-8`}
        >
          📞 Call (720) 340-1849
        </a>
        <a
          href="sms:7203401849"
          class={`${buttonVariants({ size: "lg", variant: "secondary" })} text-lg px-8`}
        >
          💬 Text Us
        </a>
      </div>
      <p class="mt-6 text-white/80">
        📍 8805 W. 14th Ave, Suite 300, Lakewood, CO 80215<br />
        🕒 Monday - Sunday: 8:00am - 6:00pm
      </p>
    </div>
  </section>
</BaseLayout>
