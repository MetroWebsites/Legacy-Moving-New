---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import teamImage from '../assets/308748956_459885262825080_6269738357866645302_n_nw_0489b96e.jpg';
import ownerImage from '../assets/andrew-mcfarland-portrait_nw_15e22c72.png';
---

<BaseLayout
  title="About Us | Legacy Moving Denver | Our Story"
  description="Learn about Legacy Moving Denver, our mission, values, and the team behind Denver's trusted moving company. Serving the Denver community since 2018."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={teamImage} 
        alt="Legacy Moving Denver team" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">About Legacy Moving Denver</h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto">
          Meet the team behind Denver's trusted moving company. Since 2018, we've been helping families and businesses move with confidence.
        </p>
      </div>
    </div>
  </section>

  <!-- Our Story Section -->
  <section class="py-16">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
        <div>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">Our Story</h2>
          <p class="text-muted-foreground mb-4">
            Legacy Moving Denver was founded in 2018 with a simple mission: to provide the Denver community with a moving service they could truly trust. After experiencing the frustrations of unprofessional movers firsthand, our founder Andrew McFarland set out to create a company that would set a new standard for the moving industry in Denver.
          </p>
          <p class="text-muted-foreground mb-4">
            Starting with just one truck and a small team, Legacy Moving quickly earned a reputation for exceptional service, care, and professionalism. We've since grown to become one of Denver's highest-rated moving companies, serving thousands of satisfied customers throughout the metro area and beyond.
          </p>
          <p class="text-muted-foreground mb-4">
            What sets us apart isn't just our moving expertise, but our genuine commitment to making each customer's move as stress-free and positive as possible. We believe that moving doesn't have to be a dreaded experience – with the right team, it can be the exciting start of a new chapter.
          </p>
        </div>
        <div>
          <div class="relative rounded-lg overflow-hidden shadow-xl">
            <Image 
              src={ownerImage} 
              alt="Andrew McFarland, Founder of Legacy Moving Denver" 
              class="w-full h-auto object-cover"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-4">
              <h3 class="text-white font-semibold text-xl">Andrew McFarland</h3>
              <p class="text-white/80 text-sm">Founder & CEO</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Values -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">Our Core Values</h2>
        <p class="text-muted-foreground max-w-3xl mx-auto">These principles guide everything we do at Legacy Moving Denver.</p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Value 1 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
          </div>
          <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Customer First</h3>
          <p class="text-muted-foreground">
            We prioritize your needs, concerns, and satisfaction above all else. Your peace of mind is our primary goal throughout the entire moving process.
          </p>
        </div>
        
        <!-- Value 2 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg>
          </div>
          <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Integrity</h3>
          <p class="text-muted-foreground">
            We believe in honest, transparent business practices. From upfront pricing to clear communication, we operate with integrity in everything we do.
          </p>
        </div>
        
        <!-- Value 3 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 text-center">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="M7 21h10"></path><path d="M12 3v18"></path><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"></path></svg>
          </div>
          <h3 class="font-display font-semibold text-xl mb-3 text-secondary">Excellence</h3>
          <p class="text-muted-foreground">
            We strive for excellence in every move, from the careful handling of your belongings to the efficiency of our processes and the professionalism of our team.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">Why Choose Legacy Moving</h2>
        <p class="text-muted-foreground max-w-3xl mx-auto">Here's what sets us apart from other moving companies in Denver.</p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Feature 1 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <h3 class="font-display font-semibold text-lg mb-2 text-secondary">Experienced Team</h3>
          <p class="text-muted-foreground text-sm">
            Our professional movers are trained, experienced, and committed to providing excellent service on every move.
          </p>
        </div>
        
        <!-- Feature 2 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>
          </div>
          <h3 class="font-display font-semibold text-lg mb-2 text-secondary">Highly Rated</h3>
          <p class="text-muted-foreground text-sm">
            With a 4.8-star rating and 1,780+ positive reviews across review platforms, our reputation speaks for itself.
          </p>
        </div>
        
        <!-- Feature 3 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="9" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <h3 class="font-display font-semibold text-lg mb-2 text-secondary">Locally Owned</h3>
          <p class="text-muted-foreground text-sm">
            As a Denver-based company, we understand the unique challenges of moving in our city and surrounding areas.
          </p>
        </div>
        
        <!-- Feature 4 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path><path d="M12 8v4l2 2"></path></svg>
          </div>
          <h3 class="font-display font-semibold text-lg mb-2 text-secondary">Reliable Service</h3>
          <p class="text-muted-foreground text-sm">
            We pride ourselves on punctuality, efficiency, and consistently exceeding our customers' expectations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Credentials -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-3xl mb-4 text-secondary">Our Credentials</h2>
        <p class="text-muted-foreground max-w-3xl mx-auto">Legacy Moving Denver is fully licensed, insured, and certified to provide moving services.</p>
      </div>
      
      <div class="flex flex-wrap justify-center gap-8 max-w-4xl mx-auto">
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 text-center w-56">
          <h3 class="text-primary font-semibold mb-2">U.S. DOT</h3>
          <p class="text-2xl font-bold text-secondary">#3462023</p>
        </div>
        
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 text-center w-56">
          <h3 class="text-primary font-semibold mb-2">MC Number</h3>
          <p class="text-2xl font-bold text-secondary">#1189363</p>
        </div>
        
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 text-center w-56">
          <h3 class="text-primary font-semibold mb-2">PUC License</h3>
          <p class="text-2xl font-bold text-secondary">#HHG-00682</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="bg-primary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">Experience the Legacy Moving Difference</h2>
        <p class="text-white/90 text-lg mb-8">
          Ready to work with a moving company that truly cares? Contact us today for a free, no-obligation quote.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/request-quote" class={buttonVariants({ size: 'lg', className: 'bg-white !text-primary hover:bg-secondary hover:text-white font-semibold transition-colors' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary border border-white text-white hover:bg-secondary/80 hover:text-white phone-link transition-colors' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>