---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Package, Building, Truck, TruckIcon, PackageCheck, Warehouse } from "lucide-react";
import { Image } from 'astro:assets';
import heroImage from '../assets/services/hero.jpg';
import localMovingImage from '../assets/truck-in-driveway-legacy-moving-denver_nw_b9c9f7fe.jpeg';
import residentialImage from '../assets/services/residential.jpg';
import commercialImage from '../assets/services/commercial.jpg';
import packingImage from '../assets/services/packing.jpg';
import longDistanceImage from '../assets/services/longdistance.jpg';
import loadingImage from '../assets/services/loading.jpg';
import storageImage from '../assets/services/storage.jpg';
---

<BaseLayout
  title="Our Moving Services | Legacy Moving Denver | Local & Long Distance Movers"
  description="Explore our comprehensive moving services including local & long-distance moving, packing, loading, and storage solutions. Get a free quote for your next move in Denver, CO."
>
  <!-- Hero Section -->
  <section class="relative bg-secondary py-16 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image src={heroImage} alt="Legacy Moving Denver truck" class="w-full h-full object-cover" />
    </div>
    <div class="container relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-4">Our Moving Services</h1>
        <p class="text-lg md:text-xl text-white/90 mb-8">
          Professional moving services in Denver – local, long distance, and everything in between.
        </p>
        
        <!-- Quick Navigation -->
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3 max-w-5xl mx-auto">
          <a href="/services/local-moving" class="bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/20 rounded-lg px-4 py-3 text-sm font-semibold transition-all hover:scale-105 flex items-center justify-center">
            Local Moving
          </a>
          <a href="/services/long-distance-moving" class="bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/20 rounded-lg px-4 py-3 text-sm font-semibold transition-all hover:scale-105 flex items-center justify-center">
            Long Distance
          </a>
          <a href="/residential-moving-services" class="bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/20 rounded-lg px-4 py-3 text-sm font-semibold transition-all hover:scale-105 flex items-center justify-center">
            Residential
          </a>
          <a href="/commercial-moving-services" class="bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/20 rounded-lg px-4 py-3 text-sm font-semibold transition-all hover:scale-105 flex items-center justify-center">
            Commercial
          </a>
          <a href="/packing-services" class="bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/20 rounded-lg px-4 py-3 text-sm font-semibold transition-all hover:scale-105 flex items-center justify-center">
            Packing
          </a>
          <a href="#loading" class="bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/20 rounded-lg px-4 py-3 text-sm font-semibold transition-all hover:scale-105 flex items-center justify-center">
            Labor Only
          </a>
          <a href="/storage-services" class="bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/20 rounded-lg px-4 py-3 text-sm font-semibold transition-all hover:scale-105 flex items-center justify-center">
            Storage
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Local Moving -->
  <section id="local" class="py-10 md:py-12">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div class="rounded-lg overflow-hidden shadow-lg">
          <Image 
            src={localMovingImage} 
            alt="Local moving services in Denver"
            class="w-full h-64 object-cover"
          />
        </div>
        <div>
          <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <TruckIcon size={28} className="text-primary" />
          </div>
          <h2 class="font-display font-bold text-3xl mb-4 text-secondary">Local Moving</h2>
          <p class="text-muted-foreground mb-3">
            Professional local moves within Denver and surrounding areas with same-day availability and flexible scheduling.
          </p>
          <div class="grid grid-cols-2 gap-2 mb-4">
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Same-day service</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Metro specialists</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Flexible schedule</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Quick service</p>
            </div>
          </div>
          <div class="flex gap-3">
            <a href="/services/local-moving" class={buttonVariants({ size: 'sm' })}>
              Learn More
            </a>
            <a href="/get-quote" class={buttonVariants({ variant: 'outline', size: 'sm' })}>
              Get Quote
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Long Distance Moving -->
  <section id="long-distance" class="py-10 md:py-12 bg-gray-50">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div class="rounded-lg overflow-hidden shadow-lg">
          <Image 
            src={longDistanceImage} 
            alt="Long distance moving services"
            class="w-full h-64 object-cover"
          />
        </div>
        <div>
          <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <Truck size={28} className="text-primary" />
          </div>
          <h2 class="font-display font-bold text-3xl mb-4 text-secondary">Long Distance Moving</h2>
          <p class="text-muted-foreground mb-3">
            Reliable interstate moves with experienced crews, professional packing, and nationwide reach.
          </p>
          <div class="grid grid-cols-2 gap-2 mb-4">
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Interstate moves</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Licensed & insured</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Tracking available</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Professional packing</p>
            </div>
          </div>
          <div class="flex gap-3">
            <a href="/services/long-distance-moving" class={buttonVariants({ size: 'sm' })}>
              Learn More
            </a>
            <a href="/get-quote" class={buttonVariants({ variant: 'outline', size: 'sm' })}>
              Get Quote
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Residential Moving -->
  <section id="residential" class="py-10 md:py-12">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div class="rounded-lg overflow-hidden shadow-lg">
          <Image 
            src={residentialImage} 
            alt="Residential moving services"
            class="w-full h-64 object-cover"
          />
        </div>
        <div>
          <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <Package size={28} className="text-primary" />
          </div>
          <h2 class="font-display font-bold text-3xl mb-4 text-secondary">Residential Moving</h2>
          <p class="text-muted-foreground mb-3">
            From studio apartments to multi-bedroom houses, we handle your home move with care and professionalism.
          </p>
          <div class="grid grid-cols-2 gap-2 mb-4">
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Apartment moves</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Home relocations</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Senior assistance</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Small moves</p>
            </div>
          </div>
          <div class="flex gap-3">
            <a href="/services/residential-moving" class={buttonVariants({ size: 'sm' })}>
              Learn More
            </a>
            <a href="/get-quote" class={buttonVariants({ variant: 'outline', size: 'sm' })}>
              Get Quote
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Commercial Moving -->
  <section id="commercial" class="py-10 md:py-12 bg-gray-50">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div class="rounded-lg overflow-hidden shadow-lg">
          <Image 
            src={commercialImage} 
            alt="Commercial moving services"
            class="w-full h-64 object-cover"
          />
        </div>
        <div>
          <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <Building size={28} className="text-primary" />
          </div>
          <h2 class="font-display font-bold text-3xl mb-4 text-secondary">Commercial Moving</h2>
          <p class="text-muted-foreground mb-3">
            Minimize downtime with our efficient commercial moving services. From office relocations to corporate moves, we handle it all.
          </p>
          <div class="grid grid-cols-2 gap-2 mb-4">
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Office relocations</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Retail moves</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Corporate moves</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Equipment transport</p>
            </div>
          </div>
          <div class="flex gap-3">
            <a href="/services/commercial-moving" class={buttonVariants({ size: 'sm' })}>
              Learn More
            </a>
            <a href="/get-quote" class={buttonVariants({ variant: 'outline', size: 'sm' })}>
              Get Quote
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Packing Services -->
  <section id="packing" class="py-10 md:py-12">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div class="rounded-lg overflow-hidden shadow-lg">
          <Image 
            src={packingImage} 
            alt="Professional packing services"
            class="w-full h-64 object-cover"
          />
        </div>
        <div>
          <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <PackageCheck size={28} className="text-primary" />
          </div>
          <h2 class="font-display font-bold text-3xl mb-4 text-secondary">Packing Services</h2>
          <p class="text-muted-foreground mb-3">
            Professional packing services with quality materials. We'll pack your entire home or just specific items that need special care.
          </p>
          <div class="grid grid-cols-2 gap-2 mb-4">
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Full-home packing</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Partial packing</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Quality materials</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Fragile item care</p>
            </div>
          </div>
          <div class="flex gap-3">
            <a href="/services/packing-services" class={buttonVariants({ size: 'sm' })}>
              Learn More
            </a>
            <a href="/get-quote" class={buttonVariants({ variant: 'outline', size: 'sm' })}>
              Get Quote
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Loading & Unloading -->
  <section id="loading" class="py-10 md:py-12 bg-gray-50">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div class="rounded-lg overflow-hidden shadow-lg">
          <Image 
            src={loadingImage} 
            alt="Loading and unloading services"
            class="w-full h-64 object-cover"
          />
        </div>
        <div>
          <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <TruckIcon size={28} className="text-primary" />
          </div>
          <h2 class="font-display font-bold text-3xl mb-4 text-secondary">Loading & Unloading</h2>
          <p class="text-muted-foreground mb-3">
            Need help with just the heavy lifting? Professional loading and unloading services for your moving truck or storage container.
          </p>
          <div class="grid grid-cols-2 gap-2 mb-4">
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Efficient loading</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Careful handling</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Secure transit prep</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Placement service</p>
            </div>
          </div>
          <div class="flex gap-3">
            <a href="/services/loading-unloading" class={buttonVariants({ size: 'sm' })}>
              Learn More
            </a>
            <a href="/get-quote" class={buttonVariants({ variant: 'outline', size: 'sm' })}>
              Get Quote
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Storage Solutions -->
  <section id="storage" class="py-10 md:py-12">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div class="rounded-lg overflow-hidden shadow-lg">
          <Image 
            src={storageImage} 
            alt="Secure storage solutions"
            class="w-full h-64 object-cover"
          />
        </div>
        <div>
          <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-4">
            <Warehouse size={28} className="text-primary" />
          </div>
          <h2 class="font-display font-bold text-3xl mb-4 text-secondary">Storage Solutions</h2>
          <p class="text-muted-foreground mb-3">
            Secure storage for your belongings during transition. Short-term and long-term options available in our Lakewood facility.
          </p>
          <div class="grid grid-cols-2 gap-2 mb-4">
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Short-term storage</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Long-term storage</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Secure facility</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="text-primary text-sm">✓</div>
              <p class="text-sm text-muted-foreground">Flexible options</p>
            </div>
          </div>
          <div class="flex gap-3">
            <a href="/services/storage-solutions" class={buttonVariants({ size: 'sm' })}>
              Learn More
            </a>
            <a href="/get-quote" class={buttonVariants({ variant: 'outline', size: 'sm' })}>
              Get Quote
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Get a Quote Section -->
  <section class="py-10 md:py-14 bg-gray-50">
    <div class="container">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 text-secondary">Get Your Free Moving Quote</h2>
        <p class="text-muted-foreground max-w-3xl mx-auto">
          Ready to experience Denver's top-rated moving service? Fill out the form to get a free, accurate quote for your move. Our team responds within 24 hours with a detailed estimate.
        </p>
      </div>
      
      <div class="grid lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
        <!-- Contact Form -->
        <div class="bg-white p-6 md:p-8 rounded-lg shadow-xl border border-gray-100">
          <h3 class="font-display font-bold text-xl md:text-2xl mb-4 text-secondary">Request Your Quote</h3>
          <!-- Moverbase Quote Widget -->
          <div data-version="10" id="J8QDKR-services"></div>
          <script is:inline>
          (function(r,k) {
            var s = document.createElement('script');
            s.async = true;
            s.defer = true;
            s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
            s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); } );
            document.getElementById(r).appendChild(s);
          })('J8QDKR-services','JGCB6TGFN7N3NTTDOGMQUK1S9L3A4N73LYF2ZX4H248K97JD');
          </script>
        </div>
        
        <!-- Why Choose Us & Quick Links -->
        <div class="space-y-6">
          <!-- Why Choose Legacy Moving -->
          <div class="bg-white p-6 md:p-8 rounded-lg shadow-lg border border-gray-100">
            <h3 class="font-display font-bold text-xl md:text-2xl mb-4 text-secondary">Why Choose Legacy Moving?</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary flex-shrink-0 mt-1"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
                <div>
                  <strong class="text-secondary">1,700+ 5-Star Reviews</strong>
                  <p class="text-sm text-muted-foreground">Denver's most trusted moving company with proven customer satisfaction</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary flex-shrink-0 mt-1"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
                <div>
                  <strong class="text-secondary">No Hidden Fees</strong>
                  <p class="text-sm text-muted-foreground">Transparent pricing with no travel time charges, free supplies, and no fuel surcharges</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary flex-shrink-0 mt-1"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
                <div>
                  <strong class="text-secondary">Fully Licensed & Insured</strong>
                  <p class="text-sm text-muted-foreground">DOT #3462023, MC #1189363, PUC #HHG-00682 - Your belongings are protected</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary flex-shrink-0 mt-1"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
                <div>
                  <strong class="text-secondary">Same-Day Availability</strong>
                  <p class="text-sm text-muted-foreground">Need to move today? We offer flexible scheduling including same-day service</p>
                </div>
              </li>
            </ul>
          </div>

          <!-- Quick Service Links -->
          <div class="bg-white p-6 md:p-8 rounded-lg shadow-lg border border-gray-100">
            <h3 class="font-display font-bold text-xl mb-4 text-secondary">Popular Services</h3>
            <div class="grid grid-cols-2 gap-3">
              <a href="/services/local-moving" class="text-sm bg-gray-50 hover:bg-primary hover:text-white transition-all p-3 rounded-lg text-center font-semibold border border-gray-200 hover:border-primary">
                Local Moving
              </a>
              <a href="/services/long-distance-moving" class="text-sm bg-gray-50 hover:bg-primary hover:text-white transition-all p-3 rounded-lg text-center font-semibold border border-gray-200 hover:border-primary">
                Long Distance
              </a>
              <a href="/services/residential-moving" class="text-sm bg-gray-50 hover:bg-primary hover:text-white transition-all p-3 rounded-lg text-center font-semibold border border-gray-200 hover:border-primary">
                Residential
              </a>
              <a href="/services/commercial-moving" class="text-sm bg-gray-50 hover:bg-primary hover:text-white transition-all p-3 rounded-lg text-center font-semibold border border-gray-200 hover:border-primary">
                Commercial
              </a>
              <a href="/services/packing-services" class="text-sm bg-gray-50 hover:bg-primary hover:text-white transition-all p-3 rounded-lg text-center font-semibold border border-gray-200 hover:border-primary">
                Packing
              </a>
              <a href="/services/storage-solutions" class="text-sm bg-gray-50 hover:bg-primary hover:text-white transition-all p-3 rounded-lg text-center font-semibold border border-gray-200 hover:border-primary">
                Storage
              </a>
            </div>
            <div class="mt-4 pt-4 border-t border-gray-200">
              <p class="text-sm text-muted-foreground mb-3">
                <strong class="text-secondary">Need help right now?</strong><br>
                Call us at <a href="tel:7203401849" class="text-primary hover:underline font-semibold">(720) 340-1849</a> for immediate assistance.
              </p>
              <p class="text-xs text-muted-foreground">
                📍 Serving Denver, Aurora, Lakewood, Arvada, Westminster, Thornton, and surrounding areas
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>