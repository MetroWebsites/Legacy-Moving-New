---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { Check, Package, Shield, Calendar, Clock, Warehouse } from 'lucide-react';
import ContactForm from '@/components/ContactForm';
import storageImage from '../assets/storage.DfX1S1Xl_Z1iU7ac.webp';
---

<BaseLayout
  title="Storage Services Denver | Legacy Moving Denver | Short & Long-term Storage"
  description="Secure short and long-term storage solutions in Denver. Our storage facilities offer climate-controlled options and easy access. Get a free quote on storage services."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-secondary to-secondary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={storageImage} 
        alt="Legacy Moving Denver storage solutions" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">Storage Services</h1>
        <p class="text-xl text-white/90 mb-8 max-w-2xl">
          Secure, convenient storage solutions for residential and commercial needs. Short and long-term options available with easy access to your items.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/request-quote" class={buttonVariants({ size: 'lg', className: 'bg-primary text-white hover:bg-primary/90 font-semibold' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-white text-secondary hover:bg-gray-100 font-semibold' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
        <div>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">Secure Storage Solutions</h2>
          <p class="text-muted-foreground mb-4">
            Legacy Moving Denver offers flexible storage options to meet your needs during transitions or when you need extra space. Our Lakewood facility provides secure, clean storage for all your belongings.
          </p>
          <p class="text-muted-foreground mb-6">
            Whether you need short-term storage during a move or long-term solutions for seasonal items, our storage services are designed to keep your belongings safe and accessible when you need them.
          </p>
          
          <div class="space-y-4 mt-8">
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Climate-controlled options available</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">24/7 security monitoring</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Flexible short and long-term options</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Pick-up and delivery services</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Convenient access during business hours</p>
            </div>
          </div>
        </div>
        
        <div>
          <div class="bg-gray-50 p-6 rounded-lg border border-gray-100 shadow-md">
            <h3 class="font-display font-bold text-xl mb-4 text-secondary">Storage Options We Provide:</h3>
            <ul class="space-y-3">
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <Calendar size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Short-Term Storage</h4>
                  <p class="text-muted-foreground text-sm">Temporary storage solutions during your move or home staging</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <Clock size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Long-Term Storage</h4>
                  <p class="text-muted-foreground text-sm">Extended storage options for seasonal items or during extended transitions</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <Shield size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Climate-Controlled Storage</h4>
                  <p class="text-muted-foreground text-sm">Temperature-regulated units for sensitive items like electronics, wood furniture, and artwork</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <Warehouse size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Commercial Storage</h4>
                  <p class="text-muted-foreground text-sm">Business inventory, document, and equipment storage with flexible access</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Storage Process -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <h2 class="font-display font-bold text-3xl text-center mb-12 text-secondary">Our Storage Process</h2>
      
      <div class="grid md:grid-cols-4 gap-8 max-w-5xl mx-auto">
        <!-- Step 1 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 relative">
          <div class="absolute -top-4 -left-4 w-10 h-10 rounded-full bg-primary flex items-center justify-center text-white font-bold text-lg">1</div>
          <h3 class="font-display font-semibold text-xl mb-3 text-secondary pt-2">Consultation</h3>
          <p class="text-muted-foreground text-sm sm:text-base">
            We discuss your storage needs, timeline, and special requirements to recommend the right solution.
          </p>
        </div>
        
        <!-- Step 2 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 relative">
          <div class="absolute -top-4 -left-4 w-10 h-10 rounded-full bg-primary flex items-center justify-center text-white font-bold text-lg">2</div>
          <h3 class="font-display font-semibold text-xl mb-3 text-secondary pt-2">Pick-up</h3>
          <p class="text-muted-foreground text-sm sm:text-base">
            Our team carefully packs and loads your items for transport to our secure storage facility.
          </p>
        </div>
        
        <!-- Step 3 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 relative">
          <div class="absolute -top-4 -left-4 w-10 h-10 rounded-full bg-primary flex items-center justify-center text-white font-bold text-lg">3</div>
          <h3 class="font-display font-semibold text-xl mb-3 text-secondary pt-2">Storage</h3>
          <p class="text-muted-foreground text-sm sm:text-base">
            We carefully place your items in the appropriate storage unit, organizing them for easy access if needed.
          </p>
        </div>
        
        <!-- Step 4 -->
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100 relative">
          <div class="absolute -top-4 -left-4 w-10 h-10 rounded-full bg-primary flex items-center justify-center text-white font-bold text-lg">4</div>
          <h3 class="font-display font-semibold text-xl mb-3 text-secondary pt-2">Delivery</h3>
          <p class="text-muted-foreground text-sm sm:text-base">
            When you're ready, we coordinate delivery of your items to your location, handling all loading and unloading.
          </p>
        </div>
      </div>
      
      <div class="text-center mt-8">
        <a href="/request-quote" class={buttonVariants({ className: 'bg-primary text-white hover:bg-primary/80 mt-2' })}>
          Get Started Today
        </a>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="bg-secondary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">Need Secure Storage Solutions?</h2>
        <p class="text-white/90 text-lg mb-8">
          Contact our storage specialists today for a free consultation and quote on your storage needs.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/request-quote" class={buttonVariants({ size: 'lg', className: 'bg-white text-secondary hover:bg-primary hover:text-white font-semibold transition-colors' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-primary border border-white text-white hover:bg-primary/80 hover:text-white phone-link transition-colors' })} data-google-link="https://maps.app.goo.gl/guTYTjBgBgSYpH5L9">
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>