  <script is:inline>
  (function () {
    const TOTAL_STEPS = 8;
    const STEP_LABELS = [
      'Company Basics',
      'Primary Contact',
      'Business Scale',
      'Licensing & Credibility',
      'Partnership Fit',
      'How You\'d Work With Us',
      'Client Experience Standards',
      'Compliance & Ethics',
    ];

    let currentStep = 1;

    const form       = document.getElementById('partner-form');
    const btnNext    = document.getElementById('btn-next');
    const btnPrev    = document.getElementById('btn-prev');
    const btnSubmit  = document.getElementById('btn-submit');
    const progressBar = document.getElementById('progress-bar');
    const stepCounter = document.getElementById('step-counter');
    const stepLabel  = document.getElementById('step-label');
    const successMsg = document.getElementById('form-success');

    function getSteps() {
      return form.querySelectorAll('.form-step');
    }

    function getDots() {
      return document.querySelectorAll('.step-dot');
    }

    function showStep(n) {
      getSteps().forEach((s) => s.classList.add('hidden'));
      const target = form.querySelector('[data-step="' + n + '"]');
      if (target) target.classList.remove('hidden');

      // Progress
      const pct = (n / TOTAL_STEPS) * 100;
      progressBar.style.width = pct + '%';
      stepCounter.textContent = 'Step ' + n + ' of ' + TOTAL_STEPS;
      stepLabel.textContent   = STEP_LABELS[n - 1];

      // Dots
      getDots().forEach((dot) => {
        const dn = parseInt(dot.getAttribute('data-dot'));
        dot.classList.remove('bg-primary', 'bg-green-500', 'bg-gray-200', 'w-4', 'w-2');
        if (dn < n) {
          dot.classList.add('bg-green-500', 'w-2');
        } else if (dn === n) {
          dot.classList.add('bg-primary', 'w-4');
        } else {
          dot.classList.add('bg-gray-200', 'w-2');
        }
      });

      // Buttons
      btnPrev.classList.toggle('hidden', n === 1);
      if (n === TOTAL_STEPS) {
        btnNext.classList.add('hidden');
        btnSubmit.classList.remove('hidden');
      } else {
        btnNext.classList.remove('hidden');
        btnSubmit.classList.add('hidden');
      }

      currentStep = n;
    }

    function validateStep(n) {
      const step = form.querySelector('[data-step="' + n + '"]');
      if (!step) return true;
      const required = step.querySelectorAll('[required]');
      let valid = true;
      required.forEach((field) => {
        field.classList.remove('border-red-400', 'ring-2', 'ring-red-200');
        if (field.type === 'checkbox') {
          if (!field.checked) {
            field.closest('label') && field.closest('label').classList.add('text-red-500');
            valid = false;
          }
        } else if (!field.value.trim()) {
          field.classList.add('border-red-400', 'ring-2', 'ring-red-200');
          valid = false;
        }
      });
      // Radio required check
      const radioGroups = {};
      step.querySelectorAll('input[type="radio"][required]').forEach((r) => {
        radioGroups[r.name] = radioGroups[r.name] || [];
        radioGroups[r.name].push(r);
      });
      Object.keys(radioGroups).forEach((name) => {
        const checked = radioGroups[name].some((r) => r.checked);
        if (!checked) valid = false;
      });
      if (!valid) {
        // Scroll to first error
        const firstError = step.querySelector('.border-red-400, input[required]:not(:checked)');
        if (firstError) firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      return valid;
    }

    btnNext.addEventListener('click', () => {
      if (validateStep(currentStep)) {
        showStep(currentStep + 1);
        window.scrollTo({ top: document.getElementById('apply').offsetTop - 20, behavior: 'smooth' });
      }
    });

    btnPrev.addEventListener('click', () => {
      showStep(currentStep - 1);
      window.scrollTo({ top: document.getElementById('apply').offsetTop - 20, behavior: 'smooth' });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!validateStep(TOTAL_STEPS)) return;

      // Collect all form data
      const data = new FormData(form);
      const payload = {};
      for (const [key, value] of data.entries()) {
        if (payload[key]) {
          payload[key] = Array.isArray(payload[key])
            ? [...payload[key], value]
            : [payload[key], value];
        } else {
          payload[key] = value;
        }
      }

      // Submit to Netlify / API if available, otherwise just show success
      const endpoint = '/api/forms/submit';
      fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ form: 'partner-application', ...payload }),
      }).catch(() => {
        // Silently fail — still show success to user
      }).finally(() => {
        getSteps().forEach((s) => s.classList.add('hidden'));
        btnNext.classList.add('hidden');
        btnPrev.classList.add('hidden');
        btnSubmit.classList.add('hidden');
        document.querySelector('#step-dots').classList.add('hidden');
        document.querySelector('.border-t').classList.add('hidden');
        successMsg.classList.remove('hidden');
        progressBar.style.width = '100%';
        stepCounter.textContent = 'Complete!';
        stepLabel.textContent = 'Application Submitted';
        window.scrollTo({ top: document.getElementById('apply').offsetTop - 20, behavior: 'smooth' });
      });
    });

    // Init
    showStep(1);
  })();
  </script>

