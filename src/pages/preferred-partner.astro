---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Legacy Preferred Partner Program | Legacy Moving Denver | Priority Moving Partner"
  description="Join the Legacy Moving Denver Preferred Partner Program. Priority scheduling, discounted rates, dedicated account rep, monthly referral bonuses, and co-marketing opportunities for Denver professionals."
>
  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-secondary to-secondary/90 py-16 md:py-24 text-white overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1521737711867-e3b97375f902?w=1400&auto=format&q=80')] bg-cover bg-center opacity-10"></div>
    <!-- Gold accent -->
    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-yellow-500 via-primary to-yellow-500"></div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-yellow-500/20 border border-yellow-500/40 text-yellow-300 rounded-full px-4 py-1.5 text-sm font-medium mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          Legacy Preferred Partner Program
        </div>
        <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight">
          Do You Want to Become a<br>
          <span class="text-primary">Legacy Partner?</span>
        </h1>
        <p class="text-lg md:text-xl text-white/85 mb-8 max-w-2xl mx-auto">
          Join Denver's most exclusive moving partnership program. Priority service, financial rewards, and a moving company that makes YOU look good — every single time.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="#apply" class="inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-white font-semibold py-3.5 px-8 rounded-xl transition-all hover:scale-105 shadow-lg shadow-primary/30">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            Apply Now — It's Free
          </a>
          <a href="tel:7207642299" class="inline-flex items-center gap-2 border-2 border-white/40 text-white hover:bg-white/10 font-semibold py-3.5 px-8 rounded-xl transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call (720) 764-2299
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- We Make YOU Look Good -->
  <section class="py-10 bg-primary">
    <div class="container text-center">
      <p class="text-white font-display font-bold text-2xl md:text-3xl tracking-wide">
        ⭐ We Make <span class="underline underline-offset-4 decoration-white/60">YOU</span> Look Good. Every Single Move. ⭐
      </p>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-6 max-w-4xl mx-auto text-center">
        {[
          ["6,000+", "Moves Completed"],
          ["5★", "Google Rated"],
          ["A", "BBB Rating"],
          ["100%", "Licensed & Insured"],
          ["Denver", "Local Experts"],
        ].map(([stat, label]) => (
          <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
            <div class="font-display font-bold text-3xl text-primary mb-1">{stat}</div>
            <div class="text-sm text-muted-foreground">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Partner Benefits -->
  <section class="py-16">
    <div class="container">
      <div class="text-center mb-12">
        <span class="inline-block bg-primary/10 text-primary text-sm font-semibold px-4 py-1.5 rounded-full mb-3">Partner Benefits</span>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-secondary mb-4">Everything You Get as a Legacy Partner</h2>
        <p class="text-muted-foreground max-w-2xl mx-auto">Our partner program is designed to create real value for the professionals who refer us — not just a handshake agreement.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {[
          ["🚀", "Priority Scheduling", "Your clients skip the waitlist. Partner referrals get access to priority booking slots — including same-week and last-minute availability that isn't offered to the general public."],
          ["💰", "Discounted Rates", "Your referred clients receive exclusive partner pricing. Better rates for them, a stronger recommendation from you."],
          ["👤", "Dedicated Account Rep", "You get a single point of contact who knows your clients, your standards, and your business — available by direct phone or text."],
          ["🎁", "Monthly Referral Bonuses", "Every client you send our way earns you a bonus. The more you refer, the more you earn. Paid monthly with full transparency."],
          ["📣", "Co-Marketing Opportunities", "We feature our partners on our website, social media, and marketing materials. Your business gets visibility alongside Denver's top-rated mover."],
          ["👑", "VIP Client Treatment", "Every client referred by a partner receives white-glove treatment — uniformed crew, damage protection, premium communication, and a dedicated follow-up."],
        ].map(([icon, title, desc]) => (
          <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100 hover:border-primary/30 hover:shadow-lg transition-all relative overflow-hidden">
            <div class="absolute top-0 right-0 w-20 h-20 bg-primary/5 rounded-bl-full"></div>
            <div class="text-3xl mb-4">{icon}</div>
            <h3 class="font-display font-semibold text-lg text-secondary mb-2">{title}</h3>
            <p class="text-muted-foreground text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who Can Partner -->
  <section class="py-14 bg-secondary text-white">
    <div class="container">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-3xl mb-3">Who Is This Program For?</h2>
        <p class="text-white/75 max-w-2xl mx-auto">The Legacy Preferred Partner Program is built for Denver professionals who work with people in transition. If your clients move, we want to be your partner.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 max-w-5xl mx-auto">
        {[
          ["🏡", "Realtors", "/realtor"],
          ["🔨", "Contractors", "/contractor"],
          ["🏢", "Property Managers", "/property-manager"],
          ["🏗️", "Apartment Complexes", "/apartment-complex"],
          ["🛋️", "Interior Designers & Stagers", "/interior-designer"],
          ["💛", "Senior Living Communities", "/senior-living"],
        ].map(([icon, label, href]) => (
          <a href={href} class="flex flex-col items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 rounded-2xl p-4 text-center transition-all hover:scale-105">
            <span class="text-3xl">{icon}</span>
            <span class="text-sm font-medium text-white">{label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="text-center mb-12">
        <span class="inline-block bg-primary/10 text-primary text-sm font-semibold px-4 py-1.5 rounded-full mb-3">Simple Process</span>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-secondary mb-4">How the Partner Program Works</h2>
      </div>
      <div class="grid md:grid-cols-4 gap-6 max-w-4xl mx-auto">
        {[
          ["1", "Apply Below", "Fill out the short partner application. We review all applications within 24 hours."],
          ["2", "Get Onboarded", "Your dedicated account rep reaches out to walk you through the program, rates, and benefits."],
          ["3", "Refer Your Clients", "When a client needs to move, you refer them directly to Legacy Moving — and mention your partner status."],
          ["4", "Earn & Build", "Your clients get a 5-star experience. You earn monthly bonuses and co-marketing exposure. Everyone wins."],
        ].map(([num, title, desc]) => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 text-center">
            <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center text-white font-bold text-xl mx-auto mb-4 shadow-md shadow-primary/30">{num}</div>
            <h3 class="font-semibold text-secondary mb-2">{title}</h3>
            <p class="text-muted-foreground text-sm">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="py-14 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl text-secondary text-center mb-10">What Our Partners Say</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {[
            ["\"We recommend Legacy Moving to every client. They're reliable, professional, and our clients always thank us. The referral bonuses are just a bonus.\"", "— Denver Realtor, Flourish Collective"],
            ["\"As a property manager, I need a mover I can count on. Legacy Moving shows up on time, protects my buildings, and my tenants love them.\"", "— Denver Property Manager"],
          ].map(([quote, attr]) => (
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <div class="flex items-center gap-1 mb-3">
                {[...Array(5)].map(() => (
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#f97316" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                ))}
              </div>
              <p class="text-muted-foreground text-sm leading-relaxed mb-3 italic">{quote}</p>
              <p class="text-xs text-secondary font-semibold">{attr}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Application Form -->
  <section id="apply" class="py-16 bg-gradient-to-br from-secondary to-secondary/90">
    <div class="container">
      <div class="max-w-2xl mx-auto">
        <div class="text-center mb-10">
          <span class="inline-block bg-primary/20 text-primary text-sm font-semibold px-4 py-1.5 rounded-full mb-4">Apply Today — It's Free</span>
          <h2 class="font-display font-bold text-3xl md:text-4xl text-white mb-3">Become a Legacy Preferred Partner</h2>
          <p class="text-white/75">Fill out the form below and our team will reach out within 24 hours to get you set up.</p>
        </div>

        <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">
          <div class="bg-primary px-8 py-5">
            <h3 class="font-display font-bold text-xl text-white">Partner Application</h3>
            <p class="text-white/80 text-sm mt-1">Free to join. No obligations. Cancel anytime.</p>
          </div>
          <div class="p-8">
            <form class="space-y-5" name="partner-application" method="POST" action="/thank-you">
              <input type="hidden" name="form-name" value="partner-application" />
              
              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-semibold text-secondary mb-1.5" for="first-name">First Name *</label>
                  <input type="text" id="first-name" name="first-name" required placeholder="Jane" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors" />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-secondary mb-1.5" for="last-name">Last Name *</label>
                  <input type="text" id="last-name" name="last-name" required placeholder="Smith" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors" />
                </div>
              </div>

              <div>
                <label class="block text-sm font-semibold text-secondary mb-1.5" for="company">Company / Business Name *</label>
                <input type="text" id="company" name="company" required placeholder="Your company name" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors" />
              </div>

              <div>
                <label class="block text-sm font-semibold text-secondary mb-1.5" for="industry">Industry / Role *</label>
                <select id="industry" name="industry" required class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors bg-white">
                  <option value="" disabled selected>Select your industry</option>
                  <option value="realtor">Realtor / Real Estate Agent</option>
                  <option value="contractor">Contractor / Home Builder</option>
                  <option value="property-manager">Property Manager</option>
                  <option value="apartment-complex">Apartment Complex / HOA</option>
                  <option value="interior-designer">Interior Designer / Home Stager</option>
                  <option value="senior-living">Senior Living Community</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-semibold text-secondary mb-1.5" for="email">Email Address *</label>
                  <input type="email" id="email" name="email" required placeholder="jane@company.com" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors" />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-secondary mb-1.5" for="phone">Phone Number *</label>
                  <input type="tel" id="phone" name="phone" required placeholder="(720) 555-0000" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors" />
                </div>
              </div>

              <div>
                <label class="block text-sm font-semibold text-secondary mb-1.5" for="monthly-referrals">Estimated Monthly Referrals</label>
                <select id="monthly-referrals" name="monthly-referrals" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors bg-white">
                  <option value="" disabled selected>Approximately how many clients per month?</option>
                  <option value="1-3">1–3 clients/month</option>
                  <option value="4-10">4–10 clients/month</option>
                  <option value="11-25">11–25 clients/month</option>
                  <option value="25+">25+ clients/month</option>
                </select>
              </div>

              <div>
                <label class="block text-sm font-semibold text-secondary mb-1.5" for="message">Anything Else We Should Know?</label>
                <textarea id="message" name="message" rows="3" placeholder="Tell us about your business or any specific needs..." class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors resize-none"></textarea>
              </div>

              <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-white font-semibold py-3.5 px-8 rounded-xl transition-all hover:scale-[1.02] shadow-lg shadow-primary/30 text-base">
                Submit My Partner Application →
              </button>

              <p class="text-xs text-muted-foreground text-center">We'll reach out within 24 business hours. No spam, ever.</p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-3xl text-secondary mb-3">Partner Program FAQs</h2>
      </div>
      <div class="max-w-3xl mx-auto space-y-4">
        {[
          ["Is there a cost to join?", "No. The Legacy Preferred Partner Program is completely free to join. There are no fees, no minimums, and no contracts."],
          ["How do referral bonuses work?", "Each time a client you refer completes a move with Legacy Moving, you earn a bonus. Bonuses are tracked and paid out monthly. Your account rep will walk you through the details during onboarding."],
          ["What does 'priority scheduling' actually mean?", "Partner-referred clients are placed in a priority queue that gives them access to scheduling slots before they're offered to the general public — including same-week and occasionally same-day availability."],
          ["Can I partner for multiple property types?", "Absolutely. Many of our partners refer clients from multiple contexts — a realtor who also manages properties, for example. Your account rep can customize your setup accordingly."],
          ["How long does approval take?", "We review all applications within 24 business hours and will reach out to schedule a quick onboarding call."],
        ].map(([q, a]) => (
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
            <h3 class="font-display font-semibold text-lg text-secondary mb-2">{q}</h3>
            <p class="text-muted-foreground">{a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-primary">
    <div class="container text-center">
      <h2 class="font-display font-bold text-3xl md:text-4xl text-white mb-4">Ready to Become a Legacy Partner?</h2>
      <p class="text-white/85 text-lg mb-8 max-w-xl mx-auto">Join Denver's most trusted moving company's partner network and start earning while delivering exceptional value to your clients.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#apply" class="inline-flex items-center gap-2 bg-white text-primary hover:bg-white/90 font-semibold py-3.5 px-8 rounded-xl transition-all hover:scale-105 shadow-lg">
          Apply Now — Free
        </a>
        <a href="tel:7207642299" class="inline-flex items-center gap-2 border-2 border-white/40 text-white hover:bg-white/10 font-semibold py-3.5 px-8 rounded-xl transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call (720) 764-2299
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
