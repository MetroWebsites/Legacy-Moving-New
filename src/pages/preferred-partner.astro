---
import FunnelLayout from "@/layouts/FunnelLayout.astro";
import MoverbaseRedirect from '../components/MoverbaseRedirect.astro';
---

<FunnelLayout
  title="Legacy Preferred Partner Program | Legacy Moving Denver | Priority Moving Partner"
  description="Join the Legacy Moving Denver Preferred Partner Program. Priority scheduling, quarterly referral competition, dedicated account rep, and co-marketing opportunities for Denver professionals."
  phoneNumber="7207642299"
>
  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-secondary to-secondary/90 py-16 md:py-24 text-white overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1521737711867-e3b97375f902?w=1400&auto=format&q=80')] bg-cover bg-center opacity-10"></div>
    <!-- Gold accent bar -->
    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-yellow-500 via-primary to-yellow-500"></div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-yellow-500/20 border border-yellow-500/40 text-yellow-300 rounded-full px-4 py-1.5 text-sm font-medium mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          Legacy Preferred Partner Program
        </div>
        <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl mb-5 leading-tight">
          Do You Want to Become a<br>
          <span class="text-primary">Legacy Partner?</span>
        </h1>

        <!-- 1,700+ Reviews Trust Signal -->
        <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-xl px-5 py-2.5 mb-6">
          <div class="flex gap-0.5">
            {[...Array(5)].map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#f97316" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
          </div>
          <span class="text-white/90 text-sm font-medium">Trusted by 1,700+ customers with five-star Google reviews</span>
        </div>

        <p class="text-lg md:text-xl text-white/85 mb-8 max-w-2xl mx-auto">
          A structured referral partnership designed to reward professionals who consistently send clients our way. Built for long-term relationships — not one-time referrals.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="#apply" class="inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-white font-semibold py-3.5 px-8 rounded-xl transition-all hover:scale-105 shadow-lg shadow-primary/30">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            Apply Now — It's Free
          </a>
          <a href="tel:7207642299" class="inline-flex items-center gap-2 border-2 border-white/40 text-white hover:bg-white/10 font-semibold py-3.5 px-8 rounded-xl transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call (720) 764-2299
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Tagline Bar -->
  <section class="py-10 bg-primary">
    <div class="container text-center">
      <p class="text-white font-display font-bold text-2xl md:text-3xl tracking-wide">
        ⭐ We Make <span class="underline underline-offset-4 decoration-white/60">YOU</span> Look Good. Every Single Move. ⭐
      </p>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-6 max-w-4xl mx-auto text-center">
        {[
          ["6,000+", "Moves Completed"],
          ["1,700+", "Five-Star Reviews"],
          ["A", "BBB Rating"],
          ["100%", "Licensed & Insured"],
          ["Denver", "Local Experts"],
        ].map(([stat, label]) => (
          <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
            <div class="font-display font-bold text-3xl text-primary mb-1">{stat}</div>
            <div class="text-sm text-muted-foreground">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Core Benefits -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <span class="inline-block bg-primary/10 text-primary text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-3">Partner Benefits</span>
          <h2 class="font-display font-bold text-3xl md:text-4xl text-secondary mb-4">Everything You Get as a Legacy Partner</h2>
          <p class="text-muted-foreground max-w-2xl mx-auto">Our partner program is designed to create real, lasting value — not just a handshake agreement.</p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-16">
          {[
            ["🎁", "Moving Perks for Your Clients", "Complimentary wardrobe boxes and TV box rentals for every referred move — a tangible gift your clients will remember."],
            ["📅", "Priority Scheduling", "Your clients skip the waitlist. Partner referrals access booking slots before they're offered to the general public."],
            ["📣", "Co-Branded Marketing Materials", "Custom materials featuring your name alongside Legacy Moving — helping you stand out in your market."],
            ["📱", "Social Media Recognition", "Top partners are featured on our channels, giving your brand real exposure to our growing audience."],
            ["👤", "Dedicated Support & Communication", "A direct line to your account rep who knows your clients and holds your partnership accountable."],
            ["👑", "VIP Client Treatment", "Every referred client receives white-glove treatment — uniformed crew, damage protection, and premium follow-through."],
          ].map(([icon, title, desc]) => (
            <div class="flex items-start gap-4 bg-gray-50 rounded-2xl p-5 border border-gray-100 hover:border-primary/20 hover:bg-primary/5 transition-all">
              <div class="w-11 h-11 bg-secondary rounded-xl flex items-center justify-center text-xl flex-shrink-0">{icon}</div>
              <div>
                <h3 class="font-semibold text-secondary text-sm mb-1">{title}</h3>
                <p class="text-muted-foreground text-xs leading-relaxed">{desc}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- ==========================================
             QUARTERLY REFERRAL COMPETITION
             ========================================== -->
        <div class="bg-secondary rounded-2xl overflow-hidden mb-12">
          <div class="bg-gradient-to-r from-yellow-500/20 via-yellow-400/10 to-transparent px-8 pt-8 pb-6">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-4xl">🏆</span>
              <div>
                <h2 class="font-display font-bold text-2xl text-white">Quarterly Referral Competition</h2>
                <p class="text-yellow-300 text-xs font-bold uppercase tracking-widest mt-0.5">Refer · Compete · Win</p>
              </div>
            </div>
            <p class="text-white/85 text-base leading-relaxed max-w-2xl mb-3">
              Send clients our way and join a quarterly competition built to reward our most engaged partners. Recognition, rewards, and a front-row seat to your impact — every three months.
            </p>
            <p class="text-white/60 text-sm">
              Top partners are recognized each quarter based on <strong class="text-white/85">total referrals</strong> and <strong class="text-white/85">total revenue generated</strong>.
            </p>
          </div>

          <div class="px-8 pb-8 grid md:grid-cols-2 gap-8">
            <!-- Tiers -->
            <div>
              <h4 class="text-white/60 text-xs font-bold uppercase tracking-widest mb-4">Partner Tiers</h4>
              <div class="space-y-3">
                {[
                  ["🥉", "Bronze", "1–4 referrals / quarter", "border-amber-700/40 bg-amber-900/20"],
                  ["🥈", "Silver", "5–9 referrals / quarter", "border-gray-400/40 bg-gray-500/20"],
                  ["🥇", "Gold", "10+ referrals / quarter", "border-yellow-500/50 bg-yellow-500/10"],
                ].map(([medal, tier, range, style]) => (
                  <div class={`flex items-center justify-between border rounded-xl px-5 py-3.5 ${style}`}>
                    <div class="flex items-center gap-3">
                      <span class="text-2xl">{medal}</span>
                      <span class="font-bold text-white">{tier}</span>
                    </div>
                    <span class="text-white/60 text-sm">{range}</span>
                  </div>
                ))}
              </div>
              <p class="text-white/40 text-xs mt-3">Higher tiers unlock additional perks, priority treatment, and competition eligibility.</p>
            </div>

            <!-- Rewards -->
            <div>
              <h4 class="text-white/60 text-xs font-bold uppercase tracking-widest mb-4">What Winners Receive</h4>
              <div class="bg-white/5 border border-white/10 rounded-xl p-6">
                <p class="text-white/85 text-sm leading-relaxed mb-5">
                  Winners receive curated local experiences — including restaurant gift cards, event tickets, and exclusive outings.
                </p>
                <ul class="space-y-3">
                  {[
                    "Restaurant gift cards & dining experiences",
                    "Event tickets & exclusive local outings",
                    "Social recognition & partner spotlight features",
                  ].map((reward) => (
                    <li class="flex items-center gap-3 text-white/75 text-sm">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
                      {reward}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- How It Works -->
        <div class="bg-gray-50 rounded-2xl p-8 mb-12 border border-gray-100">
          <h3 class="font-display font-bold text-2xl text-secondary mb-8 text-center">How It Works</h3>
          <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-6">
            {[
              ["1", "Send a Referral", "Via form, QR code, or a quick call — whichever is easiest for you."],
              ["2", "We Handle Everything", "Outreach, booking, and the full client experience — handled by us."],
              ["3", "Confirmation in 24–48 hrs", "You receive a confirmation once the referral is logged and in process."],
              ["4", "Track Your Progress", "Referrals count toward your tier and quarterly competition standing."],
            ].map(([num, title, desc]) => (
              <div class="text-center">
                <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center text-white font-bold text-xl mx-auto mb-4 shadow-md shadow-primary/20">{num}</div>
                <h4 class="font-semibold text-secondary mb-2">{title}</h4>
                <p class="text-muted-foreground text-sm">{desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Trust + Fairness Line -->
        <div class="bg-primary/5 border border-primary/15 rounded-2xl p-7 text-center mb-4">
          <p class="text-secondary text-base leading-relaxed max-w-2xl mx-auto">
            <strong>Every referral is acknowledged.</strong> Only completed moves count toward tiers and competition — ensuring fairness and real results for every partner in the program.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Who Can Partner -->
  <section class="py-14 bg-secondary text-white">
    <div class="container">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-3xl mb-3">Who Is This Program For?</h2>
        <p class="text-white/75 max-w-2xl mx-auto">The Legacy Preferred Partner Program is built for Denver professionals who work with people in transition. If your clients move, we want to be your partner.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 max-w-5xl mx-auto">
        {[
          ["🏡", "Realtors", "/realtor"],
          ["🔨", "Contractors", "/contractor"],
          ["🏠", "Property Managers", "/property-manager"],
          ["🏢", "Apartment Complexes", "/apartment-complex"],
          ["🛋️", "Interior Designers & Stagers", "/interior-designer"],
          ["💛", "Senior Living Communities", "/senior-living"],
        ].map(([icon, label, href]) => (
          <a href={href} class="flex flex-col items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 rounded-2xl p-4 text-center transition-all hover:scale-105">
            <span class="text-3xl">{icon}</span>
            <span class="text-sm font-medium text-white">{label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-14 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl text-secondary text-center mb-3">What Our Partners Say</h2>
        <p class="text-muted-foreground text-center text-sm mb-10">1,700+ five-star Google reviews from clients referred by partners like you.</p>
        <div class="grid md:grid-cols-2 gap-6">
          {[
            ["\"We recommend Legacy Moving to every client. They're reliable, professional, and our clients always thank us. The quarterly competition keeps things exciting.\"", "— Denver Realtor, Flourish Collective"],
            ["\"As a property manager, I need a mover I can count on. Legacy Moving shows up on time, protects my buildings, and my tenants love them.\"", "— Denver Property Manager"],
          ].map(([quote, attr]) => (
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <div class="flex items-center gap-1 mb-3">
                {[...Array(5)].map(() => (
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#f97316" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                ))}
              </div>
              <p class="text-muted-foreground text-sm leading-relaxed mb-3 italic">{quote}</p>
              <p class="text-xs text-secondary font-semibold">{attr}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Application Form -->
  <section id="apply" class="py-16 bg-gradient-to-br from-secondary to-secondary/90">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10">
          <span class="inline-block bg-primary/20 text-primary text-sm font-semibold px-4 py-1.5 rounded-full mb-4">Apply Today — It's Free</span>
          <h2 class="font-display font-bold text-3xl md:text-4xl text-white mb-3">Become a Legacy Preferred Partner</h2>
          <p class="text-white/75">Complete the application below — our team will review and reach out within 24 hours.</p>
        </div>

        <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">
          <!-- Form header with step progress -->
          <div class="bg-primary px-8 py-5">
            <div class="flex items-center justify-between mb-3">
              <div>
                <h3 class="font-display font-bold text-xl text-white">Partner Application</h3>
                <p class="text-white/80 text-sm mt-0.5">Free to join. No obligations. Cancel anytime.</p>
              </div>
              <span id="step-counter" class="text-white/80 text-sm font-medium">Step 1 of 8</span>
            </div>
            <!-- Progress bar -->
            <div class="bg-white/20 rounded-full h-2">
              <div id="progress-bar" class="bg-white rounded-full h-2 transition-all duration-300" style="width: 12.5%"></div>
            </div>
            <!-- Step labels -->
            <div id="step-label" class="text-white/90 text-xs font-semibold mt-2 uppercase tracking-widest">Company Basics</div>
          </div>

          <form id="partner-form" class="p-6 md:p-8" novalidate>

            <!-- STEP 1: Company Basics -->
            <fieldset class="form-step" data-step="1">
              <legend class="sr-only">Company Basics</legend>
              <div class="space-y-4">
                <div class="grid md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-semibold text-secondary mb-1.5">Legal Business Name <span class="text-red-500">*</span></label>
                    <input type="text" name="legal_name" required placeholder="e.g. Smith Realty LLC" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition" />
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-secondary mb-1.5">DBA / Trade Name</label>
                    <input type="text" name="dba" placeholder="If different from legal name" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition" />
                  </div>
                </div>
                <div>
                  <label class="block text-sm font-semibold text-secondary mb-1.5">Business Type <span class="text-red-500">*</span></label>
                  <select name="business_type" required class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition bg-white">
                    <option value="">Select business type…</option>
                    <option>Real Estate Brokerage</option>
                    <option>Property Management</option>
                    <option>Apartment Complex / Multi-Family</option>
                    <option>Storage Facility</option>
                    <option>Cleaning Company</option>
                    <option>Home Staging / Interior Design</option>
                    <option>Senior Living Community</option>
                    <option>General Contractor / Remodeler</option>
                    <option>Corporate Relocation</option>
                    <option>Other</option>
                  </select>
                </div>
                <div class="grid md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-semibold text-secondary mb-1.5">Years in Business <span class="text-red-500">*</span></label>
                    <select name="years_in_business" required class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition bg-white">
                      <option value="">Select…</option>
                      <option>Less than 1 year</option>
                      <option>1–2 years</option>
                      <option>3–5 years</option>
                      <option>6–10 years</option>
                      <option>10+ years</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-secondary mb-1.5">Website</label>
                    <input type="url" name="website" placeholder="https://yoursite.com" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition" />
                  </div>
                </div>
                <div>
                  <label class="block text-sm font-semibold text-secondary mb-1.5">Social Profiles</label>
                  <input type="text" name="social_profiles" placeholder="Facebook, Instagram, LinkedIn URLs" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition" />
                </div>
                <div class="grid md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-semibold text-secondary mb-1.5">Service Area / Coverage Zones <span class="text-red-500">*</span></label>
                    <input type="text" name="service_area" required placeholder="e.g. Denver Metro, DTC, Boulder" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition" />
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-secondary mb-1.5">Office Location(s)</label>
                    <input type="text" name="office_locations" placeholder="e.g. Downtown Denver, Cherry Creek" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition" />
                  </div>
                </div>
              </div>
            </fieldset>

            <!-- STEP 2: Primary Contact -->
            <fieldset class="form-step hidden" data-step="2">
              <legend class="sr-only">Primary Contact</legend>
              <div class="space-y-4">
                <div class="grid md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-semibold text-secondary mb-1.5">Full Name <span class="text-red-500">*</span></label>
                    <input type="text" name="contact_name" required placeholder="Jane Smith" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition" />
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-secondary mb-1.5">Title / Role <span class="text-red-500">*</span></label>
                    <input type="text" name="contact_title" required placeholder="e.g. Broker, Owner, Director" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition" />
                  </div>
                </div>
                <div class="grid md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-semibold text-secondary mb-1.5">Email <span class="text-red-500">*</span></label>
                    <input type="email" name="contact_email" required placeholder="jane@yourcompany.com" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition" />
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-secondary mb-1.5">Direct Phone <span class="text-red-500">*</span></label>
                    <input type="tel" name="contact_phone" required placeholder="(720) 000-0000" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition" />
                  </div>
                </div>
                <div>
                  <label class="block text-sm font-semibold text-secondary mb-1.5">Preferred Communication Method <span class="text-red-500">*</span></label>
                  <div class="flex flex-wrap gap-3 mt-1">
                    {["Email", "Text / SMS", "Phone Call"].map((opt) => (
                      <label class="inline-flex items-center gap-2 cursor-pointer">
                        <input type="radio" name="preferred_contact" value={opt} class="accent-primary w-4 h-4" />
                        <span class="text-sm text-secondary">{opt}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </div>
            </fieldset>

            <!-- STEP 3: Business Scale -->
            <fieldset class="form-step hidden" data-step="3">
              <legend class="sr-only">Business Scale</legend>
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-semibold text-secondary mb-1.5">Team Size <span class="text-red-500">*</span></label>
                  <select name="team_size" required class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition bg-white">
                    <option value="">Select…</option>
                    <option>Solo / Individual rep</option>
                    <option>2–5 agents / staff</option>
                    <option>6–15 agents / staff</option>
                    <option>16–50 agents / staff</option>
                    <option>50+ agents / staff</option>
                  </select>
                </div>
                <div>
                  <label class="block text-sm font-semibold text-secondary mb-1.5">Typical Client Profile <span class="text-red-500">*</span></label>
                  <div class="flex flex-wrap gap-3 mt-1">
