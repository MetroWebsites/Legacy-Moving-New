---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from 'astro:assets';
import { buttonVariants } from "@/components/ui/button";
import { Check, Building, Calendar, Clock, Truck, ShieldCheck, FileText } from 'lucide-react';
import ContactForm from '@/components/ContactForm';
import commercialImage from '../assets/commercial.Bz1aHyUe_ZflDS6.webp';
---

<BaseLayout
  title="Commercial Moving Services Denver | Legacy Moving Denver"
  description="Professional commercial moving services in Denver. Our business movers provide efficient, minimally disruptive office relocations. Get a free commercial moving quote today."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-r from-primary to-primary/90 text-white py-16">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <Image 
        src={commercialImage} 
        alt="Legacy Moving Denver commercial movers in action" 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="container relative z-10">
      <div class="max-w-3xl">
        <h1 class="font-display font-bold text-4xl md:text-5xl mb-6">Commercial Moving Services</h1>
        <p class="text-xl text-white/90 mb-8 max-w-2xl">
          Professional office and business relocation services in Denver. Our commercial moving team ensures minimal downtime and maximum efficiency.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/request-quote" class={buttonVariants({ size: 'lg', className: 'bg-white text-primary hover:bg-secondary hover:text-white font-semibold' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary text-white hover:bg-secondary/80 font-semibold' })}>
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
        <div>
          <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-secondary">Business Moving Specialists</h2>
          <p class="text-muted-foreground mb-4">
            Legacy Moving Denver specializes in efficient, professional commercial moving services for businesses of all sizes. We understand that minimizing downtime is crucial for your operations, which is why our commercial moving team is trained to work quickly and efficiently.
          </p>
          <p class="text-muted-foreground mb-6">
            From small offices to large corporate headquarters, our experienced movers handle everything from furniture and equipment to sensitive documents and technology with the utmost care and precision.
          </p>
          
          <div class="space-y-4 mt-8">
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Minimal business disruption</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Weekend & after-hours moves available</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Specialized handling of office equipment</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">IT infrastructure relocation expertise</p>
            </div>
            <div class="flex gap-3">
              <div class="flex-shrink-0 h-6 w-6 bg-primary/10 rounded-full flex items-center justify-center">
                <Check size={16} className="text-primary" />
              </div>
              <p class="text-secondary font-medium">Comprehensive project management</p>
            </div>
          </div>
        </div>
        
        <div>
          <div class="bg-gray-50 p-6 rounded-lg border border-gray-100 shadow-md">
            <h3 class="font-display font-bold text-xl mb-4 text-secondary">Our Commercial Moving Services Include:</h3>
            <ul class="space-y-3">
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <Building size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Office Relocations</h4>
                  <p class="text-muted-foreground text-sm">Complete moving services for offices of all sizes with careful handling of furniture and equipment</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <FileText size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Filing & Records</h4>
                  <p class="text-muted-foreground text-sm">Organized relocation of important documents and filing systems with secure handling</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <Calendar size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Move Planning</h4>
                  <p class="text-muted-foreground text-sm">Strategic planning and coordination to minimize business disruption during your move</p>
                </div>
              </li>
              
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                  <Truck size={20} className="text-primary" />
                </div>
                <div>
                  <h4 class="font-semibold text-secondary">Equipment Transport</h4>
                  <p class="text-muted-foreground text-sm">Specialized handling and transportation of office equipment and technology</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="bg-primary py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-6 text-white">Ready to Relocate Your Business?</h2>
        <p class="text-white/90 text-lg mb-8">
          Contact our commercial moving specialists today for a free, customized quote on your business relocation.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/request-quote" class={buttonVariants({ size: 'lg', className: 'bg-white text-secondary hover:bg-primary hover:text-white font-semibold transition-colors' })}>
            Get a Free Quote
          </a>
          <a href="tel:7203401849" class={buttonVariants({ size: 'lg', className: 'bg-secondary border border-white text-white hover:bg-secondary/80 hover:text-white phone-link transition-colors' })} data-google-link="https://maps.app.goo.gl/guTYTjBgBgSYpH5L9">
            Call (720) 340-1849
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>