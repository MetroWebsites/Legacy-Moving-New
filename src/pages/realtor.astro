---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Realtor Moving Partner | Legacy Moving Denver | Priority Service for Realtors"
  description="Legacy Moving Denver is Denver's preferred moving partner for realtors. Priority scheduling, white-glove service, and a referral rewards program that makes YOU look good."
>
  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-secondary to-secondary/90 py-16 md:py-24 text-white overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=1400&auto=format&q=80')] bg-cover bg-center opacity-10"></div>
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-primary/20 border border-primary/30 rounded-full px-4 py-1.5 text-sm font-medium mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          For Denver Realtors
        </div>
        <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight">
          Helping Denver Realtors<br>
          <span class="text-primary">Close More Deals</span><br>
          With Stress-Free Moves
        </h1>
        <p class="text-lg md:text-xl text-white/85 mb-8 max-w-2xl mx-auto">
          Your clients will remember who made moving easy. Partner with Legacy Moving Denver and make every closing day a celebration — not a headache.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="tel:7207642299" class="inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-white font-semibold py-3.5 px-8 rounded-xl transition-all hover:scale-105 shadow-lg shadow-primary/30">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call (720) 764-2299
          </a>
          <a href="/preferred-partner" class="inline-flex items-center gap-2 border-2 border-white/40 text-white hover:bg-white/10 font-semibold py-3.5 px-8 rounded-xl transition-all">
            Become a Partner
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- We Make YOU Look Good -->
  <section class="py-10 bg-primary">
    <div class="container text-center">
      <p class="text-white font-display font-bold text-2xl md:text-3xl tracking-wide">
        ⭐ We Make <span class="underline underline-offset-4 decoration-white/60">YOU</span> Look Good. ⭐
      </p>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="py-12 bg-gray-50">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-6 max-w-4xl mx-auto text-center">
        {[
          ["6,000+", "Moves Completed"],
          ["5★", "Google Rated"],
          ["A", "BBB Rating"],
          ["100%", "Licensed & Insured"],
          ["Denver", "Local Experts"],
        ].map(([stat, label]) => (
          <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
            <div class="font-display font-bold text-3xl text-primary mb-1">{stat}</div>
            <div class="text-sm text-muted-foreground">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Realtor Benefits -->
  <section class="py-16">
    <div class="container">
      <div class="text-center mb-12">
        <span class="inline-block bg-primary/10 text-primary text-sm font-semibold px-4 py-1.5 rounded-full mb-3">Realtor-Specific Benefits</span>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-secondary mb-4">The Moving Company That Makes YOU Look Good</h2>
        <p class="text-muted-foreground max-w-2xl mx-auto">We understand that your reputation is everything. Our realtor-friendly service is designed to reflect your professionalism at every step.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {[
          ["🏃", "Last-Minute Moves Before Closing", "Tight closing dates happen. We keep priority slots available for realtor partners so your clients always have a crew ready."],
          ["🤍", "White-Glove Packing for High-End Clients", "For luxury listings and high-value clients, we offer white-glove packing services that match the premium standard your brand represents."],
          ["📅", "Flexible Scheduling Around Closing Dates", "Closings shift. We shift with them. We coordinate directly with your timeline so your clients aren't left scrambling."],
          ["👔", "Clean, Professional Crews That Reflect Your Brand", "Uniformed, background-checked, courteous movers who show up on time and leave the home better than they found it."],
          ["⭐", "Priority Service for Realtor Partners", "Enrolled partners go to the front of the line. Your referrals get same-week availability and a dedicated point of contact."],
          ["🎁", "Referral Rewards Program", "Every client you send our way earns you rewards. Cash bonuses, co-marketing opportunities, and VIP treatment for your clients."],
        ].map(([icon, title, desc]) => (
          <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100 hover:border-primary/30 hover:shadow-lg transition-all">
            <div class="text-3xl mb-4">{icon}</div>
            <h3 class="font-display font-semibold text-lg text-secondary mb-2">{title}</h3>
            <p class="text-muted-foreground text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Credibility Boosters -->
  <section class="py-14 bg-secondary text-white">
    <div class="container">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-3xl mb-3">Why Realtors Choose Legacy Moving</h2>
        <p class="text-white/75 max-w-xl mx-auto">Protecting Your Reputation One Move at a Time</p>
      </div>
      <div class="flex flex-wrap justify-center gap-4 max-w-3xl mx-auto">
        {[
          "Licensed & Insured",
          "5-Star Reviews",
          "Locally Owned Denver Company",
          "Professional Uniformed Movers",
          "Background Checked Crews",
          "Damage Protection Options",
          "Same Week Availability",
          "Recommended by Flourish Collective",
        ].map((badge) => (
          <span class="inline-flex items-center gap-2 bg-white/10 border border-white/20 text-white text-sm px-4 py-2 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><polyline points="20 6 9 17 4 12"/></svg>
            {badge}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Flourish Collective Endorsement -->
  <section class="py-14 bg-white">
    <div class="container">
      <div class="max-w-2xl mx-auto bg-primary/5 border border-primary/15 rounded-2xl p-8 text-center">
        <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3 class="font-display font-bold text-2xl text-secondary mb-3">Recommended by Flourish Collective</h3>
        <p class="text-muted-foreground mb-4">
          Legacy Moving Denver is the trusted moving partner recommended by <strong>Neil and Brittany Sanderlin</strong> at Flourish Collective. Their clients receive priority scheduling and dedicated service.
        </p>
        <div class="flex items-center justify-center gap-1">
          {[...Array(5)].map(() => (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#f97316" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Emotional Hook + CTA -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-secondary mb-6">Your Clients Will Remember Who Made Moving Easy.</h2>
        <p class="text-muted-foreground text-lg mb-8">
          When the chaos of closing day clears, the realtor who handed them a card for Legacy Moving is the one they'll refer to their friends. Let's build that reputation together.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="tel:7207642299" class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary/90 text-white font-semibold py-3.5 px-8 rounded-xl transition-all hover:scale-105 shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call (720) 764-2299
          </a>
          <a href="/preferred-partner" class="inline-flex items-center justify-center gap-2 bg-secondary hover:bg-secondary/90 text-white font-semibold py-3.5 px-8 rounded-xl transition-all hover:scale-105">
            Join Our Partner Program
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Preferred Partner Teaser -->
  <section class="py-14 bg-primary text-white">
    <div class="container">
      <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="font-display font-bold text-2xl md:text-3xl mb-3">Legacy Preferred Partner Program</h3>
          <p class="text-white/80 max-w-xl">Priority scheduling, monthly referral bonuses, dedicated account rep, and co-marketing opportunities — built specifically for Denver's top real estate professionals.</p>
        </div>
        <a href="/preferred-partner" class="flex-shrink-0 inline-flex items-center gap-2 bg-white text-primary hover:bg-white/90 font-semibold py-3.5 px-8 rounded-xl transition-all hover:scale-105 shadow-lg whitespace-nowrap">
          Learn More
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
