---
import PartnerLayout from "@/layouts/PartnerLayout.astro";
import { Image } from "astro:assets";
import truckImage from "../assets/truck-in-driveway-legacy-moving-denver_nw_b9c9f7fe.jpeg";
import packingImage from "../assets/working-ad-legacy-moving-denver_nw_c7ceaf8e.jpeg";
import teamImage from "../assets/308748956_459885262825080_6269738357866645302_n_nw_0489b96e.jpg";
import furnitureImage from "../assets/290197457_539473571254356_3082118749704086809_n_nw_a389c17b.jpg";

---

<PartnerLayout
  title="Legacy Moving Denver | Denver's Top-Rated Moving Company"
  description="Legacy Moving Denver — 1,700+ five-star reviews, family-owned since 2018. Local and long-distance moving, packing, storage, and a preferred partner program for Denver professionals."
>

  <!-- ══════════════════════════════════════════════
       SERVICE BAR (mirrors homepage)
  ══════════════════════════════════════════════ -->
  <section class="w-full bg-white border-b border-gray-200">
    <div class="flex w-full">
      <a href="tel:7207642299" class="flex-1 flex items-center justify-center py-4 px-2 bg-primary text-white font-semibold text-sm sm:text-base hover:bg-secondary transition-colors duration-300 border-r border-white whitespace-nowrap gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Local Moving
      </a>
      <a href="tel:7207642299" class="flex-1 flex items-center justify-center py-4 px-2 bg-gray-700 text-white font-semibold text-sm sm:text-base hover:bg-secondary transition-colors duration-300 border-r border-white whitespace-nowrap gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.28a1 1 0 0 0-.684-.948l-1.923-.641a1 1 0 0 1-.578-.579l-1.393-4.18A1 1 0 0 0 18.845 11H10"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
        Long Distance
      </a>
      <a href="tel:7207642299" class="flex-1 flex items-center justify-center py-4 px-2 bg-gray-500 text-white font-semibold text-sm sm:text-base hover:bg-secondary transition-colors duration-300 whitespace-nowrap gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 15 2 2 4-4"/><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        Labor Only
      </a>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       HERO — dark navy + truck photo behind overlay
  ══════════════════════════════════════════════ -->
  <section class="relative bg-secondary text-white overflow-hidden">
    <!-- Background truck photo (desktop) -->
    <div class="absolute inset-0 hidden md:block">
      <Image
        src={truckImage}
        alt="Legacy Moving Denver truck"
        class="w-full h-full object-cover opacity-30"
        widths={[800, 1400, 1920]}
        sizes="100vw"
        quality={40}
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-secondary/80 to-secondary/60"></div>
    </div>
    <!-- Background photo (mobile) -->
    <div class="absolute inset-0 md:hidden opacity-15 mix-blend-overlay">
      <Image
        src={truckImage}
        alt="Legacy Moving Denver truck"
        class="w-full h-full object-cover"
        widths={[400, 700]}
        sizes="100vw"
        quality={35}
        loading="eager"
      />
    </div>

    <div class="container relative z-10 grid lg:grid-cols-2 gap-6 md:gap-10 pt-10 md:pt-14 lg:pt-20 pb-8 md:pb-12 lg:pb-16 px-4 md:px-0">
      <!-- LEFT: headline + trust pill row -->
      <div class="flex flex-col justify-center">
        <div class="inline-flex items-center gap-2 bg-primary/20 border border-primary/40 rounded-full px-4 py-1.5 text-xs font-bold tracking-widest uppercase mb-5 w-fit">
          <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="#1565f0" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <span class="text-blue-300">1,700+ Five-Star Reviews · Denver's Top-Rated Mover</span>
        </div>

        <h1 class="font-display font-bold text-3xl md:text-5xl lg:text-6xl leading-tight mb-5">
          Your Highly Recommended,<br class="hidden md:block">
          <span class="text-primary">Accredited Denver Movers</span>
        </h1>

        <p class="text-white/80 text-base md:text-lg leading-relaxed mb-7 max-w-xl">
          Legacy Moving Denver is a family-owned company serving the Denver metro since 2018. With over 1,700 five-star reviews and 6,000+ successful moves, we've built our reputation one move at a time.
        </p>

        <!-- Trust pill row -->
        <div class="flex flex-wrap gap-3 mb-8">
          {[
            { icon: `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="#f97316" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`, text: "1,700+ Google Reviews" },
            { icon: `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`, text: "Licensed & Insured" },
            { icon: `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`, text: "Family-Owned Since 2018" },
            { icon: `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`, text: "Same-Day Available" },
          ].map(({ icon, text }) => (
            <div class="inline-flex items-center gap-1.5 text-xs text-white/75 bg-white/8 border border-white/15 rounded-full px-3 py-1.5">
              <span set:html={icon} />
              {text}
            </div>
          ))}
        </div>

        <!-- CTA buttons -->
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="tel:7207642299" class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary/90 text-white font-semibold rounded-lg px-7 py-3.5 transition-all shadow-lg text-base">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call (720) 764-2299
          </a>
          <a href="#quote" class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 border border-white/30 text-white font-semibold rounded-lg px-7 py-3.5 transition-all text-base">
            Get a Free Quote
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- RIGHT: stats + truck photo card -->
      <div class="flex flex-col gap-4">
        <!-- Truck photo card -->
        <div class="rounded-2xl overflow-hidden shadow-2xl border border-white/10 relative aspect-[4/3]">
          <Image
            src={truckImage}
            alt="Legacy Moving Denver truck parked at a Denver home"
            class="w-full h-full object-cover"
            widths={[400, 700, 900]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            quality={50}
            loading="eager"
          />
          <div class="absolute bottom-0 left-0 right-0 p-4" style="background:linear-gradient(to top,rgba(30,45,61,0.9),transparent);">
            <div class="flex items-center gap-1.5 mb-1">
              {[...Array(5)].map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#f97316" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
              <span class="text-white/80 text-xs ml-1">4.9 · 1,700+ reviews</span>
            </div>
            <p class="text-white text-sm font-semibold">Legacy Moving Denver — Denver's top-rated movers since 2018</p>
          </div>
        </div>
        <!-- Quick stats row -->
        <div class="grid grid-cols-4 gap-2">
          {[
            { stat: "1,700+", label: "5-Star Reviews" },
            { stat: "6,000+", label: "Moves Done" },
            { stat: "A Rated", label: "BBB Accredited" },
            { stat: "Same Day", label: "Availability" },
          ].map(({ stat, label }) => (
            <div class="bg-white/8 border border-white/15 rounded-xl p-3 text-center backdrop-blur-sm">
              <div class="font-display font-bold text-sm md:text-base text-primary leading-tight">{stat}</div>
              <div class="text-white/55 text-xs mt-0.5 leading-tight">{label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       QUOTE REQUEST FORM
  ══════════════════════════════════════════════ -->
  <section class="py-12 md:py-16 bg-white border-b border-gray-100" id="quote">
    <div class="container max-w-2xl mx-auto px-4 md:px-0">
      <div class="text-center mb-6">
        <h2 class="font-display font-bold text-2xl md:text-3xl text-secondary mb-2">Get a Free Moving Quote</h2>
        <p class="text-muted-foreground text-sm md:text-base">Fill out the form below and we'll get back to you within the hour.</p>
      </div>
      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-5 md:p-8">
        <div data-version="4" id="56AIR8"></div>
        <script is:inline>
        (function(r,k) {
          var s = document.createElement('script');
          s.async = true;
          s.defer = true;
          s.src = 'https://lead.moverbase.net/js/mbwidgetcls.js?v=66';
          s.addEventListener('load', function() { window.MBWidget.init(r, k, false, true); });
          document.getElementById(r).appendChild(s);
        })('56AIR8','PE277BJIM3OAT6PP0J8IF0BJ5VH5WR8SG2NIKF7AD92OR5EF');
        </script>
        <p class="text-center text-xs text-muted-foreground mt-4 flex items-center justify-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          No commitment · Free estimate · We'll contact you within the hour
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       SCROLLING TRUST BADGES (mirrors homepage)
  ══════════════════════════════════════════════ -->
  <section class="bg-white pt-2 md:pt-3 pb-4 md:pb-6 overflow-hidden border-y border-gray-200">
    <div class="container px-2 md:px-4">
      <div class="flex items-center gap-3 md:gap-0">
        <div class="w-1/3 md:w-1/4 pr-3 md:pr-6 border-r border-gray-300">
          <h3 class="text-gray-900 font-bold text-xs md:text-base lg:text-lg xl:text-xl text-center leading-tight">
            Where Proven Local Trust Meets<br class="hidden md:block"/> Nationwide Standards
          </h3>
        </div>
        <div class="w-2/3 md:w-3/4 pl-3 md:pl-6 relative overflow-hidden">
          <div class="clients-scroll-container">
            <div class="clients-scroll-content">
              <a href="https://maps.app.goo.gl/9YhGXwHp1TMi6xoG9" target="_blank" rel="noopener" class="clients-trust-badge">
                <img src="/images/trust-badges/google-guaranteed.webp" alt="Google" class="clients-badge-logo" width="100" height="35" loading="lazy" decoding="async" />
                <div class="clients-badge-rating"><span class="clients-stars clients-stars-4-8">★★★★★</span></div>
              </a>
              <a href="https://www.yelp.com/biz/legacy-moving-denver-denver-2" target="_blank" rel="noopener" class="clients-trust-badge">
                <img src="/images/trust-badges/yelp.webp" alt="Yelp" class="clients-badge-logo" width="80" height="35" loading="lazy" decoding="async" />
                <div class="clients-badge-rating"><span class="clients-stars clients-stars-4-2">★★★★★</span></div>
              </a>
              <a href="https://www.facebook.com/LegacyMovingDenver" target="_blank" rel="noopener" class="clients-trust-badge">
                <img src="/images/trust-badges/facebook-colorful.webp" alt="Facebook" class="clients-badge-logo" width="100" height="35" loading="lazy" decoding="async" />
                <div class="clients-badge-rating"><span class="clients-stars clients-stars-4-8">★★★★★</span></div>
              </a>
              <a href="https://www.bbb.org/us/co/lakewood/profile/moving-companies/legacy-moving-llc-1296-1000116791" target="_blank" rel="noopener" class="clients-trust-badge">
                <img src="/images/trust-badges/bbb-square.webp" alt="BBB" class="clients-badge-logo" width="80" height="35" loading="lazy" decoding="async" />
                <div class="clients-badge-rating"><span class="clients-stars clients-stars-4-8">★★★★★</span></div>
              </a>
              <a href="https://mapq.st/45jRwvi" target="_blank" rel="noopener" class="clients-trust-badge">
                <img src="/images/trust-badges/mapquest.webp" alt="MapQuest" class="clients-badge-logo" width="100" height="35" loading="lazy" decoding="async" />
                <div class="clients-badge-rating"><span class="clients-stars">★★★★★</span></div>
              </a>
              <a href="https://www.trustindex.io/reviews/legacymovingdenver.com-1" target="_blank" rel="noopener" class="clients-trust-badge">
                <img src="/images/trust-badges/trustindex.webp" alt="Trustindex" class="clients-badge-logo" width="80" height="35" loading="lazy" decoding="async" />
                <div class="clients-badge-rating"><span class="clients-stars clients-stars-4-7">★★★★★</span></div>
              </a>
              <a href="https://www.homeadvisor.com/rated.legacydeliveryandmoving.107671725.html" target="_blank" rel="noopener" class="clients-trust-badge">
                <img src="/images/trust-badges/homeadvisor-elite.webp" alt="HomeAdvisor Elite" class="clients-badge-logo" width="80" height="35" loading="lazy" decoding="async" />
                <div class="clients-badge-rating"><span class="clients-stars clients-stars-4-8">★★★★★</span></div>
              </a>
              <a href="https://www.angi.com/companylist/us/co/denver/legacy-moving-denver-reviews-10178798.htm" target="_blank" rel="noopener" class="clients-trust-badge">
                <img src="/images/trust-badges/angi-super-service-2025.webp" alt="Angi Super Service 2025" class="clients-badge-logo" width="80" height="35" loading="lazy" decoding="async" />
                <div class="clients-badge-rating"><span class="clients-stars clients-stars-4-8">★★★★★</span></div>
              </a>
              <!-- Duplicates for seamless loop -->
              <a href="https://maps.app.goo.gl/9YhGXwHp1TMi6xoG9" target="_blank" rel="noopener" class="clients-trust-badge" aria-hidden="true">
                <img src="/images/trust-badges/google-guaranteed.webp" alt="Google Guaranteed badge - Legacy Moving Denver" class="clients-badge-logo" width="100" height="35" loading="lazy" decoding="async" />
                <div class="clients-badge-rating"><span class="clients-stars clients-stars-4-8">★★★★★</span></div>
              </a>
              <a href="https://www.yelp.com/biz/legacy-moving-denver-denver-2" target="_blank" rel="noopener" class="clients-trust-badge" aria-hidden="true">
                <img src="/images/trust-badges/yelp.webp" alt="Yelp badge - Legacy Moving Denver reviews" class="clients-badge-logo" width="80" height="35" loading="lazy" decoding="async" />
                <div class="clients-badge-rating"><span class="clients-stars clients-stars-4-2">★★★★★</span></div>
              </a>
              <a href="https://www.facebook.com/LegacyMovingDenver" target="_blank" rel="noopener" class="clients-trust-badge" aria-hidden="true">
                <img src="/images/trust-badges/facebook-colorful.webp" alt="Facebook badge - Legacy Moving Denver" class="clients-badge-logo" width="100" height="35" loading="lazy" decoding="async" />
                <div class="clients-badge-rating"><span class="clients-stars clients-stars-4-8">★★★★★</span></div>
              </a>
              <a href="https://www.bbb.org/us/co/lakewood/profile/moving-companies/legacy-moving-llc-1296-1000116791" target="_blank" rel="noopener" class="clients-trust-badge" aria-hidden="true">
                <img src="/images/trust-badges/bbb-square.webp" alt="Better Business Bureau (BBB) accreditation badge" class="clients-badge-logo" width="80" height="35" loading="lazy" decoding="async" />
                <div class="clients-badge-rating"><span class="clients-stars clients-stars-4-8">★★★★★</span></div>
              </a>
              <a href="https://mapq.st/45jRwvi" target="_blank" rel="noopener" class="clients-trust-badge" aria-hidden="true">
                <img src="/images/trust-badges/mapquest.webp" alt="MapQuest moving services badge" class="clients-badge-logo" width="100" height="35" loading="lazy" decoding="async" />
                <div class="clients-badge-rating"><span class="clients-stars">★★★★★</span></div>
              </a>
              <a href="https://www.trustindex.io/reviews/legacymovingdenver.com-1" target="_blank" rel="noopener" class="clients-trust-badge" aria-hidden="true">
                <img src="/images/trust-badges/trustindex.webp" alt="Trustindex verified reviews badge" class="clients-badge-logo" width="80" height="35" loading="lazy" decoding="async" />
                <div class="clients-badge-rating"><span class="clients-stars clients-stars-4-7">★★★★★</span></div>
              </a>
              <a href="https://www.homeadvisor.com/rated.legacydeliveryandmoving.107671725.html" target="_blank" rel="noopener" class="clients-trust-badge" aria-hidden="true">
                <img src="/images/trust-badges/homeadvisor-elite.webp" alt="HomeAdvisor Elite Service badge" class="clients-badge-logo" width="80" height="35" loading="lazy" decoding="async" />
                <div class="clients-badge-rating"><span class="clients-stars clients-stars-4-8">★★★★★</span></div>
              </a>
              <a href="https://www.angi.com/companylist/us/co/denver/legacy-moving-denver-reviews-10178798.htm" target="_blank" rel="noopener" class="clients-trust-badge" aria-hidden="true">
                <img src="/images/trust-badges/angi-super-service-2025.webp" alt="Angi Super Service Award 2025" class="clients-badge-logo" width="80" height="35" loading="lazy" decoding="async" />
                <div class="clients-badge-rating"><span class="clients-stars clients-stars-4-8">★★★★★</span></div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .clients-scroll-container { position:relative; overflow:hidden; width:100%; }
    .clients-scroll-content {
      display:flex; gap:0.5rem; animation:clients-scroll 22s linear infinite;
      width:max-content; will-change:transform; transform:translateZ(0);
    }
    @media(min-width:768px){ .clients-scroll-content{ gap:1.5rem; animation-duration:28s; } }
    @keyframes clients-scroll {
      0%{ transform:translate3d(0,0,0); }
      100%{ transform:translate3d(calc(-50% - 0.25rem),0,0); }
    }
    @media(min-width:768px){
      @keyframes clients-scroll {
        0%{ transform:translate3d(0,0,0); }
        100%{ transform:translate3d(calc(-50% - 0.75rem),0,0); }
      }
    }
    .clients-scroll-container:hover .clients-scroll-content{ animation-play-state:paused; }
    .clients-trust-badge {
      display:flex; flex-direction:column; align-items:center; gap:0.25rem;
      padding:0.5rem; background:white; border-radius:8px; min-width:90px;
      flex-shrink:0; text-decoration:none; transition:transform 0.2s;
    }
    @media(min-width:768px){ .clients-trust-badge{ gap:0.5rem; padding:1rem; min-width:140px; } }
    .clients-trust-badge:hover{ transform:translateY(-2px); }
    .clients-badge-logo{ height:35px; width:auto; max-width:80px; object-fit:contain; }
    @media(min-width:768px){ .clients-badge-logo{ height:50px; max-width:100px; } }
    .clients-badge-rating{ font-size:0.75rem; font-weight:600; color:#1f2937; text-align:center; }
    @media(min-width:768px){ .clients-badge-rating{ font-size:0.875rem; } }
    .clients-stars{ color:#FFA500; font-size:0.875rem; margin-right:0.25rem; }
    @media(min-width:768px){ .clients-stars{ font-size:1rem; } }
    .clients-stars-4-2{ background:linear-gradient(to right,#FFA500 0%,#FFA500 87%,#D3D3D3 87%,#D3D3D3 100%); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }
