---
import HeadSEO from "@/components/HeadSEO.astro";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  ogImage?: URL | undefined;
  phoneNumber?: string | undefined;
}

const { title, description, ogImage, phoneNumber } = Astro.props;
---

<html lang="en">
  <head>
    <HeadSEO title={title} description={description} ogImage={ogImage} />
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-10890296710"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-10890296710');
    </script>
  </head>
  <body class="bg-background min-h-screen font-sans antialiased">
    <!-- Funnel Nav: Logo only, not linked -->
    <div class="bg-white border-b border-gray-100 py-3 px-4 md:px-6">
      <div class="container flex items-center justify-between gap-3">
        <!-- Logo — NOT a link (closed funnel) -->
        <span class="inline-flex items-center select-none min-w-0" aria-label="Legacy Moving Denver">
          <img
            src="/assets/legacy-logo-full.webp"
            alt="Legacy Moving Denver"
            width="180"
            height="55"
            class="h-10 w-auto md:h-12 flex-shrink-0"
            decoding="async"
          />
        </span>
        <!-- Single call CTA in nav — always one line on every screen size -->
        <a
          href={`tel:${phoneNumber ?? '7207642299'}`}
          class="inline-flex items-center gap-1.5 bg-primary hover:bg-primary/90 text-white font-semibold rounded-lg px-3 py-2 md:px-5 text-sm transition-all shadow-sm flex-shrink-0 whitespace-nowrap"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span class="whitespace-nowrap">(720) 764-2299</span>
        </a>
      </div>
    </div>

    <main class="flex-auto">
      <slot />
    </main>

    <!-- Minimal funnel footer -->
    <footer class="bg-secondary text-white py-8 mt-0">
      <div class="container">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-2">
            <img src="/favicon.png" alt="Legacy Moving Denver" class="w-6 h-6 opacity-80" />
            <span class="font-display font-semibold text-sm text-white/80">Legacy Moving Denver</span>
          </div>
          <p class="text-white/40 text-xs text-center">
            DOT #3462023 · MC #1189363 · PUC #HHG-00682 · Licensed & Insured
          </p>
          <a href={`tel:${phoneNumber ?? '7207642299'}`} class="text-primary font-semibold text-sm hover:text-primary/80 transition-colors">
            (720) 764-2299
          </a>
        </div>
      </div>
    </footer>

    <script>
      // Handle phone links differently on desktop vs mobile
      document.addEventListener('DOMContentLoaded', () => {
        const phoneLinks = document.querySelectorAll('.phone-link');
        const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
        phoneLinks.forEach(link => {
          if (!isMobile && link.hasAttribute('data-google-link')) {
            const googleLink = link.getAttribute('data-google-link');
            link.addEventListener('click', (e) => {
              if (!isMobile) {
                e.preventDefault();
                window.open(googleLink, '_blank');
              }
            });
          }
        });
      });
    </script>
  </body>
</html>
