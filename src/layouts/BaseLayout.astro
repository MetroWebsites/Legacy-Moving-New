---
import HeadSEO from "@/components/HeadSEO.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  ogImage?: URL | undefined;
  phoneNumber?: string | undefined;
}

const { title, description, ogImage, phoneNumber } = Astro.props;
---

<html lang="en">
  <head>
    <HeadSEO title={title} description={description} ogImage={ogImage} />
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-10890296710"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-10890296710');
    </script>
  </head>
  <body class="bg-background min-h-screen font-sans antialiased">
    <div class="relative flex min-h-screen flex-col">
      <Header phoneNumber={phoneNumber} />
      <main class="flex-auto">
        <slot />
      </main>
      <Footer phoneNumber={phoneNumber} />
    </div>
    
    <!-- Floating CTA Button -->
    <!-- Mobile: Direct SMS link -->
    <!-- Mobile: Text Us (SMS) -->
    <a 
      href="sms:7203401849?&body=Hi!%20I'm%20looking%20to%20get%20a%20moving%20quote.%0A%0AHere's%20a%20quick%20summary%20of%20my%20move%3A%0A-%20Name%3A%20%0A-%20Email%20address%3A%20%0A-%20Desired%20move%20date%3A%20%0A-%20Starting%20and%20Ending%20address%3A%20%0A-%20Other%20Details%3A%20%0A%0AIf%20you%20prefer%2C%20we%20can%20set%20up%20a%20call%20to%20discuss%20all%20details%20in%20depth%20and%20give%20you%20an%20accurate%20quote." 
      class="floating-cta-button md:hidden fixed bottom-6 right-6 bg-primary hover:bg-primary/90 text-white font-semibold rounded-full shadow-lg hover:shadow-xl transition-all duration-300 z-50 flex items-center justify-center px-6 py-3"
      aria-label="Text us"
    >
      Text Us
    </a>
    
    <!-- Desktop: Free Quote -->
    <a 
      href="/get-quote"
      class="floating-cta-button hidden md:flex fixed bottom-6 right-6 bg-primary hover:bg-primary/90 text-white font-semibold rounded-full shadow-lg hover:shadow-xl transition-all duration-300 z-50 items-center justify-center px-6 py-3"
      aria-label="Get a free quote"
    >
      Free Quote
    </a>
    
    <style>
      .floating-cta-button {
        animation: pulse-subtle 2s ease-in-out infinite;
      }
      
      @keyframes pulse-subtle {
        0%, 100% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.05);
        }
      }
      
      .floating-cta-button:hover {
        animation: none;
        transform: scale(1.1);
      }
    </style>
    
    <script>
      // Handle phone links differently on desktop vs mobile
      document.addEventListener('DOMContentLoaded', () => {
        const phoneLinks = document.querySelectorAll('.phone-link');
        const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
        
        phoneLinks.forEach(link => {
          if (!isMobile && link.hasAttribute('data-google-link')) {
            const googleLink = link.getAttribute('data-google-link');
            
            link.addEventListener('click', (e) => {
              if (!isMobile) {
                e.preventDefault();
                window.open(googleLink, '_blank');
              }
              // On mobile, the default tel: behavior will work
            });
          }
        });
      });
    </script>
  </body>
</html>
